export default function AdminDashboard() {
  const { currentAdmin } = useAdmin();

  const [drawerOpen, setDrawerOpen] =
    useState(false);

  const [search, setSearch] =
    useState('');

  const [dashboardData, setDashboardData] =
    useState<DashboardData>({
      properties: [],
      viewings: [],
      marketers: [],
      customers: [],
      refreshedAt: null,
    });

  const [dashboardLoading, setDashboardLoading] =
    useState(true);

  const [dashboardError, setDashboardError] =
    useState('');

  const adminFirstName =
    currentAdmin?.firstName?.trim() || 'Admin';

  const loadDashboard = async () => {
    try {
      setDashboardError('');

      const token =
        await SecureStore.getItemAsync(
          'makazii_admin_token',
        );

      if (!token) {
        throw new Error(
          'Admin session not found.',
        );
      }

      const headers = {
        Accept: 'application/json',
        Authorization: `Bearer ${token}`,
      };

      const [
        propertiesResponse,
        viewingsResponse,
        marketersResponse,
        customersResponse,
      ] = await Promise.all([
        fetch(
          `${API_BASE_URL}/admin/properties`,
          { headers },
        ),
        fetch(
          `${API_BASE_URL}/admin/viewings`,
          { headers },
        ),
        fetch(
          `${API_BASE_URL}/admin/marketers`,
          { headers },
        ),
        fetch(
          `${API_BASE_URL}/admin/users`,
          { headers },
        ),
      ]);

      if (
        propertiesResponse.status === 401 ||
        propertiesResponse.status === 403 ||
        viewingsResponse.status === 401 ||
        viewingsResponse.status === 403 ||
        marketersResponse.status === 401 ||
        marketersResponse.status === 403 ||
        customersResponse.status === 401 ||
        customersResponse.status === 403
      ) {
        throw new Error(
          'Your admin session has expired. Please sign in again.',
        );
      }

      if (
        !propertiesResponse.ok ||
        !viewingsResponse.ok ||
        !marketersResponse.ok ||
        !customersResponse.ok
      ) {
        throw new Error(
          'Unable to load dashboard data.',
        );
      }

      const [
        propertiesPayload,
        viewingsPayload,
        marketersPayload,
        customersPayload,
      ] = await Promise.all([
        propertiesResponse.json(),
        viewingsResponse.json(),
        marketersResponse.json(),
        customersResponse.json(),
      ]);

      if (
        propertiesPayload?.success === false ||
        viewingsPayload?.success === false ||
        marketersPayload?.success === false ||
        customersPayload?.success === false
      ) {
        throw new Error(
          'Unable to load dashboard data.',
        );
      }

      setDashboardData({
        properties: extractArray(
          propertiesPayload,
          ['properties'],
        ),
        viewings: extractArray(
          viewingsPayload,
          ['viewings'],
        ),
        marketers: extractArray(
          marketersPayload,
          ['marketers'],
        ),
        customers: extractArray(
          customersPayload,
          ['customers'],
        ),
        refreshedAt: new Date(),
      });
    } catch (error) {
      setDashboardError(
        error instanceof Error
          ? error.message
          : 'Unable to load dashboard data.',
      );
    } finally {
      setDashboardLoading(false);
    }
  };

  useEffect(() => {
    void loadDashboard();
  }, []);

  const adminInitial =
    adminFirstName.charAt(0).toUpperCase() || 'A';

  const totalProperties =
    dashboardData.properties.length;

  const totalViewings =
    dashboardData.viewings.length;

  const pendingVerification =
    dashboardData.properties.filter(
      (property) => {
        const status =
          String(
            property.status ?? '',
          ).toUpperCase();

        return (
          property.verified === false ||
          status === 'PENDING_VERIFICATION'
        );
      },
    ).length;

  const activeMarketers =
    dashboardData.marketers.filter(
      (marketer) =>
        Boolean(marketer.user?.isActive) ||
        String(
          marketer.user?.accountStatus ?? '',
        ).toUpperCase() === 'ACTIVE',
    ).length;

  const upcomingViewings =
    dashboardData.viewings
      .filter((viewing) => {
        const status =
          String(
            viewing.status ?? '',
          ).toUpperCase();

        return (
          status !== 'CANCELLED' &&
          status !== 'COMPLETED' &&
          getViewingTimestamp(viewing) >=
            Date.now()
        );
      })
      .sort(
        (a, b) =>
          getViewingTimestamp(a) -
          getViewingTimestamp(b),
      );

  const nextViewing =
    upcomingViewings[0] ?? null;

  const nextViewingTitle =
    nextViewing?.property?.title ??
    (
      nextViewing?.property?.longStayType ??
      nextViewing?.property?.shortStayType ??
      'Property'
    ).replaceAll('_', ' ');

  const nextViewingLocation = [
    nextViewing?.property?.area,
    nextViewing?.property?.town,
    nextViewing?.property?.county,
  ]
    .map((value) => String(value ?? '').trim())
    .filter(Boolean)
    .join(', ') || 'Location not specified';

  const recentActivities =
    useMemo<ActivityItem[]>(() => {
      const propertyActivities =
        dashboardData.properties.map(
          (property) => {
            const history =
              property.statusHistory?.[0];

            const status =
              String(
                property.status ?? '',
              ).toUpperCase();

            const isPending =
              status ===
              'PENDING_VERIFICATION';

            return {
              title: isPending
                ? 'Property awaiting verification'
                : status === 'ACTIVE'
                  ? 'Property active'
                  : 'Property updated',
              description:
                `${property.title ?? 'Property'} · ${formatPropertyDescription(property)}`,
              time: formatActivityTime(
                history?.createdAt ??
                  property.updatedAt ??
                  property.createdAt,
              ),
              status: isPending
                ? 'Review'
                : status === 'ACTIVE'
                  ? 'Active'
                  : status || 'Updated',
              statusColor: isPending
                ? COLORS.orange
                : status === 'ACTIVE'
                  ? COLORS.green
                  : COLORS.blue,
              statusBackground: isPending
                ? COLORS.orangeSoft
                : status === 'ACTIVE'
                  ? COLORS.greenSoft
                  : COLORS.blueSoft,
              icon: isPending
                ? ShieldCheck
                : status === 'ACTIVE'
                  ? BadgeCheck
                  : Building2,
              timestamp: new Date(
                history?.createdAt ??
                  property.updatedAt ??
                  property.createdAt ??
                  0,
              ).getTime(),
            };
          },
        );

      const viewingActivities =
        dashboardData.viewings.map(
          (viewing) => {
            const status =
              String(
                viewing.status ?? '',
              ).toUpperCase();

            const statusIsPending =
              status ===
                'PENDING_PAYMENT' ||
              status === 'PAID';

            return {
              title: 'Viewing request',
              description:
                `${viewing.property?.title ?? 'Property'} · ${formatPropertyDescription(viewing.property)}`,
              time: formatActivityTime(
                viewing.createdAt ??
                  viewing.updatedAt,
              ),
              status:
                statusIsPending
                  ? 'Pending'
                  : status || 'Updated',
              statusColor:
                statusIsPending
                  ? COLORS.blue
                  : status === 'CANCELLED'
                    ? COLORS.red
                    : COLORS.green,
              statusBackground:
                statusIsPending
                  ? COLORS.blueSoft
                  : status === 'CANCELLED'
                    ? COLORS.redSoft
                    : COLORS.greenSoft,
              icon: CalendarDays,
              timestamp: new Date(
                viewing.createdAt ??
                  viewing.updatedAt ??
                  0,
              ).getTime(),
            };
          },
        );

      const marketerActivities =
        dashboardData.marketers.map(
          (marketer) => {
            const active =
              Boolean(
                marketer.user?.isActive,
              ) ||
              String(
                marketer.user?.accountStatus ??
                  '',
              ).toUpperCase() ===
                'ACTIVE';

            const name =
              [
                marketer.user?.firstName,
                marketer.user?.lastName,
              ]
                .filter(Boolean)
                .join(' ') ||
              'Marketer';

            return {
              title:
                'Marketer registered',
              description:
                `${name} · Makazii field team`,
              time: formatActivityTime(
                marketer.createdAt ??
                  marketer.updatedAt,
              ),
              status: active
                ? 'Active'
                : 'Inactive',
              statusColor: active
                ? COLORS.lime
                : COLORS.muted,
              statusBackground: active
                ? COLORS.limeSoft
                : COLORS.cardSoft,
              icon: UserCheck,
              timestamp: new Date(
                marketer.createdAt ??
                  marketer.updatedAt ??
                  0,
              ).getTime(),
            };
          },
        );

      return [
        ...propertyActivities,
        ...viewingActivities,
        ...marketerActivities,
      ]
        .sort(
          (a, b) =>
            b.timestamp - a.timestamp,
        )
        .slice(0, 4)
        .map(
          ({
            timestamp: _timestamp,
            ...item
          }) => item,
        );
    }, [
      dashboardData.properties,
      dashboardData.viewings,
      dashboardData.marketers,
    ]);

