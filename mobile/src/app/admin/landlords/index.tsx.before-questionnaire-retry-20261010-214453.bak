import React, { useEffect, useMemo, useState } from 'react';
import { SafeAreaView } from 'react-native-safe-area-context';
import {
  ActivityIndicator,
  Alert,
  Modal,
  Platform,
  Pressable,
  ScrollView,
  StyleSheet,
  Text,
  TextInput,
  useWindowDimensions,
  View,
  ViewStyle,
  TextStyle,
} from 'react-native';
import {
  Bell,
  Building2,
  Check,
  ChevronDown,
  Eye,
  Home,
  LayoutDashboard,
  Mail,
  MapPin,
  Menu,
  MoreHorizontal,
  Pencil,
  Phone,
  Plus,
  Search,
  Settings,
  ShieldCheck,
  UserCheck,
  UserPlus,
  Users,
  X,
  XCircle,
} from 'lucide-react-native';
import { router } from 'expo-router';
import * as SecureStore from 'expo-secure-store';
import { API_BASE_URL } from '@/config/api';

const COLORS = {
  background: '#0B0F10',
  sidebar: '#101516',
  card: '#14191B',
  cardSoft: '#181E20',
  lime: '#D7FF5F',
  white: '#FFFFFF',
  muted: '#9CA5A7',
  mutedDark: '#657073',
  sidebarText: '#7F898B',
  border: '#252C2E',
  green: '#62D39B',
  greenSoft: '#183128',
  orange: '#FFB45B',
  orangeSoft: '#342818',
  red: '#FF7070',
  redSoft: '#351D20',
  blue: '#72B7FF',
  blueSoft: '#182A3B',
};

type LandlordStatus = 'Active' | 'Pending' | 'Suspended';
type ApplicationStatus = 'PENDING' | 'UNDER_REVIEW' | 'ACTION_REQUIRED' | 'APPROVED' | 'REJECTED' | string;
type IdVerificationStatus = 'PENDING' | 'REVIEW' | 'VERIFIED' | 'REJECTED' | string;
type LandlordQuestionnaire = Record<string, unknown>;

type BackendLandlord = {
  id: string;
  applicationStatus: ApplicationStatus;
  idVerificationStatus: IdVerificationStatus;
  reviewNotes?: string | null;
  reviewedAt?: string | null;
  createdAt?: string;
  propertyCount?: number;
  user?: {
    firstName?: string | null;
    lastName?: string | null;
    email?: string | null;
    phone?: string | null;
    accountStatus?: string;
    isActive?: boolean;
    createdAt?: string;
  };
};

type LandlordPerformance = {
  landlordId: string;
  properties: {
    total: number;
    byStatus: { status: string; count: number }[];
    recent: {
      id: string;
      title: string | null;
      status: string;
      purpose: string;
      county: string | null;
      town: string | null;
      createdAt: string;
    }[];
  };
  viewings: { total: number; completed: number; cancelled: number };
  inspections: { total: number; completed: number; cancelled: number };
  bookings: { total: number; completed: number; cancelled: number };
  payments: {
    status: string;
    currency: string;
    count: number;
    amount: number | string;
  }[];
  note?: string;
};

type Landlord = {
  id: string;
  name: string;
  phone: string;
  email: string;
  location: string;
  properties: number;
  verifiedProperties: number;
  status: LandlordStatus;
  applicationStatus: ApplicationStatus;
  idVerificationStatus: IdVerificationStatus;
  joined: string;
  source: 'Makazii Team' | 'Marketer' | 'Direct';
  notes: string;
};

const INITIAL_LANDLORDS: Landlord[] = [];

const NAV_ITEMS = [
  {
    label: 'Dashboard',
    icon: LayoutDashboard,
    route: '/admin/dashboard',
  },
  {
    label: 'Properties',
    icon: Home,
    route: '/admin/properties',
  },
  {
    label: 'Viewings',
    icon: Building2,
    route: '/admin/viewings',
    badge: '24',
  },
  {
    label: 'Verification',
    icon: ShieldCheck,
    route: '/admin/verification',
    badge: '12',
  },
  {
    label: 'Landlords',
    icon: Users,
    route: '/admin/landlords',
  },
  {
    label: 'Marketers',
    icon: UserCheck,
    route: '/admin/marketers',
  },
  {
    label: 'Users',
    icon: Users,
    route: '/admin/users',
  },
  {
    label: 'Settings',
    icon: Settings,
    route: '/admin/settings',
  },
];

const STATUS_OPTIONS = ['All', 'PENDING', 'UNDER_REVIEW', 'ACTION_REQUIRED', 'APPROVED', 'REJECTED'] as const;

const formatNumber = (value: number) =>
  value.toLocaleString('en-KE');

const getStatusColors = (status: LandlordStatus) => {
  switch (status) {
    case 'Active':
      return {
        backgroundColor: COLORS.greenSoft,
        color: COLORS.green,
      };

    case 'Suspended':
      return {
        backgroundColor: COLORS.redSoft,
        color: COLORS.red,
      };

    default:
      return {
        backgroundColor: COLORS.orangeSoft,
        color: COLORS.orange,
      };
  }
};

export default function LandlordsPage() {
  const { width } = useWindowDimensions();

  const isDesktop = width >= 1050;
  const isTablet = width >= 760;

  const [landlords, setLandlords] =
    useState<Landlord[]>(INITIAL_LANDLORDS);
  const [landlordsLoading, setLandlordsLoading] = useState(true);
  const [landlordsError, setLandlordsError] = useState('');
  const [backendSummary, setBackendSummary] = useState<{
    total: number; pending: number; underReview: number; approved: number;
    rejected: number; pendingIds: number; verifiedIds: number;
  } | null>(null);

  const [search, setSearch] = useState('');

  const [statusFilter, setStatusFilter] =
    useState<string>('All');

  const [sidebarOpen, setSidebarOpen] = useState(false);

  const [selectedLandlord, setSelectedLandlord] =
    useState<Landlord | null>(null);

  const [detailsVisible, setDetailsVisible] =
    useState(false);

  const [performance, setPerformance] =
    useState<LandlordPerformance | null>(null);
  const [performanceLoading, setPerformanceLoading] = useState(false);
  const [performanceError, setPerformanceError] = useState('');
  const [performanceReloadKey, setPerformanceReloadKey] = useState(0);
  const [landlordQuestionnaire, setLandlordQuestionnaire] =
    useState<LandlordQuestionnaire | null>(null);
  const [questionnaireLoading, setQuestionnaireLoading] = useState(false);
  const [questionnaireError, setQuestionnaireError] = useState('');


  useEffect(() => {
    let cancelled = false;

    const loadLandlords = async () => {
      setLandlordsLoading(true);
      setLandlordsError('');

      try {
        let token: string | null = null;

        if (Platform.OS === 'web') {
          token =
            typeof localStorage !== 'undefined'
              ? localStorage.getItem('makazii_admin_token')
              : null;
        } else {
          token = await SecureStore.getItemAsync('makazii_admin_token');
        }

        if (!token) {
          throw new Error('Admin session not found. Please sign in again.');
        }

        const response = await fetch(`${API_BASE_URL}/admin/landlords`, {
          headers: {
            Accept: 'application/json',
            Authorization: `Bearer ${token}`,
          },
        });

        if (response.status === 401 || response.status === 403) {
          throw new Error('Your admin session has expired. Please sign in again.');
        }
        if (!response.ok) {
          throw new Error('Unable to load registered landlords.');
        }

        const payload = await response.json();
        if (payload?.success === false) {
          throw new Error(payload?.message || 'Unable to load registered landlords.');
        }

        const records: BackendLandlord[] = Array.isArray(payload?.landlords)
          ? payload.landlords
          : Array.isArray(payload?.data?.landlords)
            ? payload.data.landlords
            : [];

        const mapped: Landlord[] = records.map((item) => {
          const name = [
            item.user?.firstName?.trim(),
            item.user?.lastName?.trim(),
          ].filter(Boolean).join(' ') || 'Name not provided';

          const applicationStatus = String(item.applicationStatus || 'PENDING').toUpperCase();
          const idVerificationStatus = String(item.idVerificationStatus || 'PENDING').toUpperCase();

          const status: LandlordStatus =
            applicationStatus === 'APPROVED'
              ? 'Active'
              : applicationStatus === 'REJECTED'
                ? 'Suspended'
                : 'Pending';

          const createdAt = item.createdAt || item.user?.createdAt;
          const joined = createdAt
            ? new Date(createdAt).toLocaleDateString('en-KE', {
                day: '2-digit', month: 'short', year: 'numeric',
              })
            : 'Date unavailable';

          return {
            id: item.id,
            name,
            phone: item.user?.phone || 'Not provided',
            email: item.user?.email || '',
            location: 'Not provided by registration list',
            properties: Number(item.propertyCount || 0),
            verifiedProperties: 0,
            status,
            applicationStatus,
            idVerificationStatus,
            joined,
            source: 'Direct',
            notes: item.reviewNotes || '',
          };
        });

        if (!cancelled) {
          setLandlords(mapped);
          setBackendSummary(payload?.summary || payload?.data?.summary || null);
        }
      } catch (error) {
        if (!cancelled) {
          setLandlordsError(
            error instanceof Error ? error.message : 'Unable to load registered landlords.',
          );
        }
      } finally {
        if (!cancelled) setLandlordsLoading(false);
      }
    };

    void loadLandlords();
    return () => { cancelled = true; };
  }, []);

  useEffect(() => {
    let cancelled = false;
    const landlordId = selectedLandlord?.id;

    if (!detailsVisible || !landlordId) {
      setLandlordQuestionnaire(null);
      setQuestionnaireError('');
      setQuestionnaireLoading(false);
      return () => { cancelled = true; };
    }

    const loadQuestionnaire = async () => {
      setLandlordQuestionnaire(null);
      setQuestionnaireError('');
      setQuestionnaireLoading(true);

      try {
        let token: string | null = null;

        if (Platform.OS === 'web') {
          token =
            typeof localStorage !== 'undefined'
              ? localStorage.getItem('makazii_admin_token')
              : null;
        } else {
          token = await SecureStore.getItemAsync('makazii_admin_token');
        }

        if (!token) {
          throw new Error('Admin session not found. Please sign in again.');
        }

        const response = await fetch(
          `${API_BASE_URL}/admin/landlords/${encodeURIComponent(landlordId)}`,
          {
            headers: {
              Accept: 'application/json',
              Authorization: `Bearer ${token}`,
            },
          },
        );

        const payload = await response.json();

        if (!response.ok || payload?.success === false) {
          throw new Error(
            payload?.message || 'Unable to load landlord questionnaire.',
          );
        }

        const result = payload?.landlord ?? payload?.data?.landlord ?? payload?.data ?? payload;
        const answers = result?.questionnaire;

        if (
          !answers ||
          typeof answers !== 'object' ||
          Array.isArray(answers)
        ) {
          if (!cancelled) setLandlordQuestionnaire(null);
        } else if (!cancelled) {
          setLandlordQuestionnaire(answers as LandlordQuestionnaire);
        }
      } catch (error) {
        if (!cancelled) {
          setQuestionnaireError(
            error instanceof Error
              ? error.message
              : 'Unable to load landlord questionnaire.',
          );
        }
      } finally {
        if (!cancelled) setQuestionnaireLoading(false);
      }
    };

    void loadQuestionnaire();
    return () => { cancelled = true; };
  }, [detailsVisible, selectedLandlord?.id]);

  useEffect(() => {
    let cancelled = false;
    const landlordId = selectedLandlord?.id;

    if (!detailsVisible || !landlordId) {
      setPerformance(null);
      setPerformanceError('');
      setPerformanceLoading(false);
      return () => { cancelled = true; };
    }

    const loadPerformance = async () => {
      setPerformance(null);
      setPerformanceError('');
      setPerformanceLoading(true);

      try {
        let token: string | null = null;

        if (Platform.OS === 'web') {
          token =
            typeof localStorage !== 'undefined'
              ? localStorage.getItem('makazii_admin_token')
              : null;
        } else {
          token = await SecureStore.getItemAsync('makazii_admin_token');
        }

        if (!token) {
          throw new Error('Admin session not found. Please sign in again.');
        }

        const response = await fetch(
          `${API_BASE_URL}/admin/landlords/${encodeURIComponent(landlordId)}/performance`,
          {
            headers: {
              Accept: 'application/json',
              Authorization: `Bearer ${token}`,
            },
          },
        );

        if (response.status === 401 || response.status === 403) {
          throw new Error('Your admin session has expired. Please sign in again.');
        }

        const payload = await response.json();

        if (!response.ok || payload?.success === false) {
          throw new Error(
            payload?.message || 'Unable to load landlord performance.',
          );
        }

        const result = payload?.data ?? payload;

        if (
          !result?.properties ||
          !result?.viewings ||
          !result?.inspections ||
          !result?.bookings ||
          !Array.isArray(result?.payments)
        ) {
          throw new Error('The performance response was incomplete.');
        }

        if (!cancelled) setPerformance(result as LandlordPerformance);
      } catch (error) {
        if (!cancelled) {
          setPerformanceError(
            error instanceof Error
              ? error.message
              : 'Unable to load landlord performance.',
          );
        }
      } finally {
        if (!cancelled) setPerformanceLoading(false);
      }
    };

    void loadPerformance();
    return () => { cancelled = true; };
  }, [detailsVisible, selectedLandlord?.id, performanceReloadKey]);

  const stats = useMemo(() => {
    return {
      total: backendSummary?.total ?? landlords.length,
      active: backendSummary?.approved ?? landlords.filter((item) => item.applicationStatus === 'APPROVED').length,
      pending: backendSummary?.pending ?? landlords.filter((item) => item.applicationStatus === 'PENDING').length,
      suspended: backendSummary?.rejected ?? landlords.filter((item) => item.applicationStatus === 'REJECTED').length,
      properties: landlords.reduce(
        (sum, item) => sum + item.properties,
        0,
      ),
    };
  }, [landlords, backendSummary]);

  const filteredLandlords = useMemo(() => {
    const query = search.trim().toLowerCase();

    return landlords.filter((landlord) => {
      const matchesStatus =
        statusFilter === 'All' ||
        landlord.applicationStatus === statusFilter;

      const matchesSearch =
        !query ||
        landlord.id.toLowerCase().includes(query) ||
        landlord.name.toLowerCase().includes(query) ||
        landlord.phone.toLowerCase().includes(query) ||
        landlord.email.toLowerCase().includes(query) ||
        landlord.location.toLowerCase().includes(query) ||
        landlord.applicationStatus.toLowerCase().includes(query) ||
        landlord.idVerificationStatus.toLowerCase().includes(query);

      return matchesStatus && matchesSearch;
    });
  }, [landlords, search, statusFilter]);

  const openDetails = (landlord: Landlord) => {
    setPerformance(null);
    setPerformanceError('');
    setSelectedLandlord(landlord);
    setDetailsVisible(true);
  };

  const renderSidebar = () => (
    <View
      style={[
        styles.sidebar,
        !isDesktop && styles.mobileSidebar,
        !isDesktop && {
          position: 'absolute',
          left: 0,
          top: 0,
          bottom: 0,
          zIndex: 50,
          width: Math.min(width * 0.86, 320),
        },
        !isDesktop &&
          !sidebarOpen && {
            display: 'none',
          },
      ]}
    >
      <View style={styles.sidebarHeader}>
        <View style={styles.logoMark}>
          <Text style={styles.logoMarkText}>M</Text>
        </View>

        <View>
          <Text style={styles.brandName}>MAKAZII</Text>
          <Text style={styles.brandSubtitle}>
            TEAM PORTAL
          </Text>
        </View>
      </View>

      <View style={styles.platformStatus}>
        <View style={styles.onlineDot} />

        <Text style={styles.platformText}>
          PLATFORM ONLINE
        </Text>
      </View>

      <ScrollView
        showsVerticalScrollIndicator={false}
        contentContainerStyle={styles.sidebarScroll}
      >
        <Text style={styles.menuLabel}>WORKSPACE</Text>

        {NAV_ITEMS.map((item) => {
          const Icon = item.icon;
          const active = item.label === 'Landlords';

          return (
            <Pressable
              key={item.label}
              style={[
                styles.navItem,
                active && styles.navItemActive,
              ]}
              onPress={() => {
                setSidebarOpen(false);

                if (item.route !== '/admin/landlords') {
                  router.push(item.route as never);
                }
              }}
            >
              <Icon
                size={19}
                color={
                  active
                    ? COLORS.lime
                    : COLORS.sidebarText
                }
                strokeWidth={active ? 2.3 : 1.8}
              />

              <Text
                style={[
                  styles.navText,
                  active && styles.navTextActive,
                ]}
              >
                {item.label}
              </Text>

              {item.badge && (
                <View
                  style={[
                    styles.navBadge,
                    active &&
                      styles.navBadgeActive,
                  ]}
                >
                  <Text
                    style={[
                      styles.navBadgeText,
                      active &&
                        styles.navBadgeTextActive,
                    ]}
                  >
                    {item.badge}
                  </Text>
                </View>
              )}
            </Pressable>
          );
        })}

        <View style={styles.sidebarDivider} />

        <Text style={styles.menuLabel}>ACCOUNT</Text>

        <View style={styles.adminCard}>
          <View style={styles.adminAvatar}>
            <Text style={styles.adminAvatarText}>A</Text>
          </View>

          <View style={styles.adminInfo}>
            <Text style={styles.adminName}>Admin</Text>
            <Text style={styles.adminRole}>
              Administrator
            </Text>
          </View>

          <MoreHorizontal
            size={18}
            color={COLORS.mutedDark}
          />
        </View>

        <Pressable
          style={styles.signOutButton}
          onPress={() =>
            Alert.alert(
              'Sign out',
              'Sign out functionality will be connected to the backend later.',
            )
          }
        >
          <XCircle
            size={18}
            color={COLORS.sidebarText}
          />

          <Text style={styles.signOutText}>
            Sign out
          </Text>
        </Pressable>
      </ScrollView>
    </View>
  );

  const renderTopBar = () => (
    <View style={styles.topBar}>
      <View style={styles.topLeft}>
        {!isDesktop && (
          <Pressable
            style={styles.menuButton}
            onPress={() => setSidebarOpen(true)}
          >
            <Menu
              size={21}
              color={COLORS.white}
            />
          </Pressable>
        )}

        <View>
          <Text style={styles.breadcrumb}>
            ADMIN / LANDLORDS
          </Text>

          <Text style={styles.topTitle}>
            Landlord management
          </Text>
        </View>
      </View>

      <View style={styles.topActions}>
        {isDesktop && (
          <View style={styles.topSearch}>
            <Search
              size={17}
              color={COLORS.mutedDark}
            />

            <TextInput
              value={search}
              onChangeText={setSearch}
              placeholder="Search landlords..."
              placeholderTextColor={
                COLORS.mutedDark
              }
              style={styles.topSearchInput}
            />
          </View>
        )}

        <Pressable style={styles.iconButton}>
          <Bell
            size={19}
            color={COLORS.muted}
          />

          <View style={styles.notificationDot} />
        </Pressable>

        <View style={styles.topAvatar}>
          <Text style={styles.topAvatarText}>A</Text>
        </View>
      </View>
    </View>
  );

  const renderStatCard = (
    label: string,
    value: number,
    icon: React.ElementType,
    accent: string,
    description: string,
  ) => {
    const Icon = icon;

    return (
      <View style={styles.statCard}>
        <View style={styles.statTop}>
          <View
            style={[
              styles.statIcon,
              {
                backgroundColor: `${accent}18`,
              },
            ]}
          >
            <Icon
              size={20}
              color={accent}
            />
          </View>

          <MoreHorizontal
            size={18}
            color={COLORS.mutedDark}
          />
        </View>

        <Text style={styles.statValue}>
          {formatNumber(value)}
        </Text>

        <Text style={styles.statLabel}>
          {label}
        </Text>

        <Text style={styles.statSubtext}>
          {description}
        </Text>
      </View>
    );
  };

  const renderStatusPill = (
    status: LandlordStatus,
  ) => {
    const statusColors =
      getStatusColors(status);

    return (
      <View
        style={[
          styles.statusPill,
          {
            backgroundColor:
              statusColors.backgroundColor,
          },
        ]}
      >
        <View
          style={[
            styles.statusDot,
            {
              backgroundColor:
                statusColors.color,
            },
          ]}
        />

        <Text
          style={[
            styles.statusText,
            {
              color: statusColors.color,
            },
          ]}
        >
          {status}
        </Text>
      </View>
    );
  };

  const renderLandlordCard = (
    landlord: Landlord,
  ) => {
    return (
      <Pressable
        key={landlord.id}
        style={styles.landlordCard}
        onPress={() => openDetails(landlord)}
      >
        <View style={styles.landlordMain}>
          <View style={styles.landlordAvatar}>
            <Text style={styles.landlordAvatarText}>
              {landlord.name
                .charAt(0)
                .toUpperCase()}
            </Text>
          </View>

          <View style={styles.landlordIdentity}>
            <View style={styles.idRow}>
              <Text style={styles.landlordId}>
                {landlord.id}
              </Text>

              {renderStatusPill(landlord.status)}
            </View>

            <Text
              style={styles.landlordName}
              numberOfLines={1}
            >
              {landlord.name}
            </Text>

            <View style={styles.locationRow}>
              <MapPin
                size={13}
                color={COLORS.mutedDark}
              />

              <Text
                style={styles.locationText}
                numberOfLines={1}
              >
                {landlord.location}
              </Text>
            </View>
          </View>
        </View>

        <View style={styles.contactColumn}>
          <Text style={styles.columnLabel}>
            CONTACT
          </Text>

          <View style={styles.contactRow}>
            <Phone
              size={13}
              color={COLORS.mutedDark}
            />

            <Text
              style={styles.contactText}
              numberOfLines={1}
            >
              {landlord.phone}
            </Text>
          </View>

          <View style={styles.contactRow}>
            <Mail
              size={13}
              color={COLORS.mutedDark}
            />

            <Text
              style={styles.contactText}
              numberOfLines={1}
            >
              {landlord.email ||
                'No email provided'}
            </Text>
          </View>
        </View>

        <View style={styles.propertiesColumn}>
          <Text style={styles.columnLabel}>
            PROPERTIES
          </Text>

          <Text style={styles.propertyCount}>
            {landlord.properties}
          </Text>

          <Text style={styles.verifiedCount}>
            Property verification details unavailable
          </Text>
        </View>

        <View style={styles.sourceColumn}>
          <Text style={styles.columnLabel}>
            SOURCE
          </Text>

          <Text
            style={styles.sourceText}
            numberOfLines={1}
          >
            {landlord.source}
          </Text>

          <Text style={styles.joinedText}>
            Joined {landlord.joined}
          </Text>
        </View>

        <View style={styles.viewAction}>
          <Eye
            size={17}
            color={COLORS.muted}
          />
        </View>
      </Pressable>
    );
  };

  return (
    <SafeAreaView style={styles.safeArea}>
      <View style={styles.app}>
        {renderSidebar()}

        {!isDesktop && sidebarOpen && (
          <Pressable
            style={styles.overlay}
            onPress={() =>
              setSidebarOpen(false)
            }
          />
        )}

        <View
          style={[
            styles.content,
            isDesktop &&
              styles.contentDesktop,
          ]}
        >
          {renderTopBar()}

          <ScrollView
            showsVerticalScrollIndicator={false}
            contentContainerStyle={[
              styles.pageContent,
              isTablet &&
                styles.pageContentTablet,
            ]}
          >
            <View style={styles.pageHeader}>
              <View style={styles.pageHeaderText}>
                <Text style={styles.eyebrow}>
                  PLATFORM PARTNERS
                </Text>

                <Text style={styles.pageTitle}>
                  Landlords
                </Text>

                <Text
                  style={styles.pageDescription}
                >
                  Manage property owners, their
                  listings and onboarding status.
                  Registered landlord applications and their verification statuses.
                </Text>
              </View>
            </View>

            <View
              style={[
                styles.statsGrid,
                !isTablet &&
                  styles.statsGridMobile,
              ]}
            >
              {renderStatCard(
                'Total landlords',
                stats.total,
                Users,
                COLORS.lime,
                'All registered owners',
              )}

              {renderStatCard(
                'Active',
                stats.active,
                UserCheck,
                COLORS.green,
                'Currently active',
              )}

              {renderStatCard(
                'Pending onboarding',
                stats.pending,
                UserPlus,
                COLORS.orange,
                'Need review',
              )}

              {renderStatCard(
                'Suspended',
                stats.suspended,
                XCircle,
                COLORS.red,
                'Temporarily inactive',
              )}

              {isDesktop &&
                renderStatCard(
                  'Listed properties',
                  stats.properties,
                  Home,
                  COLORS.blue,
                  'Across all landlords',
                )}
            </View>

            {!isDesktop && (
              <View style={styles.mobileSearch}>
                <Search
                  size={18}
                  color={COLORS.mutedDark}
                />

                <TextInput
                  value={search}
                  onChangeText={setSearch}
                  placeholder="Search landlord, phone or location..."
                  placeholderTextColor={
                    COLORS.mutedDark
                  }
                  style={
                    styles.mobileSearchInput
                  }
                />
              </View>
            )}

            <View style={styles.sectionHeader}>
              <View>
                <Text
                  style={styles.sectionTitle}
                >
                  Landlord directory
                </Text>

                <Text
                  style={styles.sectionSubtitle}
                >
                  {filteredLandlords.length}{' '}
                  landlord
                  {filteredLandlords.length ===
                  1
                    ? ''
                    : 's'} found
                </Text>
              </View>

              <View style={styles.filterArea}>
                <ScrollView
                  horizontal
                  showsHorizontalScrollIndicator={
                    false
                  }
                  contentContainerStyle={
                    styles.filterScroll
                  }
                >
                  {STATUS_OPTIONS.map(
                    (status) => {
                      const active =
                        statusFilter ===
                        status;

                      return (
                        <Pressable
                          key={status}
                          onPress={() =>
                            setStatusFilter(
                              status,
                            )
                          }
                          style={[
                            styles.filterChip,
                            active &&
                              styles.filterChipActive,
                          ]}
                        >
                          <Text
                            style={[
                              styles.filterChipText,
                              active &&
                                styles.filterChipTextActive,
                            ]}
                          >
                            {status === 'All'
                              ? 'All'
                              : status === 'PENDING'
                                ? 'Pending'
                                : status === 'UNDER_REVIEW'
                                  ? 'Under review'
                                  : status === 'ACTION_REQUIRED'
                                    ? 'Action required'
                                    : status === 'APPROVED'
                                      ? 'Approved'
                                      : 'Rejected'}
                          </Text>

                          {status !==
                            'All' && (
                            <Text
                              style={[
                                styles.filterCount,
                                active &&
                                  styles.filterCountActive,
                              ]}
                            >
                              {status === 'PENDING'
                                ? stats.pending
                                : status === 'UNDER_REVIEW'
                                  ? (backendSummary?.underReview ?? landlords.filter((item) => item.applicationStatus === 'UNDER_REVIEW').length)
                                  : status === 'ACTION_REQUIRED'
                                    ? landlords.filter((item) => item.applicationStatus === 'ACTION_REQUIRED').length
                                    : status === 'APPROVED'
                                      ? stats.active
                                      : stats.suspended}
                            </Text>
                          )}
                        </Pressable>
                      );
                    },
                  )}
                </ScrollView>
              </View>
            </View>

            <View style={styles.table}>
              {isDesktop && (
                <View
                  style={styles.tableHeader}
                >
                  <Text
                    style={[
                      styles.tableHeaderText,
                      styles.landlordHeader,
                    ]}
                  >
                    LANDLORD
                  </Text>

                  <Text
                    style={[
                      styles.tableHeaderText,
                      styles.contactHeader,
                    ]}
                  >
                    CONTACT
                  </Text>

                  <Text
                    style={[
                      styles.tableHeaderText,
                      styles.propertiesHeader,
                    ]}
                  >
                    PROPERTIES
                  </Text>

                  <Text
                    style={[
                      styles.tableHeaderText,
                      styles.sourceHeader,
                    ]}
                  >
                    SOURCE
                  </Text>

                  <View
                    style={styles.headerSpacer}
                  />
                </View>
              )}

              {landlordsLoading ? (
                <View style={styles.emptyState}>
                  <ActivityIndicator color={COLORS.lime} size="large" />
                  <Text style={styles.emptyTitle}>Loading registered landlords…</Text>
                </View>
              ) : landlordsError ? (
                <View style={styles.emptyState}>
                  <Text style={styles.emptyTitle}>Unable to load landlords</Text>
                  <Text style={styles.emptyText}>{landlordsError}</Text>
                  <Pressable
                    style={styles.secondaryButton}
                    onPress={() => router.replace('/admin/landlords')}
                  >
                    <Text style={styles.secondaryButtonText}>Reload page</Text>
                  </Pressable>
                </View>
              ) : filteredLandlords.length > 0 ? (
                filteredLandlords.map(
                  renderLandlordCard,
                )
              ) : (
                <View
                  style={styles.emptyState}
                >
                  <View
                    style={styles.emptyIcon}
                  >
                    <Users
                      size={28}
                      color={
                        COLORS.mutedDark
                      }
                    />
                  </View>

                  <Text
                    style={styles.emptyTitle}
                  >
                    No landlords found
                  </Text>

                  <Text
                    style={styles.emptyText}
                  >
                    No registered landlord applications match this search or status filter.
                  </Text>
                </View>
              )}
            </View>

            <View
              style={styles.workflowNotice}
            >
              <View
                style={styles.workflowIcon}
              >
                <ShieldCheck
                  size={18}
                  color={COLORS.lime}
                />
              </View>

              <View
                style={styles.workflowContent}
              >
                <Text
                  style={styles.workflowTitle}
                >
                  Landlord registration and review
                </Text>

                <Text
                  style={styles.workflowText}
                >
                  Registered landlord applications
                  appear here from the backend.
                  Administrators can review each
                  application and its ID verification
                  status. Property verification and
                  publishing follow the separate
                  property approval workflow.
                </Text>
              </View>
            </View>
          </ScrollView>
        </View>
      </View>

      {/* LANDLORD DETAILS */}
      <Modal
        visible={detailsVisible}
        transparent
        animationType="fade"
        onRequestClose={() =>
          setDetailsVisible(false)
        }
      >
        <View style={styles.modalOverlay}>
          <View
            style={[
              styles.detailsModal,
              width < 650 &&
                styles.detailsModalMobile,
            ]}
          >
            {selectedLandlord && (
              <>
                <View
                  style={styles.modalHeader}
                >
                  <View>
                    <Text
                      style={styles.modalEyebrow}
                    >
                      LANDLORD PROFILE
                    </Text>

                    <Text
                      style={styles.modalTitle}
                    >
                      {selectedLandlord.id}
                    </Text>
                  </View>

                  <Pressable
                    style={styles.modalClose}
                    onPress={() =>
                      setDetailsVisible(false)
                    }
                  >
                    <X
                      size={20}
                      color={COLORS.muted}
                    />
                  </Pressable>
                </View>

                <ScrollView
                  showsVerticalScrollIndicator={
                    false
                  }
                  contentContainerStyle={
                    styles.modalScroll
                  }
                >
                  <View
                    style={styles.profileHero}
                  >
                    <View
                      style={
                        styles.profileAvatar
                      }
                    >
                      <Text
                        style={
                          styles.profileAvatarText
                        }
                      >
                        {selectedLandlord.name
                          .charAt(0)
                          .toUpperCase()}
                      </Text>
                    </View>

                    <View
                      style={
                        styles.profileHeroInfo
                      }
                    >
                      <Text
                        style={
                          styles.profileName
                        }
                      >
                        {selectedLandlord.name}
                      </Text>

                      <View
                        style={
                          styles.locationRow
                        }
                      >
                        <MapPin
                          size={14}
                          color={
                            COLORS.muted
                          }
                        />

                        <Text
                          style={
                            styles.profileLocation
                          }
                        >
                          {selectedLandlord.location}
                        </Text>
                      </View>
                    </View>

                    {renderStatusPill(selectedLandlord.status)}
                  </View>

                  <View
                    style={styles.detailGrid}
                  >
                    <View
                      style={styles.detailItem}
                    >
                      <Text
                        style={
                          styles.detailLabel
                        }
                      >
                        PHONE
                      </Text>

                      <Text
                        style={
                          styles.detailValue
                        }
                      >
                        {selectedLandlord.phone}
                      </Text>
                    </View>

                    <View
                      style={styles.detailItem}
                    >
                      <Text
                        style={
                          styles.detailLabel
                        }
                      >
                        EMAIL
                      </Text>

                      <Text
                        style={
                          styles.detailValue
                        }
                        numberOfLines={1}
                      >
                        {selectedLandlord.email ||
                          'Not provided'}
                      </Text>
                    </View>

                    <View
                      style={styles.detailItem}
                    >
                      <Text
                        style={
                          styles.detailLabel
                        }
                      >
                        PROPERTIES
                      </Text>

                      <Text
                        style={
                          styles.detailValue
                        }
                      >
                        {
                          selectedLandlord.properties
                        }{' '}
                        total
                      </Text>
                    </View>

                    <View
                      style={styles.detailItem}
                    >
                      <Text
                        style={
                          styles.detailLabel
                        }
                      >
                        ID VERIFICATION
                      </Text>

                      <Text
                        style={
                          styles.detailValue
                        }
                      >
                        {selectedLandlord.idVerificationStatus.replace(/_/g, ' ')}
                      </Text>
                    </View>
                    <View
                      style={styles.detailItem}
                    >
                      <Text
                        style={
                          styles.detailLabel
                        }
                      >
                        APPLICATION STATUS
                      </Text>

                      <Text
                        style={
                          styles.detailValue
                        }
                      >
                        {selectedLandlord.applicationStatus.replace(/_/g, ' ')}
                      </Text>
                    </View>
                  </View>

                  <View
                    style={styles.modalSection}
                  >
                    <Text
                      style={
                        styles.modalSectionTitle
                      }
                    >
                      ONBOARDING
                    </Text>

                    <View
                      style={
                        styles.onboardingCard
                      }
                    >
                      <View
                        style={
                          styles.onboardingRow
                        }
                      >
                        <View
                          style={
                            styles.onboardingIcon
                          }
                        >
                          <UserPlus
                            size={16}
                            color={
                              COLORS.lime
                            }
                          />
                        </View>

                        <View
                          style={
                            styles.onboardingInfo
                          }
                        >
                          <Text
                            style={
                              styles.onboardingLabel
                            }
                          >
                            Added to Makazii
                          </Text>

                          <Text
                            style={
                              styles.onboardingValue
                            }
                          >
                            {
                              selectedLandlord.joined
                            }
                          </Text>
                        </View>
                      </View>

                      <View
                        style={
                          styles.onboardingDivider
                        }
                      />

                      <View
                        style={
                          styles.onboardingRow
                        }
                      >
                        <View
                          style={
                            styles.onboardingIcon
                          }
                        >
                          <Building2
                            size={16}
                            color={
                              COLORS.lime
                            }
                          />
                        </View>

                        <View
                          style={
                            styles.onboardingInfo
                          }
                        >
                          <Text
                            style={
                              styles.onboardingLabel
                            }
                          >
                            Registration source
                          </Text>

                          <Text
                            style={
                              styles.onboardingValue
                            }
                          >
                            {
                              selectedLandlord.source
                            }
                          </Text>
                        </View>
                      </View>
                    </View>
                  </View>

                  <View style={styles.modalSection}>
                    <Text style={styles.modalSectionTitle}>
                      LANDLORD QUESTIONNAIRE
                    </Text>

                    {questionnaireLoading ? (
                      <View style={styles.notesBox}>
                        <ActivityIndicator color={COLORS.lime} />
                        <Text style={[styles.notesText, { marginTop: 10 }]}>
                          Loading submitted answers...
                        </Text>
                      </View>
                    ) : questionnaireError ? (
                      <View style={styles.notesBox}>
                        <Text style={styles.notesText}>
                          {questionnaireError}
                        </Text>
                        <Pressable
                          onPress={() => {
                            setQuestionnaireError('');
                            setQuestionnaireLoading(true);
                            setPerformanceReloadKey((current) => current + 1);
                          }}
                          style={{ marginTop: 10 }}
                        >
                          <Text style={{ color: COLORS.lime, fontWeight: '800' }}>
                            Close and reopen this profile to retry
                          </Text>
                        </Pressable>
                      </View>
                    ) : landlordQuestionnaire &&
                      Object.keys(landlordQuestionnaire).length > 0 ? (
                      <View style={styles.notesBox}>
                        {Object.entries(landlordQuestionnaire).map(
                          ([key, value], index, entries) => {
                            const label = key
                              .replace(/([A-Z])/g, ' $1')
                              .replace(/_/g, ' ')
                              .trim()
                              .replace(/^./, (character) => character.toUpperCase());

                            let displayValue: string;

                            if (value === null || value === undefined || value === '') {
                              displayValue = 'Not provided';
                            } else if (
                              key === 'listingPackageBudgetKsh' &&
                              String(value).trim() !== ''
                            ) {
                              displayValue = `KSh ${String(value)}`;
                            } else if (Array.isArray(value)) {
                              displayValue = value.map(String).join(', ');
                            } else if (typeof value === 'object') {
                              displayValue = JSON.stringify(value);
                            } else {
                              displayValue = String(value);
                            }

                            return (
                              <View
                                key={key}
                                style={{
                                  marginBottom: index < entries.length - 1 ? 16 : 0,
                                }}
                              >
                                <Text style={styles.detailLabel}>
                                  {label.toUpperCase()}
                                </Text>
                                <Text style={[styles.detailValue, { marginTop: 5 }]}>
                                  {displayValue}
                                </Text>
                              </View>
                            );
                          },
                        )}
                        <Text style={[styles.notesText, { marginTop: 18 }]}>
                          These are the landlord's stated preferences, not
                          agreed fees or payment commitments.
                        </Text>
                      </View>
                    ) : (
                      <View style={styles.notesBox}>
                        <Text style={styles.notesText}>
                          No questionnaire answers were found for this application.
                        </Text>
                      </View>
                    )}
                  </View>

                  <View
                    style={styles.modalSection}
                  >
                    <Text
                      style={
                        styles.modalSectionTitle
                      }
                    >
                      INTERNAL NOTES
                    </Text>

                    <View
                      style={styles.notesBox}
                    >
                      <Text
                        style={styles.notesText}
                      >
                        {selectedLandlord.notes ||
                          'No internal notes.'}
                      </Text>
                    </View>
                  </View>

                  <View
                    style={styles.modalSection}
                  >
                    <Text
                      style={
                        styles.modalSectionTitle
                      }
                    >
                      PROPERTY SUMMARY
                    </Text>

                    <View
                      style={
                        styles.propertySummaryCard
                      }
                    >
                      <View
                        style={
                          styles.propertySummaryIcon
                        }
                      >
                        <Home
                          size={19}
                          color={
                            COLORS.lime
                          }
                        />
                      </View>

                      <View
                        style={
                          styles.propertySummaryInfo
                        }
                      >
                        <Text
                          style={
                            styles.propertySummaryTitle
                          }
                        >
                          {
                            selectedLandlord.properties
                          }{' '}
                          listed properties
                        </Text>

                        <Text
                          style={
                            styles.propertySummaryText
                          }
                        >
                          Property verification totals are not included in this response.
                        </Text>
                      </View>

                      <ChevronDown
                        size={18}
                        color={
                          COLORS.mutedDark
                        }
                      />
                    </View>
                  </View>

                  <View style={styles.modalSection}>
                    <Text style={styles.modalSectionTitle}>
                      LANDLORD PERFORMANCE
                    </Text>

                    {performanceLoading && (
                      <View style={styles.performanceMessage}>
                        <ActivityIndicator color={COLORS.lime} />
                        <Text style={styles.performanceMessageText}>
                          Loading live performance data...
                        </Text>
                      </View>
                    )}

                    {!performanceLoading && !!performanceError && (
                      <View style={styles.performanceMessage}>
                        <Text style={styles.performanceErrorText}>
                          {performanceError}
                        </Text>
                        <Pressable
                          style={styles.performanceRetryButton}
                          onPress={() => setPerformanceReloadKey((value) => value + 1)}
                        >
                          <Text style={styles.performanceRetryText}>Try again</Text>
                        </Pressable>
                      </View>
                    )}

                    {!performanceLoading && !performanceError && performance && (
                      <>
                        <View style={styles.performanceGrid}>
                          <View style={styles.performanceMetric}>
                            <Text style={styles.performanceMetricLabel}>PROPERTIES</Text>
                            <Text style={styles.performanceMetricValue}>
                              {formatNumber(Number(performance.properties.total || 0))}
                            </Text>
                            <Text style={styles.performanceMetricCaption}>
                              Total properties recorded
                            </Text>
                          </View>

                          <View style={styles.performanceMetric}>
                            <Text style={styles.performanceMetricLabel}>VIEWINGS</Text>
                            <Text style={styles.performanceMetricValue}>
                              {formatNumber(Number(performance.viewings.total || 0))}
                            </Text>
                            <Text style={styles.performanceMetricCaption}>
                              {performance.viewings.completed || 0} completed · {performance.viewings.cancelled || 0} cancelled
                            </Text>
                          </View>

                          <View style={styles.performanceMetric}>
                            <Text style={styles.performanceMetricLabel}>INSPECTIONS</Text>
                            <Text style={styles.performanceMetricValue}>
                              {formatNumber(Number(performance.inspections.total || 0))}
                            </Text>
                            <Text style={styles.performanceMetricCaption}>
                              {performance.inspections.completed || 0} completed · {performance.inspections.cancelled || 0} cancelled
                            </Text>
                          </View>

                          <View style={styles.performanceMetric}>
                            <Text style={styles.performanceMetricLabel}>BOOKINGS</Text>
                            <Text style={styles.performanceMetricValue}>
                              {formatNumber(Number(performance.bookings.total || 0))}
                            </Text>
                            <Text style={styles.performanceMetricCaption}>
                              {performance.bookings.completed || 0} completed · {performance.bookings.cancelled || 0} cancelled
                            </Text>
                          </View>
                        </View>

                        <View style={styles.performancePanel}>
                          <Text style={styles.performancePanelTitle}>
                            PROPERTY STATUS BREAKDOWN
                          </Text>
                          {performance.properties.byStatus.length === 0 ? (
                            <Text style={styles.performanceEmpty}>
                              No property status records available.
                            </Text>
                          ) : (
                            performance.properties.byStatus.map((item, index) => (
                              <View
                                key={`${item.status}-${index}`}
                                style={styles.performanceRow}
                              >
                                <Text style={styles.performanceRowLabel}>
                                  {String(item.status || 'UNKNOWN').replace(/_/g, ' ')}
                                </Text>
                                <Text style={styles.performanceRowValue}>
                                  {formatNumber(Number(item.count || 0))}
                                </Text>
                              </View>
                            ))
                          )}
                        </View>

                        <View style={styles.performancePanel}>
                          <Text style={styles.performancePanelTitle}>
                            RECENT PROPERTIES
                          </Text>
                          {performance.properties.recent.length === 0 ? (
                            <Text style={styles.performanceEmpty}>
                              No properties have been recorded for this landlord.
                            </Text>
                          ) : (
                            performance.properties.recent.map((item) => (
                              <View key={item.id} style={styles.performanceListing}>
                                <Text style={styles.performanceListingTitle}>
                                  {item.title || 'Untitled property'}
                                </Text>
                                <Text style={styles.performanceListingMeta}>
                                  {[
                                    item.status?.replace(/_/g, ' ') || 'Status unavailable',
                                    item.purpose?.replace(/_/g, ' ') || '',
                                    [item.town, item.county].filter(Boolean).join(', '),
                                    item.createdAt
                                      ? new Date(item.createdAt).toLocaleDateString('en-KE')
                                      : '',
                                  ].filter(Boolean).join(' · ')}
                                </Text>
                              </View>
                            ))
                          )}
                        </View>

                        <View style={styles.performancePanel}>
                          <Text style={styles.performancePanelTitle}>
                            RECORDED CUSTOMER PAYMENTS
                          </Text>
                          {performance.payments.length === 0 ? (
                            <Text style={styles.performanceEmpty}>
                              No recorded payments are linked to this landlord's properties.
                            </Text>
                          ) : (
                            performance.payments.map((payment, index) => (
                              <View
                                key={`${payment.status}-${payment.currency}-${index}`}
                                style={styles.performanceRow}
                              >
                                <View style={styles.performancePaymentInfo}>
                                  <Text style={styles.performanceRowLabel}>
                                    {String(payment.status || 'UNKNOWN').replace(/_/g, ' ')}
                                  </Text>
                                  <Text style={styles.performanceListingMeta}>
                                    {formatNumber(Number(payment.count || 0))} payment(s) · {payment.currency || 'Currency unavailable'}
                                  </Text>
                                </View>
                                <Text style={styles.performanceRowValue}>
                                  {Number(payment.amount || 0).toLocaleString('en-KE', {
                                    maximumFractionDigits: 2,
                                  })}
                                </Text>
                              </View>
                            ))
                          )}
                          <Text style={styles.performanceDisclaimer}>
                            {performance.note ||
                              'These totals represent recorded customer payments linked to this landlord’s properties. They are not necessarily landlord earnings or payouts.'}
                          </Text>
                        </View>
                      </>
                    )}
                  </View>
                </ScrollView>

                <View style={styles.modalActions}>
                  <Pressable
                    style={styles.secondaryButton}
                    onPress={() => setDetailsVisible(false)}
                  >
                    <X size={16} color={COLORS.white} />
                    <Text style={styles.secondaryButtonText}>Close</Text>
                  </Pressable>
                </View>
              </>
            )}
          </View>
        </View>
      </Modal>

    </SafeAreaView>
  );
}

type Styles = {
  safeArea: ViewStyle;
  app: ViewStyle;
  sidebar: ViewStyle;
  mobileSidebar: ViewStyle;
  sidebarHeader: ViewStyle;
  logoMark: ViewStyle;
  logoMarkText: TextStyle;
  brandName: TextStyle;
  brandSubtitle: TextStyle;
  platformStatus: ViewStyle;
  onlineDot: ViewStyle;
  platformText: TextStyle;
  sidebarScroll: ViewStyle;
  menuLabel: TextStyle;
  navItem: ViewStyle;
  navItemActive: ViewStyle;
  navText: TextStyle;
  navTextActive: TextStyle;
  navBadge: ViewStyle;
  navBadgeActive: ViewStyle;
  navBadgeText: TextStyle;
  navBadgeTextActive: TextStyle;
  sidebarDivider: ViewStyle;
  adminCard: ViewStyle;
  adminAvatar: ViewStyle;
  adminAvatarText: TextStyle;
  adminInfo: ViewStyle;
  adminName: TextStyle;
  adminRole: TextStyle;
  signOutButton: ViewStyle;
  signOutText: TextStyle;
  overlay: ViewStyle;
  content: ViewStyle;
  contentDesktop: ViewStyle;
  topBar: ViewStyle;
  topLeft: ViewStyle;
  menuButton: ViewStyle;
  breadcrumb: TextStyle;
  topTitle: TextStyle;
  topActions: ViewStyle;
  topSearch: ViewStyle;
  topSearchInput: TextStyle;
  iconButton: ViewStyle;
  notificationDot: ViewStyle;
  topAvatar: ViewStyle;
  topAvatarText: TextStyle;
  pageContent: ViewStyle;
  pageContentTablet: ViewStyle;
  pageHeader: ViewStyle;
  pageHeaderText: ViewStyle;
  eyebrow: TextStyle;
  pageTitle: TextStyle;
  pageDescription: TextStyle;
  primaryButton: ViewStyle;
  primaryButtonText: TextStyle;
  statsGrid: ViewStyle;
  statsGridMobile: ViewStyle;
  statCard: ViewStyle;
  statTop: ViewStyle;
  statIcon: ViewStyle;
  statValue: TextStyle;
  statLabel: TextStyle;
  statSubtext: TextStyle;
  mobileSearch: ViewStyle;
  mobileSearchInput: TextStyle;
  sectionHeader: ViewStyle;
  sectionTitle: TextStyle;
  sectionSubtitle: TextStyle;
  filterArea: ViewStyle;
  filterScroll: ViewStyle;
  filterChip: ViewStyle;
  filterChipActive: ViewStyle;
  filterChipText: TextStyle;
  filterChipTextActive: TextStyle;
  filterCount: TextStyle;
  filterCountActive: TextStyle;
  table: ViewStyle;
  tableHeader: ViewStyle;
  tableHeaderText: TextStyle;
  landlordHeader: TextStyle;
  contactHeader: TextStyle;
  propertiesHeader: TextStyle;
  sourceHeader: TextStyle;
  headerSpacer: ViewStyle;
  landlordCard: ViewStyle;
  landlordMain: ViewStyle;
  landlordAvatar: ViewStyle;
  landlordAvatarText: TextStyle;
  landlordIdentity: ViewStyle;
  idRow: ViewStyle;
  landlordId: TextStyle;
  landlordName: TextStyle;
  locationRow: ViewStyle;
  locationText: TextStyle;
