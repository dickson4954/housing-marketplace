import React, {
  useCallback,
  useEffect,
  useMemo,
  useState,
} from 'react';
import {
  ActivityIndicator,
  Alert,
  Image,
  Pressable,
  ScrollView,
  StyleSheet,
  Text,
  TextInput,
  useWindowDimensions,
  View,
} from 'react-native';
import { router } from 'expo-router';
import {
  ArrowLeft,
  Check,
  ChevronRight,
  Clock3,
  Eye,
  FileText,
  MapPin,
  Menu,
  RefreshCw,
  Search,
  ShieldCheck,
  UserCheck,
  UserRound,
  UsersRound,
  X,
} from 'lucide-react-native';
import * as SecureStore from 'expo-secure-store';

import { API_BASE_URL } from '@/config/api';

const COLORS = {
  background: '#0B0F10',
  sidebar: '#0E1314',
  card: '#14191B',
  cardSoft: '#181E20',
  lime: '#D7FF5F',
  white: '#FFFFFF',
  text: '#E9EEEE',
  muted: '#9CA5A7',
  subtle: '#6F797B',
  sidebarText: '#7F898B',
  border: '#252C2E',
  success: '#7BE495',
  warning: '#FFC857',
  danger: '#FF6B6B',
};

type ApplicationStatus =
  | 'PENDING'
  | 'UNDER_REVIEW'
  | 'ACTION_REQUIRED'
  | 'APPROVED'
  | 'REJECTED';

type IdVerificationStatus =
  | 'PENDING'
  | 'VERIFIED'
  | 'REJECTED'
  | 'REVIEW';

type IdDocumentSide = 'front' | 'back';

type MarketerApplication = {
  id: string;

  firstName: string;
  lastName: string;
  phone: string;
  email: string;

  idType: string;
  idNumber: string;
  idFrontUrl?: string | null;
  idBackUrl?: string | null;

  idVerificationStatus: IdVerificationStatus;
  idVerificationDecision?: string | null;
  idVerificationMessage?: string | null;
  idVerifiedAt?: string | null;

  countyId: string;
  constituencyId: string;
  wardIds: string[];
  placeIds: string[];
  timeInSelectedAreas: string;

  hasRealEstateExperience: boolean;
  experienceAreas: string[];
  experienceDuration: string;
  experienceDescription: string;

  currentOccupation: string;
  workingWithAnotherAgency: boolean;
  currentAgencyName?: string | null;

  motivation: string;
  contribution: string;
  expectedPropertiesPerMonth: string;

  propertySources: string[];
  knowsLandlords: boolean;
  approximateLandlordCount?: number | null;

  comfortableCommunicating: boolean;
  communicationMethods: string[];
  timeAvailability: string;
  willingToFollowProcedures: boolean;

  referenceName: string;
  referencePhone: string;
  referenceRelationship: string;

  declarationAccepted: boolean;

  marketerId?: string | null;

  status: ApplicationStatus;
  adminNotes?: string | null;
  rejectionReason?: string | null;
  requestedChanges?: string | null;

  reviewedAt?: string | null;
  approvedAt?: string | null;
  rejectedAt?: string | null;

  createdAt: string;
  updatedAt: string;
};

type ListResponse = {
  success?: boolean;
  count?: number;
  data?: MarketerApplication[];
  message?: string;
};

type SingleResponse = {
  success?: boolean;
  data?: MarketerApplication;
  message?: string;
};

type VerificationResponse = {
  success?: boolean;
  application?: MarketerApplication;
  data?: MarketerApplication;
  message?: string;
};

const STATUS_FILTERS: Array<{
  key: 'ALL' | ApplicationStatus;
  label: string;
}> = [
  { key: 'ALL', label: 'All' },
  { key: 'PENDING', label: 'Pending' },
  { key: 'UNDER_REVIEW', label: 'Under review' },
  { key: 'ACTION_REQUIRED', label: 'Action required' },
  { key: 'APPROVED', label: 'Approved' },
  { key: 'REJECTED', label: 'Rejected' },
];

const NAV_ITEMS = [
  { label: 'Dashboard', route: '/admin/dashboard' },
  { label: 'Properties', route: '/admin/properties' },
  { label: 'Viewings', route: '/admin/viewings' },
  { label: 'Verification', route: '/admin/verification' },
  { label: 'Landlords', route: '/admin/landlords' },
  { label: 'Marketers', route: '/admin/marketers' },
  { label: 'Users', route: '/admin/users' },
  { label: 'Notifications', route: '/admin/notifications' },
  { label: 'Settings', route: '/admin/settings' },
];

function formatDate(value?: string | null) {
  if (!value) return '—';

  const date = new Date(value);

  if (Number.isNaN(date.getTime())) return value;

  return date.toLocaleDateString('en-KE', {
    day: '2-digit',
    month: 'short',
    year: 'numeric',
  });
}

function formatDateTime(value?: string | null) {
  if (!value) return '—';

  const date = new Date(value);

  if (Number.isNaN(date.getTime())) return value;

  return date.toLocaleString('en-KE', {
    day: '2-digit',
    month: 'short',
    year: 'numeric',
    hour: '2-digit',
    minute: '2-digit',
  });
}

function formatStatus(status: ApplicationStatus) {
  switch (status) {
    case 'UNDER_REVIEW':
      return 'Under review';

    case 'ACTION_REQUIRED':
      return 'Action required';

    default:
      return status.charAt(0) + status.slice(1).toLowerCase();
  }
}

function formatVerificationStatus(
  status: IdVerificationStatus,
) {
  switch (status) {
    case 'VERIFIED':
      return 'Verified';

    case 'REJECTED':
      return 'Rejected';

    case 'REVIEW':
      return 'Needs review';

    default:
      return 'Pending';
  }
}

function getStatusTone(status: ApplicationStatus) {
  switch (status) {
    case 'APPROVED':
      return {
        background: 'rgba(123,228,149,0.12)',
        border: 'rgba(123,228,149,0.24)',
        text: COLORS.success,
      };

    case 'REJECTED':
      return {
        background: 'rgba(255,107,107,0.10)',
        border: 'rgba(255,107,107,0.22)',
        text: COLORS.danger,
      };

    case 'ACTION_REQUIRED':
      return {
        background: 'rgba(255,200,87,0.10)',
        border: 'rgba(255,200,87,0.22)',
        text: COLORS.warning,
      };

    case 'UNDER_REVIEW':
      return {
        background: 'rgba(215,255,95,0.10)',
        border: 'rgba(215,255,95,0.20)',
        text: COLORS.lime,
      };

    default:
      return {
        background: 'rgba(156,165,167,0.10)',
        border: 'rgba(156,165,167,0.20)',
        text: COLORS.muted,
      };
  }
}

function getVerificationTone(status: IdVerificationStatus) {
  switch (status) {
    case 'VERIFIED':
      return COLORS.success;

    case 'REJECTED':
      return COLORS.danger;

    case 'REVIEW':
      return COLORS.warning;

    default:
      return COLORS.muted;
  }
}

function joinValues(values?: string[]) {
  if (!values?.length) return '—';

  return values.join(', ');
}

async function getAdminToken() {
  const token = await SecureStore.getItemAsync(
    'makazii_admin_token',
  );

  if (!token) {
    throw new Error(
      'Your administrator session has expired. Please sign in again.',
    );
  }

  return token;
}

async function adminFetch(
  path: string,
  options: RequestInit = {},
) {
  const token = await getAdminToken();

  const response = await fetch(
    `${API_BASE_URL}${path}`,
    {
      ...options,
      headers: {
        Accept: 'application/json',
        'Content-Type': 'application/json',
        ...(options.headers ?? {}),
        Authorization: `Bearer ${token}`,
      },
    },
  );

  let result: unknown = null;

  try {
    result = await response.json();
  } catch {
    result = null;
  }

  if (!response.ok) {
    const message =
      typeof result === 'object' &&
      result !== null &&
      'message' in result &&
      typeof result.message === 'string'
        ? result.message
        : `Request failed with status ${response.status}.`;

    throw new Error(message);
  }

  return result;
}

async function fetchPrivateDocument(
  side: IdDocumentSide,
) {
  const token = await getAdminToken();

  const response = await fetch(
    `${API_BASE_URL}/marketer-applications/admin/document-placeholder`,
  );

  void response;

  const documentUrl =
    `${API_BASE_URL}/marketer-applications/admin`;

  void documentUrl;

  const basePath =
    `${API_BASE_URL}/marketer-applications/admin`;

  void basePath;

  throw new Error(
    `Private ${side} document endpoint must be resolved using the application ID.`,
  );
}

function DetailRow({
  label,
  value,
}: {
  label: string;
  value?: string | null;
}) {
  return (
    <View style={styles.detailRow}>
      <Text style={styles.detailLabel}>
        {label}
      </Text>

      <Text style={styles.detailValue}>
        {value || '—'}
      </Text>
    </View>
  );
}

function SectionBox({
  title,
  icon: Icon,
  children,
}: {
  title: string;
  icon: React.ComponentType<any>;
  children: React.ReactNode;
}) {
  return (
    <View style={styles.detailSection}>
      <View style={styles.detailSectionHeader}>
        <View style={styles.detailSectionIcon}>
          <Icon
            size={16}
            color={COLORS.lime}
          />
        </View>

        <Text
          style={styles.detailSectionTitle}
        >
          {title}
        </Text>
      </View>

      {children}
    </View>
  );
}

function StatusBadge({
  status,
}: {
  status: ApplicationStatus;
}) {
  const tone = getStatusTone(status);

  return (
    <View
      style={[
        styles.statusBadge,
        {
          backgroundColor:
            tone.background,
          borderColor: tone.border,
        },
      ]}
    >
      <Text
        style={[
          styles.statusBadgeText,
          {
            color: tone.text,
          },
        ]}
      >
        {formatStatus(status)}
      </Text>
    </View>
  );
}

export default function AdminMarketerApplications() {
  const { width, height } =
    useWindowDimensions();

  const isDesktop = width >= 1000;

  const [sidebarOpen, setSidebarOpen] =
    useState(false);

  const [applications, setApplications] =
    useState<MarketerApplication[]>([]);

  const [
    selectedApplication,
    setSelectedApplication,
  ] = useState<MarketerApplication | null>(
    null,
  );

  const [statusFilter, setStatusFilter] =
    useState<
      'ALL' | ApplicationStatus
    >('ALL');

  const [searchQuery, setSearchQuery] =
    useState('');

  const [loading, setLoading] =
    useState(true);

  const [loadingDetail, setLoadingDetail] =
    useState(false);

  const [refreshing, setRefreshing] =
    useState(false);

  const [actionLoading, setActionLoading] =
    useState(false);

  const [
    verificationLoading,
    setVerificationLoading,
  ] = useState(false);

  const [error, setError] =
    useState<string | null>(null);

  const [
    actionModal,
    setActionModal,
  ] = useState<
    | 'requestChanges'
    | 'reject'
    | 'rejectId'
    | null
  >(null);

  const [actionReason, setActionReason] =
    useState('');

  const [
    documentViewer,
    setDocumentViewer,
  ] = useState<{
    side: IdDocumentSide;
    uri: string;
  } | null>(null);

  const [
    documentLoading,
    setDocumentLoading,
  ] = useState(false);

  const [
    documentError,
    setDocumentError,
  ] = useState<string | null>(null);

  const loadApplications =
    useCallback(
      async (showRefresh = false) => {
        try {
          if (showRefresh) {
            setRefreshing(true);
          } else {
            setLoading(true);
          }

          setError(null);

          const query =
            statusFilter === 'ALL'
              ? ''
              : `?status=${encodeURIComponent(
                  statusFilter,
                )}`;

          const result =
            (await adminFetch(
              `/marketer-applications/admin${query}`,
            )) as ListResponse;

          if (result.success === false) {
            throw new Error(
              result.message ||
                'Failed to load marketer applications.',
            );
          }

          setApplications(
            Array.isArray(result.data)
              ? result.data
              : [],
          );
        } catch (requestError) {
          const message =
            requestError instanceof Error
              ? requestError.message
              : 'Failed to load marketer applications.';

          setError(message);

          if (
            message
              .toLowerCase()
              .includes('session')
          ) {
            Alert.alert(
              'Admin session',
              message,
              [
                {
                  text: 'Sign in',
                  onPress: () =>
                    router.replace(
                      '/admin/login' as any,
                    ),
                },
              ],
            );
          }
        } finally {
          setLoading(false);
          setRefreshing(false);
        }
      },
      [statusFilter],
    );

  const loadApplicationDetail =
    useCallback(
      async (id: string) => {
        try {
          setLoadingDetail(true);

          const result =
            (await adminFetch(
              `/marketer-applications/admin/${id}`,
            )) as SingleResponse;

          if (result.success === false) {
            throw new Error(
              result.message ||
                'Failed to load application.',
            );
          }

          if (!result.data) {
            throw new Error(
              'The application was not returned by the backend.',
            );
          }

          setSelectedApplication(
            result.data,
          );
        } catch (requestError) {
          Alert.alert(
            'Unable to open application',
            requestError instanceof Error
              ? requestError.message
              : 'Please try again.',
          );
        } finally {
          setLoadingDetail(false);
        }
      },
      [],
    );

  useEffect(() => {
    void loadApplications();
  }, [loadApplications]);

  const filteredApplications =
    useMemo(() => {
      const normalized =
        searchQuery.trim().toLowerCase();

      if (!normalized) {
        return applications;
      }

      return applications.filter(
        (application) => {
          const haystack = [
            application.firstName,
            application.lastName,
            application.email,
            application.phone,
            application.idNumber,
            application.id,
          ]
            .join(' ')
            .toLowerCase();

          return haystack.includes(
            normalized,
          );
        },
      );
    }, [
      applications,
      searchQuery,
    ]);

  const counts = useMemo(() => {
    const result: Record<
      ApplicationStatus,
      number
    > = {
      PENDING: 0,
      UNDER_REVIEW: 0,
      ACTION_REQUIRED: 0,
      APPROVED: 0,
      REJECTED: 0,
    };

    for (const application of applications) {
      result[application.status] += 1;
    }

    return result;
  }, [applications]);

  const handleSelectApplication =
    async (
      application: MarketerApplication,
    ) => {
      setSelectedApplication(
        application,
      );

      await loadApplicationDetail(
        application.id,
      );
    };

  const refreshSelectedApplication =
    useCallback(
      async (id: string) => {
        try {
          const result =
            (await adminFetch(
              `/marketer-applications/admin/${id}`,
            )) as SingleResponse;

          if (
            result.success !== false &&
            result.data
          ) {
            setSelectedApplication(
              result.data,
            );
          }
        } catch {
          // The original action has already completed.
          // The next manual refresh will retry.
        }
      },
      [],
    );

  const performAction = async (
    action:
      | 'review'
      | 'requestChanges'
      | 'reject'
      | 'approve',
  ) => {
    if (!selectedApplication) {
      return;
    }

    let path = '';

    let body:
      | Record<string, string>
      | undefined;

    if (action === 'review') {
      path =
        `/marketer-applications/admin/${selectedApplication.id}/review`;
    }

    if (
      action === 'requestChanges'
    ) {
      const reason =
        actionReason.trim();

      if (!reason) {
        Alert.alert(
          'Changes required',
          'Please explain what the applicant needs to change.',
        );

        return;
      }

      path =
        `/marketer-applications/admin/${selectedApplication.id}/request-changes`;

      body = {
        requestedChanges: reason,
      };
    }

    if (action === 'reject') {
      const reason =
        actionReason.trim();

      if (!reason) {
        Alert.alert(
          'Rejection reason required',
          'Please provide a reason for rejecting this application.',
        );

        return;
      }

      path =
        `/marketer-applications/admin/${selectedApplication.id}/reject`;

      body = {
        rejectionReason: reason,
      };
    }

    if (action === 'approve') {
      if (
        selectedApplication.idVerificationStatus !==
        'VERIFIED'
      ) {
        Alert.alert(
          'ID verification required',
          'This application cannot be approved until the applicant identity documents have been verified.',
        );

        return;
      }

      path =
        `/marketer-applications/admin/${selectedApplication.id}/approve`;
    }

    try {
      setActionLoading(true);

      const result =
        (await adminFetch(path, {
          method: 'PATCH',
          body: body
            ? JSON.stringify(body)
            : undefined,
        })) as SingleResponse;

      if (result.success === false) {
        throw new Error(
          result.message ||
            'The action could not be completed.',
        );
      }

      setActionModal(null);
      setActionReason('');

      if (result.data) {
        setSelectedApplication(
          result.data,
        );
      } else {
        await refreshSelectedApplication(
          selectedApplication.id,
        );
      }

      await loadApplications(true);

      if (action === 'approve') {
        Alert.alert(
          'Application approved',
          'The marketer application was approved and the backend created the active marketer account.',
        );
      } else if (action === 'reject') {
        Alert.alert(
          'Application rejected',
          'The application has been rejected.',
        );
      } else if (
        action === 'requestChanges'
      ) {
        Alert.alert(
          'Changes requested',
          'The application has been marked as requiring changes.',
        );
      } else {
        Alert.alert(
          'Application under review',
          'The application is now marked as under review.',
        );
      }
    } catch (requestError) {
      Alert.alert(
        'Action failed',
        requestError instanceof Error
          ? requestError.message
          : 'Please try again.',
      );
    } finally {
      setActionLoading(false);
    }
  };

  const updateIdVerification =
    async (
      status:
        | 'VERIFIED'
        | 'REJECTED',
      message?: string,
    ) => {
      if (!selectedApplication) {
        return;
      }

      try {
        setVerificationLoading(true);

        const result =
          (await adminFetch(
            `/marketer-applications/admin/${selectedApplication.id}/id-verification`,
            {
              method: 'PATCH',
              body: JSON.stringify({
                status,
                decision:
                  status === 'VERIFIED'
                    ? 'ID documents verified by admin'
                    : 'ID documents rejected by admin',
                message:
                  message?.trim() ||
                  undefined,
              }),
            },
          )) as VerificationResponse;

        if (result.success === false) {
          throw new Error(
            result.message ||
              'Unable to update identity verification.',
          );
        }

        const updated =
          result.application ||
          result.data;

        if (updated) {
          setSelectedApplication(
            updated,
          );
        } else {
          await refreshSelectedApplication(
            selectedApplication.id,
          );
        }

        setActionModal(null);
        setActionReason('');

        await loadApplications(true);

        if (status === 'VERIFIED') {
          Alert.alert(
            'Identity verified',
            'The applicant identity documents have been verified. The application can now be approved if all other requirements are satisfactory.',
          );
        } else {
          Alert.alert(
            'Identity rejected',
            'The applicant identity documents have been rejected. This application cannot be approved until the identity issue is resolved.',
          );
        }
      } catch (requestError) {
        Alert.alert(
          'Verification failed',
          requestError instanceof Error
            ? requestError.message
            : 'Please try again.',
        );
      } finally {
        setVerificationLoading(false);
      }
    };

  const handleVerifyId = () => {
    if (!selectedApplication) {
      return;
    }

    Alert.alert(
      'Verify identity',
      `Confirm that the submitted ${selectedApplication.idType} documents belong to ${selectedApplication.firstName} ${selectedApplication.lastName} and are valid.`,
      [
        {
          text: 'Cancel',
          style: 'cancel',
        },
        {
          text: 'Verify ID',
          onPress: () =>
            void updateIdVerification(
              'VERIFIED',
            ),
        },
      ],
    );
  };

  const handleApprove = () => {
    if (!selectedApplication) {
      return;
    }

    if (
      selectedApplication.idVerificationStatus !==
      'VERIFIED'
    ) {
      Alert.alert(
        'ID verification required',
        'Verify the applicant identity documents before approving this application.',
      );

      return;
    }

    Alert.alert(
      'Approve marketer application',
      `Approve ${selectedApplication.firstName} ${selectedApplication.lastName}? This will create and activate the marketer account if all backend requirements pass.`,
      [
        {
          text: 'Cancel',
          style: 'cancel',
        },
        {
          text: 'Approve',
          onPress: () =>
            void performAction(
              'approve',
            ),
        },
      ],
    );
  };

  const handleMarkReview = () => {
    void performAction('review');
  };

  const openReasonModal = (
    type:
      | 'requestChanges'
      | 'reject'
      | 'rejectId',
  ) => {
    setActionReason('');
    setActionModal(type);
  };

  const navigate = (
    route: string,
  ) => {
    setSidebarOpen(false);
    router.push(route as any);
  };

  const openPrivateDocument =
    async (
      side: IdDocumentSide,
    ) => {
      if (!selectedApplication) {
        return;
      }

      const hasDocument =
        side === 'front'
          ? Boolean(
              selectedApplication.idFrontUrl,
            )
          : Boolean(
              selectedApplication.idBackUrl,
            );

      if (!hasDocument) {
        Alert.alert(
          'Document unavailable',
          `The ${side} identity document was not uploaded with this application.`,
        );

        return;
      }

      try {
        setDocumentLoading(true);
        setDocumentError(null);

        const token =
          await getAdminToken();

        const endpoint =
          `${API_BASE_URL}/marketer-applications/admin/${selectedApplication.id}/id/${side}`;

        const response =
          await fetch(endpoint, {
            method: 'GET',
            headers: {
              Accept: 'image/*',
              Authorization:
                `Bearer ${token}`,
            },
          });

        if (!response.ok) {
          let message =
            `Unable to load the ${side} identity document.`;

          try {
            const result =
              await response.json();

            if (
              result &&
              typeof result.message ===
                'string'
            ) {
              message =
                result.message;
            }
          } catch {
            // Keep default message.
          }

          throw new Error(
            message,
          );
        }

        const blob =
          await response.blob();

        if (
          typeof FileReader ===
          'undefined'
        ) {
          throw new Error(
            'This device cannot display the protected identity document.',
          );
        }

        const reader =
          new FileReader();

        const dataUri =
          await new Promise<string>(
            (
              resolve,
              reject,
            ) => {
              reader.onloadend =
                () => {
                  if (
                    typeof reader.result ===
                    'string'
                  ) {
                    resolve(
                      reader.result,
                    );
                  } else {
                    reject(
                      new Error(
                        'Unable to prepare identity document for viewing.',
                      ),
                    );
                  }
                };

              reader.onerror =
                () => {
                  reject(
                    new Error(
                      'Unable to read identity document.',
                    ),
                  );
                };

              reader.readAsDataURL(
                blob,
              );
            },
          );

        setDocumentViewer({
          side,
          uri: dataUri,
        });
      } catch (requestError) {
        const message =
          requestError instanceof Error
            ? requestError.message
            : `Unable to load the ${side} identity document.`;

        setDocumentError(message);

        Alert.alert(
          'Unable to view document',
          message,
        );
      } finally {
        setDocumentLoading(false);
      }
    };

  const renderSidebar = () => (
    <View
      style={[
        styles.sidebar,
        isDesktop
          ? styles.sidebarDesktop
          : styles.sidebarMobile,
      ]}
    >
      <View
        style={styles.sidebarBrand}
      >
        <View
          style={styles.brandMark}
        >
          <Text
            style={styles.brandMarkText}
          >
            M
          </Text>
        </View>

        <View>
          <Text
            style={styles.brandName}
          >
            MAKAZII
          </Text>

          <Text
            style={styles.brandTagline}
          >
            ADMIN PORTAL
          </Text>
        </View>

        {!isDesktop ? (
          <Pressable
            style={styles.sidebarClose}
            onPress={() =>
              setSidebarOpen(
                false,
              )
            }
          >
            <X
              size={20}
              color={COLORS.muted}
            />
          </Pressable>
        ) : null}
      </View>

      <ScrollView
        style={styles.sidebarScroll}
        contentContainerStyle={
          styles.sidebarContent
        }
        showsVerticalScrollIndicator={
          false
        }
      >
        <Text
          style={styles.sidebarLabel}
        >
          MANAGEMENT
        </Text>

        {NAV_ITEMS.map(
          (item) => {
            const active =
              item.route ===
              '/admin/marketer-applications';

            return (
              <Pressable
                key={item.route}
                style={[
                  styles.navItem,
                  active &&
                    styles.navItemActive,
                ]}
                onPress={() =>
                  navigate(
                    item.route,
                  )
                }
              >
                <Text
                  style={[
                    styles.navItemText,
                    active &&
                      styles.navItemTextActive,
                  ]}
                >
                  {item.label}
                </Text>
              </Pressable>
            );
          },
        )}

        <View
          style={
            styles.applicationNavBox
          }
        >
          <View
            style={
              styles.applicationNavIcon
            }
          >
            <FileText
              size={16}
              color={COLORS.lime}
            />
          </View>

          <View
            style={{ flex: 1 }}
          >
            <Text
              style={
                styles.applicationNavTitle
              }
            >
              Applications
            </Text>

            <Text
              style={
                styles.applicationNavText
              }
            >
              Marketer applications
            </Text>
          </View>
        </View>
      </ScrollView>
    </View>
  );

  const renderList = () => (
    <View
      style={[
        styles.listPanel,
        isDesktop &&
          styles.listPanelDesktop,
      ]}
    >
      <View
        style={styles.listHeader}
      >
        <View>
          <Text
            style={styles.panelTitle}
          >
            Applications
          </Text>

          <Text
            style={styles.panelSubtitle}
          >
            {filteredApplications.length}{' '}
            application
            {filteredApplications.length ===
            1
              ? ''
              : 's'}
          </Text>
        </View>

        <Pressable
          style={styles.iconButton}
          onPress={() =>
            void loadApplications(
              true,
            )
          }
          disabled={refreshing}
        >
          {refreshing ? (
            <ActivityIndicator
              size="small"
              color={COLORS.lime}
            />
          ) : (
            <RefreshCw
              size={17}
              color={COLORS.muted}
            />
          )}
        </Pressable>
      </View>

      <View
        style={styles.searchBox}
      >
        <Search
          size={17}
          color={COLORS.muted}
        />

        <TextInput
          value={searchQuery}
          onChangeText={
            setSearchQuery
          }
          placeholder="Search name, phone, email or ID..."
          placeholderTextColor={
            COLORS.subtle
          }
          style={
            styles.searchInput
          }
        />
      </View>

      <ScrollView
        horizontal
        showsHorizontalScrollIndicator={
          false
        }
        contentContainerStyle={
          styles.filterRow
        }
      >
        {STATUS_FILTERS.map(
          (filter) => {
            const count =
              filter.key ===
              'ALL'
                ? applications.length
                : counts[
                    filter.key
                  ];

            const active =
              statusFilter ===
              filter.key;

            return (
              <Pressable
                key={filter.key}
                style={[
                  styles.filterChip,
                  active &&
                    styles.filterChipActive,
                ]}
                onPress={() =>
                  setStatusFilter(
                    filter.key,
                  )
                }
              >
                <Text
                  style={[
                    styles.filterChipText,
                    active &&
                      styles.filterChipTextActive,
                  ]}
                >
                  {
                    filter.label
                  }
                </Text>

                <View
                  style={[
                    styles.filterCount,
                    active &&
                      styles.filterCountActive,
                  ]}
                >
                  <Text
                    style={[
                      styles.filterCountText,
                      active &&
                        styles.filterCountTextActive,
                    ]}
                  >
                    {count}
                  </Text>
                </View>
              </Pressable>
            );
          },
        )}
      </ScrollView>

      {loading ? (
        <View
          style={styles.centerState}
        >
          <ActivityIndicator
            size="large"
            color={COLORS.lime}
          />

          <Text
            style={styles.stateText}
          >
            Loading applications...
          </Text>
        </View>
      ) : error ? (
        <View
          style={styles.centerState}
        >
          <View
            style={styles.errorIcon}
          >
            <X
              size={22}
              color={COLORS.danger}
            />
          </View>

          <Text
            style={styles.stateTitle}
          >
            Unable to load applications
          </Text>

          <Text
            style={styles.stateText}
          >
            {error}
          </Text>

          <Pressable
            style={
              styles.primaryButton
            }
            onPress={() =>
              void loadApplications()
            }
          >
            <RefreshCw
              size={16}
              color={
                COLORS.background
              }
            />

            <Text
              style={
                styles.primaryButtonText
              }
            >
              Try again
            </Text>
          </Pressable>
        </View>
      ) : filteredApplications.length ===
        0 ? (
        <View
          style={styles.centerState}
        >
          <View
            style={styles.emptyIcon}
          >
            <UsersRound
              size={24}
              color={COLORS.muted}
            />
          </View>

          <Text
            style={styles.stateTitle}
          >
            No applications found
          </Text>

          <Text
            style={styles.stateText}
          >
            {searchQuery.trim()
              ? 'Try another search.'
              : 'There are no applications in this filter yet.'}
          </Text>
        </View>
      ) : (
        <ScrollView
          style={
            styles.applicationList
          }
          contentContainerStyle={
            styles.applicationListContent
          }
          showsVerticalScrollIndicator={
            false
          }
        >
          {filteredApplications.map(
            (application) => {
              const selected =
                selectedApplication?.id ===
                application.id;

              const verificationColor =
                getVerificationTone(
                  application.idVerificationStatus,
                );

              return (
                <Pressable
                  key={
                    application.id
                  }
                  style={[
                    styles.applicationCard,
                    selected &&
                      styles.applicationCardSelected,
                  ]}
                  onPress={() =>
                    void handleSelectApplication(
                      application,
                    )
                  }
                >
                  <View
                    style={
                      styles.applicationAvatar
                    }
                  >
                    <Text
                      style={
                        styles.applicationAvatarText
                      }
                    >
                      {application.firstName
                        .charAt(
                          0,
                        )
                        .toUpperCase()}
                      {application.lastName
                        .charAt(
                          0,
                        )
                        .toUpperCase()}
                    </Text>
                  </View>

                  <View
                    style={
                      styles.applicationMain
                    }
                  >
                    <View
                      style={
                        styles.applicationTitleRow
                      }
                    >
                      <Text
                        style={
                          styles.applicationName
                        }
                        numberOfLines={
                          1
                        }
                      >
                        {
                          application.firstName
                        }{' '}
                        {
                          application.lastName
                        }
                      </Text>

                      <StatusBadge
                        status={
                          application.status
                        }
                      />
                    </View>

                    <Text
                      style={
                        styles.applicationEmail
                      }
                      numberOfLines={
                        1
                      }
                    >
                      {
                        application.email
                      }
                    </Text>

                    <View
                      style={
                        styles.applicationMeta
                      }
                    >
                      <Text
                        style={
                          styles.applicationMetaText
                        }
                      >
                        {
                          application.phone
                        }
                      </Text>

                      <Text
                        style={
                          styles.applicationMetaDot
                        }
                      >
                        •
                      </Text>

                      <Text
                        style={
                          styles.applicationMetaText
                        }
                      >
                        {formatDate(
                          application.createdAt,
                        )}
                      </Text>

                      <Text
                        style={
                          styles.applicationMetaDot
                        }
                      >
                        •
                      </Text>

                      <Text
                        style={[
                          styles.applicationMetaText,
                          {
                            color:
                              verificationColor,
                          },
                        ]}
                      >
                        ID{' '}
                        {formatVerificationStatus(
                          application.idVerificationStatus,
                        )}
                      </Text>
                    </View>
                  </View>

                  <ChevronRight
                    size={18}
                    color={
                      selected
                        ? COLORS.lime
                        : COLORS.subtle
                    }
                  />
                </Pressable>
              );
            },
          )}
        </ScrollView>
      )}
    </View>
  );

  const renderIdentityDocuments =
    () => {
      if (!selectedApplication) {
        return null;
      }

      const application =
        selectedApplication;

      const frontAvailable =
        Boolean(
          application.idFrontUrl,
        );

      const backAvailable =
        Boolean(
          application.idBackUrl,
        );

      const verified =
        application.idVerificationStatus ===
        'VERIFIED';

      const rejected =
        application.idVerificationStatus ===
        'REJECTED';

      return (
        <View
          style={
            styles.identityDocumentArea
          }
        >
          <View
            style={
              styles.identityDocumentGrid
            }
          >
            <View
              style={
                styles.identityDocumentCard
              }
            >
              <View
                style={
                  styles.identityDocumentHeader
                }
              >
                <View
                  style={
                    styles.identityDocumentIcon
                  }
                >
                  <FileText
                    size={16}
                    color={
                      COLORS.lime
                    }
                  />
                </View>

                <View
                  style={{
                    flex: 1,
                  }}
                >
                  <Text
                    style={
                      styles.identityDocumentTitle
                    }
                  >
                    Front of ID
                  </Text>

                  <Text
                    style={
                      styles.identityDocumentSubtitle
                    }
                  >
                    Applicant's ID front
                  </Text>
                </View>
              </View>

              <Pressable
                style={[
                  styles.viewDocumentButton,
                  !frontAvailable &&
                    styles.disabledDocumentButton,
                ]}
                onPress={() =>
                  void openPrivateDocument(
                    'front',
                  )
                }
                disabled={
                  !frontAvailable ||
                  documentLoading
                }
              >
                {documentLoading ? (
                  <ActivityIndicator
                    size="small"
                    color={
                      COLORS.lime
                    }
                  />
                ) : (
                  <Eye
                    size={15}
                    color={
                      frontAvailable
                        ? COLORS.lime
                        : COLORS.subtle
                    }
                  />
                )}

                <Text
                  style={[
                    styles.viewDocumentButtonText,
                    !frontAvailable &&
                      styles.disabledDocumentButtonText,
                  ]}
                >
                  {frontAvailable
                    ? 'View front ID'
                    : 'Not uploaded'}
                </Text>
              </Pressable>
            </View>

            <View
              style={
                styles.identityDocumentCard
              }
            >
              <View
                style={
                  styles.identityDocumentHeader
                }
              >
                <View
                  style={
                    styles.identityDocumentIcon
                  }
                >
                  <FileText
                    size={16}
                    color={
                      COLORS.lime
                    }
                  />
                </View>

                <View
                  style={{
                    flex: 1,
                  }}
                >
                  <Text
                    style={
                      styles.identityDocumentTitle
                    }
                  >
                    Back of ID
                  </Text>

                  <Text
                    style={
                      styles.identityDocumentSubtitle
                    }
                  >
                    Applicant's ID back
                  </Text>
                </View>
              </View>

              <Pressable
                style={[
                  styles.viewDocumentButton,
                  !backAvailable &&
                    styles.disabledDocumentButton,
                ]}
                onPress={() =>
                  void openPrivateDocument(
                    'back',
                  )
                }
                disabled={
                  !backAvailable ||
                  documentLoading
                }
              >
                {documentLoading ? (
                  <ActivityIndicator
                    size="small"
                    color={
                      COLORS.lime
                    }
                  />
                ) : (
                  <Eye
                    size={15}
                    color={
                      backAvailable
                        ? COLORS.lime
                        : COLORS.subtle
                    }
                  />
                )}

                <Text
                  style={[
                    styles.viewDocumentButtonText,
                    !backAvailable &&
                      styles.disabledDocumentButtonText,
                  ]}
                >
                  {backAvailable
                    ? 'View back ID'
                    : 'Not uploaded'}
                </Text>
              </Pressable>
            </View>
          </View>

          {!verified ? (
            <View
              style={
                styles.verificationDecisionBox
              }
            >
              <View
                style={
                  styles.verificationDecisionHeader
                }
              >
                <ShieldCheck
                  size={17}
                  color={
                    rejected
                      ? COLORS.danger
                      : COLORS.warning
                  }
                />

                <View
                  style={{
                    flex: 1,
                  }}
                >
                  <Text
                    style={
                      styles.verificationDecisionTitle
                    }
                  >
                    {rejected
                      ? 'Identity verification rejected'
                      : 'Identity verification required'}
                  </Text>

                  <Text
                    style={
                      styles.verificationDecisionText
                    }
                  >
                    {rejected
                      ? 'The ID documents are currently rejected. Review the documents again if the applicant resubmits them.'
                      : 'Review both sides of the submitted ID before making a verification decision.'}
                  </Text>
                </View>
              </View>

              <View
                style={
                  styles.verificationDecisionActions
                }
              >
                <Pressable
                  style={
                    styles.verifyIdButton
                  }
                  onPress={
                    handleVerifyId
                  }
                  disabled={
                    verificationLoading ||
                    !frontAvailable ||
                    !backAvailable
                  }
                >
                  {verificationLoading ? (
                    <ActivityIndicator
                      size="small"
                      color={
                        COLORS.background
                      }
                    />
                  ) : (
                    <ShieldCheck
                      size={16}
                      color={
                        COLORS.background
                      }
                    />
                  )}

                  <Text
                    style={
                      styles.verifyIdButtonText
                    }
                  >
                    Verify ID
                  </Text>
                </Pressable>

                <Pressable
                  style={
                    styles.rejectIdButton
                  }
                  onPress={() =>
                    openReasonModal(
                      'rejectId',
                    )
                  }
                  disabled={
                    verificationLoading
                  }
                >
                  <X
                    size={16}
                    color={
                      COLORS.danger
                    }
                  />

                  <Text
                    style={
                      styles.rejectIdButtonText
                    }
                  >
                    Reject ID
                  </Text>
                </Pressable>
              </View>

              {!frontAvailable ||
              !backAvailable ? (
                <Text
                  style={
                    styles.verificationRequirement
                  }
                >
                  Both front and back identity documents
                  must be available before the ID can
                  be verified.
                </Text>
              ) : null}
            </View>
          ) : (
            <View
              style={
                styles.verifiedBox
              }
            >
              <View
                style={
                  styles.verifiedIcon
                }
              >
                <Check
                  size={18}
                  color={
                    COLORS.success
                  }
                />
              </View>

              <View
                style={{
                  flex: 1,
                }}
              >
                <Text
                  style={
                    styles.verifiedTitle
                  }
                >
                  Identity verified
                </Text>

                <Text
                  style={
                    styles.verifiedText
                  }
                >
                  The applicant's identity documents have
                  been verified. The application may now
                  proceed to approval if all other
                  requirements are satisfactory.
                </Text>
              </View>
            </View>
          )}
        </View>
      );
    };

  const renderDetail = () => {
    if (!selectedApplication) {
      return (
        <View
          style={styles.noSelection}
        >
          <View
            style={
              styles.noSelectionIcon
            }
          >
            <FileText
              size={30}
              color={COLORS.muted}
            />
          </View>

          <Text
            style={
              styles.noSelectionTitle
            }
          >
            Select an application
          </Text>

          <Text
            style={
              styles.noSelectionText
            }
          >
            Choose a marketer application from
            the list to review the complete
            submission.
          </Text>
        </View>
      );
    }

    const application =
      selectedApplication;

    const terminal =
      application.status ===
        'APPROVED' ||
      application.status ===
        'REJECTED';

    const canReview =
      !terminal &&
      application.status !==
        'UNDER_REVIEW';

    const idVerified =
      application.idVerificationStatus ===
      'VERIFIED';

    return (
      <ScrollView
        style={styles.detailPanel}
        contentContainerStyle={
          styles.detailContent
        }
        showsVerticalScrollIndicator={
          false
        }
      >
        <View
          style={styles.detailHeader}
        >
          <Pressable
            style={
              styles.mobileBackButton
            }
            onPress={() =>
              setSelectedApplication(
                null,
              )
            }
          >
            <ArrowLeft
              size={18}
              color={
                COLORS.muted
              }
            />
          </Pressable>

          <View
            style={
              styles.detailAvatar
            }
          >
            <Text
              style={
                styles.detailAvatarText
              }
            >
              {application.firstName
                .charAt(0)
                .toUpperCase()}
              {application.lastName
                .charAt(0)
                .toUpperCase()}
            </Text>
          </View>

          <View
            style={
              styles.detailHeaderMain
            }
          >
            <Text
              style={
                styles.detailName
              }
            >
              {application.firstName}{' '}
              {application.lastName}
            </Text>

            <Text
              style={
                styles.detailEmail
              }
            >
              {application.email}
            </Text>

            <View
              style={
                styles.detailBadges
              }
            >
              <StatusBadge
                status={
                  application.status
                }
              />

              <View
                style={[
                  styles.verificationBadge,
                  {
                    borderColor:
                      getVerificationTone(
                        application.idVerificationStatus,
                      ),
                  },
                ]}
              >
                <ShieldCheck
                  size={13}
                  color={getVerificationTone(
                    application.idVerificationStatus,
                  )}
                />

                <Text
                  style={[
                    styles.verificationBadgeText,
                    {
                      color:
                        getVerificationTone(
                          application.idVerificationStatus,
                        ),
                    },
                  ]}
                >
                  ID{' '}
                  {formatVerificationStatus(
                    application.idVerificationStatus,
                  )}
                </Text>
              </View>
            </View>
          </View>

          {loadingDetail ? (
            <ActivityIndicator
              size="small"
              color={
                COLORS.lime
              }
            />
          ) : null}
        </View>

        {!terminal ? (
          <View
            style={styles.actionBar}
          >
            {canReview ? (
              <Pressable
                style={
                  styles.secondaryAction
                }
                onPress={
                  handleMarkReview
                }
                disabled={
                  actionLoading
                }
              >
                <Clock3
                  size={16}
                  color={
                    COLORS.lime
                  }
                />

                <Text
                  style={
                    styles.secondaryActionText
                  }
                >
                  Mark under review
                </Text>
              </Pressable>
            ) : null}

            <Pressable
              style={
                styles.secondaryAction
              }
              onPress={() =>
                openReasonModal(
                  'requestChanges',
                )
              }
              disabled={
                actionLoading
              }
            >
              <FileText
                size={16}
                color={
                  COLORS.warning
                }
              />

              <Text
                style={
                  styles.secondaryActionText
                }
              >
                Request changes
              </Text>
            </Pressable>

            <Pressable
              style={
                styles.dangerAction
              }
              onPress={() =>
                openReasonModal(
                  'reject',
                )
              }
              disabled={
                actionLoading
              }
            >
              <X
                size={16}
                color={
                  COLORS.danger
                }
              />

              <Text
                style={
                  styles.dangerActionText
                }
              >
                Reject
              </Text>
            </Pressable>

            <Pressable
              style={[
                styles.approveAction,
                !idVerified &&
                  styles.approveActionDisabled,
                actionLoading &&
                  styles.buttonDisabled,
              ]}
              onPress={
                handleApprove
              }
              disabled={
                actionLoading ||
                !idVerified
              }
            >
              {actionLoading ? (
                <ActivityIndicator
                  size="small"
                  color={
                    idVerified
                      ? COLORS.background
                      : COLORS.subtle
                  }
                />
              ) : (
                <Check
                  size={16}
                  color={
                    idVerified
                      ? COLORS.background
                      : COLORS.subtle
                  }
                />
              )}

              <Text
                style={[
                  styles.approveActionText,
                  !idVerified &&
                    styles.approveActionTextDisabled,
                ]}
              >
                {idVerified
                  ? 'Approve'
                  : 'Approve — verify ID first'}
              </Text>
            </Pressable>
          </View>
        ) : (
          <View
            style={
              styles.terminalNotice
            }
          >
            <ShieldCheck
              size={17}
              color={
                application.status ===
                'APPROVED'
                  ? COLORS.success
                  : COLORS.danger
              }
            />

            <Text
              style={
                styles.terminalNoticeText
              }
            >
              This application is{' '}
              {formatStatus(
                application.status,
              ).toLowerCase()}
              . No further application
              workflow actions are available.
            </Text>
          </View>
        )}

        {!terminal &&
        !idVerified ? (
          <View
            style={
              styles.approvalWarning
            }
          >
            <ShieldCheck
              size={18}
              color={
                COLORS.warning
              }
            />

            <View
              style={{
                flex: 1,
              }}
            >
              <Text
                style={
                  styles.approvalWarningTitle
                }
              >
                Approval is locked
              </Text>

              <Text
                style={
                  styles.approvalWarningText
                }
              >
                Review the applicant's front and back
                identity documents and verify the ID
                before this application can be approved.
              </Text>
            </View>
          </View>
        ) : null}

        <SectionBox
          title="Application"
          icon={FileText}
        >
          <DetailRow
            label="Application ID"
            value={
              application.id
            }
          />

          <DetailRow
            label="Submitted"
            value={formatDateTime(
              application.createdAt,
            )}
          />

          <DetailRow
            label="Last updated"
            value={formatDateTime(
              application.updatedAt,
            )}
          />

          <DetailRow
            label="Reviewed"
            value={formatDateTime(
              application.reviewedAt,
            )}
          />

          {application.approvedAt ? (
            <DetailRow
              label="Approved"
              value={formatDateTime(
                application.approvedAt,
              )}
            />
          ) : null}

          {application.rejectedAt ? (
            <DetailRow
              label="Rejected"
              value={formatDateTime(
                application.rejectedAt,
              )}
            />
          ) : null}

          {application.marketerId ? (
            <DetailRow
              label="Created marketer ID"
              value={
                application.marketerId
              }
            />
          ) : null}
        </SectionBox>

        <SectionBox
          title="Personal information"
          icon={UserRound}
        >
          <DetailRow
            label="Full name"
            value={`${application.firstName} ${application.lastName}`}
          />

          <DetailRow
            label="Phone"
            value={
              application.phone
            }
          />

          <DetailRow
            label="Email"
            value={
              application.email
            }
          />
        </SectionBox>

        <SectionBox
          title="Identity verification"
          icon={ShieldCheck}
        >
          <DetailRow
            label="ID type"
            value={
              application.idType
            }
          />

          <DetailRow
            label="ID number"
            value={
              application.idNumber
            }
          />

          <DetailRow
            label="Verification status"
            value={formatVerificationStatus(
              application.idVerificationStatus,
            )}
          />

          <DetailRow
            label="Verified at"
            value={formatDateTime(
              application.idVerifiedAt,
            )}
          />

          <DetailRow
            label="Verification decision"
            value={
              application.idVerificationDecision
            }
          />

          <DetailRow
            label="Verification message"
            value={
              application.idVerificationMessage
            }
          />

          {renderIdentityDocuments()}
        </SectionBox>

        <SectionBox
          title="Geographic coverage"
          icon={MapPin}
        >
          <DetailRow
            label="County ID"
            value={
              application.countyId
            }
          />

          <DetailRow
            label="Constituency ID"
            value={
              application.constituencyId
            }
          />

          <DetailRow
            label="Ward IDs"
            value={joinValues(
              application.wardIds,
            )}
          />

          <DetailRow
            label="Place IDs"
            value={joinValues(
              application.placeIds,
            )}
          />

          <DetailRow
            label="Time in selected areas"
            value={
              application.timeInSelectedAreas
            }
          />
        </SectionBox>

        <SectionBox
          title="Real estate experience"
          icon={UserCheck}
        >
          <DetailRow
            label="Has experience"
            value={
              application.hasRealEstateExperience
                ? 'Yes'
                : 'No'
            }
          />

          <DetailRow
            label="Experience areas"
            value={joinValues(
              application.experienceAreas,
            )}
          />

          <DetailRow
            label="Experience duration"
            value={
              application.experienceDuration
            }
          />

          <DetailRow
            label="Description"
            value={
              application.experienceDescription
            }
          />
        </SectionBox>

        <SectionBox
          title="Current work"
          icon={UsersRound}
        >
          <DetailRow
            label="Occupation"
            value={
              application.currentOccupation
            }
          />

          <DetailRow
            label="Works with another agency"
            value={
              application.workingWithAnotherAgency
                ? 'Yes'
                : 'No'
            }
          />

          {application.currentAgencyName ? (
            <DetailRow
              label="Agency"
              value={
                application.currentAgencyName
              }
            />
          ) : null}
        </SectionBox>

        <SectionBox
          title="Motivation"
          icon={FileText}
        >
          <DetailRow
            label="Motivation"
            value={
              application.motivation
            }
          />

          <DetailRow
            label="Contribution"
            value={
              application.contribution
            }
          />

          <DetailRow
            label="Expected properties / month"
            value={
              application.expectedPropertiesPerMonth
            }
          />
        </SectionBox>

        <SectionBox
          title="Property sources"
          icon={MapPin}
        >
          <DetailRow
            label="Property sources"
            value={joinValues(
              application.propertySources,
            )}
          />

          <DetailRow
            label="Knows landlords"
            value={
              application.knowsLandlords
                ? 'Yes'
                : 'No'
            }
          />

          <DetailRow
            label="Approximate landlord count"
            value={
              application.approximateLandlordCount !==
                null &&
              application.approximateLandlordCount !==
                undefined
                ? String(
                    application.approximateLandlordCount,
                  )
                : '—'
            }
          />
        </SectionBox>

        <SectionBox
          title="Communication"
          icon={UsersRound}
        >
          <DetailRow
            label="Comfortable communicating"
            value={
              application.comfortableCommunicating
                ? 'Yes'
                : 'No'
            }
          />

          <DetailRow
            label="Communication methods"
            value={joinValues(
              application.communicationMethods,
            )}
          />

          <DetailRow
            label="Availability"
            value={
              application.timeAvailability
            }
          />

          <DetailRow
            label="Will follow procedures"
            value={
              application.willingToFollowProcedures
                ? 'Yes'
                : 'No'
            }
          />
        </SectionBox>

        <SectionBox
          title="Reference"
          icon={UserRound}
        >
          <DetailRow
            label="Name"
            value={
              application.referenceName
            }
          />

          <DetailRow
            label="Phone"
            value={
              application.referencePhone
            }
          />

          <DetailRow
            label="Relationship"
            value={
              application.referenceRelationship
            }
          />
        </SectionBox>

        <SectionBox
          title="Declaration and administration"
          icon={ShieldCheck}
        >
          <DetailRow
            label="Declaration accepted"
            value={
              application.declarationAccepted
                ? 'Yes'
                : 'No'
            }
          />

          <DetailRow
            label="Admin notes"
            value={
              application.adminNotes
            }
          />

          <DetailRow
            label="Requested changes"
            value={
              application.requestedChanges
            }
          />

          <DetailRow
            label="Rejection reason"
            value={
              application.rejectionReason
            }
          />
        </SectionBox>
      </ScrollView>
    );
  };

  return (
    <View style={styles.screen}>
      {!isDesktop &&
      sidebarOpen ? (
        <Pressable
          style={
            styles.sidebarOverlay
          }
          onPress={() =>
            setSidebarOpen(
              false,
            )
          }
        />
      ) : null}

      {isDesktop ||
      sidebarOpen
        ? renderSidebar()
        : null}

      <View
        style={styles.main}
      >
        <View
          style={styles.topbar}
        >
          <View
            style={styles.topbarLeft}
          >
            {!isDesktop ? (
              <Pressable
                style={
                  styles.menuButton
                }
                onPress={() =>
                  setSidebarOpen(
                    true,
                  )
                }
              >
                <Menu
                  size={21}
                  color={
                    COLORS.text
                  }
                />
              </Pressable>
            ) : null}

            <View>
              <Text
                style={
                  styles.topbarTitle
                }
              >
                Marketer applications
              </Text>

              <Text
                style={
                  styles.topbarSubtitle
                }
              >
                Review and approve field
                marketer applications
              </Text>
            </View>
          </View>

          <Pressable
            style={
              styles.backButton
            }
            onPress={() =>
              router.push(
                '/admin/marketers' as any,
              )
            }
          >
            <ArrowLeft
              size={16}
              color={
                COLORS.muted
              }
            />

            <Text
              style={
                styles.backButtonText
              }
            >
              Marketers
            </Text>
          </Pressable>
        </View>

        <View
          style={[
            styles.content,
            isDesktop &&
              styles.contentDesktop,
          ]}
        >
          <View
            style={styles.pageIntro}
          >
            <View>
              <Text
                style={
                  styles.pageTitle
                }
              >
                Marketer applications
              </Text>

              <Text
                style={
                  styles.pageDescription
                }
              >
                Review applicant information,
                identity verification and
                coverage before creating a
                marketer account.
              </Text>
            </View>

            <View
              style={
                styles.workflowBadge
              }
            >
              <ShieldCheck
                size={16}
                color={
                  COLORS.lime
                }
              />

              <Text
                style={
                  styles.workflowBadgeText
                }
              >
                Backend workflow
              </Text>
            </View>
          </View>

          <View
            style={styles.statsRow}
          >
            <View
              style={styles.statCard}
            >
              <Text
                style={
                  styles.statLabel
                }
              >
                Pending
              </Text>

              <Text
                style={
                  styles.statValue
                }
              >
                {counts.PENDING}
              </Text>
            </View>

            <View
              style={styles.statCard}
            >
              <Text
                style={
                  styles.statLabel
                }
              >
                Under review
              </Text>

              <Text
                style={
                  styles.statValue
                }
              >
                {
                  counts.UNDER_REVIEW
                }
              </Text>
            </View>

            <View
              style={styles.statCard}
            >
              <Text
                style={
                  styles.statLabel
                }
              >
                Action required
              </Text>

              <Text
                style={
                  styles.statValue
                }
              >
                {
                  counts.ACTION_REQUIRED
                }
              </Text>
            </View>

            <View
              style={styles.statCard}
            >
              <Text
                style={
                  styles.statLabel
                }
              >
                Approved
              </Text>

              <Text
                style={
                  styles.statValue
                }
              >
                {counts.APPROVED}
              </Text>
            </View>
          </View>

          <View
            style={[
              styles.workspace,
              isDesktop &&
                styles.workspaceDesktop,
            ]}
          >
            {renderList()}

            {isDesktop ? (
              renderDetail()
            ) : selectedApplication ? (
              <View
                style={
                  styles.mobileDetailWrap
                }
              >
                {renderDetail()}
              </View>
            ) : null}
          </View>
        </View>
      </View>

      {actionModal ? (
        <View
          style={styles.modalOverlay}
        >
          <Pressable
            style={
              StyleSheet.absoluteFill
            }
            onPress={() =>
              setActionModal(
                null,
              )
            }
          />

          <View
            style={styles.modalCard}
          >
            <View
              style={
                styles.modalHeader
              }
            >
              <View
                style={{
                  flex: 1,
                }}
              >
                <Text
                  style={
                    styles.modalTitle
                  }
                >
                  {actionModal ===
                  'reject'
                    ? 'Reject application'
                    : actionModal ===
                        'rejectId'
                      ? 'Reject identity documents'
                      : 'Request changes'}
                </Text>

                <Text
                  style={
                    styles.modalSubtitle
                  }
                >
                  {selectedApplication
                    ? `${selectedApplication.firstName} ${selectedApplication.lastName}`
                    : ''}
                </Text>
              </View>

              <Pressable
                style={
                  styles.iconButton
                }
                onPress={() =>
                  setActionModal(
                    null,
                  )
                }
              >
                <X
                  size={18}
                  color={
                    COLORS.muted
                  }
                />
              </Pressable>
            </View>

            <Text
              style={
                styles.modalLabel
              }
            >
              {actionModal ===
              'reject'
                ? 'Rejection reason'
                : actionModal ===
                    'rejectId'
                  ? 'ID rejection reason'
                  : 'Requested changes'}
            </Text>

            <TextInput
              value={
                actionReason
              }
              onChangeText={
                setActionReason
              }
              placeholder={
                actionModal ===
                'reject'
                  ? 'Explain why this application is being rejected...'
                  : actionModal ===
                      'rejectId'
                    ? 'Explain why the submitted identity documents are being rejected...'
                    : 'Explain what the applicant needs to correct or provide...'
              }
              placeholderTextColor={
                COLORS.subtle
              }
              multiline
              textAlignVertical="top"
              style={
                styles.modalInput
              }
            />

            <View
              style={
                styles.modalActions
              }
            >
              <Pressable
                style={
                  styles.cancelButton
                }
                onPress={() =>
                  setActionModal(
                    null,
                  )
                }
                disabled={
                  actionLoading ||
                  verificationLoading
                }
              >
                <Text
                  style={
                    styles.cancelButtonText
                  }
                >
                  Cancel
                </Text>
              </Pressable>

              <Pressable
                style={[
                  actionModal ===
                  'reject' ||
                  actionModal ===
                  'rejectId'
                    ? styles.rejectModalButton
                    : styles.requestModalButton,
                  (actionLoading ||
                    verificationLoading) &&
                    styles.buttonDisabled,
                ]}
                onPress={() => {
                  if (
                    actionModal ===
                    'rejectId'
                  ) {
                    const reason =
                      actionReason.trim();

                    if (!reason) {
                      Alert.alert(
                        'Reason required',
                        'Please provide a reason for rejecting the identity documents.',
                      );

                      return;
                    }

                    void updateIdVerification(
                      'REJECTED',
                      reason,
                    );

                    return;
                  }

                  void performAction(
                    actionModal,
                  );
                }}
                disabled={
                  actionLoading ||
                  verificationLoading
                }
              >
                {actionLoading ||
                verificationLoading ? (
                  <ActivityIndicator
                    size="small"
                    color={
                      actionModal ===
                        'reject' ||
                      actionModal ===
                        'rejectId'
                        ? COLORS.white
                        : COLORS.background
                    }
                  />
                ) : actionModal ===
                    'reject' ||
                  actionModal ===
                    'rejectId' ? (
                  <X
                    size={16}
                    color={
                      COLORS.white
                    }
                  />
                ) : (
                  <FileText
                    size={16}
                    color={
                      COLORS.background
                    }
                  />
                )}

                <Text
                  style={[
                    styles.modalActionText,
                    (actionModal ===
                      'reject' ||
                      actionModal ===
                        'rejectId') &&
                      styles.modalActionTextLight,
                  ]}
                >
                  {actionModal ===
                    'reject' ||
                  actionModal ===
                    'rejectId'
                    ? actionModal ===
                      'rejectId'
                      ? 'Reject ID'
                      : 'Reject application'
                    : 'Request changes'}
                </Text>
              </Pressable>
            </View>
          </View>
        </View>
      ) : null}

      {documentViewer ? (
        <View
          style={
            styles.documentViewerOverlay
          }
        >
          <View
            style={
              styles.documentViewerCard
            }
          >
            <View
              style={
                styles.documentViewerHeader
              }
            >
              <View
                style={{
                  flex: 1,
                }}
              >
                <Text
                  style={
                    styles.documentViewerTitle
                  }
                >
                  {documentViewer.side ===
                  'front'
                    ? 'Front of ID'
                    : 'Back of ID'}
                </Text>

                <Text
                  style={
                    styles.documentViewerSubtitle
                  }
                >
                  Private identity document
                </Text>
              </View>

              <Pressable
                style={
                  styles.documentViewerClose
                }
                onPress={() =>
                  setDocumentViewer(
                    null,
                  )
                }
              >
                <X
                  size={20}
                  color={
                    COLORS.muted
                  }
                />
              </Pressable>
            </View>

            <View
              style={[
                styles.documentImageContainer,
                {
                  height: Math.max(
                    260,
                    Math.min(
                      height - 180,
                      620,
                    ),
                  ),
                },
              ]}
            >
              <Image
                source={{
                  uri: documentViewer.uri,
                }}
                style={
                  styles.documentImage
                }
                resizeMode="contain"
              />
            </View>

            <View
              style={
                styles.documentViewerFooter
              }
            >
              <ShieldCheck
                size={15}
                color={
                  COLORS.success
                }
              />

              <Text
                style={
                  styles.documentViewerFooterText
                }
              >
                This document is loaded through
                an authenticated admin-only endpoint.
              </Text>
            </View>
          </View>
        </View>
      ) : null}

      {documentLoading &&
      !documentViewer ? (
        <View
          style={
            styles.documentLoadingOverlay
          }
        >
          <View
            style={
              styles.documentLoadingCard
            }
          >
            <ActivityIndicator
              size="large"
              color={
                COLORS.lime
              }
            />

            <Text
              style={
                styles.documentLoadingTitle
              }
            >
              Loading identity document
            </Text>

            <Text
              style={
                styles.documentLoadingText
              }
            >
              Securely retrieving the document for
              admin review...
            </Text>
          </View>
        </View>
      ) : null}

      {documentError ? null : null}
    </View>
  );
}

