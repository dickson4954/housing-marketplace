      'center',
  },

  searchBox: {
    margin: 12,
    minHeight: 42,
    borderRadius: 11,
    borderWidth: 1,
    borderColor:
      COLORS.border,
    backgroundColor:
      COLORS.cardSoft,
    flexDirection:
      'row',
    alignItems:
