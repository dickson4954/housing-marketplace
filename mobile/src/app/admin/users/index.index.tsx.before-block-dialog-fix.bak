    minWidth: 24,
    height: 21,
    paddingHorizontal: 6,
    borderRadius: 7,
    backgroundColor: '#252C2E',
    alignItems: 'center',
    justifyContent: 'center',
  },

  navBadgeText: {
    color: COLORS.muted,
    fontSize: 10,
    fontWeight: '800',
  },

  sidebarBottom: {
    paddingTop: 13,
    paddingBottom: 16,
    borderTopWidth: 1,
