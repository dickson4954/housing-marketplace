import React, { useCallback, useEffect, useMemo, useState } from 'react';
import {
  ActivityIndicator,
  Alert,
  Modal,
  Pressable,
  RefreshControl,
  ScrollView,
  StyleSheet,
  Text,
  TextInput,
  useWindowDimensions,
  View,
} from 'react-native';
import { router } from 'expo-router';
import * as SecureStore from 'expo-secure-store';
import {
  Bell,
  Building2,
  CalendarDays,
  Check,
  ChevronRight,
  Clock3,
  LayoutDashboard,
  Mail,
  MapPin,
  Megaphone,
  Menu,
  MoreHorizontal,
  Phone,
  Search,
  Settings,
  ShieldCheck,
  UserRound,
  UsersRound,
  X,
} from 'lucide-react-native';

import { API_BASE_URL } from '@/config/api';

const COLORS = {
  background: '#0B0F10',
  sidebar: '#0E1314',
  card: '#14191B',
  cardSoft: '#181E20',
  lime: '#D7FF5F',
  white: '#FFFFFF',
  muted: '#9CA5A7',
  sidebarText: '#7F898B',
  border: '#252C2E',
  danger: '#FF6B6B',
  warning: '#FFC857',
  success: '#7BE495',
};

type UserStatus = 'Active' | 'Inactive' | 'Blocked';

type UserRecord = {
  id: string;
  name: string;
  email: string;
  phone: string;
  location: string;
  joined: string;
  status: UserStatus;
  savedHomes: number;
  viewings: number;
  role?: string;
  createdAt?: string;
  updatedAt?: string;
};

type ApiUser = {
  id?: string;
  name?: string | null;
  fullName?: string | null;
  firstName?: string | null;
  lastName?: string | null;
  email?: string | null;
  phone?: string | null;
  role?: string | null;
  status?: string | null;
  accountStatus?: string | null;
  isActive?: boolean | null;
  active?: boolean | null;
  county?: string | null;
  constituency?: string | null;
  ward?: string | null;
  location?: string | null;
  createdAt?: string | null;
  updatedAt?: string | null;
  savedHomes?: number | null;
  shortlistCount?: number | null;
  viewings?: number | null;
  viewingCount?: number | null;
  _count?: {
    viewings?: number;
    viewingRequests?: number;
    shortlists?: number;
    savedHomes?: number;
  };
};

type CustomerListResponse = {
  success?: boolean;
  message?: string;
  users?: ApiUser[];
  customers?: ApiUser[];
  data?: ApiUser[] | {
    users?: ApiUser[];
    customers?: ApiUser[];
  };
};

type CustomerDetailResponse = {
  success?: boolean;
  message?: string;
  user?: ApiUser;
  customer?: ApiUser;
  data?: ApiUser;
};

const NAV_ITEMS = [
  { label: 'Dashboard', icon: LayoutDashboard, route: '/admin/dashboard' },
  { label: 'Properties', icon: Building2, route: '/admin/properties' },
  { label: 'Viewings', icon: CalendarDays, route: '/admin/viewings', badge: '24' },
  { label: 'Verification', icon: ShieldCheck, route: '/admin/verification', badge: '12' },
  { label: 'Landlords', icon: UserRound, route: '/admin/landlords' },
  { label: 'Marketers', icon: Megaphone, route: '/admin/marketers' },
  { label: 'Customers', icon: UsersRound, route: '/admin/users' },
  { label: 'Settings', icon: Settings, route: '/admin/settings' },
];

function normalizeStatus(user: ApiUser): UserStatus {
  const rawStatus = String(
    user.accountStatus ??
      user.status ??
      '',
  )
    .trim()
    .toUpperCase();

  if (
    rawStatus === 'BLOCKED' ||
    rawStatus === 'SUSPENDED'
  ) {
    return 'Blocked';
  }

  if (
    rawStatus === 'INACTIVE' ||
    rawStatus === 'DISABLED' ||
    rawStatus === 'DEACTIVATED'
  ) {
    return 'Inactive';
  }

  if (rawStatus === 'ACTIVE') {
    return 'Active';
  }

  if (user.isActive === false || user.active === false) {
    return 'Inactive';
  }

  return 'Active';
}

function formatDate(value?: string | null) {
  if (!value) {
    return '—';
  }

  const date = new Date(value);

  if (Number.isNaN(date.getTime())) {
    return value;
  }

  return date.toLocaleDateString('en-KE', {
    day: '2-digit',
    month: 'short',
    year: 'numeric',
  });
}

function buildUserName(user: ApiUser) {
  const explicitName =
    user.name?.trim() ||
    user.fullName?.trim();

  if (explicitName) {
    return explicitName;
  }

  const combined = [
    user.firstName?.trim(),
    user.lastName?.trim(),
  ]
    .filter(Boolean)
    .join(' ')
    .trim();

  if (combined) {
    return combined;
  }

  return user.email?.trim() || 'Customer';
}

function buildLocation(user: ApiUser) {
  if (user.location?.trim()) {
    return user.location.trim();
  }

  const parts = [
    user.ward,
    user.constituency,
    user.county,
  ]
    .map((value) => value?.trim())
    .filter(Boolean);

  return parts.length > 0
    ? parts.join(', ')
    : 'Location not provided';
}

function mapApiUser(user: ApiUser): UserRecord {
  const savedHomes =
    Number(
      user.savedHomes ??
        user.shortlistCount ??
        user._count?.savedHomes ??
        user._count?.shortlists ??
        0,
    ) || 0;

  const viewings =
    Number(
      user.viewings ??
        user.viewingCount ??
        user._count?.viewings ??
        user._count?.viewingRequests ??
        0,
    ) || 0;

  return {
    id: String(user.id ?? ''),
    name: buildUserName(user),
    email: user.email?.trim() || 'No email',
    phone: user.phone?.trim() || 'No phone number',
    location: buildLocation(user),
    joined: formatDate(user.createdAt),
    status: normalizeStatus(user),
    savedHomes,
    viewings,
    role: user.role ?? undefined,
    createdAt: user.createdAt ?? undefined,
    updatedAt: user.updatedAt ?? undefined,
  };
}

async function adminFetch(
  endpoint: string,
  options: RequestInit = {},
) {
  const token = await SecureStore.getItemAsync(
    'makazii_admin_token',
  );

  if (!token) {
    throw new Error(
      'Your admin session has expired. Please log in again.',
    );
  }

  const headers = new Headers(options.headers);

  headers.set('Authorization', `Bearer ${token}`);

  if (!headers.has('Content-Type')) {
    headers.set('Content-Type', 'application/json');
  }

  const response = await fetch(
    `${API_BASE_URL}${endpoint}`,
    {
      ...options,
      headers,
    },
  );

  const text = await response.text();

  let body: any = null;

  if (text) {
    try {
      body = JSON.parse(text);
    } catch {
      body = {
        message: text,
      };
    }
  }

  if (!response.ok) {
    throw new Error(
      body?.message ||
        body?.error ||
        `Request failed with status ${response.status}`,
    );
  }

  return body;
}

function extractUsers(
  response: CustomerListResponse,
): ApiUser[] {
  if (Array.isArray(response.users)) {
    return response.users;
  }

  if (Array.isArray(response.customers)) {
    return response.customers;
  }

  if (Array.isArray(response.data)) {
    return response.data;
  }

  if (
    response.data &&
    typeof response.data === 'object'
  ) {
    if (Array.isArray(response.data.users)) {
      return response.data.users;
    }

    if (Array.isArray(response.data.customers)) {
      return response.data.customers;
    }
  }

  return [];
}

function extractCustomer(
  response: CustomerDetailResponse,
): ApiUser | null {
  if (response.user) {
    return response.user;
  }

  if (response.customer) {
    return response.customer;
  }

  if (response.data) {
    return response.data;
  }

  return null;
}

export default function UsersPage() {
  const { width } = useWindowDimensions();

  const [users, setUsers] = useState<UserRecord[]>([]);
  const [search, setSearch] = useState('');
  const [filter, setFilter] = useState<'All' | UserStatus>('All');

  const [selectedUser, setSelectedUser] =
    useState<UserRecord | null>(null);

  const [sidebarOpen, setSidebarOpen] =
    useState(false);

  const [loading, setLoading] =
    useState(true);

  const [refreshing, setRefreshing] =
    useState(false);

  const [savingStatus, setSavingStatus] =
    useState(false);

  const [blockReasonOpen, setBlockReasonOpen] =
    useState(false);
  const [blockReason, setBlockReason] =
    useState('');
  const [pendingBlockUserId, setPendingBlockUserId] =
    useState<string | null>(null);

  const [error, setError] =
    useState<string | null>(null);

  const [loadingDetail, setLoadingDetail] =
    useState(false);

  const isDesktop = width >= 900;
  const isSmallPhone = width < 390;

  const horizontalPadding = isDesktop
    ? 28
    : isSmallPhone
      ? 14
      : 18;

  const loadUsers = useCallback(
    async (showLoader = true) => {
      try {
        if (showLoader) {
          setLoading(true);
        }

        setError(null);

        const response =
          (await adminFetch(
            '/admin/users',
          )) as CustomerListResponse;

        const apiUsers = extractUsers(response);

        const mappedUsers = apiUsers
          .filter((user) => {
            const role = String(
              user.role ?? '',
            ).toUpperCase();

            return (
              !role ||
              role === 'RENTER' ||
              role === 'CUSTOMER'
            );
          })
          .map(mapApiUser)
          .filter((user) => Boolean(user.id));

        setUsers(mappedUsers);
      } catch (err) {
        console.error(
          'Failed to load admin customers:',
          err,
        );

        const message =
          err instanceof Error
            ? err.message
            : 'Failed to load customers.';

        setError(message);
      } finally {
        if (showLoader) {
          setLoading(false);
        }
      }
    },
    [],
  );

  useEffect(() => {
    loadUsers();
  }, [loadUsers]);

  const onRefresh = useCallback(
    async () => {
      try {
        setRefreshing(true);
        await loadUsers(false);
      } finally {
        setRefreshing(false);
      }
    },
    [loadUsers],
  );

  const filteredUsers = useMemo(() => {
    const query = search
      .toLowerCase()
      .trim();

    return users.filter((user) => {
      const matchesFilter =
        filter === 'All'
          ? true
          : user.status === filter;

      const matchesSearch =
        !query ||
        user.name
          .toLowerCase()
          .includes(query) ||
        user.email
          .toLowerCase()
          .includes(query) ||
        user.phone
          .toLowerCase()
          .includes(query) ||
        user.location
          .toLowerCase()
          .includes(query) ||
        user.id
          .toLowerCase()
          .includes(query);

      return (
        matchesFilter &&
        matchesSearch
      );
    });
  }, [users, search, filter]);

  const total = users.length;

  const active = users.filter(
    (u) => u.status === 'Active',
  ).length;

  const inactive = users.filter(
    (u) => u.status === 'Inactive',
  ).length;

  const blocked = users.filter(
    (u) => u.status === 'Blocked',
  ).length;

  const navigate = (route: string) => {
    router.push(route as any);
  };

  const openUser = async (
    user: UserRecord,
  ) => {
    setSelectedUser(user);
    setLoadingDetail(true);

    try {
      const response =
        (await adminFetch(
          `/admin/users/${encodeURIComponent(
            user.id,
          )}`,
        )) as CustomerDetailResponse;

      const customer =
        extractCustomer(response);

      if (customer) {
        const detailedUser =
          mapApiUser(customer);

        setSelectedUser(detailedUser);

        setUsers((current) =>
          current.map((item) =>
            item.id === detailedUser.id
              ? detailedUser
              : item,
          ),
        );
      }
    } catch (err) {
      console.error(
        'Failed to load customer details:',
        err,
      );

      const message =
        err instanceof Error
          ? err.message
          : 'Failed to load customer details.';

      Alert.alert(
        'Customer details',
        message,
      );
    } finally {
      setLoadingDetail(false);
    }
  };

  const updateStatus = async (
    id: string,
    status: UserStatus,
    reason?: string,
  ) => {
    if (status === 'Blocked' && !reason?.trim()) {
      setPendingBlockUserId(id);
      setBlockReason('');
      setBlockReasonOpen(true);
      return;
    }
    if (savingStatus) {
      return;
    }

    const previousUser =
      users.find((user) => user.id === id);

    if (!previousUser) {
      return;
    }

    if (previousUser.status === status) {
      return;
    }

    const backendStatus =
      status.toUpperCase();

    try {
      setSavingStatus(true);

      const response =
        await adminFetch(
          `/admin/users/${encodeURIComponent(
            id,
          )}/status`,
          {
            method: 'PATCH',
            body: JSON.stringify({
              status: backendStatus,
              ...(status === 'Blocked'
                ? { reason: reason?.trim() }
                : {}),
            }),
          },
        );

      const returnedUser =
        response?.user ||
        response?.customer ||
        response?.data;

      if (
        !returnedUser ||
        typeof returnedUser !== 'object' ||
        String(returnedUser.id ?? '') !== id
      ) {
        throw new Error(
          'The server did not return the updated customer. Please refresh and check the saved status.',
        );
      }

      const nextUser: UserRecord =
        mapApiUser(returnedUser);

      setUsers((current) =>
        current.map((user) =>
          user.id === id
            ? nextUser
            : user,
        ),
      );

      setSelectedUser((current) =>
        current && current.id === id
          ? nextUser
          : current,
      );

      Alert.alert(
        'Status updated',
        `${nextUser.name} is now ${status}.`,
      );
    } catch (err) {
      console.error(
        'Failed to update customer status:',
        err,
      );

      const message =
        err instanceof Error
          ? err.message
          : 'Failed to update customer status.';

      Alert.alert(
        'Update failed',
        message,
      );
    } finally {
      setSavingStatus(false);
    }
  };

  return (
    <View style={styles.container}>
      {isDesktop ? (
        <View style={styles.desktopSidebar}>
          <SidebarContent
            navigate={navigate}
          />
        </View>
      ) : sidebarOpen ? (
        <View style={styles.mobileSidebarOverlay}>
          <View style={styles.mobileSidebar}>
            <View
              style={styles.mobileSidebarHeader}
            >
              <Text
                style={styles.mobileSidebarTitle}
              >
                MAKAZII
              </Text>

              <Pressable
                style={styles.closeButton}
                onPress={() =>
                  setSidebarOpen(false)
                }
              >
                <X
                  size={20}
                  color={COLORS.white}
                />
              </Pressable>
            </View>

            <SidebarContent
              navigate={(route) => {
                setSidebarOpen(false);
                navigate(route);
              }}
            />
          </View>
        </View>
      ) : null}

      <View style={styles.main}>
        <View
          style={[
            styles.topbar,
            {
              paddingHorizontal:
                horizontalPadding,
            },
          ]}
        >
          <View style={styles.topbarLeft}>
            {!isDesktop && (
              <Pressable
                style={styles.menuButton}
                onPress={() =>
                  setSidebarOpen(true)
                }
              >
                <Menu
                  size={20}
                  color={COLORS.white}
                />
              </Pressable>
            )}

            <View>
              <Text
                style={styles.breadcrumb}
              >
                ADMIN / CUSTOMERS
              </Text>

              <Text
                style={styles.topbarTitle}
              >
                Customer management
              </Text>
            </View>
          </View>

          <View style={styles.topbarRight}>
            <Pressable
              style={styles.iconButton}
              onPress={() =>
                router.push(
                  '/admin/notifications' as any,
                )
              }
            >
              <Bell
                size={18}
                color={COLORS.white}
              />

              <View
                style={styles.notificationDot}
              />
            </Pressable>

            <View
              style={styles.adminAvatar}
            >
              <Text
                style={styles.adminAvatarText}
              >
                A
              </Text>
            </View>

            {isDesktop && (
              <View>
                <Text
                  style={styles.adminName}
                >
                  Admin
                </Text>

                <Text
                  style={styles.adminRole}
                >
                  Platform administrator
                </Text>
              </View>
            )}
          </View>
        </View>

        <ScrollView
          showsVerticalScrollIndicator={false}
          refreshControl={
            <RefreshControl
              refreshing={refreshing}
              onRefresh={onRefresh}
              tintColor={COLORS.lime}
            />
          }
          contentContainerStyle={[
            styles.content,
            {
              paddingHorizontal:
                horizontalPadding,
            },
          ]}
        >
          <View
            style={[
              styles.pageHeader,
              {
                marginTop:
                  isDesktop ? 8 : 14,
              },
            ]}
          >
            <View
              style={styles.pageHeaderText}
            >
              <Text
                style={styles.eyebrow}
              >
                CUSTOMER MANAGEMENT
              </Text>

              <Text
                style={[
                  styles.pageTitle,
                  isSmallPhone &&
                    styles.pageTitleSmall,
                ]}
              >
                Customers
              </Text>

              <Text
                style={[
                  styles.pageSubtitle,
                  isSmallPhone &&
                    styles.pageSubtitleSmall,
                ]}
              >
                See everyone who has created a
                Makazii customer account and
                monitor their activity.
              </Text>
            </View>
          </View>

          <View
            style={[
              styles.statsGrid,
              isSmallPhone &&
                styles.statsGridSmall,
            ]}
          >
            <StatCard
              label="Total customers"
              value={String(total)}
              description="Registered accounts"
              icon={UsersRound}
            />

            <StatCard
              label="Active"
              value={String(active)}
              description="Currently active"
              icon={Check}
              accent={COLORS.success}
            />

            <StatCard
              label="Inactive"
              value={String(inactive)}
              description="No recent activity"
              icon={Clock3}
              accent={COLORS.warning}
            />

            <StatCard
              label="Blocked"
              value={String(blocked)}
              description="Restricted accounts"
              icon={ShieldCheck}
              accent={COLORS.danger}
            />
          </View>

          {error ? (
            <View
              style={styles.errorBanner}
            >
              <ShieldCheck
                size={18}
                color={COLORS.danger}
              />

              <View
                style={styles.errorContent}
              >
                <Text
                  style={styles.errorTitle}
                >
                  Could not load customers
                </Text>

                <Text
                  style={styles.errorText}
                >
                  {error}
                </Text>

                <Pressable
                  style={styles.retryButton}
                  onPress={() =>
                    loadUsers()
                  }
                >
                  <Text
                    style={styles.retryButtonText}
                  >
                    Try again
                  </Text>
                </Pressable>
              </View>
            </View>
          ) : null}

          <View
            style={[
              styles.toolbar,
              !isDesktop &&
                styles.toolbarMobile,
            ]}
          >
            <View
              style={[
                styles.searchBox,
                !isDesktop &&
                  styles.searchBoxMobile,
              ]}
            >
              <Search
                size={17}
                color={COLORS.muted}
              />

              <TextInput
                value={search}
                onChangeText={setSearch}
                placeholder="Search customers, email, phone, location..."
                placeholderTextColor={
                  COLORS.muted
                }
                style={styles.searchInput}
              />
            </View>

            <ScrollView
              horizontal
              showsHorizontalScrollIndicator={
                false
              }
              contentContainerStyle={
                styles.filterRow
              }
            >
              {(
                [
                  'All',
                  'Active',
                  'Inactive',
                  'Blocked',
                ] as const
              ).map((item) => (
                <Pressable
                  key={item}
                  style={[
                    styles.filterButton,
                    filter === item &&
                      styles.filterButtonActive,
                  ]}
                  onPress={() =>
                    setFilter(item)
                  }
                >
                  <Text
                    style={[
                      styles.filterText,
                      filter === item &&
                        styles.filterTextActive,
                    ]}
                  >
                    {item}
                  </Text>
                </Pressable>
              ))}
            </ScrollView>
          </View>

          <View
            style={styles.sectionHeader}
          >
            <View>
              <Text
                style={[
                  styles.sectionTitle,
                  isSmallPhone &&
                    styles.sectionTitleSmall,
                ]}
              >
                Registered customers
              </Text>

              <Text
                style={styles.sectionSubtitle}
              >
                {loading
                  ? 'Loading customer records...'
                  : `${filteredUsers.length} customers shown`}
              </Text>
            </View>

            {!loading && users.length > 0 ? (
              <Pressable
                style={styles.refreshButton}
                onPress={() =>
                  loadUsers()
                }
              >
                <Text
                  style={styles.refreshButtonText}
                >
                  Refresh
                </Text>
              </Pressable>
            ) : null}
          </View>

          {loading ? (
            <LoadingState />
          ) : isDesktop ? (
            <View style={styles.tableCard}>
              <View
                style={styles.tableHeader}
              >
                <Text
                  style={[
                    styles.tableHeading,
                    styles.userColumn,
                  ]}
                >
                  USER
                </Text>

                <Text
                  style={[
                    styles.tableHeading,
                    styles.locationColumn,
                  ]}
                >
                  LOCATION
                </Text>

                <Text
                  style={[
                    styles.tableHeading,
                    styles.activityColumn,
                  ]}
                >
                  ACTIVITY
                </Text>

                <Text
                  style={[
                    styles.tableHeading,
                    styles.statusColumn,
                  ]}
                >
                  STATUS
                </Text>

                <Text
                  style={[
                    styles.tableHeading,
                    styles.actionColumn,
                  ]}
                >
                  ACTION
                </Text>
              </View>

              {filteredUsers.map(
                (user) => (
                  <Pressable
                    key={user.id}
                    style={styles.tableRow}
                    onPress={() =>
                      openUser(user)
                    }
                  >
                    <View
                      style={[
                        styles.userColumn,
                        styles.userCell,
                      ]}
                    >
                      <View
                        style={
                          styles.userAvatar
                        }
                      >
                        <Text
                          style={
                            styles.userAvatarText
                          }
                        >
                          {user.name
                            .charAt(0)
                            .toUpperCase()}
                        </Text>
                      </View>

                      <View
                        style={
                          styles.userInfo
                        }
                      >
                        <Text
                          style={
                            styles.userName
                          }
                        >
                          {user.name}
                        </Text>

                        <Text
                          style={
                            styles.userEmail
                          }
                        >
                          {user.email}
                        </Text>

                        <Text
                          style={
                            styles.userId
                          }
                        >
                          {user.id}
                        </Text>
                      </View>
                    </View>

                    <View
                      style={
                        styles.locationColumn
                      }
                    >
                      <Text
                        style={
                          styles.locationText
                        }
                      >
                        {user.location}
                      </Text>

                      <Text
                        style={
                          styles.joinedText
                        }
                      >
                        Joined {user.joined}
                      </Text>
                    </View>

                    <View
                      style={
                        styles.activityColumn
                      }
                    >
                      <View
                        style={
                          styles.activityItem
                        }
                      >
                        <HeartPlaceholder />

                        <Text
                          style={
                            styles.activityText
                          }
                        >
                          {user.savedHomes}{' '}
                          saved homes
                        </Text>
                      </View>

                      <View
                        style={
                          styles.activityItem
                        }
                      >
                        <CalendarDays
                          size={14}
                          color={
                            COLORS.muted
                          }
                        />

                        <Text
                          style={
                            styles.activityText
                          }
                        >
                          {user.viewings}{' '}
                          viewings
                        </Text>
                      </View>
                    </View>

                    <View
                      style={
                        styles.statusColumn
                      }
                    >
                      <StatusBadge
                        status={
                          user.status
                        }
                      />
                    </View>

                    <View
                      style={
                        styles.actionColumn
                      }
                    >
                      <Pressable
                        style={
                          styles.viewButton
                        }
                        onPress={() =>
                          openUser(user)
                        }
                      >
                        <Text
                          style={
                            styles.viewButtonText
                          }
                        >
                          View
                        </Text>

                        <ChevronRight
                          size={15}
                          color={
                            COLORS.lime
                          }
                        />
                      </Pressable>
                    </View>
                  </Pressable>
                ),
              )}

              {filteredUsers.length ===
                0 && <EmptyState />}
            </View>
          ) : (
            <View
              style={styles.mobileList}
            >
              {filteredUsers.map(
                (user) => (
                  <Pressable
                    key={user.id}
                    style={
                      styles.mobileUserCard
                    }
                    onPress={() =>
                      openUser(user)
                    }
                  >
                    <View
                      style={
                        styles.mobileUserTop
                      }
                    >
                      <View
                        style={[
                          styles.userCell,
                          { flex: 1 },
                        ]}
                      >
                        <View
                          style={
                            styles.userAvatar
                          }
                        >
                          <Text
                            style={
                              styles.userAvatarText
                            }
                          >
                            {user.name
                              .charAt(0)
                              .toUpperCase()}
                          </Text>
                        </View>

                        <View
                          style={
                            styles.userInfo
                          }
                        >
                          <Text
                            style={
                              styles.userName
                            }
                            numberOfLines={1}
                          >
                            {user.name}
                          </Text>

                          <Text
                            style={
                              styles.userEmail
                            }
                            numberOfLines={1}
                          >
                            {user.email}
                          </Text>
                        </View>
                      </View>

                      <StatusBadge
                        status={
                          user.status
                        }
                      />
                    </View>

                    <View
                      style={
                        styles.mobileDivider
                      }
                    />

                    <View
                      style={
                        styles.mobileMetaRow
                      }
                    >
                      <View
                        style={
                          styles.mobileMetaItem
                        }
                      >
                        <MapPin
                          size={14}
                          color={
                            COLORS.muted
                          }
                        />

                        <Text
                          style={
                            styles.mobileMetaText
                          }
                          numberOfLines={1}
                        >
                          {user.location}
                        </Text>
                      </View>

                      <Text
                        style={
                          styles.userId
                        }
                        numberOfLines={1}
                      >
                        {user.id}
                      </Text>
                    </View>

                    <View
                      style={
                        styles.mobileActivityRow
                      }
                    >
                      <Text
                        style={
                          styles.mobileActivityText
                        }
                      >
                        {user.savedHomes}{' '}
                        saved homes
                      </Text>

                      <Text
                        style={
                          styles.mobileActivityText
                        }
                      >
                        {user.viewings}{' '}
                        viewings
                      </Text>

                      <ChevronRight
                        size={17}
                        color={
                          COLORS.muted
                        }
                      />
                    </View>
                  </Pressable>
                ),
              )}

              {filteredUsers.length ===
                0 && <EmptyState />}
            </View>
          )}

          <View
            style={styles.liveNotice}
          >
            <ShieldCheck
              size={18}
              color={COLORS.lime}
            />

            <View
              style={
                styles.liveNoticeContent
              }
            >
              <Text
                style={
                  styles.liveNoticeTitle
                }
              >
                Live customer records
              </Text>

              <Text
                style={
                  styles.liveNoticeText
                }
              >
                These customers are loaded
                directly from registered Makazii
                accounts. Status changes are saved
                to the admin backend.
              </Text>
            </View>
          </View>
        </ScrollView>
      </View>

      <Modal
        visible={Boolean(selectedUser)}
        transparent
        animationType="fade"
        onRequestClose={() =>
          setSelectedUser(null)
        }
      >
        <View
          style={styles.modalBackdrop}
        >
          <View
            style={[
              styles.detailModal,
              {
                maxWidth: isDesktop
                  ? 720
                  : undefined,
                width: isDesktop
                  ? '100%'
                  : '94%',
              },
            ]}
          >
            {selectedUser && (
              <>
                <View
                  style={styles.modalHeader}
                >
                  <View
                    style={{ flex: 1 }}
                  >
                    <Text
                      style={
                        styles.modalEyebrow
                      }
                    >
                      CUSTOMER ACCOUNT
                    </Text>

                    <Text
                      style={
                        styles.modalTitle
                      }
                      numberOfLines={1}
                    >
                      {selectedUser.name}
                    </Text>
                  </View>

                  <Pressable
                    style={
                      styles.closeButton
                    }
                    onPress={() =>
                      setSelectedUser(
                        null,
                      )
                    }
                  >
                    <X
                      size={20}
                      color={
                        COLORS.white
                      }
                    />
                  </Pressable>
                </View>

                <ScrollView
                  showsVerticalScrollIndicator={
                    false
                  }
                  contentContainerStyle={
                    styles.modalScroll
                  }
                >
                  <View
                    style={
                      styles.profileHero
                    }
                  >
                    <View
                      style={
                        styles.largeAvatar
                      }
                    >
                      <Text
                        style={
                          styles.largeAvatarText
                        }
                      >
                        {selectedUser.name
                          .charAt(0)
                          .toUpperCase()}
                      </Text>
                    </View>

                    <View
                      style={
                        styles.profileHeroText
                      }
                    >
                      <Text
                        style={
                          styles.profileName
                        }
                        numberOfLines={1}
                      >
                        {selectedUser.name}
                      </Text>

                      <Text
                        style={
                          styles.profileEmail
                        }
                        numberOfLines={1}
                      >
                        {selectedUser.email}
                      </Text>

                      <StatusBadge
                        status={
                          selectedUser.status
                        }
                      />
                    </View>
                  </View>

                  {loadingDetail ? (
                    <View
                      style={
                        styles.detailLoading
                      }
                    >
                      <ActivityIndicator
                        size="small"
                        color={
                          COLORS.lime
                        }
                      />

                      <Text
                        style={
                          styles.detailLoadingText
                        }
                      >
                        Loading full customer
                        record...
                      </Text>
                    </View>
                  ) : null}

                  <View
                    style={styles.infoGrid}
                  >
                    <InfoItem
                      icon={Mail}
                      label="Email"
                      value={
                        selectedUser.email
                      }
                    />

                    <InfoItem
                      icon={Phone}
                      label="Phone"
                      value={
                        selectedUser.phone
                      }
                    />

                    <InfoItem
                      icon={MapPin}
                      label="Location"
                      value={
                        selectedUser.location
                      }
                    />

                    <InfoItem
                      icon={CalendarDays}
                      label="Joined"
                      value={
                        selectedUser.joined
                      }
                    />

                    <InfoItem
                      icon={Building2}
                      label="Saved homes"
                      value={String(
                        selectedUser.savedHomes,
                      )}
                    />

                    <InfoItem
                      icon={Clock3}
                      label="Viewings"
                      value={String(
                        selectedUser.viewings,
                      )}
                    />

                    <InfoItem
                      icon={UserRound}
                      label="Customer ID"
                      value={
                        selectedUser.id
                      }
                    />

                    <InfoItem
                      icon={ShieldCheck}
                      label="Role"
                      value={
                        selectedUser.role ||
                        'RENTER'
                      }
                    />
                  </View>

                  <View
                    style={styles.modalSection}
                  >
                    <Text
                      style={
                        styles.modalSectionTitle
                      }
                    >
                      Account status
                    </Text>

                    <Text
                      style={
                        styles.modalSectionDescription
                      }
                    >
                      This changes the customer's
                      account status in the Makazii
                      backend.
                    </Text>

                    <View
                      style={
                        styles.statusOptions
                      }
                    >
                      {(
                        [
                          'Active',
                          'Inactive',
                          'Blocked',
                        ] as const
                      ).map((status) => (
                        <Pressable
                          key={status}
                          style={[
                            styles.statusOption,
                            selectedUser.status ===
                              status &&
                              styles.statusOptionActive,
                            savingStatus &&
                              styles.statusOptionDisabled,
                          ]}
                          disabled={
                            savingStatus
                          }
                          onPress={() =>
                            updateStatus(
                              selectedUser.id,
                              status,
                            )
                          }
                        >
                          {selectedUser.status ===
                            status && (
                            <Check
                              size={15}
                              color={
                                COLORS.lime
                              }
                            />
                          )}

                          <Text
                            style={[
                              styles.statusOptionText,
                              selectedUser.status ===
                                status &&
                                styles.statusOptionTextActive,
                            ]}
                          >
                            {status}
                          </Text>
                        </Pressable>
                      ))}
                    </View>

                    {savingStatus ? (
                      <View
                        style={
                          styles.statusSaving
                        }
                      >
                        <ActivityIndicator
                          size="small"
                          color={
                            COLORS.lime
                          }
                        />

                        <Text
                          style={
                            styles.statusSavingText
                          }
                        >
                          Saving account status...
                        </Text>
                      </View>
                    ) : null}
                  </View>

                  <View
                    style={
                      styles.securityNotice
                    }
                  >
                    <ShieldCheck
                      size={17}
                      color={
                        COLORS.lime
                      }
                    />

                    <Text
                      style={
                        styles.securityNoticeText
                      }
                    >
                      Customer information is
                      private and available only to
                      authorized Makazii team
                      members. Customer contact
                      details are not exposed to
                      landlords through the public
                      app.
                    </Text>
                  </View>
                </ScrollView>

                <View
                  style={styles.modalFooter}
                >
                  <Pressable
                    style={
                      styles.secondaryButton
                    }
                    onPress={() =>
                      setSelectedUser(
                        null,
                      )
                    }
                  >
                    <Text
                      style={
                        styles.secondaryButtonText
                      }
                    >
                      Close
                    </Text>
                  </Pressable>

                  <Pressable
                    style={
                      styles.primaryButton
                    }
                    onPress={() =>
                      setSelectedUser(
                        null,
                      )
                    }
                  >
                    <Check
                      size={16}
                      color={
                        COLORS.background
                      }
                    />

                    <Text
                      style={
                        styles.primaryButtonText
                      }
                    >
                      Done
                    </Text>
                  </Pressable>
                </View>
              </>
            )}
          </View>
        </View>
      </Modal>

      <Modal
        visible={blockReasonOpen}
        transparent
        animationType="fade"
        onRequestClose={() => {
          if (!savingStatus) {
            setBlockReasonOpen(false);
            setPendingBlockUserId(null);
            setBlockReason('');
          }
        }}
      >
        <View style={styles.modalBackdrop}>
          <View style={styles.blockReasonModal}>
            <Text style={styles.blockReasonTitle}>
              Block customer account
            </Text>

            <Text style={styles.blockReasonDescription}>
              Provide a reason for blocking this customer.
              This will be saved in the account status history.
            </Text>

            <TextInput
              value={blockReason}
              onChangeText={setBlockReason}
              placeholder="Enter reason for blocking..."
              placeholderTextColor={COLORS.muted}
              multiline
              editable={!savingStatus}
              textAlignVertical="top"
              style={styles.blockReasonInput}
            />

            <View style={styles.blockReasonActions}>
              <Pressable
                disabled={savingStatus}
                style={styles.blockReasonCancel}
                onPress={() => {
                  setBlockReasonOpen(false);
                  setPendingBlockUserId(null);
                  setBlockReason('');
                }}
              >
                <Text style={styles.blockReasonCancelText}>
                  Cancel
                </Text>
              </Pressable>

              <Pressable
                disabled={
                  savingStatus ||
                  !blockReason.trim() ||
                  !pendingBlockUserId
                }
                style={[
                  styles.blockReasonConfirm,
                  (savingStatus ||
                    !blockReason.trim() ||
                    !pendingBlockUserId) &&
                    styles.statusOptionDisabled,
                ]}
                onPress={async () => {
                  const id = pendingBlockUserId;
                  const reason = blockReason.trim();

                  if (!id || !reason || savingStatus) {
                    return;
                  }

                  await updateStatus(id, 'Blocked', reason);
                  setBlockReasonOpen(false);
                  setPendingBlockUserId(null);
                  setBlockReason('');
                }}
              >
                {savingStatus ? (
                  <ActivityIndicator
                    size="small"
                    color={COLORS.background}
                  />
                ) : (
                  <Text style={styles.blockReasonConfirmText}>
                    Confirm block
                  </Text>
                )}
              </Pressable>
            </View>
          </View>
        </View>
      </Modal>
    </View>
  );
}

function SidebarContent({
  navigate,
}: {
  navigate: (route: string) => void;
}) {
  return (
    <View style={styles.sidebarContent}>
      <View style={styles.brandBlock}>
        <Text style={styles.brand}>
          MAKAZII
        </Text>

        <Text
          style={styles.brandSubtitle}
        >
          TEAM PORTAL
        </Text>

        <View style={styles.onlineRow}>
          <View
            style={styles.onlineDot}
          />

          <Text
            style={styles.onlineText}
          >
            PLATFORM ONLINE
          </Text>
        </View>
      </View>

      <View style={styles.navSection}>
        <Text style={styles.navLabel}>
          WORKSPACE
        </Text>

        {NAV_ITEMS.map((item) => {
          const Icon = item.icon;
          const active =
            item.label === 'Customers';

          return (
            <Pressable
              key={item.label}
              style={[
                styles.navItem,
                active &&
                  styles.navItemActive,
              ]}
              onPress={() =>
                navigate(item.route)
              }
            >
              <Icon
                size={18}
                color={
                  active
                    ? COLORS.lime
                    : COLORS.sidebarText
                }
              />

              <Text
                style={[
                  styles.navItemText,
                  active &&
                    styles.navItemTextActive,
                ]}
              >
                {item.label}
              </Text>

              {item.badge && (
                <View
                  style={styles.navBadge}
                >
                  <Text
                    style={
                      styles.navBadgeText
                    }
                  >
                    {item.badge}
                  </Text>
                </View>
              )}
            </Pressable>
          );
        })}
      </View>

      <View
        style={styles.sidebarBottom}
      >
        <View
          style={styles.adminMiniProfile}
        >
          <View
            style={styles.adminAvatar}
          >
            <Text
              style={
                styles.adminAvatarText
              }
            >
              A
            </Text>
          </View>

          <View
            style={{ flex: 1 }}
          >
            <Text
              style={styles.adminName}
            >
              Admin
            </Text>

            <Text
              style={styles.adminRole}
            >
              Administrator
            </Text>
          </View>

          <MoreHorizontal
            size={18}
            color={
              COLORS.sidebarText
            }
          />
        </View>

        <Text
          style={styles.sidebarFooter}
        >
          MAKAZII · FIND YOUR PLACE
        </Text>
      </View>
    </View>
  );
}

function StatCard({
  label,
  value,
  description,
  icon: Icon,
  accent = COLORS.lime,
}: {
  label: string;
  value: string;
  description: string;
  icon: React.ElementType;
  accent?: string;
}) {
  return (
    <View style={styles.statCard}>
      <View style={styles.statTop}>
        <Text
          style={styles.statLabel}
          numberOfLines={1}
        >
          {label}
        </Text>

        <View
          style={[
            styles.statIcon,
            {
              borderColor: `${accent}33`,
            },
          ]}
        >
          <Icon
            size={16}
            color={accent}
          />
        </View>
      </View>

      <Text style={styles.statValue}>
        {value}
      </Text>

      <Text
        style={styles.statDescription}
      >
        {description}
      </Text>
    </View>
  );
}

function StatusBadge({
  status,
}: {
  status: UserStatus;
}) {
  const color =
    status === 'Active'
      ? COLORS.success
      : status === 'Inactive'
        ? COLORS.warning
        : COLORS.danger;

  return (
    <View
      style={[
        styles.statusBadge,
        {
          borderColor: `${color}44`,
          backgroundColor: `${color}10`,
        },
      ]}
    >
      <View
        style={[
          styles.statusDot,
          {
            backgroundColor: color,
          },
        ]}
      />

      <Text
        style={[
          styles.statusBadgeText,
          {
            color,
          },
        ]}
      >
        {status}
      </Text>
    </View>
  );
}

function InfoItem({
  icon: Icon,
  label,
  value,
}: {
  icon: React.ElementType;
  label: string;
  value: string;
}) {
  return (
    <View style={styles.infoItem}>
      <View style={styles.infoIcon}>
        <Icon
          size={16}
          color={COLORS.lime}
        />
      </View>

      <View style={{ flex: 1 }}>
        <Text
          style={styles.infoLabel}
        >
          {label}
        </Text>

        <Text
          style={styles.infoValue}
          numberOfLines={2}
        >
          {value}
        </Text>
      </View>
    </View>
  );
}

function LoadingState() {
  return (
    <View style={styles.loadingState}>
      <ActivityIndicator
        size="large"
        color={COLORS.lime}
      />

      <Text
        style={styles.loadingTitle}
      >
        Loading customers
      </Text>

      <Text
        style={styles.loadingText}
      >
        Fetching registered customer
        accounts from Makazii.
      </Text>
    </View>
  );
}

function EmptyState() {
  return (
    <View style={styles.emptyState}>
      <UsersRound
        size={28}
        color={COLORS.muted}
      />

      <Text style={styles.emptyTitle}>
        No customers found
      </Text>

      <Text style={styles.emptyText}>
        Try changing your search or status
        filter.
      </Text>
    </View>
  );
}

function HeartPlaceholder() {
  return (
    <View
      style={styles.heartPlaceholder}
    >
      <Text
        style={styles.heartText}
      >
        ♡
      </Text>
    </View>
  );
}

