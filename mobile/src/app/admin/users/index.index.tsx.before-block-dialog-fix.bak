  main: {
    flex: 1,
    backgroundColor: COLORS.background,
    minWidth: 0,
  },

  topbar: {
    minHeight: 72,
    borderBottomWidth: 1,
    borderBottomColor: COLORS.border,
    flexDirection: 'row',
    alignItems: 'center',
    justifyContent: 'space-between',
  },

  topbarLeft: {
    flexDirection: 'row',
    alignItems: 'center',
    gap: 10,
    minWidth: 0,
    flex: 1,
  },

  breadcrumb: {
    color: COLORS.lime,
    fontSize: 8,
