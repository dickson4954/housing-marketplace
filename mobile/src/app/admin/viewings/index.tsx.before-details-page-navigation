                        </Text>

                        <View
                          style={
                            styles.contactLine
                          }
                        >
                          <Phone
                            size={14}
                            color="#8D9799"
                          />

                          <Text
                            style={
                              styles.contactText
                            }
                          >
                            {selectedViewing
                              .assignedMarketer
                              .user?.phone ||
                              "No phone"}
                          </Text>
                        </View>

                        <View
                          style={
                            styles.contactLine
                          }
                        >
                          <Mail
                            size={14}
                            color="#8D9799"
                          />

                          <Text
                            style={
                              styles.contactText
                            }
                          >
                            {selectedViewing
                              .assignedMarketer
                              .user?.email ||
                              "No email"}
                          </Text>
                        </View>

                        <Text
                          style={
                            styles.assignmentDate
                          }
                        >
                          Assigned{" "}
                          {formatDateTime(
                            selectedViewing.assignedAt
                          )}
                        </Text>
                      </View>
                    </View>
                  ) : selectedViewing.property
                      ?.marketer ? (
                    <View
                      style={
                        styles.sourceInfoCard
                      }
                    >
                      <ShieldCheck
                        size={19}
                        color="#D7FF5F"
                      />

                      <View
                        style={
                          styles.sourceInfoText
                        }
                      >
                        <Text
                          style={
                            styles.sourceInfoTitle
                          }
                        >
                          Property source representative
                        </Text>

                        <Text
                          style={
                            styles.sourceInfoName
                          }
                        >
                          {getMarketerName(
                            selectedViewing
                              .property
                              .marketer
                          )}
                        </Text>

                        <Text
                          style={
                            styles.sourceInfoDescription
                          }
                        >
                          This marketer will be
                          automatically assigned when
                          the paid viewing is approved.
                        </Text>
                      </View>
                    </View>
                  ) : (
                    <View
                      style={styles.warningCard}
                    >
                      <AlertCircle
                        size={19}
                        color="#FFB86B"
                      />

                      <Text
                        style={
                          styles.warningText
                        }
                      >
                        This property has no source
                        marketer. The backend will not
                        approve this viewing until one
                        is available.
                      </Text>
                    </View>
                  )}
                </View>

                {selectedViewing.statusHistory &&
                selectedViewing.statusHistory.length >
                  0 ? (
                  <View
                    style={styles.detailSection}
                  >
                    <Text
                      style={styles.sectionTitle}
                    >
                      Status history
                    </Text>

                    <View
                      style={
                        styles.historyList
                      }
                    >
                      {selectedViewing.statusHistory.map(
                        (history) => (
                          <View
                            key={history.id}
                            style={
                              styles.historyItem
                            }
                          >
                            <View
                              style={
                                styles.historyDot
                              }
                            />

                            <View
                              style={
                                styles.historyMain
                              }
                            >
                              <View
                                style={
                                  styles.historyTop
                                }
                              >
                                <Text
                                  style={
                                    styles.historyStatus
                                  }
                                >
                                  {formatStatus(
                                    history.status ||
                                      ""
                                  )}
                                </Text>

                                <Text
                                  style={
                                    styles.historyDate
                                  }
                                >
                                  {formatDateTime(
                                    history.createdAt
                                  )}
                                </Text>
                              </View>

                              {history.note ? (
                                <Text
                                  style={
                                    styles.historyNote
                                  }
                                >
                                  {history.note}
                                </Text>
                              ) : null}
                            </View>
                          </View>
                        )
                      )}
                    </View>
                  </View>
                ) : null}

                {selectedViewing.status ===
                  "PAID" && (
                  <View style={styles.modalActions}>
                    <Pressable
                      onPress={approveViewing}
                      disabled={approving}
                      style={[
                        styles.approveButton,
                        approving &&
                          styles.buttonDisabled,
                      ]}
                    >
                      {approving ? (
                        <ActivityIndicator
                          size="small"
                          color="#0B0F10"
                        />
                      ) : (
                        <CheckCircle2
                          size={18}
                          color="#0B0F10"
                        />
                      )}

                      <Text
                        style={
                          styles.approveButtonText
                        }
                      >
                        {approving
                          ? "Approving..."
                          : "Approve & Assign Source Marketer"}
                      </Text>
                    </Pressable>
                  </View>
                )}
              </ScrollView>
            ) : null}
          </View>
        </View>
      </Modal>
    </View>
  );
}

