                      </View>

                      <View style={styles.cardInfoGrid}>
                        <View style={styles.infoItem}>
                          <UserRound
                            size={15}
                            color="#7E898B"
                          />
                          <Text
                            style={styles.infoText}
                            numberOfLines={1}
                          >
                            {getPersonName(
                              viewing.renter
                            )}
                          </Text>
                        </View>

                        <View style={styles.infoItem}>
                          <CalendarDays
                            size={15}
                            color="#7E898B"
                          />
                          <Text
                            style={styles.infoText}
                          >
                            {formatDate(
                              viewing.requestedDate
                            )}
                          </Text>
                        </View>

                        <View style={styles.infoItem}>
                          <Clock3
                            size={15}
                            color="#7E898B"
                          />
                          <Text
                            style={styles.infoText}
                          >
                            {viewing.preferredTime ||
                              "Flexible"}
                          </Text>
                        </View>

                        <View style={styles.infoItem}>
                          <CheckCircle2
                            size={15}
                            color={
                              payment?.status ===
                              "SUCCESS"
                                ? "#D7FF5F"
                                : "#7E898B"
                            }
                          />
                          <Text
                            style={styles.infoText}
                          >
                            {payment
                              ? `${payment.status || "Payment"} · ${formatMoney(
                                  payment.amount,
                                  payment.currency ||
                                    "KES"
                                )}`
                              : "No payment record"}
                          </Text>
                        </View>
                      </View>

                      <View style={styles.cardBottom}>
                        <Text
                          style={styles.createdText}
                        >
                          Request created{" "}
                          {formatDateTime(
                            viewing.createdAt
                          )}
                        </Text>

                        {viewing.assignedMarketer ? (
                          <Text
                            style={
                              styles.assignedText
                            }
                            numberOfLines={1}
                          >
                            Representative:{" "}
                            {getMarketerName(
                              viewing.assignedMarketer
                            )}
                          </Text>
                        ) : (
                          <Text
                            style={
                              styles.unassignedText
                            }
                          >
                            Representative not assigned — awaiting admin approval
                          </Text>
                        )}

                        <ChevronRight
                          size={18}
                          color="#667073"
                        />
                      </View>
                    </View>
                  </Pressable>
                );
              })}
            </View>
          )}
        </ScrollView>
      </View>

      <Modal
        visible={Boolean(selectedViewing)}
        transparent
        animationType="slide"
        onRequestClose={() =>
          setSelectedViewing(null)
        }
      >
        <View style={styles.modalOverlay}>
          <View style={styles.detailModal}>
            <View style={styles.modalHeader}>
              <View style={styles.modalHeaderText}>
                <Text style={styles.modalTitle}>
                  Viewing details
                </Text>

                <Text style={styles.modalSubtitle}>
                  {selectedViewing?.id || ""}
                </Text>
              </View>

              <Pressable
                onPress={() =>
                  setSelectedViewing(null)
                }
                style={styles.closeButton}
              >
                <X
                  size={21}
                  color="#F5F7F7"
                />
              </Pressable>
            </View>

            {detailLoading ? (
              <View style={styles.modalLoading}>
                <ActivityIndicator
                  size="large"
                  color="#D7FF5F"
                />
                <Text style={styles.loadingText}>
                  Loading details...
                </Text>
              </View>
            ) : selectedViewing ? (
              <ScrollView
                style={styles.modalScroll}
                contentContainerStyle={
                  styles.modalContent
                }
                showsVerticalScrollIndicator={false}
              >
                <View style={styles.modalStatusRow}>
                  <StatusBadge
                    status={
                      selectedViewing.status
                    }
                  />

                  <Text
                    style={styles.statusDescription}
                  >
                    {getStatusDescription(
                      selectedViewing.status
                    )}
                  </Text>
                </View>

                {selectedViewing.status ===
                  "PAID" && (
                  <View
                    style={
                      styles.approvalCallout
                    }
                  >
                    <CheckCircle2
                      size={20}
                      color="#D7FF5F"
                    />

                    <View
                      style={
                        styles.approvalCalloutText
                      }
                    >
                      <Text
                        style={
                          styles.approvalTitle
                        }
                      >
                        Payment received
                      </Text>

                      <Text
                        style={
                          styles.approvalDescription
                        }
                      >
                        This viewing is ready for
                        admin approval. Approval
                        automatically assigns the
                        property's source marketer.
                      </Text>
                    </View>
                  </View>
                )}

                <View style={styles.detailSection}>
                  <Text
                    style={styles.sectionTitle}
                  >
                    Property
                  </Text>

                  <View style={styles.propertyDetailCard}>
                    {getPropertyImage(
                      selectedViewing.property
                    ) ? (
                      <Image
                        source={{
                          uri: getPropertyImage(
                            selectedViewing.property
                          ),
                        }}
                        style={
                          styles.detailPropertyImage
                        }
                      />
                    ) : (
                      <View
                        style={
                          styles.detailPropertyPlaceholder
                        }
                      >
                        <Home
                          size={28}
                          color="#697376"
                        />
                      </View>
                    )}

                    <View
                      style={
                        styles.propertyDetailInfo
                      }
                    >
                      <Text
                        style={
                          styles.detailPropertyTitle
                        }
                      >
                        {selectedViewing.property
                          ?.title ||
                          "Untitled property"}
                      </Text>

                      <View
                        style={
                          styles.locationLine
                        }
                      >
                        <MapPin
                          size={14}
                          color="#9CA5A7"
                        />

                        <Text
                          style={
                            styles.locationLineText
                          }
                        >
                          {getPropertyLocation(
                            selectedViewing.property
                          )}
                        </Text>
                      </View>

                      <Text
                        style={
                          styles.propertyRent
                        }
                      >
                        {formatMoney(
                          selectedViewing.property
                            ?.monthlyRent
                        )}
