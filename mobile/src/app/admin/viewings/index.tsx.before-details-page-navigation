                    selectedViewing.payments.map(
                      (payment) => (
                        <View
                          key={payment.id}
                          style={
                            styles.paymentCard
                          }
                        >
                          <View
                            style={
                              styles.paymentTop
                            }
                          >
                            <View>
                              <Text
                                style={
                                  styles.paymentAmount
                                }
                              >
                                {formatMoney(
                                  payment.amount,
                                  payment.currency ||
                                    "KES"
                                )}
                              </Text>

                              <Text
                                style={
                                  styles.paymentProvider
                                }
                              >
                                {payment.provider ||
                                  payment.method ||
                                  "Payment"}
                              </Text>
                            </View>

                            <View
                              style={[
                                styles.paymentStatus,
                                payment.status ===
                                  "SUCCESS" &&
                                  styles.paymentStatusSuccess,
                              ]}
                            >
                              <Text
                                style={
                                  styles.paymentStatusText
                                }
                              >
                                {payment.status ||
                                  "UNKNOWN"}
                              </Text>
                            </View>
                          </View>

                          <View
                            style={
                              styles.paymentDetails
                            }
                          >
                            <Text
                              style={
                                styles.paymentDetailText
                              }
                            >
                              Reference:{" "}
                              {payment.reference ||
                                "—"}
                            </Text>

                            <Text
                              style={
                                styles.paymentDetailText
                              }
                            >
                              Provider reference:{" "}
                              {payment.providerReference ||
                                "—"}
                            </Text>

                            <Text
                              style={
                                styles.paymentDetailText
                              }
                            >
                              Paid at:{" "}
                              {formatDateTime(
                                payment.paidAt
                              )}
                            </Text>
                          </View>
                        </View>
                      )
                    )
                  ) : (
                    <View
                      style={styles.noPayment}
                    >
                      <Text
                        style={
                          styles.noPaymentText
                        }
                      >
                        No payment record is attached
                        to this viewing.
                      </Text>
                    </View>
                  )}
                </View>

                <View style={styles.detailSection}>
                  <Text
                    style={styles.sectionTitle}
                  >
                    Representative
                  </Text>

                  {selectedViewing.assignedMarketer ? (
                    <View
                      style={
                        styles.contactCard
                      }
                    >
                      <View
                        style={
                          styles.contactAvatar
                        }
                      >
                        <ShieldCheck
                          size={21}
                          color="#D7FF5F"
                        />
                      </View>

                      <View
                        style={
                          styles.contactMain
                        }
                      >
                        <Text
                          style={
                            styles.contactName
                          }
                        >
                          {getMarketerName(
                            selectedViewing.assignedMarketer
