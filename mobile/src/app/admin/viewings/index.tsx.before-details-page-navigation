                    <DetailRow
                      icon={Home}
                      label="Property purpose"
                      value={
                        selectedViewing.property
                          ?.purpose || "—"
                      }
                    />

                    <DetailRow
                      icon={FileText}
                      label="Property type"
                      value={
                        selectedViewing.property
                          ?.longStayType || "—"
                      }
                    />

                    <DetailRow
                      icon={Home}
                      label="Bedrooms"
                      value={String(
                        selectedViewing.property
                          ?.bedrooms ?? "—"
                      )}
                    />

                    <DetailRow
                      icon={Home}
                      label="Bathrooms"
                      value={String(
                        selectedViewing.property
                          ?.bathrooms ?? "—"
                      )}
                    />

                    <DetailRow
                      icon={ShieldCheck}
                      label="Verification"
                      value={
                        selectedViewing.property
                          ?.verified
                          ? "Verified"
                          : "Not verified"
