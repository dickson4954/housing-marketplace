                      </Text>

                      <View
                        style={
                          styles.contactLine
                        }
                      >
                        <Phone
                          size={14}
                          color="#8D9799"
                        />

                        <Text
                          style={
                            styles.contactText
                          }
                        >
                          {selectedViewing.renter
                            ?.phone || "No phone"}
                        </Text>
                      </View>

                      <View
                        style={
                          styles.contactLine
                        }
                      >
                        <Mail
                          size={14}
                          color="#8D9799"
                        />

                        <Text
                          style={
                            styles.contactText
                          }
                        >
                          {selectedViewing.renter
                            ?.email || "No email"}
                        </Text>
                      </View>
                    </View>
                  </View>
                </View>

                <View style={styles.detailSection}>
                  <Text
                    style={styles.sectionTitle}
                  >
                    Viewing request
                  </Text>

                  <View style={styles.detailGrid}>
                    <DetailRow
                      icon={CalendarDays}
                      label="Requested date"
                      value={formatDate(
                        selectedViewing.requestedDate
                      )}
                    />

                    <DetailRow
                      icon={Clock3}
                      label="Preferred time"
                      value={
                        selectedViewing.preferredTime ||
                        "Flexible"
                      }
                    />

                    <DetailRow
                      icon={UserRound}
                      label="Requested by"
                      value={
                        selectedViewing.requestedBy ||
                        "RENTER"
                      }
