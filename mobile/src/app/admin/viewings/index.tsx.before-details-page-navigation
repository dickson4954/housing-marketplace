function getPersonName(person?: Person | null) {
  if (!person) {
    return "—";
  }

  const name = [person.firstName, person.lastName]
    .filter(Boolean)
    .join(" ")
    .trim();

  return name || "Unnamed user";
}

function getMarketerName(marketer?: Marketer | null) {
  return getPersonName(marketer?.user);
}

function getPropertyLocation(property?: Property | null) {
  if (!property) {
    return "Location unavailable";
  }

  const parts = [
    property.area,
    property.town,
    property.ward?.name,
    property.constituency?.name,
    property.countyRelation?.name || property.county,
  ].filter(
    (value): value is string =>
      typeof value === "string" && value.trim().length > 0
  );

  return parts.length ? parts.slice(0, 3).join(", ") : "Location unavailable";
}

function getPropertyImage(property?: Property | null) {
  return property?.images?.[0]?.url || "";
}

function formatMoney(
  amount?: number | null,
  currency = "KES"
) {
  if (amount === null || amount === undefined) {
    return "—";
  }

  return `${currency} ${Number(amount).toLocaleString("en-KE")}`;
}

function formatDate(value?: string | null) {
  if (!value) {
    return "—";
  }

  const date = new Date(value);

  if (Number.isNaN(date.getTime())) {
    return value;
  }

  return date.toLocaleDateString("en-KE", {
    day: "2-digit",
    month: "short",
    year: "numeric",
  });
}

function formatDateTime(value?: string | null) {
  if (!value) {
    return "—";
  }

  const date = new Date(value);

  if (Number.isNaN(date.getTime())) {
    return value;
  }

  return date.toLocaleString("en-KE", {
    day: "2-digit",
    month: "short",
    year: "numeric",
    hour: "2-digit",
    minute: "2-digit",
  });
}

function formatStatus(status: ViewingStatus) {
  switch (status) {
    case "PENDING_PAYMENT":
      return "Pending payment";
    case "PAID":
      return "Paid";
    case "AWAITING_ASSIGNMENT":
      return "Awaiting assignment";
    case "ASSIGNED":
      return "Assigned";
    case "CONFIRMED":
      return "Confirmed";
    case "COMPLETED":
      return "Completed";
    case "CANCELLED":
      return "Cancelled";
    case "DECLINED":
      return "Declined";
    default:
      return status.replaceAll("_", " ");
  }
}

function getStatusDescription(status: ViewingStatus) {
  switch (status) {
    case "PENDING_PAYMENT":
      return "Customer has not completed the viewing fee payment.";
    case "PAID":
      return "Payment is confirmed and the viewing is ready for admin approval.";
    case "AWAITING_ASSIGNMENT":
      return "The viewing is waiting for representative assignment.";
    case "ASSIGNED":
      return "The source marketer has been assigned.";
    case "CONFIRMED":
      return "The assigned marketer has confirmed the viewing.";
    case "COMPLETED":
      return "The viewing has been completed.";
    case "CANCELLED":
      return "The viewing has been cancelled.";
    case "DECLINED":
      return "The assigned representative declined the viewing.";
    default:
      return "Viewing status";
  }
}

function getStatusTone(status: ViewingStatus) {
  switch (status) {
    case "PAID":
      return "paid";
    case "ASSIGNED":
      return "assigned";
    case "CONFIRMED":
      return "confirmed";
    case "COMPLETED":
      return "completed";
    case "CANCELLED":
    case "DECLINED":
      return "danger";
    case "PENDING_PAYMENT":
      return "pending";
    default:
      return "neutral";
  }
}

function getPrimaryPayment(viewing?: Viewing | null) {
