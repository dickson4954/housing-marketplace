export default function AdminViewingsScreen() {
  const [viewings, setViewings] = useState<Viewing[]>([]);
  const [selectedViewing, setSelectedViewing] =
    useState<Viewing | null>(null);

  const [filter, setFilter] = useState<Filter>("ALL");
  const [search, setSearch] = useState("");

  const [loading, setLoading] = useState(true);
  const [refreshing, setRefreshing] = useState(false);
  const [detailLoading, setDetailLoading] = useState(false);
  const [approving, setApproving] = useState(false);
  const [error, setError] = useState<string | null>(null);

  const [sidebarOpen, setSidebarOpen] = useState(false);

  const loadViewings = useCallback(async () => {
    try {
      setError(null);

      const response = await apiRequest<ApiResponse>(
        "/admin/viewings"
      );

      setViewings(response.data?.viewings || []);
    } catch (err) {
      const message =
        err instanceof Error
          ? err.message
          : "Failed to load viewings";

      setError(message);
    } finally {
      setLoading(false);
      setRefreshing(false);
    }
  }, []);

  useEffect(() => {
    loadViewings();
  }, [loadViewings]);

  const refresh = useCallback(async () => {
    setRefreshing(true);
    await loadViewings();
  }, [loadViewings]);

  const openViewing = useCallback(async (viewing: Viewing) => {
    setSelectedViewing(viewing);
    setDetailLoading(true);

    try {
      const response = await apiRequest<ApiResponse>(
        `/admin/viewings/${viewing.id}`
      );

      if (response.data?.viewing) {
        setSelectedViewing(response.data.viewing);
      }
    } catch (err) {
      const message =
        err instanceof Error
          ? err.message
          : "Failed to load viewing details";

      Alert.alert("Unable to load viewing", message);
    } finally {
      setDetailLoading(false);
    }
  }, []);

  const approveViewing = useCallback(async () => {
    if (!selectedViewing) {
      return;
    }

    if (selectedViewing.status !== "PAID") {
      Alert.alert(
        "Cannot approve",
        "Only paid viewing requests can be approved."
      );
      return;
    }

    Alert.alert(
      "Approve viewing?",
      "The backend will automatically assign the marketer who sourced this property. The customer will receive the representative contact, and the marketer will receive the customer contact so they can coordinate the viewing.",
      [
        {
          text: "Cancel",
          style: "cancel",
        },
        {
          text: "Approve",
          onPress: async () => {
            try {
              setApproving(true);

              const response =
                await apiRequest<ApiResponse>(
                  `/admin/viewings/${selectedViewing.id}/approve`,
                  {
                    method: "POST",
                  }
                );

              const updated =
                response.data?.viewing;

              if (updated) {
                setSelectedViewing(updated);

                setViewings((current) =>
                  current.map((item) =>
                    item.id === updated.id
                      ? {
                          ...item,
                          ...updated,
                        }
                      : item
                  )
                );
              } else {
                await loadViewings();
              }

              Alert.alert(
                "Viewing approved",
                response.message ||
                  "The viewing has been approved and the source marketer has been assigned."
              );
            } catch (err) {
              const message =
                err instanceof Error
                  ? err.message
                  : "Failed to approve viewing";

              Alert.alert(
                "Approval failed",
                message
              );
            } finally {
              setApproving(false);
            }
          },
        },
      ]
    );
  }, [selectedViewing, loadViewings]);

  const counts = useMemo(() => {
    const count = (status: string) =>
      viewings.filter(
        (item) => item.status === status
      ).length;

    return {
      total: viewings.length,
      paid: count("PAID"),
      assigned: count("ASSIGNED"),
      confirmed: count("CONFIRMED"),
      completed: count("COMPLETED"),
      pendingPayment: count("PENDING_PAYMENT"),
      cancelled: count("CANCELLED"),
      declined: count("DECLINED"),
    };
  }, [viewings]);

  const filteredViewings = useMemo(() => {
    const query = search.trim().toLowerCase();

    return viewings.filter((viewing) => {
      const matchesFilter =
        filter === "ALL" ||
        viewing.status === filter;

      if (!matchesFilter) {
        return false;
      }

      if (!query) {
        return true;
      }

      const propertyName =
        viewing.property?.title || "";

      const customerName =
        getPersonName(viewing.renter);

      const marketerName =
        getMarketerName(viewing.assignedMarketer);

      const location =
        getPropertyLocation(viewing.property);

      const haystack = [
        viewing.id,
        propertyName,
        customerName,
        viewing.renter?.phone || "",
        viewing.renter?.email || "",
        marketerName,
        location,
        viewing.status,
      ]
        .join(" ")
        .toLowerCase();

      return haystack.includes(query);
    });
  }, [viewings, filter, search]);

  const navigate = (path: string) => {
    setSidebarOpen(false);
    router.push(path as never);
  };

  return (
    <View style={styles.screen}>
      {Dimensions.get("window").width >= 900 && (
        <View style={styles.desktopSidebar}>
          <SidebarContent navigate={navigate} />
        </View>
      )}

      {sidebarOpen && (
        <Modal
          visible
          animationType="fade"
          transparent
          onRequestClose={() => setSidebarOpen(false)}
        >
          <View style={styles.mobileSidebarOverlay}>
            <View style={styles.mobileSidebar}>
              <View style={styles.mobileSidebarHeader}>
                <Text style={styles.mobileSidebarTitle}>
                  MAKAZII
                </Text>

                <Pressable
                  onPress={() => setSidebarOpen(false)}
                  style={styles.iconButton}
                >
                  <X size={20} color="#F5F7F7" />
                </Pressable>
              </View>

              <SidebarContent navigate={navigate} />
            </View>
          </View>
        </Modal>
      )}

      <View style={styles.main}>
        <View style={styles.header}>
          <View style={styles.headerLeft}>
            <Pressable
              onPress={() => setSidebarOpen(true)}
              style={styles.mobileMenuButton}
            >
              <Menu size={21} color="#F5F7F7" />
            </Pressable>

            <Pressable
              onPress={() => router.replace("/admin/dashboard" as never)}
              style={styles.backButton}
              accessibilityRole="button"
              accessibilityLabel="Back to Admin Dashboard"
            >
              <ArrowLeft size={18} color="#D7FF5F" />
              <Text style={styles.backButtonText}>Back to Dashboard</Text>
            </Pressable>

            <View>
              <Text style={styles.pageTitle}>Viewings</Text>
              <Text style={styles.pageSubtitle}>
                Manage paid viewing requests, approvals, and representative assignments
              </Text>
            </View>
          </View>

          <Pressable
            onPress={refresh}
            style={styles.refreshButton}
            disabled={refreshing}
          >
            {refreshing ? (
              <ActivityIndicator
                size="small"
                color="#D7FF5F"
              />
            ) : (
              <RefreshCw
                size={17}
                color="#D7FF5F"
              />
            )}

            <Text style={styles.refreshText}>
              Refresh
            </Text>
          </Pressable>
        </View>

        <ScrollView
          style={styles.content}
          contentContainerStyle={styles.contentContainer}
          refreshControl={
            <RefreshControl
              refreshing={refreshing}
              onRefresh={refresh}
              tintColor="#D7FF5F"
            />
          }
        >
          <View style={styles.workflowBanner}>
            <View style={styles.workflowIcon}>
              <ShieldCheck
                size={20}
                color="#D7FF5F"
              />
            </View>

            <View style={styles.workflowText}>
              <Text style={styles.workflowTitle}>
                Admin approval controls representative assignment
              </Text>

              <Text style={styles.workflowDescription}>
                Only PAID viewing requests can be approved. Once approved,
                the backend automatically assigns the marketer who sourced
                the property and notifies both sides.
              </Text>
            </View>
          </View>

          <View style={styles.statsGrid}>
            <StatCard
              label="Total"
              value={counts.total}
              icon={Eye}
              onPress={() => setFilter("ALL")}
            />

            <StatCard
              label="Paid · awaiting approval"
              value={counts.paid}
              icon={CheckCircle2}
              onPress={() => setFilter("PAID")}
            />

            <StatCard
              label="Assigned"
              value={counts.assigned}
              icon={ShieldCheck}
              onPress={() => setFilter("ASSIGNED")}
            />

            <StatCard
              label="Confirmed"
              value={counts.confirmed}
              icon={CheckCircle2}
              onPress={() => setFilter("CONFIRMED")}
            />

            <StatCard
              label="Completed"
              value={counts.completed}
              icon={CheckCircle2}
              onPress={() => setFilter("COMPLETED")}
            />

            <StatCard
              label="Pending payment"
              value={counts.pendingPayment}
              icon={Clock3}
              onPress={() => setFilter("PENDING_PAYMENT")}
            />
          </View>

          <View style={styles.toolbar}>
            <View style={styles.searchWrap}>
              <Search
                size={18}
                color="#727C7F"
              />

              <TextInput
                value={search}
                onChangeText={setSearch}
                placeholder="Search customer, property, phone, marketer..."
                placeholderTextColor="#667073"
                style={styles.searchInput}
              />

              {search.length > 0 && (
                <Pressable
                  onPress={() => setSearch("")}
