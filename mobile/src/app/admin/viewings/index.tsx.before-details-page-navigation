                      <UserRound
                        size={21}
                        color="#D7FF5F"
                      />
                    </View>

                    <View
                      style={
                        styles.contactMain
                      }
                    >
                      <Text
                        style={styles.contactName}
                      >
                        {getPersonName(
                          selectedViewing.renter
