function getNotificationCategory(
  type: string,
  entityType?: string | null,
): NotificationCategory {
  if (
    type.startsWith('VIEWING_') ||
    entityType === 'VIEWING'
  ) {
    return 'Viewing';
  }

  if (
    type.startsWith('INSPECTION_') ||
    entityType === 'STAY_INSPECTION'
  ) {
    return 'Viewing';
  }

  if (
    type.startsWith('PROPERTY_') ||
    entityType === 'PROPERTY'
  ) {
    return type === 'PROPERTY_APPROVED' ||
      type === 'PROPERTY_CHANGES_REQUIRED' ||
      type === 'PROPERTY_REJECTED'
      ? 'Verification'
      : 'Property';
  }

  if (
    type.startsWith('BOOKING_') ||
    entityType === 'BOOKING'
  ) {
    return 'Property';
  }

  if (
    type === 'PAYMENT_SUCCESS' ||
    type === 'PAYMENT_FAILED'
  ) {
    return 'System';
  }

  if (type.includes('MARKETER')) {
    return 'Marketer';
  }

  return 'System';
}

function getNotificationPriority(
  type: string,
): NotificationPriority {
  switch (type) {
    case 'VIEWING_REQUESTED':
    case 'VIEWING_PAID':
    case 'INSPECTION_REQUESTED':
    case 'INSPECTION_PAID':
    case 'PROPERTY_CHANGES_REQUIRED':
    case 'PROPERTY_REJECTED':
    case 'PAYMENT_FAILED':
      return 'Important';

    case 'PROPERTY_APPROVED':
    case 'INSPECTION_ASSIGNED':
    case 'VIEWING_ASSIGNED':
      return 'Normal';

    default:
      return 'Normal';
  }
}

function formatNotificationTime(createdAt: string) {
  const created = new Date(createdAt);
  const now = new Date();

  const diffMs = Math.max(0, now.getTime() - created.getTime());
  const diffMinutes = Math.floor(diffMs / 60000);

  if (diffMinutes < 1) {
    return 'Just now';
  }

  if (diffMinutes < 60) {
    return `${diffMinutes} min ago`;
  }

  const diffHours = Math.floor(diffMinutes / 60);

  if (diffHours < 24) {
    return `${diffHours} hr${diffHours === 1 ? '' : 's'} ago`;
  }

  const diffDays = Math.floor(diffHours / 24);

  if (diffDays === 1) {
    return 'Yesterday';
  }

  if (diffDays < 7) {
    return `${diffDays} days ago`;
  }

  return created.toLocaleDateString();
}

function getNotificationDateLabel(createdAt: string) {
  const created = new Date(createdAt);
  const now = new Date();

  const createdDate = new Date(
    created.getFullYear(),
    created.getMonth(),
    created.getDate(),
  );

  const todayDate = new Date(
    now.getFullYear(),
    now.getMonth(),
    now.getDate(),
  );

  const diffDays = Math.round(
    (todayDate.getTime() - createdDate.getTime()) /
      (1000 * 60 * 60 * 24),
  );

  if (diffDays === 0) {
    return 'Today';
  }

  if (diffDays === 1) {
    return 'Yesterday';
  }

  return 'Earlier';
}

function mapBackendNotification(
  notification: BackendNotification,
): NotificationItem {
  return {
    id: notification.id,
    category: getNotificationCategory(
      notification.type,
      notification.entityType,
    ),
    title: notification.title,
    message: notification.message,
    time: formatNotificationTime(notification.createdAt),
    dateLabel: getNotificationDateLabel(notification.createdAt),
    read: notification.readAt !== null,
    priority: getNotificationPriority(notification.type),
    relatedId: notification.entityId || undefined,
    createdAt: notification.createdAt,
  };
}

