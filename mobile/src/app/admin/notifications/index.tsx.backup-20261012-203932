export default function NotificationsPage() {
  const router = useRouter();
  const { width } = useWindowDimensions();

  const isDesktop = width >= 900;

  const [notifications, setNotifications] = useState<
    NotificationItem[]
  >([]);

  const [filter, setFilter] = useState<FilterValue>('All');
  const [search, setSearch] = useState('');
  const [mobileMenuOpen, setMobileMenuOpen] = useState(false);
  const [selectedNotification, setSelectedNotification] =
    useState<NotificationItem | null>(null);

  const [loading, setLoading] = useState(true);
  const [actionLoading, setActionLoading] = useState(false);

  const unreadCount = notifications.filter(
    (item) => !item.read,
  ).length;

  const todayCount = notifications.filter(
    (item) => item.dateLabel === 'Today',
  ).length;

  const importantCount = notifications.filter(
    (item) =>
      item.priority === 'Important' ||
      item.priority === 'Urgent',
  ).length;

  const loadNotifications = async () => {
    try {
      const token = await SecureStore.getItemAsync(
        'makazii_admin_token',
      );

      if (!token) {
        router.replace('/admin/login' as any);
        return;
      }

      const response = await fetch(
        `${API_BASE_URL}/admin/notifications`,
        {
          headers: {
            Authorization: `Bearer ${token}`,
          },
        },
      );

      if (response.status === 401 || response.status === 403) {
        await SecureStore.deleteItemAsync(
          'makazii_admin_token',
        );
        router.replace('/admin/login' as any);
        return;
      }

      const result: NotificationsResponse =
        await response.json();

      if (!response.ok || !result.success) {
        throw new Error(
          result.message || 'Failed to load notifications',
        );
      }

      setNotifications(
        (result.data?.notifications || []).map(
          mapBackendNotification,
        ),
      );
    } catch (error) {
      console.error(
        'Failed to load admin notifications:',
        error,
      );
    } finally {
      setLoading(false);
    }
  };

  useEffect(() => {
    loadNotifications();
  }, []);

  const filteredNotifications = useMemo(() => {
    const normalizedSearch = search.trim().toLowerCase();

    return notifications.filter((notification) => {
      const matchesFilter =
        filter === 'All'
          ? true
          : filter === 'Unread'
            ? !notification.read
            : notification.category === filter;

      if (!matchesFilter) {
        return false;
      }

      if (!normalizedSearch) {
        return true;
      }

      return (
        notification.title.toLowerCase().includes(normalizedSearch) ||
        notification.message.toLowerCase().includes(normalizedSearch) ||
        notification.category
          .toLowerCase()
          .includes(normalizedSearch) ||
        notification.relatedId
          ?.toLowerCase()
          .includes(normalizedSearch)
      );
    });
  }, [notifications, filter, search]);

  const handleNavigate = (route: string) => {
    setMobileMenuOpen(false);

    if (route === '/admin/login') {
      router.replace(route as any);
      return;
    }

    router.push(route as any);
  };

  const toggleRead = async (id: string) => {
    const notification = notifications.find(
      (item) => item.id === id,
    );

    if (!notification || notification.read || actionLoading) {
      return;
    }

    try {
      setActionLoading(true);

      const token = await SecureStore.getItemAsync(
        'makazii_admin_token',
      );

      if (!token) {
        router.replace('/admin/login' as any);
        return;
      }

      const response = await fetch(
        `${API_BASE_URL}/admin/notifications/${id}/read`,
        {
          method: 'PATCH',
          headers: {
            Authorization: `Bearer ${token}`,
          },
        },
      );

      if (!response.ok) {
        throw new Error('Failed to mark notification as read');
      }

      setNotifications((current) =>
        current.map((item) =>
          item.id === id
            ? {
                ...item,
                read: true,
              }
            : item,
        ),
      );

      setSelectedNotification((current) =>
        current?.id === id
          ? {
              ...current,
              read: true,
            }
          : current,
      );
    } catch (error) {
      console.error(
        'Failed to mark notification as read:',
        error,
      );
    } finally {
      setActionLoading(false);
    }
  };

  const markAllRead = async () => {
    if (unreadCount === 0 || actionLoading) {
      return;
    }

    try {
      setActionLoading(true);

      const token = await SecureStore.getItemAsync(
        'makazii_admin_token',
      );

      if (!token) {
        router.replace('/admin/login' as any);
        return;
      }

      const response = await fetch(
        `${API_BASE_URL}/admin/notifications/read-all`,
        {
          method: 'PATCH',
          headers: {
            Authorization: `Bearer ${token}`,
          },
        },
      );

      if (!response.ok) {
        throw new Error(
          'Failed to mark all notifications as read',
        );
      }

      setNotifications((current) =>
        current.map((item) => ({
          ...item,
          read: true,
        })),
      );

      setSelectedNotification((current) =>
        current
          ? {
              ...current,
              read: true,
            }
          : current,
      );
    } catch (error) {
      console.error(
        'Failed to mark all notifications as read:',
        error,
      );
    } finally {
      setActionLoading(false);
    }
  };

  const markSelectedRead = async () => {
    if (!selectedNotification) {
      return;
    }

    if (selectedNotification.read) {
      return;
    }

    await toggleRead(selectedNotification.id);
  };

  const removeNotification = async (id: string) => {
    if (actionLoading) {
      return;
    }

    try {
      setActionLoading(true);

      const token = await SecureStore.getItemAsync(
        'makazii_admin_token',
      );

      if (!token) {
        router.replace('/admin/login' as any);
        return;
      }

      const response = await fetch(
        `${API_BASE_URL}/admin/notifications/${id}`,
        {
          method: 'DELETE',
          headers: {
            Authorization: `Bearer ${token}`,
          },
        },
      );

      if (!response.ok) {
        throw new Error('Failed to remove notification');
      }

      setNotifications((current) =>
        current.filter((item) => item.id !== id),
      );

      setSelectedNotification(null);
    } catch (error) {
      console.error(
        'Failed to remove notification:',
        error,
      );
    } finally {
      setActionLoading(false);
    }
  };

  return (
    <View style={styles.screen}>
      {isDesktop ? (
        <View style={styles.sidebar}>
          <SidebarContent
            activeRoute="/admin/notifications"
            onNavigate={handleNavigate}
          />
        </View>
      ) : null}

      {!isDesktop && mobileMenuOpen ? (
        <View style={styles.mobileSidebarOverlay}>
          <Pressable
            style={styles.mobileBackdrop}
            onPress={() => setMobileMenuOpen(false)}
          />

          <View style={styles.mobileSidebar}>
            <SidebarContent
              activeRoute="/admin/notifications"
              onNavigate={handleNavigate}
            />
          </View>
        </View>
      ) : null}

      <View style={styles.main}>
        <View style={styles.topbar}>
          <View style={styles.topbarLeft}>
            {!isDesktop ? (
              <Pressable
                onPress={() => setMobileMenuOpen(true)}
                style={styles.menuButton}
              >
                <Menu size={21} color={COLORS.white} />
              </Pressable>
            ) : null}

            <View>
              <Text style={styles.topbarEyebrow}>
                MAKAZII / TEAM PORTAL
              </Text>

              <Text style={styles.topbarTitle}>
                Notifications
              </Text>
            </View>
          </View>

          <View style={styles.topbarRight}>
            <Pressable
              onPress={() => router.push('/admin/notifications' as any)}
              style={styles.topbarBell}
            >
              <Bell size={19} color={COLORS.white} />

              {unreadCount > 0 ? (
                <View style={styles.topbarBellBadge}>
                  <Text style={styles.topbarBellBadgeText}>
                    {unreadCount > 9 ? '9+' : unreadCount}
                  </Text>
                </View>
              ) : null}
            </Pressable>

            <View style={styles.topbarAvatar}>
              <Text style={styles.topbarAvatarText}>A</Text>
            </View>
          </View>
        </View>

        <ScrollView
          showsVerticalScrollIndicator={false}
          contentContainerStyle={[
            styles.content,
            !isDesktop && styles.contentMobile,
          ]}
        >
          <View style={styles.pageHeader}>
            <View style={styles.pageHeaderText}>
              <View style={styles.pageKicker}>
                <View style={styles.kickerLine} />
                <Text style={styles.kickerText}>
                  NOTIFICATION CENTER
                </Text>
              </View>

              <Text style={styles.pageTitle}>
                Stay on top of the platform.
              </Text>

              <Text style={styles.pageDescription}>
                Review viewing requests, property activity,
                verification updates and important team events
                from one place.
              </Text>
            </View>

            <Pressable
              onPress={markAllRead}
              style={[
                styles.markAllButton,
                unreadCount === 0 && styles.markAllButtonDisabled,
              ]}
              disabled={unreadCount === 0}
            >
              <CheckCheck
                size={17}
                color={
                  unreadCount === 0
                    ? COLORS.sidebarText
                    : COLORS.lime
                }
              />

              <Text
                style={[
                  styles.markAllText,
                  unreadCount === 0 &&
                    styles.markAllTextDisabled,
                ]}
              >
                Mark all read
              </Text>
            </Pressable>
          </View>

          <View
            style={[
              styles.statsGrid,
              !isDesktop && styles.statsGridMobile,
            ]}
          >
            <StatCard
              label="Unread"
              value={String(unreadCount)}
              detail="Needs your attention"
              icon={Bell}
              accent
            />

            <StatCard
              label="Today"
              value={String(todayCount)}
              detail="Activity received today"
              icon={Clock3}
            />

            <StatCard
              label="Important"
              value={String(importantCount)}
              detail="Priority notifications"
              icon={AlertTriangle}
            />

            <StatCard
              label="Total"
              value={String(notifications.length)}
              detail="All recent activity"
              icon={CheckCheck}
            />
          </View>

          <View style={styles.toolbar}>
            <View style={styles.searchBox}>
              <Search size={18} color={COLORS.sidebarText} />

              <TextInput
                value={search}
                onChangeText={setSearch}
                placeholder="Search notifications..."
                placeholderTextColor={COLORS.sidebarText}
                style={styles.searchInput}
              />

              {search.length > 0 ? (
                <Pressable
                  onPress={() => setSearch('')}
                  style={styles.clearSearch}
                >
                  <X size={16} color={COLORS.muted} />
                </Pressable>
              ) : null}
            </View>

            <View style={styles.filterScroller}>
              <ScrollView
                horizontal
                showsHorizontalScrollIndicator={false}
                contentContainerStyle={styles.filterRow}
              >
                {CATEGORY_FILTERS.map((item) => {
                  const active = filter === item;

                  return (
                    <Pressable
                      key={item}
                      onPress={() => setFilter(item)}
                      style={[
                        styles.filterButton,
                        active && styles.filterButtonActive,
                      ]}
                    >
                      <Text
                        style={[
                          styles.filterText,
                          active && styles.filterTextActive,
                        ]}
                      >
                        {item}
                      </Text>

                      {item === 'Unread' && unreadCount > 0 ? (
                        <View
                          style={[
                            styles.filterCount,
                            active &&
                              styles.filterCountActive,
                          ]}
                        >
                          <Text
                            style={[
                              styles.filterCountText,
                              active &&
                                styles.filterCountTextActive,
                            ]}
                          >
                            {unreadCount}
                          </Text>
                        </View>
                      ) : null}
                    </Pressable>
                  );
                })}
              </ScrollView>
            </View>
          </View>

          <View style={styles.listCard}>
            <View style={styles.listHeader}>
              <View>
                <Text style={styles.listTitle}>
                  Recent activity
                </Text>

                <Text style={styles.listSubtitle}>
                  {filteredNotifications.length} notification
                  {filteredNotifications.length === 1 ? '' : 's'}
                  {' '}shown
                </Text>
              </View>

              <View style={styles.listHeaderStatus}>
                <View style={styles.liveDot} />
                <Text style={styles.liveText}>BACKEND FEED</Text>
              </View>
            </View>

            {loading ? (
              <View style={styles.emptyState}>
                <View style={styles.emptyIcon}>
                  <Bell size={25} color={COLORS.lime} />
                </View>

                <Text style={styles.emptyTitle}>
                  Loading notifications
                </Text>

                <Text style={styles.emptyMessage}>
                  Checking the Makazii notification center for new
                  activity.
                </Text>
              </View>
            ) : filteredNotifications.length === 0 ? (
              <EmptyState />
            ) : (
              <View style={styles.notificationList}>
                {filteredNotifications.map((notification) => (
                  <NotificationRow
                    key={notification.id}
                    notification={notification}
                    onPress={() =>
                      setSelectedNotification(notification)
                    }
                    onToggleRead={() =>
                      toggleRead(notification.id)
                    }
                  />
                ))}
              </View>
            )}
          </View>

          <View style={styles.bottomNotice}>
            <View style={styles.bottomNoticeIcon}>
              <ShieldCheck size={18} color={COLORS.lime} />
            </View>

            <View style={styles.bottomNoticeContent}>
              <Text style={styles.bottomNoticeTitle}>
                Notification privacy
              </Text>

              <Text style={styles.bottomNoticeText}>
                Notifications are part of the internal Makazii
                team portal. Customer and landlord contact
                information should only be exposed according to
                the platform's approved workflow.
              </Text>
            </View>
          </View>

          <Text style={styles.footerText}>
            MAKAZII · TEAM PORTAL
          </Text>
        </ScrollView>
      </View>

      <Modal
        visible={selectedNotification !== null}
        transparent
        animationType="fade"
        onRequestClose={() => setSelectedNotification(null)}
      >
        <View style={styles.modalBackdrop}>
          <Pressable
            style={StyleSheet.absoluteFill}
            onPress={() => setSelectedNotification(null)}
          />

          {selectedNotification ? (
            <View
              style={[
                styles.detailsModal,
                isDesktop
                  ? styles.detailsModalDesktop
                  : styles.detailsModalMobile,
              ]}
            >
              <View style={styles.modalHeader}>
                <View style={styles.modalHeaderLeft}>
                  <View
                    style={[
                      styles.modalIcon,
                      {
                        borderColor: `${getCategoryIconColor(
                          selectedNotification.category,
                        )}45`,
                      },
                    ]}
                  >
                    {React.createElement(
                      getCategoryIcon(
                        selectedNotification.category,
                      ),
                      {
                        size: 21,
                        color: getCategoryIconColor(
                          selectedNotification.category,
                        ),
                      },
                    )}
                  </View>

                  <View style={styles.modalTitleArea}>
                    <Text style={styles.modalEyebrow}>
                      {selectedNotification.category.toUpperCase()}
                    </Text>

                    <Text style={styles.modalTitle}>
                      {selectedNotification.title}
                    </Text>
                  </View>
                </View>

                <Pressable
                  onPress={() => setSelectedNotification(null)}
                  style={styles.closeButton}
                >
                  <X size={20} color={COLORS.muted} />
                </Pressable>
              </View>

              <ScrollView
                showsVerticalScrollIndicator={false}
                contentContainerStyle={styles.modalScroll}
              >
                <View style={styles.modalStatusRow}>
                  <View
                    style={[
                      styles.modalStatus,
                      selectedNotification.read
                        ? styles.modalStatusRead
                        : styles.modalStatusUnread,
                    ]}
                  >
                    <View
                      style={[
                        styles.modalStatusDot,
                        selectedNotification.read
                          ? styles.modalStatusDotRead
                          : styles.modalStatusDotUnread,
                      ]}
                    />

                    <Text
                      style={[
                        styles.modalStatusText,
                        selectedNotification.read
                          ? styles.modalStatusTextRead
                          : styles.modalStatusTextUnread,
                      ]}
                    >
                      {selectedNotification.read
                        ? 'Read'
                        : 'Unread'}
                    </Text>
                  </View>

                  <PriorityBadge
                    priority={selectedNotification.priority}
                  />

                  <Text style={styles.modalTime}>
                    {selectedNotification.time}
                  </Text>
                </View>

                <View style={styles.modalMessageCard}>
                  <Text style={styles.modalMessage}>
                    {selectedNotification.message}
                  </Text>
                </View>

                <View style={styles.detailGrid}>
                  <View style={styles.detailItem}>
                    <Text style={styles.detailLabel}>
                      Notification ID
                    </Text>
                    <Text style={styles.detailValue}>
                      {selectedNotification.id}
                    </Text>
                  </View>

                  <View style={styles.detailItem}>
                    <Text style={styles.detailLabel}>
                      Date
                    </Text>
                    <Text style={styles.detailValue}>
                      {selectedNotification.dateLabel}
                    </Text>
                  </View>

                  <View style={styles.detailItem}>
                    <Text style={styles.detailLabel}>
                      Category
                    </Text>
                    <Text style={styles.detailValue}>
                      {selectedNotification.category}
                    </Text>
                  </View>

                  <View style={styles.detailItem}>
                    <Text style={styles.detailLabel}>
                      Related record
                    </Text>
                    <Text style={styles.detailValue}>
                      {selectedNotification.relatedId || '—'}
                    </Text>
                  </View>
                </View>

                <View style={styles.demoBox}>
                  <View style={styles.demoBoxIcon}>
                    <Info size={17} color={COLORS.lime} />
                  </View>

                  <View style={styles.demoBoxContent}>
                    <Text style={styles.demoBoxTitle}>
                      Backend notification
                    </Text>

                    <Text style={styles.demoBoxText}>
                      This notification was loaded from the
                      Makazii backend and stored in the platform
                      notification system.
                    </Text>
                  </View>
                </View>
              </ScrollView>

              <View style={styles.modalActions}>
                <Pressable
                  onPress={() =>
                    removeNotification(selectedNotification.id)
                  }
                  style={styles.deleteButton}
                >
                  <Text style={styles.deleteButtonText}>
                    Remove
                  </Text>
                </Pressable>

                <Pressable
                  onPress={markSelectedRead}
                  style={styles.primaryModalButton}
                >
                  <Check size={17} color={COLORS.background} />

                  <Text style={styles.primaryModalButtonText}>
                    {selectedNotification.read
                      ? 'Already read'
                      : 'Mark as read'}
                  </Text>
                </Pressable>
              </View>
            </View>
          ) : null}
        </View>
      </Modal>
    </View>
  );
}

