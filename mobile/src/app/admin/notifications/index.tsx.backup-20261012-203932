  switch (category) {
    case 'Viewing':
      return CalendarDays;
    case 'Property':
      return Building2;
    case 'Verification':
      return ShieldCheck;
    case 'Landlord':
      return UserRound;
    case 'Marketer':
      return Megaphone;
    case 'Team':
