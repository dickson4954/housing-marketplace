import React, { useEffect, useMemo, useState } from 'react';
import {
  ActivityIndicator,
  Alert,
  Image,
  Platform,
  Pressable,
  ScrollView,
  StyleSheet,
  Text,
  TextInput,
  useWindowDimensions,
  View,
} from 'react-native';
import { SafeAreaView } from 'react-native-safe-area-context';
import { router } from 'expo-router';
import {
  ArrowLeft,
  Check,
  ChevronDown,
  ImagePlus,
  Plus,
  Save,
  Trash2,
  X,
} from 'lucide-react-native';
import * as SecureStore from 'expo-secure-store';
import { API_BASE_URL, API_ENDPOINTS } from '@/config/api';

const COLORS = {
  background: '#080B0C',
  sidebar: '#0E1314',
  card: '#121718',
  cardSoft: '#1A2122',
  lime: '#D7FF5F',
  white: '#FFFFFF',
  muted: '#9CA5A7',
  mutedDark: '#657073',
  border: '#252C2E',
  green: '#7BE495',
  red: '#FF6B6B',
  orange: '#FFC857',
};

type PropertyType =
  | 'SINGLE_ROOM'
  | 'BEDSITTER'
  | 'ONE_BEDROOM'
  | 'TWO_BEDROOM'
  | 'THREE_BEDROOM';

type County = {
  id: string;
  name: string;
  sourceId?: string | null;
};

type Constituency = {
  id: string;
  name: string;
  countyId?: string;
};

type Ward = {
  id: string;
  name: string;
  constituencyId?: string;
};

type Amenity = {
  id: string;
  name: string;
};

type PropertyImage = {
  id: string;
  uri: string;
};

const PROPERTY_TYPES: Array<{
  value: PropertyType;
  label: string;
}> = [
  {
    value: 'SINGLE_ROOM',
    label: 'Single Room',
  },
  {
    value: 'BEDSITTER',
    label: 'Bedsitter',
  },
  {
    value: 'ONE_BEDROOM',
    label: '1 Bedroom',
  },
  {
    value: 'TWO_BEDROOM',
    label: '2 Bedroom',
  },
  {
    value: 'THREE_BEDROOM',
    label: '3 Bedroom',
  },
];

const ADMIN_TOKEN_KEY = 'makazii_admin_token';

async function getAdminToken(): Promise<string | null> {
  if (Platform.OS === 'web') {
    if (typeof window === 'undefined') {
      return null;
    }

    return window.localStorage.getItem(
      ADMIN_TOKEN_KEY,
    );
  }

  return SecureStore.getItemAsync(
    ADMIN_TOKEN_KEY,
  );
}

function getErrorMessage(
  error: unknown,
): string {
  if (error instanceof Error) {
    return error.message;
  }

  return 'Something went wrong. Please try again.';
}

async function parseResponse(
  response: Response,
) {
  const text = await response.text();

  let data: any = null;

  try {
    data = text ? JSON.parse(text) : null;
  } catch {
    data = null;
  }

  if (!response.ok) {
    throw new Error(
      data?.message ||
        data?.error ||
        `Request failed with status ${response.status}.`,
    );
  }

  return data;
}

export default function AdminAddPropertyPage() {
  const { width } = useWindowDimensions();

  const isDesktop = width >= 1000;

  const [loading, setLoading] = useState(true);
  const [saving, setSaving] = useState(false);

  const [counties, setCounties] = useState<
    County[]
  >([]);

  const [constituencies, setConstituencies] =
    useState<Constituency[]>([]);

  const [wards, setWards] = useState<Ward[]>(
    [],
  );

  const [amenities, setAmenities] = useState<
    Amenity[]
  >([]);

  const [loadingConstituencies, setLoadingConstituencies] =
    useState(false);

  const [loadingWards, setLoadingWards] =
    useState(false);

  const [loadingAmenities, setLoadingAmenities] =
    useState(false);

  const [title, setTitle] = useState('');
  const [propertyType, setPropertyType] =
    useState<PropertyType | null>(null);

  const [rent, setRent] = useState('');
  const [viewingFee, setViewingFee] =
    useState('');
  const [deposit, setDeposit] = useState('');

  const [bedrooms, setBedrooms] =
    useState('');
  const [bathrooms, setBathrooms] =
    useState('');

  const [description, setDescription] =
    useState('');

  const [selectedCountyId, setSelectedCountyId] =
    useState('');

  const [
    selectedConstituencyId,
    setSelectedConstituencyId,
  ] = useState('');

  const [selectedWardId, setSelectedWardId] =
    useState('');

  const [selectedAmenityIds, setSelectedAmenityIds] =
    useState<string[]>([]);

  const [images, setImages] = useState<
    PropertyImage[]
  >([]);

  const [typeOpen, setTypeOpen] =
    useState(false);

  const [countyOpen, setCountyOpen] =
    useState(false);

  const [
    constituencyOpen,
    setConstituencyOpen,
  ] = useState(false);

  const [wardOpen, setWardOpen] =
    useState(false);

  const selectedCounty = useMemo(
    () =>
      counties.find(
        (item) =>
          item.id === selectedCountyId,
      ) ?? null,
    [counties, selectedCountyId],
  );

  const selectedConstituency = useMemo(
    () =>
      constituencies.find(
        (item) =>
          item.id ===
          selectedConstituencyId,
      ) ?? null,
    [
      constituencies,
      selectedConstituencyId,
    ],
  );

  const selectedWard = useMemo(
    () =>
      wards.find(
        (item) =>
          item.id === selectedWardId,
      ) ?? null,
    [wards, selectedWardId],
  );

  const selectedPropertyType = useMemo(
    () =>
      PROPERTY_TYPES.find(
        (item) =>
          item.value === propertyType,
      ) ?? null,
    [propertyType],
  );

  useEffect(() => {
    loadInitialData();
  }, []);

  async function loadInitialData() {
    try {
      setLoading(true);

      const token = await getAdminToken();

      if (!token) {
        Alert.alert(
          'Session expired',
          'Please log in to the admin portal again.',
        );

        router.replace('/admin/login');
        return;
      }

      const [countyResponse, amenityResponse] =
        await Promise.all([
          fetch(
            `${API_BASE_URL}${API_ENDPOINTS.geographyCounties}`,
          ),
          fetch(
            `${API_BASE_URL}/admin/amenities`,
            {
              headers: {
                Authorization: `Bearer ${token}`,
              },
            },
          ),
        ]);

      const countyData =
        await parseResponse(countyResponse);

      const amenityData =
        await parseResponse(amenityResponse);

      const countyList =
        Array.isArray(countyData)
          ? countyData
          : countyData?.data ??
            countyData?.counties ??
            [];

      const amenityList =
        Array.isArray(amenityData)
          ? amenityData
          : amenityData?.data ??
            amenityData?.amenities ??
            [];

      setCounties(countyList);
      setAmenities(amenityList);
    } catch (error) {
      Alert.alert(
        'Unable to load form',
        getErrorMessage(error),
      );
    } finally {
      setLoading(false);
    }
  }

  async function loadConstituencies(
    countyId: string,
  ) {
    try {
      setLoadingConstituencies(true);

      const response = await fetch(
        `${API_BASE_URL}${API_ENDPOINTS.geographyConstituencies(
          countyId,
        )}`,
      );

      const data =
        await parseResponse(response);

      const list =
        Array.isArray(data)
          ? data
          : data?.data ??
            data?.constituencies ??
            [];

      setConstituencies(list);
    } catch (error) {
      setConstituencies([]);

      Alert.alert(
        'Unable to load constituencies',
        getErrorMessage(error),
      );
    } finally {
      setLoadingConstituencies(false);
    }
  }

  async function loadWards(
    constituencyId: string,
  ) {
    try {
      setLoadingWards(true);

      const response = await fetch(
        `${API_BASE_URL}${API_ENDPOINTS.geographyWards(
          constituencyId,
        )}`,
      );

      const data =
        await parseResponse(response);

      const list =
        Array.isArray(data)
          ? data
          : data?.data ??
            data?.wards ??
            [];

      setWards(list);
    } catch (error) {
      setWards([]);

      Alert.alert(
        'Unable to load wards',
        getErrorMessage(error),
      );
    } finally {
      setLoadingWards(false);
    }
  }

  function handleCountyChange(
    county: County,
  ) {
    setSelectedCountyId(county.id);

    setSelectedConstituencyId('');
    setSelectedWardId('');

    setConstituencies([]);
    setWards([]);

    setCountyOpen(false);
    setConstituencyOpen(false);
    setWardOpen(false);

    loadConstituencies(county.id);
  }

  function handleConstituencyChange(
    constituency: Constituency,
  ) {
    setSelectedConstituencyId(
      constituency.id,
    );

    setSelectedWardId('');
    setWards([]);

    setConstituencyOpen(false);
    setWardOpen(false);

    loadWards(constituency.id);
  }

  function handleWardChange(
    ward: Ward,
  ) {
    setSelectedWardId(ward.id);
    setWardOpen(false);
  }

  function toggleAmenity(
    amenityId: string,
  ) {
    setSelectedAmenityIds((current) =>
      current.includes(amenityId)
        ? current.filter(
            (id) => id !== amenityId,
          )
        : [...current, amenityId],
    );
  }

  function removeImage(
    imageId: string,
  ) {
    setImages((current) =>
      current.filter(
        (image) => image.id !== imageId,
      ),
    );
  }

  /*
   * Image selection is intentionally kept as a
   * separate step from property creation.
   *
   * The backend image upload endpoint requires
   * S3 configuration. Once S3 is configured,
   * this section can upload the selected files
   * and store the returned URLs.
   */
  function addImagePlaceholder() {
    Alert.alert(
      'Image upload',
      'Property image uploading will be connected to the configured S3 upload endpoint. The property form is ready for the returned image URLs.',
    );
  }

  function validateForm() {
    if (!title.trim()) {
      return 'Property title is required.';
    }

    if (!propertyType) {
      return 'Please select a property type.';
    }

    if (
      !rent.trim() ||
      Number(rent) <= 0
    ) {
      return 'Enter a valid monthly rent.';
    }

    if (
      !viewingFee.trim() ||
      Number(viewingFee) < 0
    ) {
      return 'Enter a valid viewing fee.';
    }

    if (
      !deposit.trim() ||
      Number(deposit) < 0
    ) {
      return 'Enter a valid deposit.';
    }

    if (
      !bedrooms.trim() ||
      Number(bedrooms) < 0
    ) {
      return 'Enter the number of bedrooms.';
    }

    if (
      !bathrooms.trim() ||
      Number(bathrooms) < 0
    ) {
      return 'Enter the number of bathrooms.';
    }

    if (!description.trim()) {
      return 'Property description is required.';
    }

    if (!selectedCountyId) {
      return 'Please select a county.';
    }

    if (!selectedConstituencyId) {
      return 'Please select a constituency.';
    }

    if (!selectedWardId) {
      return 'Please select one ward.';
    }

    return null;
  }

  async function saveProperty() {
    const validationError =
      validateForm();

    if (validationError) {
      Alert.alert(
        'Missing information',
        validationError,
      );
      return;
    }

    try {
      setSaving(true);

      const token = await getAdminToken();

      if (!token) {
        Alert.alert(
          'Session expired',
          'Please log in again.',
        );

        router.replace('/admin/login');
        return;
      }

      const payload = {
        title: title.trim(),
        propertyType,
        rent: Number(rent),
        viewingFee: Number(viewingFee),
        deposit: Number(deposit),
        bedrooms: Number(bedrooms),
        bathrooms: Number(bathrooms),
        description:
          description.trim(),

        countyId: selectedCountyId,
        constituencyId:
          selectedConstituencyId,
        wardId: selectedWardId,

        amenities: selectedAmenityIds,

        images: images.map(
          (image) => ({
            url: image.uri,
          }),
        ),
      };

      const response = await fetch(
        `${API_BASE_URL}/admin/properties`,
        {
          method: 'POST',
          headers: {
            'Content-Type':
              'application/json',
            Authorization: `Bearer ${token}`,
          },
          body: JSON.stringify(payload),
        },
      );

      await parseResponse(response);

      Alert.alert(
        'Property created',
        'The property has been saved as a draft.',
        [
          {
            text: 'View properties',
            onPress: () =>
              router.replace(
                '/admin/properties',
              ),
          },
          {
            text: 'Add another',
            onPress: resetForm,
          },
        ],
      );
    } catch (error) {
      Alert.alert(
        'Unable to create property',
        getErrorMessage(error),
      );
    } finally {
      setSaving(false);
    }
  }

  function resetForm() {
    setTitle('');
    setPropertyType(null);
    setRent('');
    setViewingFee('');
    setDeposit('');
    setBedrooms('');
    setBathrooms('');
    setDescription('');

    setSelectedCountyId('');
    setSelectedConstituencyId('');
    setSelectedWardId('');

    setConstituencies([]);
    setWards([]);

    setSelectedAmenityIds([]);
    setImages([]);

    setTypeOpen(false);
    setCountyOpen(false);
    setConstituencyOpen(false);
    setWardOpen(false);
  }

  function renderFieldLabel(
    label: string,
    required = true,
  ) {
    return (
      <Text style={styles.fieldLabel}>
        {label.toUpperCase()}
        {required ? ' *' : ''}
      </Text>
    );
  }

  function renderDropdown<T extends {
    id: string;
    name: string;
  }>(
    value: T | null,
    placeholder: string,
    open: boolean,
    setOpen: (
      value: boolean,
    ) => void,
    options: T[],
    onSelect: (item: T) => void,
    disabled = false,
    loadingValue = false,
  ) {
    return (
      <View style={styles.dropdownWrapper}>
        <Pressable
          disabled={disabled}
          style={[
            styles.dropdownButton,
            disabled &&
              styles.dropdownDisabled,
          ]}
          onPress={() =>
            setOpen(!open)
          }
        >
          <Text
            style={[
              styles.dropdownText,
              !value &&
                styles.dropdownPlaceholder,
            ]}
            numberOfLines={1}
          >
            {loadingValue
              ? 'Loading...'
              : value?.name ??
                placeholder}
          </Text>

          {loadingValue ? (
            <ActivityIndicator
              size="small"
              color={COLORS.muted}
            />
          ) : (
            <ChevronDown
              size={19}
              color={COLORS.muted}
            />
          )}
        </Pressable>

        {open && !disabled && (
          <View
            style={
              styles.dropdownOptions
            }
          >
            <ScrollView
              nestedScrollEnabled
              style={styles.dropdownOptionsScroll}
              showsVerticalScrollIndicator={false}
            >
              {options.length === 0 ? (
                <View
                  style={
                    styles.dropdownEmpty
                  }
                >
                  <Text
                    style={
                      styles.dropdownEmptyText
                    }
                  >
                    No options available.
                  </Text>
                </View>
              ) : (
                options.map((item) => {
                  const selected =
                    value?.id ===
                    item.id;

                  return (
                    <Pressable
                      key={item.id}
                      style={[
                        styles.dropdownOption,
                        selected &&
                          styles.dropdownOptionSelected,
                      ]}
                      onPress={() =>
                        onSelect(item)
                      }
                    >
                      <Text
                        style={[
                          styles.dropdownOptionText,
                          selected &&
                            styles.dropdownOptionTextSelected,
                        ]}
                      >
                        {item.name}
                      </Text>

                      {selected && (
                        <Check
                          size={17}
                          color={
                            COLORS.lime
                          }
                        />
                      )}
                    </Pressable>
                  );
                })
              )}
            </ScrollView>
          </View>
        )}
      </View>
    );
  }

  if (loading) {
    return (
      <SafeAreaView
        style={styles.safeArea}
      >
        <View
          style={styles.loadingScreen}
        >
          <ActivityIndicator
            size="large"
            color={COLORS.lime}
          />

          <Text
            style={styles.loadingText}
          >
            Loading property form...
          </Text>
        </View>
      </SafeAreaView>
    );
  }

  return (
    <SafeAreaView
      style={styles.safeArea}
      edges={[
        'top',
        'left',
        'right',
      ]}
    >
      <View style={styles.app}>
        <View style={styles.topBar}>
          <View
            style={styles.topBarLeft}
          >
            <Pressable
              style={styles.backButton}
              onPress={() =>
                router.back()
              }
            >
              <ArrowLeft
                size={20}
                color={COLORS.white}
              />
            </Pressable>

            <View>
              <Text
                style={styles.breadcrumb}
              >
                ADMIN / PROPERTIES
              </Text>

              <Text
                style={styles.topTitle}
              >
                Add property
              </Text>
            </View>
          </View>

          <View
            style={styles.topBarRight}
          >
            <View
              style={styles.draftBadge}
            >
              <View
                style={styles.draftDot}
              />

              <Text
                style={styles.draftText}
              >
                DRAFT
              </Text>
            </View>
          </View>
        </View>

        <ScrollView
          showsVerticalScrollIndicator={
            false
          }
          contentContainerStyle={[
            styles.page,
            isDesktop &&
              styles.pageDesktop,
          ]}
        >
          <View
            style={styles.pageHeader}
          >
            <View>
              <Text
                style={styles.eyebrow}
              >
                PROPERTY MANAGEMENT
              </Text>

              <Text
                style={styles.pageTitle}
              >
                Add a property
              </Text>

              <Text
                style={
                  styles.pageDescription
                }
              >
                Add a Makazii property from
                anywhere in Kenya. Select the
                property's county, constituency
                and one ward.
              </Text>
            </View>
          </View>

          <View
            style={[
              styles.contentGrid,
              isDesktop &&
                styles.contentGridDesktop,
            ]}
          >
            <View
              style={
                styles.mainColumn
              }
            >
              {/* BASIC INFORMATION */}
              <View
                style={styles.card}
              >
                <View
                  style={
                    styles.cardHeader
                  }
                >
                  <View
                    style={
                      styles.stepNumber
                    }
                  >
                    <Text
                      style={
                        styles.stepNumberText
                      }
                    >
                      01
                    </Text>
                  </View>

                  <View>
                    <Text
                      style={
                        styles.cardTitle
                      }
                    >
                      Property details
                    </Text>

                    <Text
                      style={
                        styles.cardSubtitle
                      }
                    >
                      Basic information about
                      the property.
                    </Text>
                  </View>
                </View>

                <View
                  style={
                    styles.formGroup
                  }
                >
                  {renderFieldLabel(
                    'Property title',
                  )}

                  <TextInput
                    value={title}
                    onChangeText={setTitle}
                    placeholder="e.g. Modern 2 Bedroom Apartment"
                    placeholderTextColor={
                      COLORS.mutedDark
                    }
                    style={
                      styles.input
                    }
                  />
                </View>

                <View
                  style={
                    styles.formGroup
                  }
                >
                  {renderFieldLabel(
                    'Property type',
                  )}

                  <Pressable
                    style={
                      styles.dropdownButton
                    }
                    onPress={() =>
                      setTypeOpen(
                        !typeOpen,
                      )
                    }
                  >
                    <Text
                      style={[
                        styles.dropdownText,
                        !selectedPropertyType &&
                          styles.dropdownPlaceholder,
                      ]}
                    >
                      {selectedPropertyType
                        ?.label ??
                        'Select property type'}
                    </Text>

                    <ChevronDown
                      size={19}
                      color={
                        COLORS.muted
                      }
                    />
                  </Pressable>

                  {typeOpen && (
                    <View
                      style={
                        styles.dropdownOptions
                      }
                    >
                      {PROPERTY_TYPES.map(
                        (item) => {
                          const selected =
                            propertyType ===
                            item.value;

                          return (
                            <Pressable
                              key={
                                item.value
                              }
                              style={[
                                styles.dropdownOption,
                                selected &&
                                  styles.dropdownOptionSelected,
                              ]}
                              onPress={() => {
                                setPropertyType(
                                  item.value,
                                );
                                setTypeOpen(
                                  false,
                                );
                              }}
                            >
                              <Text
                                style={[
                                  styles.dropdownOptionText,
                                  selected &&
                                    styles.dropdownOptionTextSelected,
                                ]}
                              >
                                {
                                  item.label
                                }
                              </Text>

                              {selected && (
                                <Check
                                  size={
                                    17
                                  }
                                  color={
                                    COLORS.lime
                                  }
                                />
                              )}
                            </Pressable>
                          );
                        },
                      )}
                    </View>
                  )}
                </View>

                <View
                  style={[
                    styles.row,
                    !isDesktop &&
                      styles.rowMobile,
                  ]}
                >
                  <View
                    style={
                      styles.rowField
                    }
                  >
                    {renderFieldLabel(
                      'Monthly rent',
                    )}

                    <TextInput
                      value={rent}
                      onChangeText={
                        setRent
                      }
                      placeholder="0"
                      placeholderTextColor={
                        COLORS.mutedDark
                      }
                      keyboardType="numeric"
                      style={
                        styles.input
                      }
                    />
                  </View>

                  <View
                    style={
                      styles.rowField
                    }
                  >
                    {renderFieldLabel(
                      'Viewing fee',
                    )}

                    <TextInput
                      value={
                        viewingFee
                      }
                      onChangeText={
                        setViewingFee
                      }
                      placeholder="0"
                      placeholderTextColor={
                        COLORS.mutedDark
                      }
                      keyboardType="numeric"
                      style={
                        styles.input
                      }
                    />
                  </View>

                  <View
                    style={
                      styles.rowField
                    }
                  >
                    {renderFieldLabel(
                      'Deposit',
                    )}

                    <TextInput
                      value={
                        deposit
                      }
                      onChangeText={
                        setDeposit
                      }
                      placeholder="0"
                      placeholderTextColor={
                        COLORS.mutedDark
                      }
                      keyboardType="numeric"
                      style={
                        styles.input
                      }
                    />
                  </View>
                </View>

                <View
                  style={[
                    styles.row,
                    !isDesktop &&
                      styles.rowMobile,
                  ]}
                >
                  <View
                    style={
                      styles.rowField
                    }
                  >
                    {renderFieldLabel(
                      'Bedrooms',
                    )}

                    <TextInput
                      value={
                        bedrooms
                      }
                      onChangeText={
                        setBedrooms
                      }
                      placeholder="0"
                      placeholderTextColor={
                        COLORS.mutedDark
                      }
                      keyboardType="numeric"
                      style={
                        styles.input
                      }
                    />
                  </View>

                  <View
                    style={
                      styles.rowField
                    }
                  >
                    {renderFieldLabel(
                      'Bathrooms',
                    )}

                    <TextInput
                      value={
                        bathrooms
                      }
                      onChangeText={
                        setBathrooms
                      }
                      placeholder="0"
                      placeholderTextColor={
                        COLORS.mutedDark
                      }
                      keyboardType="numeric"
                      style={
                        styles.input
                      }
                    />
                  </View>
                </View>

                <View
                  style={
                    styles.formGroup
                  }
                >
                  {renderFieldLabel(
                    'Description',
                  )}

                  <TextInput
                    value={description}
                    onChangeText={
                      setDescription
                    }
                    placeholder="Describe the property, its condition and the main features customers should know..."
                    placeholderTextColor={
                      COLORS.mutedDark
                    }
                    multiline
                    numberOfLines={7}
                    textAlignVertical="top"
                    style={[
                      styles.input,
                      styles.textArea,
                    ]}
                  />

                  <Text
                    style={
                      styles.characterCount
                    }
                  >
                    {description.length}{' '}
                    characters
                  </Text>
                </View>
              </View>

              {/* LOCATION */}
              <View
                style={styles.card}
              >
                <View
                  style={
                    styles.cardHeader
                  }
                >
                  <View
                    style={
                      styles.stepNumber
                    }
                  >
                    <Text
                      style={
                        styles.stepNumberText
                      }
                    >
                      02
                    </Text>
                  </View>

                  <View>
                    <Text
                      style={
                        styles.cardTitle
                      }
                    >
                      Property location
                    </Text>

                    <Text
                      style={
                        styles.cardSubtitle
                      }
                    >
                      Select the official
                      Kenya geography.
                    </Text>
                  </View>
                </View>

                <View
                  style={
                    styles.locationNotice
                  }
                >
                  <View
                    style={
                      styles.locationNoticeIcon
                    }
                  >
                    <Check
                      size={16}
                      color={
                        COLORS.background
                      }
                    />
                  </View>

                  <Text
                    style={
                      styles.locationNoticeText
                    }
                  >
                    Admin can add properties
                    in any county in Kenya.
                    Each property belongs to
                    exactly one ward.
                  </Text>
                </View>

                <View
                  style={
                    styles.formGroup
                  }
                >
                  {renderFieldLabel(
                    'County',
                  )}

                  {renderDropdown(
                    selectedCounty,
                    'Select county',
                    countyOpen,
                    setCountyOpen,
                    counties,
                    handleCountyChange,
                  )}
                </View>

                <View
                  style={
                    styles.formGroup
                  }
                >
                  {renderFieldLabel(
                    'Constituency',
                  )}

                  {renderDropdown(
                    selectedConstituency,
                    selectedCountyId
                      ? 'Select constituency'
                      : 'Select a county first',
                    constituencyOpen,
                    setConstituencyOpen,
                    constituencies,
                    handleConstituencyChange,
                    !selectedCountyId,
                    loadingConstituencies,
                  )}
                </View>

                <View
                  style={
                    styles.formGroup
                  }
                >
                  {renderFieldLabel(
                    'Ward',
                  )}

                  {renderDropdown(
                    selectedWard,
                    selectedConstituencyId
                      ? 'Select one ward'
                      : 'Select a constituency first',
                    wardOpen,
                    setWardOpen,
                    wards,
                    handleWardChange,
                    !selectedConstituencyId,
                    loadingWards,
                  )}
                </View>

                {selectedCounty &&
                  selectedConstituency &&
                  selectedWard && (
                    <View
                      style={
                        styles.locationSummary
                      }
                    >
                      <Text
                        style={
                          styles.locationSummaryLabel
                        }
                      >
                        SELECTED LOCATION
                      </Text>

                      <Text
                        style={
                          styles.locationSummaryValue
                        }
                      >
                        {selectedCounty.name}
                        {'  •  '}
                        {
                          selectedConstituency.name
                        }
                        {'  •  '}
                        {
                          selectedWard.name
                        }
                      </Text>
                    </View>
                  )}
              </View>

              {/* AMENITIES */}
              <View
                style={styles.card}
              >
                <View
                  style={
                    styles.cardHeader
                  }
                >
                  <View
                    style={
                      styles.stepNumber
                    }
                  >
                    <Text
                      style={
                        styles.stepNumberText
                      }
                    >
                      03
                    </Text>
                  </View>

                  <View>
                    <Text
                      style={
                        styles.cardTitle
                      }
                    >
                      Amenities
                    </Text>

                    <Text
                      style={
                        styles.cardSubtitle
                      }
                    >
                      Select the features
                      available at the property.
                    </Text>
                  </View>
                </View>

                {loadingAmenities ? (
                  <View
                    style={
                      styles.inlineLoading
                    }
                  >
                    <ActivityIndicator
                      size="small"
                      color={
                        COLORS.lime
                      }
                    />

                    <Text
                      style={
                        styles.inlineLoadingText
                      }
                    >
                      Loading amenities...
                    </Text>
                  </View>
                ) : (
                  <View
                    style={
                      styles.amenitiesGrid
                    }
                  >
                    {amenities.map(
                      (amenity) => {
                        const selected =
                          selectedAmenityIds.includes(
                            amenity.id,
                          );

                        return (
                          <Pressable
                            key={
                              amenity.id
                            }
                            style={[
                              styles.amenityChip,
                              selected &&
                                styles.amenityChipSelected,
                            ]}
                            onPress={() =>
                              toggleAmenity(
                                amenity.id,
                              )
                            }
                          >
                            <View
                              style={[
                                styles.checkbox,
                                selected &&
                                  styles.checkboxSelected,
                              ]}
                            >
                              {selected && (
                                <Check
                                  size={
                                    13
                                  }
                                  color={
                                    COLORS.background
                                  }
                                  strokeWidth={
                                    3
                                  }
                                />
                              )}
                            </View>

                            <Text
                              style={[
                                styles.amenityText,
                                selected &&
                                  styles.amenityTextSelected,
                              ]}
                            >
                              {
                                amenity.name
                              }
                            </Text>
                          </Pressable>
                        );
                      },
                    )}
                  </View>
                )}
              </View>

              {/* IMAGES */}
              <View
                style={styles.card}
              >
                <View
                  style={
                    styles.cardHeader
                  }
                >
                  <View
                    style={
                      styles.stepNumber
                    }
                  >
                    <Text
                      style={
                        styles.stepNumberText
                      }
                    >
                      04
                    </Text>
                  </View>

                  <View>
                    <Text
                      style={
                        styles.cardTitle
                      }
                    >
                      Property images
                    </Text>

                    <Text
                      style={
                        styles.cardSubtitle
                      }
                    >
                      Add clear photos customers
                      can use to understand the
                      property.
                    </Text>
                  </View>
                </View>

                <Pressable
                  style={
                    styles.imageUploadButton
                  }
                  onPress={
                    addImagePlaceholder
                  }
                >
                  <View
                    style={
                      styles.imageUploadIcon
                    }
                  >
                    <ImagePlus
                      size={21}
                      color={
                        COLORS.lime
                      }
                    />
                  </View>

                  <View
                    style={
                      styles.imageUploadText
                    }
                  >
                    <Text
                      style={
                        styles.imageUploadTitle
                      }
                    >
                      Add property images
                    </Text>

                    <Text
                      style={
                        styles.imageUploadSubtitle
                      }
                    >
                      JPEG, PNG or WebP
                    </Text>
                  </View>

                  <Plus
                    size={20}
                    color={
                      COLORS.muted
                    }
                  />
                </Pressable>

                {images.length > 0 && (
                  <View
                    style={
                      styles.imageGrid
                    }
                  >
                    {images.map(
                      (image) => (
                        <View
                          key={
                            image.id
                          }
                          style={
                            styles.imageCard
                          }
                        >
                          <Image
                            source={{
                              uri: image.uri,
                            }}
                            style={
                              styles.imagePreview
                            }
                          />

                          <Pressable
                            style={
                              styles.removeImageButton
                            }
                            onPress={() =>
                              removeImage(
                                image.id,
                              )
                            }
                          >
                            <Trash2
                              size={
                                15
                              }
                              color={
                                COLORS.white
                              }
                            />
                          </Pressable>
                        </View>
                      ),
                    )}
                  </View>
                )}

                <View
                  style={
                    styles.imageNotice
                  }
                >
                  <Text
                    style={
                      styles.imageNoticeText
                    }
                  >
                    Image upload will use the
                    Makazii S3 upload service once
                    storage credentials are configured.
                  </Text>
                </View>
              </View>
            </View>

            {/* SUMMARY */}
            <View
              style={
                styles.sideColumn
              }
            >
              <View
                style={[
                  styles.summaryCard,
                  isDesktop &&
                    styles.summarySticky,
                ]}
              >
                <Text
                  style={
                    styles.summaryEyebrow
                  }
                >
                  PROPERTY SUMMARY
                </Text>

                <Text
                  style={
                    styles.summaryTitle
                  }
                >
                  Ready to save?
                </Text>

                <Text
                  style={
                    styles.summaryDescription
                  }
                >
                  Review the key information
                  before creating the property.
                </Text>

                <View
                  style={
                    styles.summaryDivider
                  }
                />

                <View
                  style={
                    styles.summaryRow
                  }
                >
                  <Text
                    style={
                      styles.summaryLabel
                    }
                  >
                    Property type
                  </Text>

                  <Text
                    style={
                      styles.summaryValue
                    }
                  >
                    {selectedPropertyType
                      ?.label ??
                      'Not selected'}
                  </Text>
                </View>

                <View
                  style={
                    styles.summaryRow
                  }
                >
                  <Text
                    style={
                      styles.summaryLabel
                    }
                  >
                    Monthly rent
                  </Text>

                  <Text
                    style={
                      styles.summaryValue
                    }
                  >
                    {rent
                      ? `KES ${Number(
                          rent,
                        ).toLocaleString(
                          'en-KE',
                        )}`
                      : 'Not set'}
                  </Text>
                </View>

                <View
                  style={
                    styles.summaryRow
                  }
                >
                  <Text
                    style={
                      styles.summaryLabel
                    }
                  >
                    Viewing fee
                  </Text>

                  <Text
                    style={
                      styles.summaryValue
                    }
                  >
                    {viewingFee
                      ? `KES ${Number(
                          viewingFee,
                        ).toLocaleString(
                          'en-KE',
                        )}`
                      : 'Not set'}
                  </Text>
                </View>

                <View
                  style={
                    styles.summaryRow
                  }
                >
                  <Text
                    style={
                      styles.summaryLabel
                    }
                  >
                    Deposit
                  </Text>

                  <Text
                    style={
                      styles.summaryValue
                    }
                  >
                    {deposit
                      ? `KES ${Number(
                          deposit,
                        ).toLocaleString(
                          'en-KE',
                        )}`
                      : 'Not set'}
                  </Text>
                </View>

                <View
                  style={
                    styles.summaryDivider
                  }
                />

                <View
                  style={
                    styles.summaryLocation
                  }
                >
                  <Text
                    style={
                      styles.summaryLocationLabel
                    }
                  >
                    LOCATION
                  </Text>

                  <Text
                    style={
                      styles.summaryLocationValue
                    }
                  >
                    {selectedCounty?.name ??
                      'County not selected'}
                  </Text>

                  <Text
                    style={
                      styles.summaryLocationSubvalue
                    }
                  >
                    {selectedConstituency?.name ??
                      'Constituency not selected'}
                  </Text>

                  <Text
                    style={
                      styles.summaryLocationSubvalue
                    }
                  >
                    {selectedWard?.name ??
                      'Ward not selected'}
                  </Text>
                </View>

                <View
                  style={
                    styles.summaryDivider
                  }
                />

                <View
                  style={
                    styles.checkList
                  }
                >
                  <ChecklistItem
                    label="Property title"
                    complete={
                      !!title.trim()
                    }
                  />

                  <ChecklistItem
                    label="Property type"
                    complete={
                      !!propertyType
                    }
                  />

                  <ChecklistItem
                    label="Pricing"
                    complete={
                      !!rent &&
                      !!viewingFee &&
                      !!deposit
                    }
                  />

                  <ChecklistItem
                    label="Location"
                    complete={
                      !!selectedCountyId &&
                      !!selectedConstituencyId &&
                      !!selectedWardId
                    }
                  />

                  <ChecklistItem
                    label="Description"
                    complete={
                      !!description.trim()
                    }
                  />
                </View>

                <Pressable
                  style={[
                    styles.saveButton,
                    saving &&
                      styles.saveButtonDisabled,
                  ]}
                  disabled={saving}
                  onPress={
                    saveProperty
                  }
                >
                  {saving ? (
                    <ActivityIndicator
                      size="small"
                      color={
                        COLORS.background
                      }
                    />
                  ) : (
                    <Save
                      size={18}
                      color={
                        COLORS.background
                      }
                    />
                  )}

                  <Text
                    style={
                      styles.saveButtonText
                    }
                  >
                    {saving
                      ? 'Saving...'
                      : 'Save as draft'}
                  </Text>
                </Pressable>

                <Pressable
                  style={
                    styles.cancelButton
                  }
                  disabled={saving}
                  onPress={() =>
                    router.back()
                  }
                >
                  <X
                    size={17}
                    color={
                      COLORS.muted
                    }
                  />

                  <Text
                    style={
                      styles.cancelButtonText
                    }
                  >
                    Cancel
                  </Text>
                </Pressable>
              </View>

              <View
                style={
                  styles.workflowCard
                }
              >
                <View
                  style={
                    styles.workflowIcon
                  }
                >
                  <Check
                    size={18}
                    color={
                      COLORS.lime
                    }
                  />
                </View>

                <View
                  style={
                    styles.workflowContent
                  }
                >
                  <Text
                    style={
                      styles.workflowTitle
                    }
                  >
                    Admin property workflow
                  </Text>

                  <Text
                    style={
                      styles.workflowText
                    }
                  >
                    New properties are created
                    as drafts. They can then be
                    reviewed and moved through the
                    Makazii verification workflow.
                  </Text>
                </View>
              </View>
            </View>
          </View>
        </ScrollView>
      </View>
    </SafeAreaView>
  );
}

function ChecklistItem({
  label,
  complete,
}: {
  label: string;
  complete: boolean;
}) {
  return (
    <View
      style={styles.checkListItem}
    >
      <View
        style={[
          styles.checkCircle,
          complete &&
            styles.checkCircleComplete,
        ]}
      >
        {complete && (
          <Check
            size={11}
            color={
              COLORS.background
            }
            strokeWidth={3}
          />
        )}
      </View>

      <Text
        style={[
          styles.checkListText,
          complete &&
            styles.checkListTextComplete,
        ]}
      >
        {label}
      </Text>
    </View>
  );
}

