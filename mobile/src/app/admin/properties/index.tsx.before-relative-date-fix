async function getAdminToken(): Promise<string | null> {
  if (Platform.OS === "web") {
    if (typeof window === "undefined") {
      return null;
    }

    return window.localStorage.getItem("makazii_admin_token");
  }

  return SecureStore.getItemAsync("makazii_admin_token");
}

async function apiRequest<T>(
  path: string,
  options: RequestInit = {},
): Promise<T> {
  const token = await getAdminToken();

  if (!token) {
    throw new Error("Admin session has expired. Please log in again.");
  }

  const response = await fetch(`${API_BASE_URL}${path}`, {
    ...options,
    headers: {
      Accept: "application/json",
      ...(options.body
        ? {
            "Content-Type": "application/json",
          }
        : {}),
      ...(options.headers ?? {}),
      Authorization: `Bearer ${token}`,
    },
  });

  let body: any = null;

  try {
    body = await response.json();
  } catch {
    body = null;
  }

  if (!response.ok) {
    throw new Error(
      body?.message ||
        body?.error ||
        `Request failed with status ${response.status}`,
    );
  }

  return body as T;
}

function humanize(value?: string | null): string {
  if (!value) {
    return "—";
  }

  return value
    .replace(/_/g, " ")
    .replace(/-/g, " ")
    .toLowerCase()
    .replace(/\b\w/g, (letter) => letter.toUpperCase());
}

function formatMoney(value?: number | null): string {
  if (value === null || value === undefined) {
    return "—";
  }

  return `KES ${value.toLocaleString("en-KE")}`;
}

function formatDate(value?: string | null): string {
  if (!value) {
    return "—";
  }

  const date = new Date(value);

  if (Number.isNaN(date.getTime())) {
    return "—";
  }

  return date.toLocaleDateString("en-KE", {
    day: "numeric",
    month: "short",
    year: "numeric",
  });
}

function formatRelativeDate(value?: string | null): string {
  if (!value) return "";

  const date = new Date(value);
  if (Number.isNaN(date.getTime())) return "";

  const now = new Date();
  const today = new Date(now.getFullYear(), now.getMonth(), now.getDate());
  const targetDay = new Date(
    date.getFullYear(),
    date.getMonth(),
    date.getDate(),
  );

  const daysAgo = Math.round(
    (today.getTime() - targetDay.getTime()) / 86400000,
  );

  if (daysAgo === 0) return "today";
  if (daysAgo === 1) return "1 day ago";
  if (daysAgo > 1 && daysAgo < 30) return `${daysAgo} days ago`;
  if (daysAgo >= 30) return formatDate(value);
  if (daysAgo === -1) return "tomorrow";
  return `in ${Math.abs(daysAgo)} days`;
}

function getPersonName(person?: PropertyPerson | null): string {
  const name = [person?.firstName, person?.lastName]
    .filter((part) => typeof part === "string" && part.trim())
    .join(" ")
    .trim();

  return name || "Makazii team";
}

function getPersonRole(person?: PropertyPerson | null): string {
  switch ((person?.role || "").toUpperCase()) {
    case "ADMIN":
      return "Administrator";
    case "LANDLORD":
      return "Landlord";
    case "MARKETER":
      return "Marketer";
    default:
      return "Property team";
  }
}

function getStatusLabel(status: string): string {
  switch (status) {
    case "PENDING_VERIFICATION":
      return "Under Review";
    case "CHANGES_REQUIRED":
      return "Changes Required";
    case "ACTIVE":
      return "Published";
    case "DRAFT":
      return "Draft";
    case "RENTED":
      return "Rented";
    case "INACTIVE":
      return "Inactive";
    case "REJECTED":
      return "Rejected";
    default:
      return humanize(status);
  }
}

function getStatusTone(status: string): "lime" | "warning" | "danger" | "muted" {
  switch (status) {
    case "ACTIVE":
      return "lime";
    case "PENDING_VERIFICATION":
    case "CHANGES_REQUIRED":
      return "warning";
    case "REJECTED":
      return "danger";
    default:
      return "muted";
  }
}

function getPurposeLabel(property: Property): string {
  if (property.purpose === "LONG_STAY") {
    return humanize(property.longStayType) || "Long Stay";
  }

  if (property.purpose === "SHORT_STAY") {
    return humanize(property.shortStayType) || "Short Stay";
  }

  return humanize(property.purpose);
}

function isShortStay(property: Property): boolean {
  return property.purpose === "SHORT_STAY";
}

function getPrimaryPrice(property: Property): {
  value: number | null;
  label: string;
} {
  if (!isShortStay(property)) {
    return {
      value: property.monthlyRent ?? null,
      label: "month",
    };
  }

  if (property.dayNightRate !== null && property.dayNightRate !== undefined) {
    return {
      value: property.dayNightRate,
      label: "day/night",
    };
  }

  if (property.nightRate !== null && property.nightRate !== undefined) {
    return {
      value: property.nightRate,
      label: "night",
    };
  }

  if (property.dayRate !== null && property.dayRate !== undefined) {
    return {
      value: property.dayRate,
      label: "day",
    };
  }

  return {
    value: null,
    label: "",
  };
}

function getImageUrl(image?: PropertyImage): string | null {
  const raw = image?.url || image?.path || image?.key;

  if (!raw) {
    return null;
  }

  if (/^https?:\/\//i.test(raw)) {
    return raw;
  }

  const baseUrl = API_BASE_URL.replace(/\/api\/?$/, "");

  if (raw.startsWith("/")) {
    return `${baseUrl}${raw}`;
  }

  return `${baseUrl}/${raw}`;
}

function getMarketerName(marketer?: Marketer | null): string {
  if (!marketer) {
    return "Unassigned";
  }

  const firstName = marketer.user?.firstName?.trim() || "";
  const lastName = marketer.user?.lastName?.trim() || "";
  const fullName = `${firstName} ${lastName}`.trim();

  return fullName || marketer.region || "Assigned marketer";
}

function getLocation(property: Property): string {
  return [property.area, property.town, property.county]
    .filter(Boolean)
    .join(", ");
}

function getInitials(name: string): string {
  const parts = name
    .split(" ")
    .map((part) => part.trim())
    .filter(Boolean);

  if (parts.length === 0) {
    return "MK";
  }

  if (parts.length === 1) {
    return parts[0].slice(0, 2).toUpperCase();
  }

  return `${parts[0][0]}${parts[parts.length - 1][0]}`.toUpperCase();
}

