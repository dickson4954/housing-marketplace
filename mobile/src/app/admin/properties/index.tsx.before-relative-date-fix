function StatusPill({ status }: { status: string }) {
  const tone = getStatusTone(status);

  const toneStyle =
    tone === "lime"
      ? styles.statusPillLime
      : tone === "warning"
        ? styles.statusPillWarning
        : tone === "danger"
          ? styles.statusPillDanger
          : styles.statusPillMuted;

  const textStyle =
    tone === "lime"
      ? styles.statusTextLime
      : tone === "warning"
        ? styles.statusTextWarning
        : tone === "danger"
          ? styles.statusTextDanger
          : styles.statusTextMuted;

  return (
    <View style={[styles.statusPill, toneStyle]}>
      <View style={[styles.statusDot, textStyle]} />
      <Text style={[styles.statusText, textStyle]}>
        {getStatusLabel(status)}
      </Text>
    </View>
  );
}

