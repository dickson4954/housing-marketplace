export default function AdminPropertiesScreen() {
  const { width } = useWindowDimensions();

  const isMobile = width < 900;
  const isWide = width >= 1350;

  const [properties, setProperties] = useState<Property[]>([]);
  const [search, setSearch] = useState("");
  const [statusFilter, setStatusFilter] =
    useState<StatusFilter>("ALL");
  const [loading, setLoading] = useState(true);
  const [refreshing, setRefreshing] = useState(false);
  const [error, setError] = useState<string | null>(null);
  const [mobileMenuOpen, setMobileMenuOpen] = useState(false);

  const loadProperties = useCallback(
    async (refresh = false) => {
      if (refresh) {
        setRefreshing(true);
      } else {
        setLoading(true);
      }

      setError(null);

      try {
        const result = await apiRequest<ApiResponse>(
          "/admin/properties",
        );

        if (!result.success) {
          throw new Error(
            result.message || "Failed to load properties.",
          );
        }

        setProperties(result.data ?? []);
      } catch (requestError) {
        const message =
          requestError instanceof Error
            ? requestError.message
            : "Failed to load properties.";

        setError(message);
      } finally {
        setLoading(false);
        setRefreshing(false);
      }
    },
    [],
  );

  useEffect(() => {
    loadProperties();
  }, [loadProperties]);

  const filteredProperties = useMemo(() => {
    const query = search.trim().toLowerCase();

    return properties.filter((property) => {
      const matchesStatus =
        statusFilter === "ALL" ||
        property.status === statusFilter;

      if (!matchesStatus) {
        return false;
      }

      if (!query) {
        return true;
      }

      const marketerName = getMarketerName(property.marketer);

      const searchable = [
        property.id,
        property.title,
        property.description,
        property.purpose,
        property.longStayType,
        property.shortStayType,
        property.status,
        property.county,
        property.town,
        property.area,
        marketerName,
      ]
        .filter(Boolean)
        .join(" ")
        .toLowerCase();

      return searchable.includes(query);
    });
  }, [properties, search, statusFilter]);

  const stats = useMemo(() => {
    return {
      total: properties.length,
      underReview: properties.filter(
        (property) =>
          property.status === "PENDING_VERIFICATION",
      ).length,
      published: properties.filter(
        (property) => property.status === "ACTIVE",
      ).length,
      available: properties.filter(
        (property) => property.available,
      ).length,
    };
  }, [properties]);

  const statusOptions: {
    label: string;
    value: StatusFilter;
  }[] = [
    { label: "All", value: "ALL" },
    { label: "Draft", value: "DRAFT" },
    {
      label: "Under Review",
      value: "PENDING_VERIFICATION",
    },
    {
      label: "Changes Required",
      value: "CHANGES_REQUIRED",
    },
    { label: "Published", value: "ACTIVE" },
    { label: "Rented", value: "RENTED" },
    { label: "Inactive", value: "INACTIVE" },
    { label: "Rejected", value: "REJECTED" },
  ];

  if (loading) {
    return (
      <SafeAreaView
        style={styles.loadingScreen}
        edges={["top", "bottom"]}
      >
        <ActivityIndicator
          size="large"
          color={COLORS.lime}
        />
        <Text style={styles.loadingText}>
          Loading property operations...
        </Text>
      </SafeAreaView>
    );
  }

  return (
    <SafeAreaView
      style={styles.screen}
      edges={["top", "bottom"]}
    >
      <View style={styles.app}>
        {!isMobile ? <Sidebar /> : null}

        {isMobile && mobileMenuOpen ? (
          <View style={styles.mobileOverlay}>
            <Pressable
              style={styles.overlayDismiss}
              onPress={() => setMobileMenuOpen(false)}
            />
            <Sidebar
              mobile
              onClose={() => setMobileMenuOpen(false)}
            />
          </View>
        ) : null}

        <View style={styles.main}>
          <Header
            onMenu={() => setMobileMenuOpen(true)}
            onRefresh={() => loadProperties(true)}
            refreshing={refreshing}
            search={isMobile ? "" : search}
            onSearch={setSearch}
          />

          <ScrollView
            style={styles.contentScroll}
            contentContainerStyle={[
              styles.content,
              isMobile && styles.contentMobile,
            ]}
            refreshControl={
              <RefreshControl
                refreshing={refreshing}
                onRefresh={() => loadProperties(true)}
                tintColor={COLORS.lime}
              />
            }
            showsVerticalScrollIndicator={false}
          >
            <View style={styles.pageHeader}>
              <View style={styles.pageHeaderCopy}>
                <Text style={styles.pageEyebrow}>
                  PROPERTY OPERATIONS
                </Text>

                <Text style={styles.pageTitle}>
                  Properties
                </Text>

                <Text style={styles.pageSubtitle}>
                  Review, approve and manage every property in
                  Makazii.
                </Text>
              </View>

              <View style={styles.pageActions}>
                <Pressable
                  onPress={() => loadProperties(true)}
                  style={styles.secondaryButton}
                >
                  <RefreshCw
                    size={17}
                    color={COLORS.white}
                  />
                  {!isMobile ? (
                    <Text style={styles.secondaryButtonText}>
                      Refresh
                    </Text>
                  ) : null}
                </Pressable>

                <Pressable
                  onPress={() =>
                    router.push("/admin/properties/add")
                  }
                  style={styles.primaryButton}
                >
                  <Plus
                    size={18}
                    color={COLORS.background}
                    strokeWidth={2.5}
                  />
                  <Text style={styles.primaryButtonText}>
                    Add Property
                  </Text>
                </Pressable>
              </View>
            </View>

            {isMobile ? (
              <View style={styles.mobileSearch}>
                <Search size={17} color={COLORS.muted} />
                <TextInput
                  value={search}
                  onChangeText={setSearch}
                  placeholder="Search properties..."
                  placeholderTextColor={COLORS.muted}
                  style={styles.mobileSearchInput}
                />
              </View>
            ) : null}

            {error ? (
              <View style={styles.errorCard}>
                <View style={styles.errorIcon}>
                  <AlertCircle
                    size={20}
                    color={COLORS.danger}
                  />
                </View>

                <View style={styles.errorCopy}>
                  <Text style={styles.errorTitle}>
                    Unable to load properties
                  </Text>
                  <Text style={styles.errorText}>
                    {error}
                  </Text>
                </View>

                <Pressable
                  onPress={() => loadProperties()}
                  style={styles.retryButton}
                >
                  <Text style={styles.retryText}>
                    Retry
                  </Text>
                </Pressable>
              </View>
            ) : null}

            <View
              style={[
                styles.statsGrid,
                isMobile && styles.statsGridMobile,
              ]}
            >
              <StatCard
                label="Total Properties"
                value={stats.total}
                icon={
                  <Building2
                    size={19}
                    color={COLORS.lime}
                  />
                }
                accent
              />

              <StatCard
                label="Under Review"
                value={stats.underReview}
                icon={
                  <Clock3
                    size={19}
                    color={COLORS.warning}
                  />
                }
              />

              <StatCard
                label="Published"
                value={stats.published}
                icon={
                  <CheckCircle2
                    size={19}
                    color={COLORS.success}
                  />
                }
              />

              <StatCard
                label="Available"
                value={stats.available}
                icon={
                  <Home
                    size={19}
                    color={COLORS.white}
                  />
                }
              />
            </View>

            {!isMobile ? <WorkflowCard /> : null}

            <View style={styles.filtersCard}>
              <View style={styles.filtersHeader}>
                <View>
                  <Text style={styles.filtersTitle}>
                    Property queue
                  </Text>
                  <Text style={styles.filtersSubtitle}>
                    {filteredProperties.length} of{" "}
                    {properties.length} properties
                  </Text>
                </View>

                {search ? (
                  <Pressable
                    onPress={() => setSearch("")}
                    style={styles.clearSearch}
                  >
                    <X size={14} color={COLORS.muted} />
                    <Text style={styles.clearSearchText}>
                      Clear search
                    </Text>
                  </Pressable>
                ) : null}
              </View>

              <ScrollView
                horizontal
                showsHorizontalScrollIndicator={false}
                contentContainerStyle={styles.filterScroll}
              >
                {statusOptions.map((option) => {
                  const active =
                    statusFilter === option.value;

                  return (
                    <Pressable
                      key={option.value}
                      onPress={() =>
                        setStatusFilter(option.value)
                      }
                      style={[
                        styles.filterButton,
                        active && styles.filterButtonActive,
                      ]}
                    >
                      <Text
                        style={[
                          styles.filterButtonText,
                          active &&
                            styles.filterButtonTextActive,
                        ]}
                      >
                        {option.label}
                      </Text>
                    </Pressable>
                  );
                })}
              </ScrollView>
            </View>

            {filteredProperties.length === 0 ? (
              <EmptyState
                search={search}
                filter={statusFilter}
              />
            ) : (
              <View
                style={[
                  styles.propertiesGrid,
                  isWide && styles.propertiesGridWide,
                  isMobile && styles.propertiesGridMobile,
                ]}
              >
                {filteredProperties.map((property) => (
                  <View
                    key={property.id}
                    style={[
                      styles.propertyColumn,
                      isWide && styles.propertyColumnWide,
                      isMobile &&
                        styles.propertyColumnMobile,
                    ]}
                  >
                    <PropertyCard
                      property={property}
                      onOpen={() =>
                        router.push(
                          `/admin/properties/${property.id}`,
                        )
                      }
                    />
                  </View>
                ))}
              </View>
            )}

            <View style={styles.bottomSpace} />
          </ScrollView>
        </View>
      </View>
    </SafeAreaView>
  );
}

