import React, { useEffect, useMemo, useState } from 'react';
import {
  ActivityIndicator,
  Alert,
  Image,
  Modal,
  Pressable,
  RefreshControl,
  ScrollView,
  StyleSheet,
  Text,
  TextInput,
  View,
} from 'react-native';
import { useLocalSearchParams, useRouter } from 'expo-router';
import * as SecureStore from 'expo-secure-store';
import {
  ArrowLeft,
  Check,
  ChevronDown,
  FileCheck2,
  Image as ImageIcon,
  RefreshCw,
  Save,
  ShieldCheck,
  X,
  XCircle,
} from 'lucide-react-native';

import { API_BASE_URL, API_ENDPOINTS } from '@/config/api';

const COLORS = {
  background: '#0B0F10',
  card: '#14191B',
  cardSoft: '#181E20',
  lime: '#D7FF5F',
  white: '#FFFFFF',
  muted: '#9CA5A7',
  border: '#252C2E',
  danger: '#FF6B6B',
  warning: '#FFC857',
  success: '#7BE495',
  blue: '#6EA8FE',
};

const PROPERTY_TYPES = [
  { label: 'Single Room', value: 'SINGLE_ROOM' },
  { label: 'Bedsitter', value: 'BEDSITTER' },
  { label: '1 Bedroom', value: 'ONE_BEDROOM' },
  { label: '2 Bedroom', value: 'TWO_BEDROOM' },
  { label: '3 Bedroom', value: 'THREE_BEDROOM' },
];

type PropertyStatus =
  | 'DRAFT'
  | 'PENDING_VERIFICATION'
  | 'CHANGES_REQUIRED'
  | 'ACTIVE'
  | 'RENTED'
  | 'INACTIVE'
  | 'REJECTED';

type BackendImage = {
  id: string;
  url: string;
  publicId?: string | null;
  altText?: string | null;
  sortOrder?: number;
  isPrimary?: boolean;
};

type GeographyItem = {
  id: string;
  name: string;
  sourceId?: string | null;
};

type Amenity = {
  id: string;
  name: string;
};

type BackendProperty = {
  id: string;
  title: string;
  description?: string | null;
  propertyType: string;
  status: PropertyStatus;
  rent: number;
  viewingFee?: number | null;
  deposit?: number | null;

  countyId: string;
  constituencyId: string;
  wardId: string;

  county?: string | null;
  town?: string | null;
  area?: string | null;

  bedrooms?: number | null;
  bathrooms?: number | null;

  available: boolean;
  verified: boolean;

  images?: BackendImage[];

  amenities?: Array<{
    propertyId?: string;
    amenityId?: string;
    amenity: Amenity;
  }>;

  countyRelation?: GeographyItem | null;
  constituency?: GeographyItem | null;
  ward?: GeographyItem | null;

  createdAt: string;
  updatedAt: string;

  statusHistory?: Array<{
    id: string;
    fromStatus?: PropertyStatus | null;
    toStatus: PropertyStatus;
    note?: string | null;
    createdAt: string;
    changedBy?: {
      id: string;
      email?: string | null;
      phone?: string | null;
    } | null;
  }>;

  _count?: {
    viewingRequests?: number;
    shortlists?: number;
  };
};

const STATUS_LABELS: Record<PropertyStatus, string> = {
  DRAFT: 'Draft',
  PENDING_VERIFICATION: 'Pending Verification',
  CHANGES_REQUIRED: 'Changes Required',
  ACTIVE: 'Published / Active',
  RENTED: 'Rented',
  INACTIVE: 'Inactive',
  REJECTED: 'Rejected',
};

function getStatusColor(status: PropertyStatus) {
  switch (status) {
    case 'ACTIVE':
      return COLORS.success;
    case 'PENDING_VERIFICATION':
      return COLORS.warning;
    case 'CHANGES_REQUIRED':
      return COLORS.blue;
    case 'REJECTED':
      return COLORS.danger;
    case 'RENTED':
      return COLORS.muted;
    case 'INACTIVE':
      return COLORS.muted;
    default:
      return COLORS.muted;
  }
}

function getPropertyTypeLabel(value?: string) {
  return (
    PROPERTY_TYPES.find((item) => item.value === value)?.label ??
    value ??
    'Unknown'
  );
}

function formatMoney(value?: number | null) {
  if (value === null || value === undefined) {
    return 'Not set';
  }

  return `KSh ${Number(value).toLocaleString('en-KE')}`;
}

function formatDate(value?: string | null) {
  if (!value) {
    return 'Not available';
  }

  const date = new Date(value);

  if (Number.isNaN(date.getTime())) {
    return value;
  }

  return date.toLocaleDateString('en-KE', {
    day: 'numeric',
    month: 'short',
    year: 'numeric',
  });
}

function formatDateTime(value?: string | null) {
  if (!value) {
    return 'Not available';
  }

  const date = new Date(value);

  if (Number.isNaN(date.getTime())) {
    return value;
  }

  return date.toLocaleString('en-KE', {
    day: 'numeric',
    month: 'short',
    year: 'numeric',
    hour: 'numeric',
    minute: '2-digit',
  });
}

function toNumber(value: string) {
  const cleaned = value.replace(/,/g, '').trim();

  if (!cleaned) {
    return 0;
  }

  const parsed = Number(cleaned);

  return Number.isNaN(parsed) ? 0 : parsed;
}

async function getAdminToken() {
  if (typeof window !== 'undefined') {
    return window.localStorage.getItem('makazii_admin_token');
  }

  return SecureStore.getItemAsync('makazii_admin_token');
}

async function apiRequest(
  path: string,
  options: RequestInit = {},
) {
  const token = await getAdminToken();

  if (!token) {
    throw new Error('Admin session has expired. Please log in again.');
  }

  const response = await fetch(`${API_BASE_URL}${path}`, {
    ...options,
    headers: {
      Accept: 'application/json',
      ...(options.body ? { 'Content-Type': 'application/json' } : {}),
      ...(options.headers ?? {}),
      Authorization: `Bearer ${token}`,
    },
  });

  let body: any = null;

  try {
    body = await response.json();
  } catch {
    body = null;
  }

  if (!response.ok) {
    throw new Error(
      body?.message ||
        body?.error ||
        `Request failed with status ${response.status}`,
    );
  }

  return body;
}

export default function AdminPropertyDetailsScreen() {
  const router = useRouter();

  const params = useLocalSearchParams<{
    id?: string | string[];
  }>();

  const propertyId = Array.isArray(params.id) ? params.id[0] : params.id;

  const [property, setProperty] = useState<BackendProperty | null>(null);

  const [loading, setLoading] = useState(true);
  const [refreshing, setRefreshing] = useState(false);
  const [saving, setSaving] = useState(false);
  const [reviewing, setReviewing] = useState(false);

  const [title, setTitle] = useState('');
  const [propertyType, setPropertyType] = useState('');
  const [rent, setRent] = useState('');
  const [viewingFee, setViewingFee] = useState('');
  const [deposit, setDeposit] = useState('');
  const [bedrooms, setBedrooms] = useState('');
  const [bathrooms, setBathrooms] = useState('');
  const [description, setDescription] = useState('');

  const [countyId, setCountyId] = useState('');
  const [constituencyId, setConstituencyId] = useState('');
  const [wardId, setWardId] = useState('');

  const [counties, setCounties] = useState<GeographyItem[]>([]);
  const [constituencies, setConstituencies] = useState<GeographyItem[]>([]);
  const [wards, setWards] = useState<GeographyItem[]>([]);
  const [amenities, setAmenities] = useState<Amenity[]>([]);
  const [selectedAmenityIds, setSelectedAmenityIds] = useState<string[]>(
    [],
  );

  const [showTypePicker, setShowTypePicker] = useState(false);
  const [showCountyPicker, setShowCountyPicker] = useState(false);
  const [showConstituencyPicker, setShowConstituencyPicker] =
    useState(false);
  const [showWardPicker, setShowWardPicker] = useState(false);

  const [reviewAction, setReviewAction] = useState<
    'changes' | 'reject' | null
  >(null);
  const [reviewNotes, setReviewNotes] = useState('');

  const [error, setError] = useState('');

  const selectedCounty = useMemo(
    () => counties.find((item) => item.id === countyId),
    [counties, countyId],
  );

  const selectedConstituency = useMemo(
    () => constituencies.find((item) => item.id === constituencyId),
    [constituencies, constituencyId],
  );

  const selectedWard = useMemo(
    () => wards.find((item) => item.id === wardId),
    [wards, wardId],
  );

  const selectedTypeLabel = useMemo(
    () => getPropertyTypeLabel(propertyType),
    [propertyType],
  );

  const statusColor = property
    ? getStatusColor(property.status)
    : COLORS.muted;

  const canEdit =
    property !== null &&
    property.status !== 'RENTED';

  const loadProperty = async (showLoader = true) => {
    if (!propertyId) {
      setError('Property ID is missing.');
      setLoading(false);
      return;
    }

    if (showLoader) {
      setLoading(true);
    }

    setError('');

    try {
      const result = await apiRequest(
        `/admin/properties/${propertyId}`,
      );

      const data = result?.data ?? result;

      if (!data) {
        throw new Error('Property was not returned by the backend.');
      }

      setProperty(data);

      setTitle(data.title ?? '');
      setPropertyType(data.propertyType ?? '');
      setRent(
        data.rent !== null && data.rent !== undefined
          ? String(data.rent)
          : '',
      );
      setViewingFee(
        data.viewingFee !== null &&
          data.viewingFee !== undefined
          ? String(data.viewingFee)
          : '',
      );
      setDeposit(
        data.deposit !== null && data.deposit !== undefined
          ? String(data.deposit)
          : '',
      );
      setBedrooms(
        data.bedrooms !== null &&
          data.bedrooms !== undefined
          ? String(data.bedrooms)
          : '',
      );
      setBathrooms(
        data.bathrooms !== null &&
          data.bathrooms !== undefined
          ? String(data.bathrooms)
          : '',
      );
      setDescription(data.description ?? '');

      setCountyId(data.countyId ?? '');
      setConstituencyId(data.constituencyId ?? '');
      setWardId(data.wardId ?? '');

      setSelectedAmenityIds(
        (data.amenities ?? [])
          .map((item: any) => item.amenityId ?? item.amenity?.id)
          .filter(Boolean),
      );
    } catch (requestError) {
      setError(
        requestError instanceof Error
          ? requestError.message
          : 'Unable to load property.',
      );
    } finally {
      setLoading(false);
    }
  };

  const loadCounties = async () => {
    try {
      const result = await apiRequest(
        API_ENDPOINTS.geographyCounties,
      );

      const data = Array.isArray(result)
        ? result
        : result?.data ?? [];

      setCounties(data);
    } catch (requestError) {
      console.error('Unable to load counties:', requestError);
    }
  };

  const loadConstituencies = async (selectedCountyId: string) => {
    if (!selectedCountyId) {
      setConstituencies([]);
      return;
    }

    try {
      const result = await apiRequest(
        API_ENDPOINTS.geographyConstituencies(
          selectedCountyId,
        ),
      );

      const data = Array.isArray(result)
        ? result
        : result?.data ?? [];

      setConstituencies(data);
    } catch (requestError) {
      console.error(
        'Unable to load constituencies:',
        requestError,
      );
      setConstituencies([]);
    }
  };

  const loadWards = async (selectedConstituencyId: string) => {
    if (!selectedConstituencyId) {
      setWards([]);
      return;
    }

    try {
      const result = await apiRequest(
        API_ENDPOINTS.geographyWards(
          selectedConstituencyId,
        ),
      );

      const data = Array.isArray(result)
        ? result
        : result?.data ?? [];

      setWards(data);
    } catch (requestError) {
      console.error('Unable to load wards:', requestError);
      setWards([]);
    }
  };

  const loadAmenities = async () => {
    try {
      const result = await apiRequest('/admin/amenities');

      const data = Array.isArray(result)
        ? result
        : result?.data ?? [];

      setAmenities(data);
    } catch (requestError) {
      console.error('Unable to load amenities:', requestError);
      setAmenities([]);
    }
  };

  useEffect(() => {
    loadProperty();
    loadCounties();
    loadAmenities();
  }, [propertyId]);

  useEffect(() => {
    if (countyId) {
      loadConstituencies(countyId);
    }
  }, [countyId]);

  useEffect(() => {
    if (constituencyId) {
      loadWards(constituencyId);
    }
  }, [constituencyId]);

  const refresh = async () => {
    setRefreshing(true);

    try {
      await Promise.all([
        loadProperty(false),
        loadCounties(),
        loadAmenities(),
      ]);
    } finally {
      setRefreshing(false);
    }
  };

  const validate = () => {
    if (!title.trim()) {
      Alert.alert('Missing title', 'Enter a property title.');
      return false;
    }

    if (!propertyType) {
      Alert.alert(
        'Missing property type',
        'Select the property type.',
      );
      return false;
    }

    const rentValue = toNumber(rent);

    if (rentValue <= 0) {
      Alert.alert(
        'Invalid rent',
        'Monthly rent must be greater than zero.',
      );
      return false;
    }

    if (viewingFee.trim()) {
      const viewingValue = toNumber(viewingFee);

      if (viewingValue < 0) {
        Alert.alert(
          'Invalid viewing fee',
          'Viewing fee cannot be negative.',
        );
        return false;
      }
    }

    if (deposit.trim()) {
      const depositValue = toNumber(deposit);

      if (depositValue < 0) {
        Alert.alert(
          'Invalid deposit',
          'Deposit cannot be negative.',
        );
        return false;
      }
    }

    if (!countyId) {
      Alert.alert(
        'Missing county',
        'Select the property county.',
      );
      return false;
    }

    if (!constituencyId) {
      Alert.alert(
        'Missing constituency',
        'Select the property constituency.',
      );
      return false;
    }

    if (!wardId) {
      Alert.alert(
        'Missing ward',
        'Select exactly one property ward.',
      );
      return false;
    }

    return true;
  };

  const saveChanges = async () => {
    if (!propertyId || !property) {
      return;
    }

    if (!canEdit) {
      Alert.alert(
        'Property locked',
        'A rented property cannot be edited.',
      );
      return;
    }

    if (!validate()) {
      return;
    }

    setSaving(true);
    setError('');

    try {
      const payload = {
        title: title.trim(),
        description: description.trim() || null,
        propertyType,
        rent: toNumber(rent),
        viewingFee: viewingFee.trim()
          ? toNumber(viewingFee)
          : null,
        deposit: deposit.trim()
          ? toNumber(deposit)
          : null,
        countyId,
        constituencyId,
        wardId,
        bedrooms: bedrooms.trim()
          ? toNumber(bedrooms)
          : null,
        bathrooms: bathrooms.trim()
          ? toNumber(bathrooms)
          : null,
        amenityIds: selectedAmenityIds,
      };

      const result = await apiRequest(
        `/admin/properties/${propertyId}`,
        {
          method: 'PATCH',
          body: JSON.stringify(payload),
        },
      );

      const updated = result?.data ?? result;

      setProperty(updated);

      Alert.alert(
        'Property saved',
        'The property has been updated successfully.',
      );

      await loadProperty(false);
    } catch (requestError) {
      const message =
        requestError instanceof Error
          ? requestError.message
          : 'Unable to save property.';

      setError(message);
      Alert.alert('Save failed', message);
    } finally {
      setSaving(false);
    }
  };

  const changeStatus = async (
    status: PropertyStatus,
    note?: string,
  ) => {
    if (!propertyId) {
      return;
    }

    setReviewing(true);
    setError('');

    try {
      const result = await apiRequest(
        `/admin/properties/${propertyId}/status`,
        {
          method: 'PATCH',
          body: JSON.stringify({
            status,
            note: note?.trim() || undefined,
          }),
        },
      );

      const updated = result?.data ?? result;

      setProperty(updated);

      await loadProperty(false);

      Alert.alert(
        'Status updated',
        `Property is now ${STATUS_LABELS[status]}.`,
      );
    } catch (requestError) {
      const message =
        requestError instanceof Error
          ? requestError.message
          : 'Unable to update property status.';

      setError(message);
      Alert.alert('Status update failed', message);
    } finally {
      setReviewing(false);
    }
  };

  const updateAvailability = async (available: boolean) => {
    if (!propertyId || !property) {
      return;
    }

    if (property.status === 'RENTED') {
      Alert.alert(
        'Property rented',
        'A rented property cannot be returned to available.',
      );
      return;
    }

    setSaving(true);

    try {
      const result = await apiRequest(
        `/admin/properties/${propertyId}/availability`,
        {
          method: 'PATCH',
          body: JSON.stringify({ available }),
        },
      );

      const updated = result?.data ?? result;

      setProperty(updated);

      await loadProperty(false);
    } catch (requestError) {
      const message =
        requestError instanceof Error
          ? requestError.message
          : 'Unable to update availability.';

      Alert.alert('Availability update failed', message);
    } finally {
      setSaving(false);
    }
  };

  const submitReviewAction = async () => {
    if (!reviewAction) {
      return;
    }

    const note = reviewNotes.trim();

    if (!note) {
      Alert.alert(
        'Review note required',
        'Please explain the reason for this action.',
      );
      return;
    }

    const targetStatus: PropertyStatus =
      reviewAction === 'changes'
        ? 'CHANGES_REQUIRED'
        : 'REJECTED';

    await changeStatus(targetStatus, note);

    setReviewAction(null);
    setReviewNotes('');
  };

  const handleApprove = () => {
    Alert.alert(
      'Approve property?',
      'This will move the property to ACTIVE and make it eligible for customer listings when available.',
      [
        {
          text: 'Cancel',
          style: 'cancel',
        },
        {
          text: 'Approve',
          onPress: () =>
            changeStatus(
              'ACTIVE',
              'Property approved and activated by admin.',
            ),
        },
      ],
    );
  };

  const toggleAmenity = (id: string) => {
    if (!canEdit) {
      return;
    }

    setSelectedAmenityIds((current) =>
      current.includes(id)
        ? current.filter((item) => item !== id)
        : [...current, id],
    );
  };

  const selectCounty = (item: GeographyItem) => {
    if (!canEdit) {
      return;
    }

    setCountyId(item.id);
    setConstituencyId('');
    setWardId('');
    setConstituencies([]);
    setWards([]);
    setShowCountyPicker(false);
  };

  const selectConstituency = (item: GeographyItem) => {
    if (!canEdit) {
      return;
    }

    setConstituencyId(item.id);
    setWardId('');
    setWards([]);
    setShowConstituencyPicker(false);
  };

  const selectWard = (item: GeographyItem) => {
    if (!canEdit) {
      return;
    }

    setWardId(item.id);
    setShowWardPicker(false);
  };

  const requestChanges = () => {
    setReviewNotes('');
    setReviewAction('changes');
  };

  const rejectProperty = () => {
    setReviewNotes('');
    setReviewAction('reject');
  };

  const markAsRented = () => {
    Alert.alert(
      'Mark property as rented?',
      'This will permanently move the property to RENTED, make it unavailable and close active viewing requests.',
      [
        {
          text: 'Cancel',
          style: 'cancel',
        },
        {
          text: 'Mark Rented',
          style: 'destructive',
          onPress: () =>
            changeStatus(
              'RENTED',
              'Property marked as rented by admin.',
            ),
        },
      ],
    );
  };

  const deactivateProperty = () => {
    Alert.alert(
      'Deactivate property?',
      'The property will no longer be active for customers.',
      [
        {
          text: 'Cancel',
          style: 'cancel',
        },
        {
          text: 'Deactivate',
          onPress: () =>
            changeStatus(
              'INACTIVE',
              'Property deactivated by admin.',
            ),
        },
      ],
    );
  };

  if (loading) {
    return (
      <View style={styles.centered}>
        <ActivityIndicator
          size="large"
          color={COLORS.lime}
        />

        <Text style={styles.loadingText}>
          Loading property...
        </Text>
      </View>
    );
  }

  if (!property) {
    return (
      <View style={styles.centered}>
        <View style={styles.errorIcon}>
          <XCircle
            size={30}
            color={COLORS.danger}
          />
        </View>

        <Text style={styles.errorTitle}>
          Property not found
        </Text>

        <Text style={styles.errorText}>
          {error ||
            'The requested property could not be loaded.'}
        </Text>

        <Pressable
          style={styles.primaryButton}
          onPress={() => router.back()}
        >
          <ArrowLeft
            size={18}
            color={COLORS.background}
          />

          <Text style={styles.primaryButtonText}>
            Back to Properties
          </Text>
        </Pressable>
      </View>
    );
  }

  return (
    <View style={styles.screen}>
      <View style={styles.topBar}>
        <Pressable
          style={styles.backButton}
          onPress={() => router.back()}
        >
          <ArrowLeft
            size={20}
            color={COLORS.white}
          />
        </Pressable>

        <View style={styles.topBarTitleWrap}>
          <Text style={styles.topBarEyebrow}>
            PROPERTY MANAGEMENT
          </Text>

          <Text
            style={styles.topBarTitle}
            numberOfLines={1}
          >
            {property.title}
          </Text>
        </View>

        <Pressable
          style={styles.refreshButton}
          onPress={refresh}
          disabled={refreshing}
        >
          {refreshing ? (
            <ActivityIndicator
              size="small"
              color={COLORS.lime}
            />
          ) : (
            <RefreshCw
              size={19}
              color={COLORS.white}
            />
          )}
        </Pressable>
      </View>

      {error ? (
        <View style={styles.errorBanner}>
          <XCircle
            size={18}
            color={COLORS.danger}
          />

          <Text style={styles.errorBannerText}>
            {error}
          </Text>

          <Pressable
            onPress={() => setError('')}
          >
            <X
              size={17}
              color={COLORS.muted}
            />
          </Pressable>
        </View>
      ) : null}

      <ScrollView
        style={styles.scroll}
        contentContainerStyle={styles.content}
        refreshControl={
          <RefreshControl
            refreshing={refreshing}
            onRefresh={refresh}
            tintColor={COLORS.lime}
          />
        }
        showsVerticalScrollIndicator={false}
      >
        <View style={styles.heroCard}>
          <View style={styles.heroTop}>
            <View style={styles.statusBadge}>
              <View
                style={[
                  styles.statusDot,
                  {
                    backgroundColor: statusColor,
                  },
                ]}
              />

              <Text
                style={[
                  styles.statusText,
                  {
                    color: statusColor,
                  },
                ]}
              >
                {STATUS_LABELS[property.status]}
              </Text>
            </View>

            <Text style={styles.propertyId}>
              ID: {property.id}
            </Text>
          </View>

          <Text style={styles.heroTitle}>
            {property.title}
          </Text>

          <Text style={styles.heroType}>
            {getPropertyTypeLabel(
              property.propertyType,
            )}
          </Text>

          <View style={styles.heroStats}>
            <MiniStat
              label="MONTHLY RENT"
              value={formatMoney(property.rent)}
            />

            <MiniStat
              label="VIEWING FEE"
              value={formatMoney(
                property.viewingFee,
              )}
            />

            <MiniStat
              label="DEPOSIT"
              value={formatMoney(property.deposit)}
            />
          </View>
        </View>

        <View style={styles.actionCard}>
          <Text style={styles.actionTitle}>
            PROPERTY WORKFLOW
          </Text>

          <Text style={styles.actionSubtitle}>
            Manage the official backend property lifecycle.
          </Text>

          <View style={styles.actionGrid}>
            {property.status ===
            'PENDING_VERIFICATION' ? (
              <>
                <Pressable
                  style={[
                    styles.actionButton,
                    styles.approveButton,
                  ]}
                  onPress={handleApprove}
                  disabled={reviewing}
                >
                  <Check
                    size={17}
                    color={COLORS.background}
                  />

                  <Text
                    style={styles.approveButtonText}
                  >
                    Approve
                  </Text>
                </Pressable>

                <Pressable
                  style={styles.actionButton}
                  onPress={requestChanges}
                  disabled={reviewing}
                >
                  <FileCheck2
                    size={17}
                    color={COLORS.white}
                  />

                  <Text
                    style={styles.actionButtonText}
                  >
                    Request Changes
                  </Text>
                </Pressable>

                <Pressable
                  style={[
                    styles.actionButton,
                    styles.rejectButton,
                  ]}
                  onPress={rejectProperty}
                  disabled={reviewing}
                >
                  <XCircle
                    size={17}
                    color={COLORS.white}
                  />

                  <Text
                    style={styles.actionButtonText}
                  >
                    Reject
                  </Text>
                </Pressable>
              </>
            ) : null}

            {property.status === 'DRAFT' ? (
              <Pressable
                style={[
                  styles.actionButton,
                  styles.approveButton,
                ]}
                onPress={() =>
                  changeStatus(
                    'PENDING_VERIFICATION',
                    'Property submitted for verification by admin.',
                  )
                }
                disabled={reviewing}
              >
                <ShieldCheck
                  size={17}
                  color={COLORS.background}
                />

                <Text
                  style={styles.approveButtonText}
                >
                  Submit for Verification
                </Text>
              </Pressable>
            ) : null}

            {property.status ===
            'CHANGES_REQUIRED' ? (
              <Pressable
                style={[
                  styles.actionButton,
                  styles.approveButton,
                ]}
                onPress={() =>
                  changeStatus(
                    'PENDING_VERIFICATION',
                    'Property resubmitted after requested changes.',
                  )
                }
                disabled={reviewing}
              >
                <ShieldCheck
                  size={17}
                  color={COLORS.background}
                />

                <Text
                  style={styles.approveButtonText}
                >
                  Resubmit for Verification
                </Text>
              </Pressable>
            ) : null}

            {property.status === 'ACTIVE' ? (
              <>
                <Pressable
                  style={[
                    styles.actionButton,
                    styles.rentedButton,
                  ]}
                  onPress={markAsRented}
                  disabled={reviewing}
                >
                  <Text
                    style={styles.rentedButtonText}
                  >
                    Mark as Rented
                  </Text>
                </Pressable>

                <Pressable
                  style={styles.actionButton}
                  onPress={deactivateProperty}
                  disabled={reviewing}
                >
                  <Text
                    style={styles.actionButtonText}
                  >
                    Deactivate
                  </Text>
                </Pressable>
              </>
            ) : null}
          </View>
        </View>

        <Section
          number="01"
          title="Basic information"
          subtitle="Core property details"
        >
          <Field
            label="Property title"
            value={title}
            onChangeText={setTitle}
            placeholder="e.g. Modern Bedsitter"
            editable={canEdit}
          />

          <Text style={styles.fieldLabel}>
            Property type
          </Text>

          <SelectField
            value={selectedTypeLabel}
            placeholder="Select property type"
            disabled={!canEdit}
            onPress={() =>
              setShowTypePicker(true)
            }
          />

          <Field
            label="Description"
            value={description}
            onChangeText={setDescription}
            placeholder="Describe the property..."
            multiline
            numberOfLines={6}
            textAlignVertical="top"
            editable={canEdit}
          />
        </Section>

        <Section
          number="02"
          title="Pricing"
          subtitle="Rental, viewing fee and deposit"
        >
          <View style={styles.twoColumns}>
            <Field
              label="Monthly rent"
              value={rent}
              onChangeText={setRent}
              placeholder="25000"
              keyboardType="numeric"
              editable={canEdit}
              flex={1}
            />

            <Field
              label="Viewing fee"
              value={viewingFee}
              onChangeText={setViewingFee}
              placeholder="500"
              keyboardType="numeric"
              editable={canEdit}
              flex={1}
            />
          </View>

          <Field
            label="Deposit"
            value={deposit}
            onChangeText={setDeposit}
            placeholder="25000"
            keyboardType="numeric"
            editable={canEdit}
          />

          <View style={styles.infoBox}>
            <Text style={styles.infoBoxTitle}>
              CUSTOMER PAYMENT INFORMATION
            </Text>

            <Text style={styles.infoBoxText}>
              Monthly rent is the recurring rental
              amount. Viewing fee is charged when a
              customer requests a physical viewing.
              Deposit is the property's security/rental
              deposit.
            </Text>
          </View>
        </Section>

        <Section
          number="03"
          title="Property specifications"
          subtitle="Supported property specifications"
        >
          <View style={styles.twoColumns}>
            <Field
              label="Bedrooms"
              value={bedrooms}
              onChangeText={setBedrooms}
              placeholder="1"
              keyboardType="numeric"
              editable={canEdit}
              flex={1}
            />

            <Field
              label="Bathrooms"
              value={bathrooms}
              onChangeText={setBathrooms}
              placeholder="1"
              keyboardType="numeric"
              editable={canEdit}
              flex={1}
            />
          </View>
        </Section>

        <Section
          number="04"
          title="Location"
          subtitle="Kenya's official county → constituency → ward hierarchy"
        >
          <Text style={styles.fieldLabel}>
            County
          </Text>

          <SelectField
            value={
              selectedCounty?.name ??
              property.county ??
              'Select county'
            }
            placeholder="Select county"
            disabled={!canEdit}
            onPress={() =>
              setShowCountyPicker(true)
            }
          />

          <Text style={styles.fieldLabel}>
            Constituency
          </Text>

          <SelectField
            value={
              selectedConstituency?.name ??
              property.constituency?.name ??
              'Select constituency'
            }
            placeholder="Select constituency"
            disabled={
              !canEdit || !countyId
            }
            onPress={() =>
              setShowConstituencyPicker(
                true,
              )
            }
          />

          <Text style={styles.fieldLabel}>
            Ward
          </Text>

          <SelectField
            value={
              selectedWard?.name ??
              property.ward?.name ??
              'Select ward'
            }
            placeholder="Select ward"
            disabled={
              !canEdit ||
              !constituencyId
            }
            onPress={() =>
              setShowWardPicker(true)
            }
          />

          <View style={styles.locationSummary}>
            <Text style={styles.locationSummaryLabel}>
              PROPERTY LOCATION
            </Text>

            <Text style={styles.locationSummaryText}>
              {selectedCounty?.name ??
                property.countyRelation?.name ??
                property.county ??
                'County not available'}
              {'  ›  '}
              {selectedConstituency?.name ??
                property.constituency?.name ??
                'Constituency not available'}
              {'  ›  '}
              {selectedWard?.name ??
                property.ward?.name ??
                'Ward not available'}
            </Text>
          </View>
        </Section>

        <Section
          number="05"
          title="Amenities"
          subtitle="Amenities stored in the backend"
        >
          {amenities.length === 0 ? (
            <View style={styles.emptyCard}>
              <Text style={styles.emptyCardText}>
                No amenities were returned by the
                backend.
              </Text>
            </View>
          ) : (
            <View style={styles.chipGrid}>
              {amenities.map((amenity) => {
                const active =
                  selectedAmenityIds.includes(
                    amenity.id,
                  );

                return (
                  <Pressable
                    key={amenity.id}
                    disabled={!canEdit}
                    onPress={() =>
                      toggleAmenity(
                        amenity.id,
                      )
                    }
                    style={[
                      styles.chip,
                      active &&
                        styles.chipActive,
                      !canEdit &&
                        styles.disabledChip,
                    ]}
                  >
                    {active ? (
                      <Check
                        size={14}
                        color={
                          COLORS.background
                        }
                      />
                    ) : null}

                    <Text
                      style={[
                        styles.chipText,
                        active &&
                          styles.chipTextActive,
                      ]}
                    >
                      {amenity.name}
                    </Text>
                  </Pressable>
                );
              })}
            </View>
          )}
        </Section>

        <Section
          number="06"
          title="Property images"
          subtitle="Images currently stored on the backend"
        >
          {!property.images?.length ? (
            <View style={styles.emptyImages}>
              <ImageIcon
                size={30}
                color={COLORS.muted}
              />

              <Text
                style={styles.emptyImagesTitle}
              >
                No property images
              </Text>

              <Text
                style={styles.emptyImagesText}
              >
                No images have been stored on this
                property yet. S3 upload will be connected
                when the storage credentials are configured.
              </Text>
            </View>
          ) : (
            <View style={styles.imageGrid}>
              {[...(property.images ?? [])]
                .sort(
                  (a, b) =>
                    (a.sortOrder ?? 0) -
                    (b.sortOrder ?? 0),
                )
                .map((image, index) => (
                  <View
                    key={image.id}
                    style={styles.imageCard}
                  >
                    <View
                      style={
                        styles.imagePreview
                      }
                    >
                      {image.url ? (
                        <Image
                          source={{
                            uri: image.url,
                          }}
                          style={
                            styles.propertyImage
                          }
                          resizeMode="cover"
                        />
                      ) : (
                        <ImageIcon
                          size={28}
                          color={
                            COLORS.muted
                          }
                        />
                      )}
                    </View>

                    <View style={styles.imageInfo}>
                      <Text
                        style={
                          styles.imageNumber
                        }
                      >
                        PHOTO {index + 1}
                      </Text>

                      {image.isPrimary ? (
                        <View
                          style={
                            styles.coverBadge
                          }
                        >
                          <Text
                            style={
                              styles.coverBadgeText
                            }
                          >
                            PRIMARY
                          </Text>
                        </View>
                      ) : null}

                      {image.altText ? (
                        <Text
                          style={
                            styles.imageAltText
                          }
                          numberOfLines={2}
                        >
                          {image.altText}
                        </Text>
                      ) : null}
                    </View>
                  </View>
                ))}
            </View>
          )}

          <View style={styles.storageNotice}>
            <ShieldCheck
              size={18}
              color={COLORS.lime}
            />

            <Text
              style={styles.storageNoticeText}
            >
              These images are read from the real
              property record. The admin screen does not
              create fake local image records.
            </Text>
          </View>
        </Section>

        <Section
          number="07"
          title="Availability"
          subtitle="Whether the property is currently available"
        >
          <View style={styles.availabilityRow}>
            <View style={styles.availabilityInfo}>
              <Text style={styles.availabilityTitle}>
                {property.available
                  ? 'Available'
                  : 'Unavailable'}
              </Text>

              <Text
                style={
                  styles.availabilitySubtitle
                }
              >
                {property.available
                  ? 'The property is currently marked available.'
                  : 'The property is currently marked unavailable.'}
              </Text>
            </View>

            <Pressable
              disabled={
                !canEdit || saving
              }
              onPress={() =>
                updateAvailability(
                  !property.available,
                )
              }
              style={[
                styles.toggleButton,
                property.available &&
                  styles.toggleButtonActive,
              ]}
            >
              <Text
                style={[
                  styles.toggleText,
                  property.available &&
                    styles.toggleTextActive,
                ]}
              >
                {property.available
                  ? 'Available'
                  : 'Unavailable'}
              </Text>
            </Pressable>
          </View>

          {property.status ===
          'RENTED' ? (
            <View style={styles.rentedNotice}>
              <Text
                style={
                  styles.rentedNoticeTitle
                }
              >
                RENTED PROPERTY
              </Text>

              <Text
                style={
                  styles.rentedNoticeText
                }
              >
                A rented property cannot be returned
                to an available state. Its history remains
                in the system.
              </Text>
            </View>
          ) : null}
        </Section>

        <Section
          number="08"
          title="Property workflow"
          subtitle="Backend status and review history"
        >
          <View style={styles.workflowCard}>
            <View style={styles.workflowStatus}>
              <View
                style={[
                  styles.workflowDot,
                  {
                    backgroundColor:
                      statusColor,
                  },
                ]}
              />

              <Text
                style={
                  styles.workflowStatusText
                }
              >
                {STATUS_LABELS[property.status]}
              </Text>
            </View>

            <Text
              style={
                styles.workflowDescription
              }
            >
              Customers should only receive properties
              that are ACTIVE and available.
            </Text>
          </View>

          <View style={styles.metaGrid}>
            <Meta
              label="CREATED"
              value={formatDateTime(
                property.createdAt,
              )}
            />

            <Meta
              label="LAST UPDATED"
              value={formatDateTime(
                property.updatedAt,
              )}
            />

            <Meta
              label="VIEWING REQUESTS"
              value={String(
                property._count
                  ?.viewingRequests ?? 0,
              )}
            />

            <Meta
              label="SHORTLISTS"
              value={String(
                property._count?.shortlists ??
                  0,
              )}
            />
          </View>

          {property.statusHistory?.length ? (
            <View style={styles.historyList}>
              {property.statusHistory
                .slice()
                .reverse()
                .map((history) => (
                  <View
                    key={history.id}
                    style={
                      styles.historyItem
                    }
                  >
                    <View
                      style={
                        styles.historyDot
                      }
                    />

                    <View
                      style={
                        styles.historyContent
                      }
                    >
                      <Text
                        style={
                          styles.historyStatus
                        }
                      >
                        {history.fromStatus
                          ? `${STATUS_LABELS[history.fromStatus]} → `
                          : ''}
                        {
                          STATUS_LABELS[
                            history.toStatus
                          ]
                        }
                      </Text>

                      <Text
                        style={
                          styles.historyDate
                        }
                      >
                        {formatDateTime(
                          history.createdAt,
                        )}
                      </Text>

                      {history.note ? (
                        <Text
                          style={
                            styles.historyNote
                          }
                        >
                          {history.note}
                        </Text>
                      ) : null}
                    </View>
                  </View>
                ))}
            </View>
          ) : (
            <View style={styles.emptyCard}>
              <Text style={styles.emptyCardText}>
                No workflow history is available.
              </Text>
            </View>
          )}
        </Section>

        {canEdit ? (
          <Pressable
            style={styles.saveButton}
            onPress={saveChanges}
            disabled={saving}
          >
            {saving ? (
              <ActivityIndicator
                size="small"
                color={COLORS.background}
              />
            ) : (
              <Save
                size={19}
                color={COLORS.background}
              />
            )}

            <Text style={styles.saveButtonText}>
              {saving
                ? 'Saving...'
                : 'Save Property Changes'}
            </Text>
          </Pressable>
        ) : null}

        {property.status === 'RENTED' ? (
          <View style={styles.lockedCard}>
            <ShieldCheck
              size={20}
              color={COLORS.muted}
            />

            <View style={styles.lockedContent}>
              <Text style={styles.lockedTitle}>
                Property is locked
              </Text>

              <Text style={styles.lockedText}>
                RENTED properties remain in the system
                for historical records and cannot be
                returned to an active or available state.
              </Text>
            </View>
          </View>
        ) : null}

        <View style={styles.bottomSpace} />
      </ScrollView>

      <PickerModal
        visible={showTypePicker}
        title="Property type"
        options={PROPERTY_TYPES.map((item) => ({
          id: item.value,
          name: item.label,
        }))}
        selectedId={propertyType}
        onSelect={(item) => {
          setPropertyType(item.id);
          setShowTypePicker(false);
        }}
        onClose={() =>
          setShowTypePicker(false)
        }
      />

      <PickerModal
        visible={showCountyPicker}
        title="County"
        options={counties}
        selectedId={countyId}
        onSelect={selectCounty}
        onClose={() =>
          setShowCountyPicker(false)
        }
      />

      <PickerModal
        visible={
          showConstituencyPicker
        }
        title="Constituency"
        options={constituencies}
        selectedId={constituencyId}
        onSelect={selectConstituency}
        onClose={() =>
          setShowConstituencyPicker(
            false,
          )
        }
      />

      <PickerModal
        visible={showWardPicker}
        title="Ward"
        options={wards}
        selectedId={wardId}
        onSelect={selectWard}
        onClose={() =>
          setShowWardPicker(false)
        }
      />

      <Modal
        visible={reviewAction !== null}
        transparent
        animationType="slide"
        onRequestClose={() =>
          !reviewing &&
          setReviewAction(null)
        }
      >
        <View style={styles.modalBackdrop}>
          <View style={styles.reviewModal}>
            <View style={styles.modalHeader}>
              <View
                style={
                  styles.modalHeaderText
                }
              >
                <Text style={styles.modalTitle}>
                  {reviewAction ===
                  'changes'
                    ? 'Request changes'
                    : 'Reject property'}
                </Text>

                <Text
                  style={
                    styles.modalSubtitle
                  }
                >
                  {reviewAction ===
                  'changes'
                    ? 'Tell the submitter exactly what needs to be corrected.'
                    : 'Provide the reason the property is being rejected.'}
                </Text>
              </View>

              <Pressable
                style={styles.closeButton}
                onPress={() =>
                  !reviewing &&
                  setReviewAction(null)
                }
              >
                <X
                  size={20}
                  color={COLORS.white}
                />
              </Pressable>
            </View>

            <Text style={styles.fieldLabel}>
              Review note
            </Text>

            <TextInput
              value={reviewNotes}
              onChangeText={setReviewNotes}
              placeholder={
                reviewAction ===
                'changes'
                  ? 'Explain what needs to be corrected...'
                  : 'Explain why this property is being rejected...'
              }
              placeholderTextColor={
                COLORS.muted
              }
              multiline
              numberOfLines={7}
              textAlignVertical="top"
              style={styles.reviewInput}
            />

            <View style={styles.modalActions}>
              <Pressable
                style={styles.modalCancel}
                onPress={() =>
                  setReviewAction(null)
                }
                disabled={reviewing}
              >
                <Text
                  style={
                    styles.modalCancelText
                  }
                >
                  Cancel
                </Text>
              </Pressable>

              <Pressable
                style={[
                  styles.modalConfirm,
                  reviewAction ===
                    'reject' &&
                    styles.modalConfirmReject,
                ]}
                onPress={
                  submitReviewAction
                }
                disabled={reviewing}
              >
                {reviewing ? (
                  <ActivityIndicator
                    size="small"
                    color={
                      reviewAction ===
                      'reject'
                        ? COLORS.white
                        : COLORS.background
                    }
                  />
                ) : reviewAction ===
                  'changes' ? (
                  <FileCheck2
                    size={18}
                    color={
                      COLORS.background
                    }
                  />
                ) : (
                  <XCircle
                    size={18}
                    color={COLORS.white}
                  />
                )}

                <Text
                  style={[
                    styles.modalConfirmText,
                    reviewAction ===
                      'reject' &&
                      styles.modalConfirmRejectText,
                  ]}
                >
                  {reviewing
                    ? 'Saving...'
                    : reviewAction ===
                        'changes'
                      ? 'Send Changes Request'
                      : 'Reject Property'}
                </Text>
              </Pressable>
            </View>
          </View>
        </View>
      </Modal>
    </View>
  );
}

function MiniStat({
  label,
  value,
}: {
  label: string;
  value: string;
}) {
  return (
    <View style={styles.miniStat}>
      <Text style={styles.miniStatLabel}>
        {label}
      </Text>

      <Text
        style={styles.miniStatValue}
        numberOfLines={1}
      >
        {value}
      </Text>
    </View>
  );
}

function Section({
  number,
  title,
  subtitle,
  children,
}: {
  number: string;
  title: string;
  subtitle: string;
  children: React.ReactNode;
}) {
  return (
    <View style={styles.sectionCard}>
      <View style={styles.sectionHeader}>
        <View style={styles.sectionNumber}>
          <Text
            style={
              styles.sectionNumberText
            }
          >
            {number}
          </Text>
        </View>

        <View style={styles.sectionHeading}>
          <Text style={styles.sectionTitle}>
            {title}
          </Text>

          <Text style={styles.sectionSubtitle}>
            {subtitle}
          </Text>
        </View>
      </View>

      <View style={styles.sectionBody}>
        {children}
      </View>
    </View>
  );
}

function Field({
  label,
  value,
  onChangeText,
  placeholder,
  keyboardType,
  multiline,
  numberOfLines,
  textAlignVertical,
  editable = true,
  flex,
}: {
  label: string;
  value: string;
  onChangeText: (value: string) => void;
  placeholder?: string;
  keyboardType?: 'default' | 'numeric' | 'email-address';
  multiline?: boolean;
  numberOfLines?: number;
  textAlignVertical?: 'auto' | 'top' | 'bottom' | 'center';
  editable?: boolean;
  flex?: number;
}) {
  return (
    <View
      style={[
        styles.field,
        flex ? { flex } : undefined,
      ]}
    >
      <Text style={styles.fieldLabel}>
        {label}
      </Text>

      <TextInput
        value={value}
        onChangeText={onChangeText}
        placeholder={placeholder}
        placeholderTextColor={COLORS.muted}
        keyboardType={
          keyboardType ?? 'default'
        }
        multiline={multiline}
        numberOfLines={numberOfLines}
        textAlignVertical={
          textAlignVertical
        }
        editable={editable}
        style={[
          styles.input,
          multiline &&
            styles.multilineInput,
          !editable &&
            styles.disabledInput,
        ]}
      />
    </View>
  );
}

function SelectField({
  value,
  placeholder,
  disabled,
  onPress,
}: {
  value: string;
  placeholder: string;
  disabled?: boolean;
  onPress: () => void;
}) {
  return (
    <Pressable
      style={[
        styles.selectField,
        disabled &&
          styles.disabledInput,
      ]}
      disabled={disabled}
      onPress={onPress}
    >
      <Text
        style={[
          styles.selectText,
          (!value ||
            value === placeholder) &&
            styles.selectPlaceholder,
        ]}
        numberOfLines={1}
      >
        {value || placeholder}
      </Text>

      <ChevronDown
        size={19}
        color={
          disabled
            ? '#5E6668'
            : COLORS.muted
        }
      />
    </Pressable>
  );
}

function PickerModal({
  visible,
  title,
  options,
  selectedId,
  onSelect,
  onClose,
}: {
  visible: boolean;
  title: string;
  options: GeographyItem[];
  selectedId: string;
  onSelect: (item: GeographyItem) => void;
  onClose: () => void;
}) {
  return (
    <Modal
      visible={visible}
      transparent
      animationType="slide"
      onRequestClose={onClose}
    >
      <View style={styles.modalBackdrop}>
        <View style={styles.pickerModal}>
          <View style={styles.pickerHeader}>
            <View>
              <Text style={styles.pickerEyebrow}>
                SELECT
              </Text>

              <Text style={styles.pickerTitle}>
                {title}
              </Text>
            </View>

            <Pressable
              style={styles.closeButton}
              onPress={onClose}
            >
              <X
                size={20}
                color={COLORS.white}
              />
            </Pressable>
          </View>

          {options.length === 0 ? (
            <View style={styles.emptyPicker}>
              <Text
                style={
                  styles.emptyPickerText
                }
              >
                No options available.
              </Text>
            </View>
          ) : (
            <ScrollView
              style={styles.pickerScroll}
              contentContainerStyle={
                styles.pickerContent
              }
              showsVerticalScrollIndicator={false}
            >
              {options.map((item) => {
                const selected =
                  item.id === selectedId;

                return (
                  <Pressable
                    key={item.id}
                    style={[
                      styles.pickerOption,
                      selected &&
                        styles.pickerOptionSelected,
                    ]}
                    onPress={() =>
                      onSelect(item)
                    }
                  >
                    <Text
                      style={[
                        styles.pickerOptionText,
                        selected &&
                          styles.pickerOptionTextSelected,
                      ]}
                    >
                      {item.name}
                    </Text>

                    {selected ? (
                      <Check
                        size={18}
                        color={
                          COLORS.background
                        }
                      />
                    ) : null}
                  </Pressable>
                );
              })}
            </ScrollView>
          )}
        </View>
      </View>
    </Modal>
  );
}

function Meta({
  label,
  value,
}: {
  label: string;
  value: string;
}) {
  return (
    <View style={styles.metaItem}>
      <Text style={styles.metaLabel}>
        {label}
      </Text>

      <Text
        style={styles.metaValue}
        numberOfLines={2}
      >
        {value}
      </Text>
    </View>
  );
}

