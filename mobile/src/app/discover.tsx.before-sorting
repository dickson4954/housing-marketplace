type PropertyImage = {
  id?: string;
  url?: string | null;
  altText?: string | null;
  sortOrder?: number;
  isPrimary?: boolean;
};

type Property = {
  id: string;
  title: string;
  description?: string | null;
  videoUrl?: string | null;
  videoMimeType?: string | null;
  purpose?: string | null;
  longStayType?: string | null;
  shortStayType?: string | null;
  monthlyRent?: number | string | null;
  dayRate?: number | string | null;
  nightRate?: number | string | null;
  dayNightRate?: number | string | null;
  bedrooms?: number | null;
  bathrooms?: number | null;
  county?: string | null;
  town?: string | null;
  area?: string | null;
  place?: { name?: string | null } | null;
  available?: boolean;
  verified?: boolean;
  images?: PropertyImage[];
};

function formatMoney(value: number | string | null | undefined) {
  if (value === null || value === undefined || value === '') {
    return 'Price on request';
  }

  const amount = Number(value);

  return Number.isFinite(amount)
    ? `KSh ${amount.toLocaleString('en-KE')}`
    : 'Price on request';
}

function getPrice(property: Property) {
  if (property.purpose === 'SHORT_STAY') {
    if (property.dayNightRate != null) {
      return `${formatMoney(property.dayNightRate)} / day + night`;
    }

    if (property.nightRate != null) {
      return `${formatMoney(property.nightRate)} / night`;
    }

    if (property.dayRate != null) {
      return `${formatMoney(property.dayRate)} / day`;
    }

    return 'Price on request';
  }

  return `${formatMoney(property.monthlyRent)} / month`;
}

function getLocation(property: Property) {
  const parts = [
    property.area,
    property.town,
    property.county,
    property.place?.name,
  ].filter((value): value is string => Boolean(value?.trim()));

  return [...new Set(parts)].join(', ') || 'Location not provided';
}

function PropertyVideo({
  uri,
  propertyId,
}: {
  uri: string | null;
  propertyId: string;
}) {
  const recordedRef = useRef(false);

  const player = useVideoPlayer(uri, (videoPlayer) => {
    videoPlayer.loop = false;
    videoPlayer.muted = false;
  });

  useEffect(() => {
    recordedRef.current = false;

    if (!uri) {
      return;
    }

    const subscription = player.addListener(
      'playingChange',
      (event) => {
        if (event.isPlaying && !recordedRef.current) {
          recordedRef.current = true;

          void recordPropertyVideoView(propertyId).catch((error) => {
            console.error(
              'Failed to record property video view:',
              error,
            );
          });
        }
      },
    );

    return () => {
      subscription.remove();
    };
  }, [player, propertyId, uri]);

  if (!uri) {
    return (
      <View style={[styles.videoFrame, styles.noVideo]}>
        <VideoOff size={30} color={C.muted} />

        <Text style={styles.noVideoTitle}>
          Video not available
        </Text>

        <Text style={styles.noVideoText}>
          This listing does not have an uploaded video yet.
        </Text>
      </View>
    );
  }

  return (
    <View style={styles.videoFrame}>
      <VideoView
        player={player}
        style={styles.video}
        contentFit="cover"
        nativeControls
        allowsPictureInPicture={false}
      />

      <View pointerEvents="none" style={styles.videoBadge}>
        <Play size={12} color={C.dark} fill={C.dark} />

        <Text style={styles.videoBadgeText}>
          PROPERTY VIDEO
        </Text>
      </View>
    </View>
  );
}

function DiscoverCard({
  property,
  isShortlisted,
  onToggleShortlist,
  isComparing,
  onToggleCompare,
}: {
  property: Property;
  isShortlisted: boolean;
  onToggleShortlist: () => void;
  isComparing: boolean;
  onToggleCompare: () => void;
}) {
  const photos = (property.images ?? [])
    .filter((photo) => Boolean(photo.url))
    .sort((a, b) => {
      if (a.isPrimary && !b.isPrimary) return -1;
      if (!a.isPrimary && b.isPrimary) return 1;

      return (a.sortOrder ?? 0) - (b.sortOrder ?? 0);
    })
    .slice(0, 3);

  const openProperty = useCallback(() => {
    router.push(`/property/${property.id}`);
  }, [property.id]);

  const shareProperty = useCallback(async () => {
    try {
      await Share.share({
        title: property.title,
        message:
          `${property.title}\n` +
          `${getLocation(property)}\n` +
          `${getPrice(property)}\n` +
          'Discover this property on MAKAZII.',
      });
    } catch (error) {
      console.error('Property sharing failed:', error);
    }
  }, [property]);

  return (
    <View style={styles.card}>
      <View style={styles.cardHeader}>
        <View style={styles.headerText}>
          <Text style={styles.eyebrow}>
            MAKAZII DISCOVER
          </Text>

          <Text style={styles.propertyTitle} numberOfLines={2}>
            {property.title}
          </Text>

          <View style={styles.locationRow}>
            <MapPin size={14} color={C.muted} />

            <Text style={styles.location} numberOfLines={2}>
              {getLocation(property)}
            </Text>
          </View>
        </View>

        <Pressable
          accessibilityRole="button"
          accessibilityLabel={
            isShortlisted
              ? 'Remove property from shortlist'
              : 'Add property to shortlist'
          }
          onPress={onToggleShortlist}
          hitSlop={8}
          style={styles.heartButton}
        >
          <Heart
            size={21}
            color={isShortlisted ? C.lime : C.white}
            fill={isShortlisted ? C.lime : 'transparent'}
          />
        </Pressable>
      </View>

      <PropertyVideo
        uri={property.videoUrl || null}
        propertyId={property.id}
      />

      {photos.length > 0 ? (
        <View style={styles.photosSection}>
          <Text style={styles.sectionLabel}>
            SUPPORTING PHOTOS
          </Text>

          <ScrollView
            horizontal
            showsHorizontalScrollIndicator={false}
            contentContainerStyle={styles.photosRow}
          >
            {photos.map((photo, index) => (
              <Pressable
                key={
                  photo.id ??
                  photo.url ??
                  `${property.id}-photo-${index}`
                }
                onPress={openProperty}
                style={styles.photoFrame}
              >
                <Image
                  source={{ uri: photo.url! }}
                  style={styles.photo}
                  resizeMode="cover"
                  accessibilityLabel={
                    photo.altText || `Property photo ${index + 1}`
                  }
                />
              </Pressable>
            ))}
          </ScrollView>
        </View>
      ) : (
        <Text style={styles.noPhotos}>
          No supporting photos have been uploaded.
        </Text>
      )}

      <View style={styles.priceRow}>
        <View style={styles.priceBlock}>
          <Text style={styles.priceLabel}>PRICE</Text>
          <Text style={styles.price}>
            {getPrice(property)}
          </Text>
        </View>

        {property.verified ? (
          <View style={styles.verifiedBadge}>
            <ShieldCheck size={14} color={C.lime} />
            <Text style={styles.verifiedText}>
              Verified
            </Text>
          </View>
        ) : null}
      </View>

      <PropertyEngagement propertyId={property.id} />

      <Pressable
        accessibilityRole="button"
        onPress={onToggleCompare}
        style={{
          minHeight: 42,
          marginTop: 14,
          borderRadius: 12,
          borderWidth: 1,
          borderColor: isComparing ? C.lime : C.border,
          backgroundColor: isComparing ? '#202A15' : C.cardSoft,
          alignItems: 'center',
          justifyContent: 'center',
        }}
      >
        <Text style={{
          color: isComparing ? C.lime : C.white,
          fontSize: 12,
          fontWeight: '800',
        }}>
          {isComparing ? '✓ Added to comparison' : '+ Add to comparison'}
        </Text>
      </Pressable>

      <View style={styles.actions}>
        <Pressable
          onPress={openProperty}
          style={({ pressed }) => [
            styles.primaryButton,
            pressed && styles.pressed,
          ]}
        >
          <Text style={styles.primaryButtonText}>
            View property
          </Text>
        </Pressable>

        <Pressable
          accessibilityRole="button"
          accessibilityLabel="Share property"
          onPress={shareProperty}
          style={({ pressed }) => [
            styles.shareButton,
            pressed && styles.pressed,
          ]}
        >
          <Share2 size={19} color={C.white} />
        </Pressable>
      </View>
    </View>
  );
}

export default function DiscoverScreen() {
  const {
    isShortlisted,
    toggleShortlist,
    comparisonIds,
    isComparing,
    toggleCompare,
  } = useShortlist();

  const [properties, setProperties] = useState<Property[]>([]);
  const [loading, setLoading] = useState(true);
  const [refreshing, setRefreshing] = useState(false);
  const [error, setError] = useState<string | null>(null);

  const loadProperties = useCallback(async (refresh = false) => {
    if (refresh) {
      setRefreshing(true);
    } else {
      setLoading(true);
    }

    setError(null);

    try {
      const response = await fetch(
        `${API_BASE_URL}${API_ENDPOINTS.properties}`,
      );

      if (!response.ok) {
        throw new Error(
          `Properties request failed (${response.status}).`,
        );
      }

      const result = await response.json();

      const records: Property[] = Array.isArray(result?.data)
        ? result.data
        : [];

      setProperties(
        records.filter(
          (property) =>
            property.available === true &&
            property.verified === true,
        ),
      );
    } catch (requestError) {
      console.error(
        'Failed to load Discover properties:',
        requestError,
      );

      setError(
        'We could not load properties right now. Check your connection and try again.',
      );
    } finally {
      setLoading(false);
      setRefreshing(false);
    }
  }, []);

  useFocusEffect(
    useCallback(() => {
      void loadProperties();
    }, [loadProperties]),
  );

  return (
    <View style={styles.screen}>
      <ScrollView
        contentContainerStyle={styles.content}
        showsVerticalScrollIndicator={false}
        refreshControl={
          <RefreshControl
            refreshing={refreshing}
            onRefresh={() => void loadProperties(true)}
            tintColor={C.lime}
          />
        }
      >
        <View style={styles.pageHeader}>
          <Text style={styles.brand}>MAKAZII</Text>

          <Text style={styles.tagline}>
            FIND YOUR PLACE
          </Text>

          <Text style={styles.heading}>
            Discover homes through video.
          </Text>

          <Text style={styles.subtitle}>
            Watch real property videos, browse supporting photos,
            and shortlist places you like.
          </Text>
        </View>

        {comparisonIds.length > 0 && (
          <Pressable
            onPress={() => router.push('/compare')}
            style={{
              marginBottom: 18,
              padding: 15,
              borderRadius: 15,
              backgroundColor: C.lime,
              flexDirection: 'row',
              alignItems: 'center',
              justifyContent: 'space-between',
            }}
          >
            <View>
              <Text style={{ color: C.dark, fontSize: 14, fontWeight: '900' }}>
                Compare selected homes
              </Text>
              <Text style={{ color: C.dark, fontSize: 12, marginTop: 3 }}>
                {comparisonIds.length} of 3 selected
              </Text>
            </View>
            <Text style={{ color: C.dark, fontSize: 13, fontWeight: '900' }}>
              Compare →
            </Text>
          </Pressable>
        )}

        {loading ? (
          <View style={styles.stateBox}>
            <ActivityIndicator
              color={C.lime}
              size="large"
            />

            <Text style={styles.stateText}>
              Loading verified properties…
            </Text>
          </View>
        ) : error ? (
          <View style={styles.stateBox}>
            <Text style={styles.errorTitle}>
              Could not load Discover
            </Text>

            <Text style={styles.stateText}>
              {error}
            </Text>

            <Pressable
              onPress={() => void loadProperties()}
              style={styles.retryButton}
            >
              <Text style={styles.retryText}>
                Try again
              </Text>
            </Pressable>
          </View>
        ) : properties.length === 0 ? (
          <View style={styles.stateBox}>
            <Text style={styles.emptyTitle}>
              No verified properties yet
            </Text>

            <Text style={styles.stateText}>
              Available, verified listings will appear here when
              they are published.
            </Text>
          </View>
        ) : (
          <>
            <Text style={styles.resultsLabel}>
              {properties.length}{' '}
              {properties.length === 1
                ? 'PROPERTY'
                : 'PROPERTIES'}
            </Text>

            {properties.map((property) => (
              <DiscoverCard
                key={property.id}
                property={property}
                isShortlisted={isShortlisted(property.id)}
                onToggleShortlist={() => {
                  void toggleShortlist(property.id);
                }}
                isComparing={isComparing(property.id)}
                onToggleCompare={() => toggleCompare(property.id)}
              />
            ))}
          </>
        )}

        <View style={styles.footer}>
          <Text style={styles.footerBrand}>
            MAKAZII
          </Text>

          <Text style={styles.footerTagline}>
            FIND YOUR PLACE
          </Text>
        </View>
      </ScrollView>
    </View>
  );
}

