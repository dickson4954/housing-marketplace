export default function HomeScreen() {
  const { currentCustomer } = useCustomer();
  const { isShortlisted, toggleShortlist } = useShortlist();

  const [properties, setProperties] = useState<Property[]>([]);
  const [counties, setCounties] = useState<County[]>([]);

  const [loading, setLoading] = useState(true);
  const [loadingCounties, setLoadingCounties] =
    useState(true);

  const [refreshing, setRefreshing] = useState(false);
  const [error, setError] = useState<string | null>(null);
  const [countyError, setCountyError] =
    useState<string | null>(null);

  const customer = currentCustomer as Customer | null;

  const loadProperties = useCallback(async () => {
    try {
      setError(null);

      const response = await fetch(
        `${API_BASE_URL}/properties`,
      );

      if (!response.ok) {
        throw new Error(
          `Properties request failed: ${response.status}`,
        );
      }

      const result = await response.json();

      const backendProperties = Array.isArray(result?.data)
        ? result.data
        : [];

      const visibleProperties = backendProperties.filter(
        (property: Property) =>
          property.available === true &&
          property.verified === true,
      );

      setProperties(visibleProperties);
    } catch (requestError) {
      console.error(
        'Failed to load MAKAZII properties:',
        requestError,
      );

      setError(
        'We could not load properties right now. Please try again.',
      );
    } finally {
      setLoading(false);
      setRefreshing(false);
    }
  }, []);

  const loadCounties = useCallback(async () => {
    try {
      setCountyError(null);

      const response = await fetch(
        `${API_BASE_URL}${API_ENDPOINTS.geographyCounties}`,
      );

      if (!response.ok) {
        throw new Error(
          `Counties request failed: ${response.status}`,
        );
      }

      const result = await response.json();

      const backendCounties = Array.isArray(result?.data)
        ? result.data
        : [];

      const normalizedCounties: County[] =
        backendCounties
          .map((county: any) => ({
            id: String(county.id),
            name: String(county.name),
            code: county.code ?? null,
            sourceId: county.sourceId ?? null,
          }))
          .filter(
            (county: County) => county.id && county.name,
          );

      setCounties(normalizedCounties);
    } catch (requestError) {
      console.error(
        'Failed to load MAKAZII counties:',
        requestError,
      );

      setCountyError(
        'We could not load counties right now.',
      );

      setCounties([]);
    } finally {
      setLoadingCounties(false);
    }
  }, []);

  const loadHomeData = useCallback(async () => {
    setLoading(true);
    setLoadingCounties(true);

    await Promise.all([
      loadProperties(),
      loadCounties(),
    ]);
  }, [loadProperties, loadCounties]);

  useFocusEffect(
    useCallback(() => {
      loadHomeData();
    }, [loadHomeData]),
  );

  const refresh = useCallback(async () => {
    setRefreshing(true);

    await Promise.all([
      loadProperties(),
      loadCounties(),
    ]);

    setRefreshing(false);
  }, [loadProperties, loadCounties]);

  const longStayProperties = useMemo(
    () =>
      properties.filter(
        (property) => !isShortStay(property),
      ),
    [properties],
  );

  const shortStayProperties = useMemo(
    () =>
      properties.filter((property) =>
        isShortStay(property),
      ),
    [properties],
  );

  const featuredProperties = useMemo(
    () => longStayProperties.slice(0, 6),
    [longStayProperties],
  );

  const recentlyAdded = useMemo(
    () => [...properties].reverse().slice(0, 6),
    [properties],
  );

  const countyPropertyCounts = useMemo(() => {
    const grouped = new Map<string, number>();

    properties.forEach((property) => {
      const countyName = property.county?.trim();

      if (!countyName) {
        return;
      }

      grouped.set(
        countyName.toLowerCase(),
        (grouped.get(countyName.toLowerCase()) || 0) + 1,
      );
    });

    return grouped;
  }, [properties]);

  const visibleCounties = useMemo(() => {
    return counties.slice(0, 12);
  }, [counties]);

  const goToSearch = (purpose?: string) => {
    if (purpose) {
      router.push({
        pathname: '/search',
        params: { purpose },
      });

      return;
    }

    router.push('/search');
  };

  const openProperty = (property: Property) => {
    router.push(`/properties/${property.id}`);
  };

  const openCounty = (county: County) => {
    router.push({
      pathname: '/search',
      params: {
        county: county.name,
        countyId: county.id,
      },
    });
  };

  const firstName = getFirstName(customer);

  const avatar =
    customer?.profileImage ||
    customer?.profilePhoto ||
    customer?.avatar ||
    null;

  return (
    <View style={styles.screen}>
      <ScrollView
        showsVerticalScrollIndicator={false}
        contentContainerStyle={styles.scrollContent}
        refreshControl={
          <RefreshControl
            refreshing={refreshing}
            onRefresh={refresh}
            tintColor={COLORS.lime}
            colors={[COLORS.lime]}
          />
        }
      >
        {/* =====================================================
            HEADER
        ====================================================== */}

        <View style={styles.header}>
          <View>
            <Text style={styles.brand}>MAKAZII</Text>

            <Text style={styles.greeting}>
              Hello, {firstName}
            </Text>
          </View>

          <View style={styles.headerActions}>
            <Pressable
              onPress={() => router.push('/account')}
              hitSlop={8}
              style={({ pressed }) => [
                styles.notificationButton,
                pressed && styles.pressed,
              ]}
            >
              <Bell
                size={20}
                color={COLORS.white}
                strokeWidth={1.8}
              />

              <View style={styles.notificationDot} />
            </Pressable>

            <Pressable
              onPress={() => router.push('/account')}
              hitSlop={8}
              style={({ pressed }) => [
                styles.profileButton,
                pressed && styles.pressed,
              ]}
            >
              {avatar ? (
                <Image
                  source={{ uri: avatar }}
                  style={styles.profileImage}
                />
              ) : (
                <Text style={styles.profileInitials}>
                  {getInitials(customer)}
                </Text>
              )}
            </Pressable>
          </View>
        </View>

        {/* =====================================================
            HERO
        ====================================================== */}

        <View style={styles.hero}>
          <Text style={styles.heroTitle}>
            Find your place.
          </Text>

          <Text style={styles.heroSubtitle}>
            Homes, stays, hotels and more.
          </Text>

          <Pressable
            onPress={() => goToSearch()}
            style={({ pressed }) => [
              styles.searchBar,
              pressed && styles.cardPressed,
            ]}
          >
            <View style={styles.searchIcon}>
              <Search
                size={21}
                color={COLORS.dark}
                strokeWidth={2.2}
              />
            </View>

            <View style={styles.searchTextContainer}>
              <Text style={styles.searchTitle}>
                Search homes, areas or counties
              </Text>

              <Text style={styles.searchSubtitle}>
                Find your next place in Kenya
              </Text>
            </View>

            <ChevronRight
              size={20}
              color="#687173"
              strokeWidth={2}
            />
          </Pressable>
        </View>

        {/* =====================================================
            PRIMARY ENTRY OPTIONS
        ====================================================== */}

        <View style={styles.entrySection}>
          <EntryCard
            title="Find a Home"
            description="Apartments, bedsitters, houses and more"
            icon={
              <HomeIcon
                size={23}
                color={COLORS.dark}
                strokeWidth={2}
              />
            }
            onPress={() => goToSearch('LONG_STAY')}
          />

          <EntryCard
            title="Short Stay"
            description="BNBs, hotels and comfortable stays"
            icon={
              <Sparkles
                size={23}
                color={COLORS.dark}
                strokeWidth={2}
              />
            }
            onPress={() => goToSearch('SHORT_STAY')}
          />
        </View>

        {/* =====================================================
            POPULAR SEARCHES
        ====================================================== */}

        <View style={styles.section}>
          <SectionHeader
            title="Popular searches"
            subtitle="Start with what you need"
          />

          <ScrollView
            horizontal
            showsHorizontalScrollIndicator={false}
            contentContainerStyle={styles.horizontalContent}
          >
            {[
              'Bedsitter',
              'One Bedroom',
              'Two Bedroom',
              'BNB',
              'Furnished',
            ].map((search) => (
              <Pressable
                key={search}
                onPress={() =>
                  router.push({
                    pathname: '/search',
                    params: { query: search },
                  })
                }
                style={({ pressed }) => [
                  styles.searchChip,
                  pressed && styles.cardPressed,
                ]}
              >
                <Search
                  size={14}
                  color={COLORS.muted}
                />

                <Text style={styles.searchChipText}>
                  {search}
                </Text>
              </Pressable>
            ))}
          </ScrollView>
        </View>

        {/* =====================================================
            FEATURED HOMES
        ====================================================== */}

        <View style={styles.section}>
          <SectionHeader
            title="Featured homes"
            subtitle={
              loading
                ? 'Finding places for you...'
                : `${featuredProperties.length} available`
            }
            onPress={() => goToSearch('LONG_STAY')}
          />

          {loading ? (
            <View style={styles.loadingContainer}>
              <ActivityIndicator
                size="small"
                color={COLORS.lime}
              />

              <Text style={styles.loadingText}>
                Loading homes...
              </Text>
            </View>
          ) : longStayProperties.length === 0 ? (
            <View style={styles.emptyCard}>
              <HomeIcon
                size={25}
                color={COLORS.muted}
              />

              <Text style={styles.emptyTitle}>
                No long-stay homes yet
              </Text>

              <Text style={styles.emptyText}>
                New homes will appear here as they become
                available.
              </Text>
            </View>
          ) : (
            <ScrollView
              horizontal
              showsHorizontalScrollIndicator={false}
              contentContainerStyle={styles.propertyScroll}
            >
              {featuredProperties.map((property) => (
                <PropertyCard
                  key={property.id}
                  property={property}
                  isShortStayProperty={false}
                  isShortlisted={isShortlisted(
                    property.id,
                  )}
                  onPress={() => openProperty(property)}
                  onHeart={() =>
                    toggleShortlist(property.id)
                  }
                />
              ))}
            </ScrollView>
          )}
        </View>

        {/* =====================================================
            RECENTLY ADDED
        ====================================================== */}

        <View style={styles.section}>
          <SectionHeader
            title="Recently added"
            subtitle="Fresh places on Makazii"
            onPress={() => goToSearch()}
          />

          {loading ? (
            <View style={styles.loadingContainer}>
              <ActivityIndicator
                size="small"
                color={COLORS.lime}
