              </Text>
            </View>
          ) : (
            <ScrollView
              horizontal
              showsHorizontalScrollIndicator={false}
              contentContainerStyle={styles.propertyScroll}
            >
              {shortStayProperties
                .slice(0, 6)
                .map((property) => (
                  <PropertyCard
                    key={`short-${property.id}`}
                    property={property}
                    isShortStayProperty
                    isShortlisted={isShortlisted(
                      property.id,
                    )}
                    onPress={() => openProperty(property)}
                    onHeart={() =>
                      toggleShortlist(property.id)
                    }
