              {recentlyAdded.map((property) => (
                <PropertyCard
                  key={`recent-${property.id}`}
                  property={property}
                  isShortStayProperty={isShortStay(
                    property,
                  )}
                  isShortlisted={isShortlisted(
                    property.id,
                  )}
                  onPress={() => openProperty(property)}
                  onHeart={() =>
                    toggleShortlist(property.id)
                  }
                />
              ))}
            </ScrollView>
          )}
