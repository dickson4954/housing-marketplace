import React, { useCallback, useEffect, useState } from 'react';
import {
  ActivityIndicator,
  Pressable,
  RefreshControl,
  ScrollView,
  StatusBar,
  StyleSheet,
  Text,
  View,
} from 'react-native';
import { SafeAreaView } from 'react-native-safe-area-context';
import { router, useLocalSearchParams } from 'expo-router';
import {
  AlertCircle,
  AlertTriangle,
  CheckCircle2,
  Clock3,
  ArrowLeft,
  ArrowRight,
  BarChart3,
  Boxes,
  CalendarDays,
  ChevronRight,
  ClipboardList,
  Contact,
  LayoutDashboard,
  Megaphone,
  Package,
  Palette,
  RefreshCw,
  ShieldCheck,
  ShoppingCart,
  Store,
  Users,
  Wallet,
} from 'lucide-react-native';

import {
  clearBusinessOwnerToken,
  getApprovedBusinessWorkspace,
  getBusinessWorkspaceOverview,
  type BusinessWorkspaceDetails,
  type BusinessWorkspaceOverview,
} from '@/lib/businessOwnerApi';

const C = {
  background: '#0B0F10',
  card: '#14191B',
  cardSoft: '#181E20',
  lime: '#D7FF5F',
  white: '#FFFFFF',
  muted: '#9CA5A7',
  border: '#252C2E',
  danger: '#FF6B6B',
  green: '#73D99A',
  amber: '#F4C66A',
};

const MODULES = [
  { title: 'Catalogue', description: 'Products, services, variants and pricing', icon: Package },
  { title: 'POS & Sales', description: 'In-person sales and receipts', icon: ShoppingCart },
  { title: 'Orders', description: 'Customer orders and fulfilment', icon: ClipboardList },
  { title: 'Inventory', description: 'Stock, suppliers and procurement', icon: Boxes },
  { title: 'Customers', description: 'Customer records and relationships', icon: Contact },
  { title: 'Finance', description: 'Payments, expenses and reconciliation', icon: Wallet },
  { title: 'Reports & Analytics', description: 'Performance from real business activity', icon: BarChart3 },
  { title: 'Marketing', description: 'Promotions and customer engagement', icon: Megaphone },
  { title: 'Appointments', description: 'Bookings and service schedules', icon: CalendarDays },
  { title: 'Team', description: 'Staff, roles and access', icon: Users },
  { title: 'Storefront Designer', description: 'Your public business presence', icon: Palette },
  { title: 'Settings', description: 'Business profile and preferences', icon: Store },
];

function readableRole(value?: string | null) {
  return value ? value.replace(/_/g, ' ').toUpperCase() : 'BUSINESS MEMBER';
}

function isAuthenticationError(message: string) {
  const value = message.toLowerCase();
  return (
    value.includes('unauthorized') ||
    value.includes('please sign in') ||
    value.includes('token expired')
  );
}

export default function BusinessWorkspaceScreen() {
  const params = useLocalSearchParams<{ businessId: string | string[] }>();
  const businessId = Array.isArray(params.businessId)
    ? params.businessId[0]
    : params.businessId;

  const [workspace, setWorkspace] =
    useState<BusinessWorkspaceDetails | null>(null);
  const [overview, setOverview] =
    useState<BusinessWorkspaceOverview | null>(null);
  const [overviewError, setOverviewError] = useState('');
  const [loading, setLoading] = useState(true);
  const [refreshing, setRefreshing] = useState(false);
  const [error, setError] = useState('');

  const loadOverview = useCallback(async () => {
    if (!businessId) return;

    try {
      const overviewResult = await getBusinessWorkspaceOverview(businessId);
      setOverview(overviewResult);
      setOverviewError('');
    } catch (overviewErr) {
      setOverview(null);
      setOverviewError(
        overviewErr instanceof Error
          ? overviewErr.message
          : 'Unable to load business overview data.',
      );
    }
  }, [businessId]);

  const loadWorkspace = useCallback(async () => {
    if (!businessId) {
      setError('The business workspace could not be identified.');
      setLoading(false);
      setRefreshing(false);
      return;
    }

    setError('');

    try {
      const result = await getApprovedBusinessWorkspace(businessId);
      setWorkspace(result);

      // Load the workspace first. Dashboard data must never block access.
      setLoading(false);
      setRefreshing(false);

      // Fetch supplementary dashboard data independently.
      void loadOverview();
    } catch (err) {
      const message = err instanceof Error
        ? err.message
        : 'Unable to load this business workspace.';

      setWorkspace(null);
      setError(message);

      if (isAuthenticationError(message)) {
        await clearBusinessOwnerToken();
        router.replace('/business/login');
      }
    } finally {
      setLoading(false);
      setRefreshing(false);
    }
  }, [businessId, loadOverview]);

  useEffect(() => {
    void loadWorkspace();
  }, [loadWorkspace]);

  function backToApplications() {
    router.replace('/business/application');
  }

  if (loading) {
    return (
      <SafeAreaView style={styles.safeArea}>
        <StatusBar barStyle="light-content" />
        <View style={styles.centerState}>
          <ActivityIndicator size="large" color={C.lime} />
          <Text style={styles.stateTitle}>Securing your workspace</Text>
          <Text style={styles.stateText}>
            Verifying business approval and your access permissions...
          </Text>
        </View>
      </SafeAreaView>
    );
  }

  if (!workspace) {
    return (
      <SafeAreaView style={styles.safeArea}>
        <StatusBar barStyle="light-content" />
        <View style={styles.failurePage}>
          <View style={styles.failureIcon}>
            <AlertCircle size={25} color={C.amber} />
          </View>
          <Text style={styles.failureTitle}>Workspace unavailable</Text>
          <Text style={styles.failureText}>
            {error || 'This workspace is not currently available to your account.'}
          </Text>
          <Text style={styles.failureHint}>
            MAKAZII checks your approval and membership whenever you open a
            workspace. If access has changed, operational access is withheld.
          </Text>

          <Pressable style={styles.primaryButton} onPress={backToApplications}>
            <ArrowLeft size={17} color={C.background} />
            <Text style={styles.primaryButtonText}>
              Return to application centre
            </Text>
          </Pressable>

          <Pressable
            style={styles.secondaryButton}
            onPress={() => {
              setLoading(true);
              void loadWorkspace();
            }}
          >
            <RefreshCw size={16} color={C.lime} />
            <Text style={styles.secondaryButtonText}>Try again</Text>
          </Pressable>
        </View>
      </SafeAreaView>
    );
  }

  const category = workspace.categoryLabel || workspace.category || 'Business';

  return (
    <SafeAreaView style={styles.safeArea}>
      <StatusBar barStyle="light-content" />

      <View style={styles.topBar}>
        <Pressable
          style={styles.backButton}
          onPress={backToApplications}
          accessibilityRole="button"
          accessibilityLabel="Back to application centre"
        >
          <ArrowLeft size={19} color={C.white} />
        </Pressable>

        <View style={styles.brandBlock}>
          <Text style={styles.eyebrow}>MAKAZII BUSINESS</Text>
          <Text style={styles.topTitle}>Business workspace</Text>
        </View>

        <View style={styles.secureMark}>
          <ShieldCheck size={19} color={C.green} />
        </View>
      </View>

      <ScrollView
        contentContainerStyle={styles.scrollContent}
        showsVerticalScrollIndicator={false}
        refreshControl={
          <RefreshControl
            refreshing={refreshing}
            onRefresh={() => {
              setRefreshing(true);
              void loadWorkspace();
            }}
            tintColor={C.lime}
            colors={[C.lime]}
            progressBackgroundColor={C.card}
          />
        }
      >
        <View style={styles.heroCard}>
          <View style={styles.heroTopRow}>
            <View style={styles.businessMark}>
              <Store size={25} color={C.lime} />
            </View>

            <View style={styles.verifiedPill}>
              <View style={styles.verifiedDot} />
              <Text style={styles.verifiedText}>ACCESS VERIFIED</Text>
            </View>
          </View>

          <Text style={styles.businessName}>{workspace.name}</Text>
          <Text style={styles.businessCategory}>{category}</Text>

          <View style={styles.heroDivider} />

          <View style={styles.heroMetaRow}>
            <View>
              <Text style={styles.metaLabel}>YOUR ACCESS</Text>
              <Text style={styles.metaValue}>
                {readableRole(workspace.membershipRole)}
              </Text>
            </View>

            <View style={styles.metaRight}>
              <Text style={styles.metaLabel}>WORKSPACE STATUS</Text>
              <Text style={[styles.metaValue, { color: C.green }]}>
                ACTIVE ACCESS
              </Text>
            </View>
          </View>
        </View>

        <View style={styles.overviewIntro}>
          <View style={styles.overviewIntroIcon}>
            <LayoutDashboard size={19} color={C.lime} />
          </View>
          <View style={styles.overviewIntroCopy}>
            <Text style={styles.overviewEyebrow}>BUSINESS OVERVIEW</Text>
            <Text style={styles.sectionTitle}>Your business at a glance</Text>
            <Text style={styles.sectionDescription}>
              A live view of your business setup and daily operations.
            </Text>
          </View>
        </View>

        {overview ? (
          <>
            <View style={styles.overviewStatsGrid}>
              <View style={styles.overviewStatCard}>
                <View style={styles.overviewStatTop}>
                  <Package size={17} color={C.lime} />
                  <Text style={styles.overviewStatLabel}>CATALOGUE</Text>
                </View>
                <Text style={styles.overviewStatValue}>
                  {overview.catalogue.publishedItems.toLocaleString('en-KE')}
                </Text>
                <Text style={styles.overviewStatHint}>
                  Published of {overview.catalogue.totalItems.toLocaleString('en-KE')} items
                </Text>
              </View>

              <View style={styles.overviewStatCard}>
                <View style={styles.overviewStatTop}>
                  <Boxes size={17} color={C.lime} />
                  <Text style={styles.overviewStatLabel}>STOCK UNITS</Text>
                </View>
                <Text style={styles.overviewStatValue}>
                  {overview.inventory.totalTrackedUnits.toLocaleString('en-KE')}
                </Text>
                <Text style={styles.overviewStatHint}>
                  Across {overview.inventory.trackedRecords.toLocaleString('en-KE')} tracked records
                </Text>
              </View>

              <View style={styles.overviewStatCard}>
                <View style={styles.overviewStatTop}>
                  <Store size={17} color={C.lime} />
                  <Text style={styles.overviewStatLabel}>STOREFRONT</Text>
                </View>
                <Text style={[
                  styles.overviewStatValue,
                  { fontSize: 15, color: overview.readiness.storefrontPublished ? C.green : C.amber },
                ]}>
                  {overview.readiness.storefrontPublished ? 'PUBLISHED' : 'NOT PUBLISHED'}
                </Text>
                <Text style={styles.overviewStatHint}>
                  {overview.storefront.publishedAt
                    ? `Live since ${new Date(overview.storefront.publishedAt).toLocaleDateString('en-KE', { day: 'numeric', month: 'short', year: 'numeric' })}`
                    : 'Public storefront status'}
                </Text>
              </View>

              <View style={styles.overviewStatCard}>
                <View style={styles.overviewStatTop}>
                  <ShieldCheck size={17} color={C.lime} />
                  <Text style={styles.overviewStatLabel}>LOCATIONS</Text>
                </View>
                <Text style={styles.overviewStatValue}>
                  {overview.locations.verified.toLocaleString('en-KE')}
                  <Text style={styles.overviewStatTotal}>
                    {' '}/ {overview.locations.active.toLocaleString('en-KE')}
                  </Text>
                </Text>
                <Text style={styles.overviewStatHint}>Verified active locations</Text>
              </View>
            </View>

          </>
        ) : (
          <View style={styles.overviewUnavailable}>
            <AlertCircle size={19} color={C.amber} />
            <View style={styles.overviewUnavailableCopy}>
              <Text style={styles.healthTitle}>Overview data unavailable</Text>
              <Text style={styles.healthDetail}>
                {overviewError || 'The business overview has not loaded yet.'}
              </Text>
              <Pressable
                onPress={() => {
                  void loadOverview();
                }}
                style={styles.overviewRetry}
              >
                <RefreshCw size={14} color={C.lime} />
                <Text style={styles.overviewRetryText}>Try again</Text>
              </Pressable>
            </View>
          </View>
        )}

        <Pressable
          style={styles.setupCard}
          onPress={() =>
            router.push((`/business/workspace/${encodeURIComponent(businessId)}/setup`) as any)
          }
          accessibilityRole="button"
          accessibilityLabel="Open business profile setup"
        >
          <View style={styles.setupIcon}>
            <BarChart3 size={20} color={C.lime} />
          </View>
          <View style={styles.setupCopy}>
            <Text style={styles.setupTitle}>
              Set up your business profile
            </Text>
            <Text style={styles.setupText}>
              Configure your public business name, description, contact
              details and location, then personalise your storefront.
            </Text>
          </View>
          <ChevronRight size={18} color={C.muted} />
        </Pressable>

        <View style={styles.sectionHeading}>
          <View>
            <Text style={styles.sectionTitle}>Business operations</Text>
            <Text style={styles.sectionDescription}>
              One platform. Connected business tools.
            </Text>
          </View>

          <View style={styles.moduleCountPill}>
            <Text style={styles.moduleCountText}>
              {MODULES.length} MODULES
            </Text>
          </View>
        </View>

        <View style={styles.moduleGrid}>
          {MODULES.map((item) => {
            const Icon = item.icon;
            const isCatalogue = item.title === 'Catalogue';
            const isStorefront = item.title === 'Storefront Designer';
            const isSettings = item.title === 'Settings';
            const isAvailable = isCatalogue || isStorefront || isSettings;

            const openModule = () => {
              if (isCatalogue) {
                router.push((`/business/workspace/${encodeURIComponent(businessId)}/catalogue`) as any);
              } else if (isStorefront) {
                router.push(
                  (`/business/workspace/${encodeURIComponent(businessId)}/storefront`) as any
                );
              } else if (isSettings) {
                router.push(
                  (`/business/workspace/${encodeURIComponent(businessId)}/setup`) as any
                );
              }
            };

            const cardContent = (
              <>
                <View style={styles.moduleIcon}>
                  <Icon size={20} color={C.lime} />
                </View>
                <Text style={styles.moduleTitle}>{item.title}</Text>
                <Text style={styles.moduleDescription}>
                  {item.description}
                </Text>
                <View style={styles.comingSoonRow}>
                  <View
                    style={[
                      styles.comingSoonDot,
                      isAvailable && { backgroundColor: C.green },
                    ]}
                  />
                  <Text
                    style={[
                      styles.comingSoonText,
                      isAvailable && { color: C.green },
                    ]}
                  >
                    {isCatalogue
                      ? 'Manage catalogue'
                      : isStorefront
                        ? 'Open designer'
                        : isSettings
                          ? 'Configure profile'
                          : 'Coming soon'}
                  </Text>
                  {isAvailable && (
                    <ChevronRight size={13} color={C.lime} />
                  )}
                </View>
              </>
            );

            return isAvailable ? (
              <Pressable
                key={item.title}
                style={styles.moduleCard}
                onPress={openModule}
                accessibilityRole="button"
                accessibilityLabel={`Open ${item.title}`}
              >
                {cardContent}
              </Pressable>
            ) : (
              <View key={item.title} style={styles.moduleCard}>
                {cardContent}
              </View>
            );
          })}
        </View>

        <View style={styles.footerNote}>
          <ShieldCheck size={17} color={C.green} />
          <Text style={styles.footerText}>
            Business data and operations will remain separated between
            businesses under the same owner account. Access is revalidated
            by the server whenever this workspace is opened.
          </Text>
        </View>

        <Pressable
          style={styles.switchBusinessButton}
          onPress={backToApplications}
        >
          <Text style={styles.switchBusinessText}>
            Switch business / application centre
          </Text>
          <ArrowRight size={16} color={C.lime} />
        </Pressable>
      </ScrollView>
    </SafeAreaView>
  );
}

