export function ErrorBoundary({
  error,
  retry,
}: {
  error: Error;
  retry: () => void;
}) {
  return (
    <SafeAreaView
      style={{
        flex: 1,
        backgroundColor: '#0B0F10',
        justifyContent: 'center',
        padding: 24,
      }}
    >
      <StatusBar barStyle="light-content" />

      <View
        style={{
          backgroundColor: '#14191B',
          borderColor: '#FF6B6B',
          borderWidth: 1,
          borderRadius: 18,
          padding: 20,
        }}
      >
        <Text
          style={{
            color: '#FF6B6B',
            fontSize: 17,
            fontWeight: '900',
            marginBottom: 12,
          }}
        >
          Business application error
        </Text>

        <Text
          selectable
          style={{
            color: '#FFFFFF',
            fontSize: 13,
            lineHeight: 21,
          }}
        >
          {error?.message || 'An unknown application error occurred.'}
        </Text>

        <Pressable
          onPress={retry}
          style={{
            backgroundColor: '#D7FF5F',
            padding: 15,
            borderRadius: 12,
            marginTop: 20,
            alignItems: 'center',
          }}
        >
          <Text style={{ color: '#0B0F10', fontWeight: '900' }}>
            Try again
          </Text>
        </Pressable>
      </View>
    </SafeAreaView>
  );
}
