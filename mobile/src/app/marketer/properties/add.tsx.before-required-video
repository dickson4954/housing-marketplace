function Section({
  number,
  title,
  subtitle,
  open,
  onPress,
  children,
}: {
  number: string;
  title: string;
  subtitle: string;
  open: boolean;
  onPress: () => void;
  children: React.ReactNode;
}) {
  return (
    <View style={styles.section}>
      <Pressable
        style={styles.sectionHeader}
        onPress={onPress}
      >
        <View
          style={styles.sectionNumber}
        >
          <Text
            style={
              styles.sectionNumberText
            }
          >
            {number}
          </Text>
        </View>

        <View
          style={
            styles.sectionHeaderText
          }
        >
          <Text
            style={styles.sectionTitle}
          >
            {title}
          </Text>

          <Text
            style={
              styles.sectionSubtitle
            }
          >
            {subtitle}
          </Text>
        </View>

        <ChevronDown
          size={19}
          color="#9CA5A7"
          style={
            open
              ? styles.rotated
              : undefined
          }
        />
      </Pressable>

      {open ? (
        <View
          style={styles.sectionBody}
        >
          {children}
        </View>
      ) : null}
    </View>
  );
}

