}

function Field({
  label,
  required,
  placeholder,
  value,
  onChangeText,
}: {
  label: string;
  required?: boolean;
  placeholder: string;
  value: string;
  onChangeText: (
    value: string,
  ) => void;
}) {
  return (
    <>
      <Text style={styles.label}>
        {label}
        {required ? " *" : ""}
      </Text>

      <TextInput
        style={styles.input}
        value={value}
        onChangeText={onChangeText}
        placeholder={placeholder}
        placeholderTextColor="#687174"
      />
    </>
  );
}

function MoneyField({
  label,
  required,
  placeholder,
  value,
  onChangeText,
}: {
  label: string;
  required?: boolean;
  placeholder: string;
  value: string;
  onChangeText: (
    value: string,
  ) => void;
}) {
  return (
    <>
      <Text style={styles.label}>
        {label}
        {required ? " *" : ""}
      </Text>

      <View
        style={styles.moneyInput}
      >
        <Text
          style={styles.currency}
        >
          KES
        </Text>

        <TextInput
          style={
            styles.moneyTextInput
          }
          value={value}
          onChangeText={
            onChangeText
          }
          placeholder={
            placeholder
          }
          placeholderTextColor="#687174"
          keyboardType="numeric"
        />
      </View>
    </>
  );
}

function NumberField({
  label,
  required,
  placeholder,
  value,
  onChangeText,
}: {
  label: string;
  required?: boolean;
  placeholder: string;
  value: string;
  onChangeText: (
    value: string,
  ) => void;
}) {
  return (
    <View
      style={styles.gridItem}
    >
      <Text style={styles.label}>
        {label}
        {required ? " *" : ""}
      </Text>

      <TextInput
        style={styles.input}
        value={value}
        onChangeText={(value) =>
          onChangeText(
            value.replace(
              /[^\d]/g,
              "",
            ),
          )
        }
        placeholder={placeholder}
        placeholderTextColor="#687174"
        keyboardType="number-pad"
      />
    </View>
  );
}

function DropdownButton({
  label,
  open,
  onPress,
}: {
  label: string;
  open: boolean;
  onPress: () => void;
}) {
  return (
    <Pressable
      style={
        styles.dropdownButton
      }
      onPress={onPress}
    >
      <Text
        style={[
          styles.dropdownButtonText,
          label.startsWith(
            "Select",
          ) &&
            styles.dropdownPlaceholder,
        ]}
      >
        {label}
      </Text>

      <ChevronDown
        size={18}
        color="#9CA5A7"
        style={
          open
            ? styles.rotated
            : undefined
        }
      />
    </Pressable>
  );
}

function LocationField({
  label,
  value,
  locked,
}: {
  label: string;
  value: string;
  locked?: boolean;
}) {
  return (
    <>
      <Text style={styles.label}>
        {label}
      </Text>

      <View
        style={
          styles.locationLocked
        }
      >
        <View
          style={
            styles.dropdownButtonLeft
          }
        >
          <MapPin
            size={17}
            color="#687174"
          />

          <Text
            style={
              styles.locationLockedText
            }
          >
            {value}
          </Text>
        </View>

        {locked ? (
          <ShieldCheck
            size={17}
            color="#687174"
          />
        ) : null}
      </View>
    </>
  );
}

