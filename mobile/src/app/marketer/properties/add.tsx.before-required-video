  value: LongStayType;
  label: string;
}> = [
  { value: "SINGLE_ROOM", label: "Single Room" },
  { value: "BEDSITTER", label: "Bedsitter" },
  { value: "STUDIO", label: "Studio" },
  { value: "ONE_BEDROOM", label: "1 Bedroom" },
  { value: "TWO_BEDROOM", label: "2 Bedrooms" },
  { value: "THREE_BEDROOM", label: "3 Bedrooms" },
  { value: "FOUR_PLUS_BEDROOM", label: "4+ Bedrooms" },
  { value: "HOUSE", label: "House" },
  { value: "APARTMENT", label: "Apartment" },
];

const SHORT_STAY_TYPES: Array<{
  value: ShortStayType;
  label: string;
}> = [
  { value: "BNB", label: "BnB" },
  { value: "LODGE", label: "Lodge" },
  { value: "GUEST_HOUSE", label: "Guest House" },
  { value: "HOTEL_ROOM", label: "Hotel Room" },
  { value: "SERVICED_APARTMENT", label: "Serviced Apartment" },
  { value: "FURNISHED_APARTMENT", label: "Furnished Apartment" },
  { value: "HOLIDAY_HOME", label: "Holiday Home" },
  { value: "VILLA", label: "Villa" },
  { value: "COTTAGE", label: "Cottage" },
  { value: "HOSTEL", label: "Hostel" },
  { value: "PRIVATE_ROOM", label: "Private Room" },
];

const STAY_MODES: Array<{
  value: StayMode;
  label: string;
}> = [
  { value: "DAY", label: "Day" },
  { value: "OVERNIGHT", label: "Overnight" },
  { value: "DAY_AND_NIGHT", label: "Day & Night" },
  { value: "FLEXIBLE", label: "Flexible" },
];

const FURNISHING_TYPES: Array<{
  value: FurnishingType;
  label: string;
}> = [
  { value: "UNFURNISHED", label: "Unfurnished" },
  { value: "SEMI_FURNISHED", label: "Semi-furnished" },
  { value: "FURNISHED", label: "Furnished" },
];

const API_BASE = API_BASE_URL.replace(/\/$/, "");

async function getMarketerToken(): Promise<string | null> {
  if (Platform.OS === "web") {
    try {
      return window.localStorage.getItem("makazii_marketer_token");
    } catch {
      return null;
    }
  }

  return SecureStore.getItemAsync("makazii_marketer_token");
}

async function authenticatedFetch(
  endpoint: string,
  options: RequestInit = {},
): Promise<Response> {
  const token = await getMarketerToken();

  if (!token) {
    throw new Error(
      "Your marketer session has expired. Please log in again.",
    );
  }

  const headers = new Headers(options.headers);

  headers.set("Authorization", `Bearer ${token}`);
  headers.set("Content-Type", "application/json");
  headers.set("Accept", "application/json");

  return fetch(`${API_BASE}${endpoint}`, {
    ...options,
    headers,
  });
}

function parseMoney(value: string): number | undefined {
  const cleaned = value.replace(/[^\d]/g, "");

  if (!cleaned) {
    return undefined;
  }

  const parsed = Number(cleaned);

  return Number.isFinite(parsed) ? parsed : undefined;
}

function parseInteger(value: string): number | undefined {
  const cleaned = value.replace(/[^\d]/g, "");

  if (!cleaned) {
    return undefined;
  }

  const parsed = Number(cleaned);

  return Number.isInteger(parsed) ? parsed : undefined;
}

function formatMoneyInput(value: string): string {
  const digits = value.replace(/[^\d]/g, "");

  if (!digits) {
    return "";
  }

  return Number(digits).toLocaleString("en-KE");
}

function labelForLongStayType(
  value: LongStayType | null,
): string {
  return (
    LONG_STAY_TYPES.find((item) => item.value === value)?.label ??
    "Select accommodation type"
  );
}

function labelForShortStayType(
  value: ShortStayType | null,
): string {
  return (
    SHORT_STAY_TYPES.find((item) => item.value === value)?.label ??
    "Select accommodation type"
  );
}

function labelForStayMode(
  value: StayMode | null,
): string {
  return (
    STAY_MODES.find((item) => item.value === value)?.label ??
    "Select stay mode"
  );
}

function labelForFurnishing(
  value: FurnishingType | null,
): string {
  return (
    FURNISHING_TYPES.find((item) => item.value === value)?.label ??
    "Select furnishing"
  );
}

export default function AddMarketerPropertyScreen() {
  const [purpose, setPurpose] =
    useState<PropertyPurpose>("LONG_STAY");

  const [title, setTitle] = useState("");
  const [description, setDescription] = useState("");

  const [longStayType, setLongStayType] =
    useState<LongStayType | null>(null);

  const [shortStayType, setShortStayType] =
    useState<ShortStayType | null>(null);

  const [stayMode, setStayMode] =
    useState<StayMode | null>(null);

  const [furnishing, setFurnishing] =
    useState<FurnishingType | null>(null);

  const [monthlyRent, setMonthlyRent] = useState("");
  const [deposit, setDeposit] = useState("");
  const [viewingFee, setViewingFee] = useState("");
  const [serviceCharge, setServiceCharge] = useState("");

  const [dayRate, setDayRate] = useState("");
  const [nightRate, setNightRate] = useState("");
  const [dayNightRate, setDayNightRate] = useState("");

  const [bedrooms, setBedrooms] = useState("");
  const [bathrooms, setBathrooms] = useState("");
  const [beds, setBeds] = useState("");
  const [maxGuests, setMaxGuests] = useState("");
  const [rooms, setRooms] = useState("");

  const [marketer, setMarketer] =
    useState<Marketer | null>(null);

  const [amenities, setAmenities] =
    useState<Amenity[]>([]);

  const [selectedAmenityIds, setSelectedAmenityIds] =
    useState<string[]>([]);

  const [countyId, setCountyId] = useState("");
  const [constituencyId, setConstituencyId] =
    useState("");
  const [wardId, setWardId] = useState("");

  const [openSection, setOpenSection] = useState<
    | "purpose"
    | "basic"
    | "pricing"
    | "details"
    | "location"
    | "amenities"
    | "images"
    | null
  >("purpose");

  const [openDropdown, setOpenDropdown] = useState<
    | "accommodation"
    | "stayMode"
    | "furnishing"
    | "ward"
    | null
  >(null);

  const [loadingInitial, setLoadingInitial] =
    useState(true);

  const [saving, setSaving] = useState(false);
  const [error, setError] = useState("");
  const [fieldError, setFieldError] = useState("");

  const coverage = marketer?.coverage;

  const coverageCounty = coverage?.county ?? null;

  const coverageConstituency =
    coverage?.constituency ?? null;

  const coverageWards = coverage?.wards ?? [];

  const selectedWard = useMemo(
    () =>
      coverageWards.find(
        (ward) => ward.id === wardId,
      ) ?? null,
    [coverageWards, wardId],
  );

  const selectedPurposeLabel =
    purpose === "LONG_STAY"
      ? "Long Stay"
      : "Short Stay";

  useEffect(() => {
    let mounted = true;

    async function loadInitialData() {
      try {
        setLoadingInitial(true);
        setError("");

        const marketerEndpoint =
          API_ENDPOINTS.marketerMe ?? "/marketer/me";

        const amenitiesEndpoint =
          API_ENDPOINTS.marketerAmenities ??
          "/marketer/amenities";

        const [
          marketerResponse,
          amenitiesResponse,
        ] = await Promise.all([
          authenticatedFetch(marketerEndpoint),
          authenticatedFetch(amenitiesEndpoint),
        ]);

        const marketerJson =
          (await marketerResponse.json()) as ApiResult<Marketer>;

        const amenitiesJson =
          (await amenitiesResponse.json()) as ApiResult<
            Amenity[]
          >;

        if (
          !marketerResponse.ok ||
          !marketerJson.success
        ) {
          throw new Error(
            marketerJson.message ??
              "Failed to load your marketer profile.",
          );
        }

        if (
          !amenitiesResponse.ok ||
          !amenitiesJson.success
        ) {
          throw new Error(
            amenitiesJson.message ??
              "Failed to load amenities.",
          );
        }

        if (!mounted) {
          return;
        }

        const marketerData =
          marketerJson.data ?? null;

        const coverageData =
          marketerData?.coverage;

        if (
          !coverageData?.county?.id ||
          !coverageData?.constituency?.id ||
          !coverageData?.wards?.length
        ) {
          throw new Error(
            "Your marketer coverage is incomplete. You need an approved county, constituency and at least one ward before adding a property.",
          );
        }

        setMarketer(marketerData);

        setAmenities(
          amenitiesJson.amenities ??
            amenitiesJson.data ??
            [],
        );

        setCountyId(
          coverageData.county.id,
        );

        setConstituencyId(
          coverageData.constituency.id,
        );

        if (coverageData.wards.length === 1) {
          setWardId(
            coverageData.wards[0].id,
          );
        }
      } catch (loadError) {
        if (!mounted) {
          return;
        }

        setError(
          loadError instanceof Error
            ? loadError.message
            : "Failed to load property form.",
        );
      } finally {
        if (mounted) {
          setLoadingInitial(false);
        }
      }
    }

    loadInitialData();

    return () => {
      mounted = false;
    };
  }, []);

  function toggleSection(
    section:
      | "purpose"
      | "basic"
      | "pricing"
      | "details"
      | "location"
      | "amenities"
      | "images",
  ) {
    setOpenDropdown(null);

    setOpenSection((current) =>
      current === section ? null : section,
    );
  }

  function toggleDropdown(
    dropdown:
      | "accommodation"
      | "stayMode"
      | "furnishing"
      | "ward",
  ) {
    setOpenDropdown((current) =>
      current === dropdown ? null : dropdown,
    );
  }

  function resetTypeFields(
    nextPurpose: PropertyPurpose,
  ) {
    setPurpose(nextPurpose);

    setLongStayType(null);
    setShortStayType(null);
    setStayMode(null);

    setOpenDropdown(null);

    if (nextPurpose === "LONG_STAY") {
      setDayRate("");
      setNightRate("");
      setDayNightRate("");
      setBeds("");
      setMaxGuests("");
      setRooms("");
    } else {
      setMonthlyRent("");
      setDeposit("");
      setServiceCharge("");
    }

    setFieldError("");
  }

  function toggleAmenity(id: string) {
    setSelectedAmenityIds((current) =>
      current.includes(id)
        ? current.filter((item) => item !== id)
        : [...current, id],
    );
  }

  function validate(): Record<
    string,
    unknown
  > | null {
    setFieldError("");

    const trimmedTitle = title.trim();

    if (trimmedTitle.length < 3) {
      setFieldError(
        "Property title must be at least 3 characters.",
      );
      return null;
    }

    if (
      !countyId ||
      !constituencyId ||
      !wardId
    ) {
      setFieldError(
        "County, constituency and ward are required.",
      );
      return null;
    }

    if (purpose === "LONG_STAY") {
      if (!longStayType) {
        setFieldError(
          "Select the long-stay accommodation type.",
        );
        return null;
      }

      const rent = parseMoney(monthlyRent);

      if (!rent || rent <= 0) {
        setFieldError(
          "Monthly rent must be greater than zero.",
        );
        return null;
      }

      return {
        title: trimmedTitle,
        description:
          description.trim() || undefined,

        purpose: "LONG_STAY",

        longStayType,
        shortStayType: undefined,

        monthlyRent: rent,
        deposit: parseMoney(deposit),
        viewingFee: parseMoney(viewingFee),
        serviceCharge:
          parseMoney(serviceCharge),

        dayRate: undefined,
        nightRate: undefined,
        dayNightRate: undefined,
        stayMode: undefined,

        bedrooms: parseInteger(bedrooms),
        bathrooms: parseInteger(bathrooms),
        beds: undefined,
        maxGuests: undefined,
        rooms: undefined,

        furnishing:
          furnishing ?? undefined,

        countyId,
        constituencyId,
        wardId,

        available: true,

        amenityIds: selectedAmenityIds,
      };
    }

    if (!shortStayType) {
      setFieldError(
        "Select the short-stay accommodation type.",
      );
      return null;
    }

    if (!stayMode) {
      setFieldError(
        "Select how guests can book the stay.",
      );
      return null;
    }

    const parsedDayRate =
      parseMoney(dayRate);

    const parsedNightRate =
      parseMoney(nightRate);

    const parsedDayNightRate =
      parseMoney(dayNightRate);

    const parsedMaxGuests =
      parseInteger(maxGuests);

    const parsedRooms =
      parseInteger(rooms);

    if (
      stayMode === "DAY" &&
      (!parsedDayRate ||
        parsedDayRate <= 0)
    ) {
      setFieldError(
        "Day rate must be greater than zero.",
      );
      return null;
    }

    if (
      stayMode === "OVERNIGHT" &&
      (!parsedNightRate ||
        parsedNightRate <= 0)
    ) {
      setFieldError(
        "Night rate must be greater than zero.",
      );
      return null;
    }

    if (
      stayMode === "DAY_AND_NIGHT" &&
      (!parsedDayNightRate ||
        parsedDayNightRate <= 0)
    ) {
      setFieldError(
        "Day-and-night rate must be greater than zero.",
      );
      return null;
    }

    if (
      stayMode === "FLEXIBLE" &&
      !parsedDayRate &&
      !parsedNightRate &&
      !parsedDayNightRate
    ) {
      setFieldError(
        "Add at least one short-stay rate for flexible stays.",
      );
      return null;
    }

    if (
      !parsedMaxGuests ||
      parsedMaxGuests <= 0
    ) {
      setFieldError(
        "Maximum guests must be greater than zero.",
      );
      return null;
    }

    if (
      !parsedRooms ||
      parsedRooms <= 0
    ) {
      setFieldError(
        "Number of rooms must be greater than zero.",
      );
      return null;
    }

    const parsedViewingFee =
      parseMoney(viewingFee);

    if (
      !parsedViewingFee ||
      parsedViewingFee <= 0
    ) {
      setFieldError(
        "Viewing / inspection fee must be greater than zero.",
      );
      return null;
    }

    return {
      title: trimmedTitle,
      description:
        description.trim() || undefined,

      purpose: "SHORT_STAY",

      longStayType: undefined,
      shortStayType,

      monthlyRent: undefined,
      deposit: undefined,

      viewingFee:
        parsedViewingFee,

      serviceCharge: undefined,

      dayRate: parsedDayRate,
      nightRate: parsedNightRate,
      dayNightRate:
        parsedDayNightRate,

      stayMode,

      bedrooms:
        parseInteger(bedrooms),
      bathrooms:
        parseInteger(bathrooms),
      beds:
        parseInteger(beds),

      maxGuests:
        parsedMaxGuests,

      rooms:
        parsedRooms,

      furnishing:
        furnishing ?? undefined,

      countyId,
      constituencyId,
      wardId,

      available: true,

      amenityIds:
        selectedAmenityIds,
    };
  }

  async function createProperty(
    submitForReview: boolean,
  ) {
    if (saving) {
      return;
    }

    const payload = validate();

    if (!payload) {
      return;
    }

    try {
      setSaving(true);
      setError("");

      const response =
        await authenticatedFetch(
          API_ENDPOINTS.marketerProperties ??
            "/marketer/properties",
          {
            method: "POST",
            body: JSON.stringify(payload),
          },
        );

      const json =
        (await response.json()) as ApiResult<{
          id: string;
        }>;

      if (
        !response.ok ||
        !json.success ||
        !json.data?.id
      ) {
        throw new Error(
          json.message ??
            "Failed to create property.",
        );
      }

      const propertyId =
        json.data.id;

      if (submitForReview) {
        const statusEndpoint =
          API_ENDPOINTS.marketerPropertyStatus(
            propertyId,
          );

        const statusResponse =
          await authenticatedFetch(
            statusEndpoint,
            {
              method: "PATCH",
              body: JSON.stringify({
                status:
                  "PENDING_VERIFICATION",
              }),
            },
          );

        const statusJson =
          (await statusResponse.json()) as ApiResult<unknown>;

        if (
          !statusResponse.ok ||
          !statusJson.success
        ) {
          throw new Error(
            statusJson.message ??
              "Property was saved, but it could not be submitted for verification.",
          );
        }
      }

      Alert.alert(
        submitForReview
          ? "Submitted"
          : "Draft saved",

        submitForReview
          ? "Your property has been submitted to Makazii for verification."
          : "Your property has been saved as a draft.",

        [
          {
            text: "OK",
            onPress: () => {
              router.replace(
                "/marketer/properties",
              );
            },
          },
        ],
      );
    } catch (saveError) {
      setError(
        saveError instanceof Error
          ? saveError.message
          : "Failed to save property.",
      );
    } finally {
      setSaving(false);
    }
  }

  if (loadingInitial) {
    return (
      <View style={styles.loadingScreen}>
        <ActivityIndicator
          size="large"
          color="#D7FF5F"
        />

        <Text style={styles.loadingText}>
          Loading property setup...
        </Text>
      </View>
    );
  }

  return (
    <View style={styles.screen}>
      <KeyboardAvoidingView
        style={styles.flex}
        behavior={
          Platform.OS === "ios"
            ? "padding"
            : undefined
        }
      >
        <ScrollView
          style={styles.flex}
          contentContainerStyle={
            styles.content
          }
          keyboardShouldPersistTaps="handled"
          showsVerticalScrollIndicator={false}
        >
          <View style={styles.header}>
            <Pressable
              style={styles.backButton}
              onPress={() => router.back()}
            >
              <ArrowLeft
                size={20}
                color="#F5F7F7"
              />
            </Pressable>

            <View style={styles.headerText}>
              <Text style={styles.eyebrow}>
                MARKETER PROPERTIES
              </Text>

              <Text style={styles.title}>
                Add Property
              </Text>

              <Text style={styles.subtitle}>
                Add a property within your
                approved coverage.
              </Text>
            </View>
          </View>

          {error ? (
            <View style={styles.errorBox}>
              <Info
                size={19}
                color="#FF8F8F"
              />

              <Text
                style={styles.errorText}
              >
                {error}
              </Text>
            </View>
          ) : null}

          <Section
            number="01"
            title="Property purpose"
            subtitle="Choose how this accommodation will be offered."
            open={
              openSection === "purpose"
            }
            onPress={() =>
              toggleSection(
                "purpose",
              )
            }
          >
            <View
              style={styles.choiceRow}
            >
              <ChoiceCard
                title="Long Stay"
                subtitle="Monthly rental"
                active={
                  purpose ===
                  "LONG_STAY"
                }
                onPress={() =>
                  resetTypeFields(
                    "LONG_STAY",
                  )
                }
              />

              <ChoiceCard
                title="Short Stay"
                subtitle="Daily accommodation"
                active={
                  purpose ===
                  "SHORT_STAY"
                }
                onPress={() =>
                  resetTypeFields(
                    "SHORT_STAY",
                  )
                }
              />
            </View>
          </Section>

          <Section
            number="02"
            title="Basic information"
            subtitle="Give customers a clear name and description."
            open={
              openSection === "basic"
            }
            onPress={() =>
              toggleSection("basic")
            }
          >
            <Field
              label="Property title"
              required
              placeholder={
                purpose ===
                "LONG_STAY"
                  ? "e.g. Modern 2 Bedroom Apartment"
                  : "e.g. Cozy BnB in Kianjai"
              }
              value={title}
              onChangeText={setTitle}
            />

            <Text style={styles.label}>
              Accommodation type *
            </Text>

            <DropdownButton
              label={
                purpose ===
                "LONG_STAY"
                  ? labelForLongStayType(
                      longStayType,
                    )
                  : labelForShortStayType(
                      shortStayType,
                    )
              }
              open={
                openDropdown ===
                "accommodation"
              }
              onPress={() =>
                toggleDropdown(
                  "accommodation",
                )
              }
            />

            {openDropdown ===
            "accommodation" ? (
              <View
                style={styles.dropdown}
              >
                {(purpose ===
                "LONG_STAY"
                  ? LONG_STAY_TYPES
                  : SHORT_STAY_TYPES
                ).map((item) => {
                  const selected =
                    purpose ===
                    "LONG_STAY"
                      ? longStayType ===
                        item.value
                      : shortStayType ===
                        item.value;

                  return (
                    <Pressable
                      key={item.value}
                      style={[
                        styles.dropdownItem,
                        selected &&
                          styles.dropdownItemActive,
                      ]}
                      onPress={() => {
                        if (
                          purpose ===
                          "LONG_STAY"
                        ) {
                          setLongStayType(
                            item.value as LongStayType,
                          );
                        } else {
                          setShortStayType(
                            item.value as ShortStayType,
                          );
                        }

                        setOpenDropdown(
                          null,
                        );
                      }}
                    >
                      <Text
                        style={[
                          styles.dropdownItemText,
                          selected &&
                            styles.dropdownItemTextActive,
                        ]}
                      >
                        {item.label}
                      </Text>

                      {selected ? (
                        <Check
                          size={18}
                          color="#D7FF5F"
                        />
                      ) : null}
                    </Pressable>
                  );
                })}
