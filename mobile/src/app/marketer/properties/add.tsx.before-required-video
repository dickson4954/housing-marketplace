import {
  ActivityIndicator,
  Alert,
  KeyboardAvoidingView,
  Platform,
  Pressable,
  ScrollView,
  StyleSheet,
  Text,
  TextInput,
  View,
} from "react-native";
import {
  ArrowLeft,
  Check,
  ChevronDown,
  Image as ImageIcon,
  Info,
  MapPin,
  Save,
  Send,
  ShieldCheck,
} from "lucide-react-native";

import { API_BASE_URL, API_ENDPOINTS } from "@/config/api";

type PropertyPurpose = "LONG_STAY" | "SHORT_STAY";

type LongStayType =
  | "SINGLE_ROOM"
  | "BEDSITTER"
  | "STUDIO"
  | "ONE_BEDROOM"
  | "TWO_BEDROOM"
  | "THREE_BEDROOM"
  | "FOUR_PLUS_BEDROOM"
  | "HOUSE"
  | "APARTMENT";

type ShortStayType =
  | "BNB"
  | "LODGE"
  | "GUEST_HOUSE"
  | "HOTEL_ROOM"
  | "SERVICED_APARTMENT"
  | "FURNISHED_APARTMENT"
  | "HOLIDAY_HOME"
  | "VILLA"
  | "COTTAGE"
  | "HOSTEL"
  | "PRIVATE_ROOM";

type StayMode =
  | "DAY"
  | "OVERNIGHT"
  | "DAY_AND_NIGHT"
  | "FLEXIBLE";

type FurnishingType =
  | "UNFURNISHED"
  | "SEMI_FURNISHED"
  | "FURNISHED";

type County = {
  id: string;
  name: string;
};

type Constituency = {
  id: string;
  name: string;
  countyId: string;
};

type Ward = {
  id: string;
  name: string;
  constituencyId: string;
};

type MarketerCoverage = {
  county?: County | null;
  constituency?: Constituency | null;
  wards?: Ward[];
};

type Marketer = {
  coverage?: MarketerCoverage | null;
};

type Amenity = {
  id: string;
  name: string;
  category?: string | null;
  isActive?: boolean;
};

type ApiResult<T> = {
  success: boolean;
  message?: string;
  data?: T;
  amenities?: T;
};

