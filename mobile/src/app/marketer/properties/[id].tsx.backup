import React, {
  useCallback,
  useEffect,
  useMemo,
  useState,
} from 'react';

import {
  ActivityIndicator,
  Alert,
  Image,
  Modal,
  Pressable,
  RefreshControl,
  ScrollView,
  StyleSheet,
  Text,
  TextInput,
  View,
} from 'react-native';

import {
  router,
  useLocalSearchParams,
} from 'expo-router';

import * as SecureStore from 'expo-secure-store';

import {
  AlertCircle,
  ArrowLeft,
  Bath,
  BedDouble,
  Building2,
  Check,
  CheckCircle2,
  ChevronDown,
  Clock3,
  Edit3,
  FileEdit,
  Image as ImageIcon,
  MapPin,
  RefreshCw,
  Save,
  Send,
  X,
  XCircle,
} from 'lucide-react-native';

import { API_BASE_URL } from '@/config/api';

const COLORS = {
  background: '#0B0F10',
  card: '#14191B',
  cardSoft: '#181E20',
  lime: '#D7FF5F',
  white: '#FFFFFF',
  muted: '#9CA5A7',
  border: '#252C2E',
  green: '#65D98A',
  amber: '#F2C94C',
  red: '#FF7070',
  blue: '#72A7FF',
};

type PropertyStatus =
  | 'DRAFT'
  | 'PENDING_VERIFICATION'
  | 'CHANGES_REQUIRED'
  | 'ACTIVE'
  | 'RENTED'
  | 'INACTIVE'
  | 'REJECTED';

type PropertyType =
  | 'SINGLE_ROOM'
  | 'BEDSITTER'
  | 'ONE_BEDROOM'
  | 'TWO_BEDROOM'
  | 'THREE_BEDROOM';

type BackendImage = {
  id: string;
  url: string;
  isCover?: boolean;
  order?: number;
  createdAt?: string;
};

type GeographyItem = {
  id: string;
  name: string;
};

type BackendProperty = {
  id: string;
  title: string;
  description?: string | null;
  propertyType: PropertyType;
  status: PropertyStatus;
  rent: number;
  viewingFee?: number | null;
  deposit?: number | null;

  countyId: string;
  constituencyId: string;
  wardId: string;

  county?: string | null;
  town?: string | null;
  area?: string | null;

  bedrooms?: number | null;
  bathrooms?: number | null;

  available: boolean;
  verified: boolean;

  countyRelation?: GeographyItem | null;
  constituency?: GeographyItem | null;
  ward?: GeographyItem | null;

  images?: BackendImage[];

  amenities?: {
    amenity?: {
      id: string;
      name: string;
    };
  }[];

  statusHistory?: {
    id: string;
    status: string;
    note?: string | null;
    createdAt: string;
  }[];

  _count?: {
    viewingRequests?: number;
    shortlists?: number;
  };
};

type Amenity = {
  id: string;
  name: string;
};

type FormState = {
  title: string;
  description: string;
  propertyType: PropertyType;
  rent: string;
  viewingFee: string;
  deposit: string;
  bedrooms: string;
  bathrooms: string;
  countyId: string;
  constituencyId: string;
  wardId: string;
  amenityIds: string[];
  available: boolean;
};

const PROPERTY_TYPES: {
  value: PropertyType;
  label: string;
}[] = [
  {
    value: 'SINGLE_ROOM',
    label: 'Single Room',
  },
  {
    value: 'BEDSITTER',
    label: 'Bedsitter',
  },
  {
    value: 'ONE_BEDROOM',
    label: '1 Bedroom',
  },
  {
    value: 'TWO_BEDROOM',
    label: '2 Bedroom',
  },
  {
    value: 'THREE_BEDROOM',
    label: '3 Bedroom',
  },
];

async function getToken(): Promise<string | null> {
  if (typeof window !== 'undefined') {
    return window.localStorage.getItem(
      'makazii_marketer_token',
    );
  }

  return SecureStore.getItemAsync(
    'makazii_marketer_token',
  );
}

async function authenticatedFetch(
  path: string,
  options: RequestInit = {},
) {
  const token = await getToken();

  if (!token) {
    throw new Error('MARKETER_AUTH_REQUIRED');
  }

  const headers = new Headers(
    options.headers || {},
  );

  headers.set(
    'Authorization',
    `Bearer ${token}`,
  );

  if (
    options.body &&
    !headers.has('Content-Type')
  ) {
    headers.set(
      'Content-Type',
      'application/json',
    );
  }

  return fetch(
    `${API_BASE_URL}${path}`,
    {
      ...options,
      headers,
    },
  );
}

async function parseResponse(
  response: Response,
) {
  let result: any = null;

  try {
    result = await response.json();
  } catch {
    result = null;
  }

  if (
    !response.ok ||
    !result?.success
  ) {
    throw new Error(
      result?.message ||
        'The server could not complete the request.',
    );
  }

  return result;
}

function propertyTypeLabel(
  type: PropertyType | string,
) {
  switch (type) {
    case 'SINGLE_ROOM':
      return 'Single Room';

    case 'BEDSITTER':
      return 'Bedsitter';

    case 'ONE_BEDROOM':
      return '1 Bedroom';

    case 'TWO_BEDROOM':
      return '2 Bedroom';

    case 'THREE_BEDROOM':
      return '3 Bedroom';

    default:
      return type;
  }
}

function statusLabel(
  status: PropertyStatus,
) {
  switch (status) {
    case 'DRAFT':
      return 'Draft';

    case 'PENDING_VERIFICATION':
      return 'Under Review';

    case 'CHANGES_REQUIRED':
      return 'Changes Required';

    case 'ACTIVE':
      return 'Approved';

    case 'RENTED':
      return 'Rented';

    case 'INACTIVE':
      return 'Inactive';

    case 'REJECTED':
      return 'Rejected';

    default:
      return status;
  }
}

function statusColor(
  status: PropertyStatus,
) {
  switch (status) {
    case 'ACTIVE':
      return COLORS.green;

    case 'PENDING_VERIFICATION':
      return COLORS.amber;

    case 'CHANGES_REQUIRED':
      return COLORS.blue;

    case 'REJECTED':
      return COLORS.red;

    case 'RENTED':
      return COLORS.red;

    case 'INACTIVE':
      return COLORS.muted;

    default:
      return COLORS.muted;
  }
}

function StatusIcon({
  status,
  size = 17,
}: {
  status: PropertyStatus;
  size?: number;
}) {
  switch (status) {
    case 'ACTIVE':
      return (
        <CheckCircle2
          size={size}
          color={COLORS.green}
        />
      );

    case 'PENDING_VERIFICATION':
      return (
        <Clock3
          size={size}
          color={COLORS.amber}
        />
      );

    case 'CHANGES_REQUIRED':
      return (
        <RefreshCw
          size={size}
          color={COLORS.blue}
        />
      );

    case 'REJECTED':
      return (
        <XCircle
          size={size}
          color={COLORS.red}
        />
      );

    default:
      return (
        <FileEdit
          size={size}
          color={COLORS.muted}
        />
      );
  }
}

function formatMoney(
  value?: number | null,
) {
  return `KSh ${Number(value || 0).toLocaleString()}`;
}

function formatDate(
  value: string,
) {
  const date = new Date(value);

  if (Number.isNaN(date.getTime())) {
    return value;
  }

  return date.toLocaleDateString(
    'en-KE',
    {
      day: '2-digit',
      month: 'short',
      year: 'numeric',
    },
  );
}

function getLatestReviewNote(
  property: BackendProperty,
) {
  if (
    property.status !==
      'CHANGES_REQUIRED' &&
    property.status !== 'REJECTED'
  ) {
    return null;
  }

  const history =
    property.statusHistory || [];

  const entry = history.find(
    (item) =>
      item.status === property.status &&
      Boolean(item.note),
  );

  return entry?.note || null;
}

function buildForm(
  property: BackendProperty,
): FormState {
  return {
    title: property.title || '',
    description:
      property.description || '',
    propertyType:
      property.propertyType,
    rent:
      property.rent !== undefined &&
      property.rent !== null
        ? String(property.rent)
        : '',
    viewingFee:
      property.viewingFee !==
        undefined &&
      property.viewingFee !== null
        ? String(property.viewingFee)
        : '',
    deposit:
      property.deposit !==
        undefined &&
      property.deposit !== null
        ? String(property.deposit)
        : '',
    bedrooms:
      property.bedrooms !==
        undefined &&
      property.bedrooms !== null
        ? String(property.bedrooms)
        : '',
    bathrooms:
      property.bathrooms !==
        undefined &&
      property.bathrooms !== null
        ? String(property.bathrooms)
        : '',
    countyId:
      property.countyId || '',
    constituencyId:
      property.constituencyId || '',
    wardId:
      property.wardId || '',
    amenityIds:
      property.amenities
        ?.map(
          (item) =>
            item.amenity?.id,
        )
        .filter(
          (
            value,
          ): value is string =>
            Boolean(value),
        ) || [],
    available:
      Boolean(property.available),
  };
}

export default function MarketerPropertyDetailsScreen() {
  const params =
    useLocalSearchParams<{
      id?: string | string[];
    }>();

  const propertyId = Array.isArray(
    params.id,
  )
    ? params.id[0]
    : params.id;

  const [property, setProperty] =
    useState<BackendProperty | null>(
      null,
    );

  const [form, setForm] =
    useState<FormState | null>(null);

  const [counties, setCounties] =
    useState<GeographyItem[]>([]);

  const [constituencies, setConstituencies] =
    useState<GeographyItem[]>([]);

  const [wards, setWards] =
    useState<GeographyItem[]>([]);

  const [amenities, setAmenities] =
    useState<Amenity[]>([]);

  const [loading, setLoading] =
    useState(true);

  const [refreshing, setRefreshing] =
    useState(false);

  const [saving, setSaving] =
    useState(false);

  const [submitting, setSubmitting] =
    useState(false);

  const [updatingAvailability, setUpdatingAvailability] =
    useState(false);

  const [error, setError] =
    useState('');

  const [editMode, setEditMode] =
    useState(false);

  const [
    showPropertyTypeModal,
    setShowPropertyTypeModal,
  ] = useState(false);

  const [
    showCountyModal,
    setShowCountyModal,
  ] = useState(false);

  const [
    showConstituencyModal,
    setShowConstituencyModal,
  ] = useState(false);

  const [
    showWardModal,
    setShowWardModal,
  ] = useState(false);

  const loadCounties =
    useCallback(async () => {
      const response =
        await fetch(
          `${API_BASE_URL}/geography/counties`,
        );

      const result =
        await response.json();

      if (
        !response.ok ||
        !result.success
      ) {
        throw new Error(
          result.message ||
            'Failed to load counties.',
        );
      }

      const data =
        Array.isArray(
          result.data,
        )
          ? result.data
          : [];

      setCounties(data);
    }, []);

  const loadConstituencies =
    useCallback(
      async (
        countyId: string,
      ) => {
        if (!countyId) {
          setConstituencies([]);
          return;
        }

        const response =
          await fetch(
            `${API_BASE_URL}/geography/counties/${encodeURIComponent(
              countyId,
            )}/constituencies`,
          );

        const result =
          await response.json();

        if (
          !response.ok ||
          !result.success
        ) {
          throw new Error(
            result.message ||
              'Failed to load constituencies.',
          );
        }

        setConstituencies(
          Array.isArray(
            result.data,
          )
            ? result.data
            : [],
        );
      },
      [],
    );

  const loadWards =
    useCallback(
      async (
        constituencyId: string,
      ) => {
        if (!constituencyId) {
          setWards([]);
          return;
        }

        const response =
          await fetch(
            `${API_BASE_URL}/geography/constituencies/${encodeURIComponent(
              constituencyId,
            )}/wards`,
          );

        const result =
          await response.json();

        if (
          !response.ok ||
          !result.success
        ) {
          throw new Error(
            result.message ||
              'Failed to load wards.',
          );
        }

        setWards(
          Array.isArray(
            result.data,
          )
            ? result.data
            : [],
        );
      },
      [],
    );

  const loadAmenities =
    useCallback(async () => {
      const response =
        await authenticatedFetch(
          '/marketer/amenities',
        );

      const result =
        await parseResponse(
          response,
        );

      setAmenities(
        Array.isArray(
          result.amenities,
        )
          ? result.amenities
          : [],
      );
    }, []);

  const loadProperty =
    useCallback(async () => {
      if (!propertyId) {
        throw new Error(
          'Property ID is missing.',
        );
      }

      const response =
        await authenticatedFetch(
          `/marketer/properties/${encodeURIComponent(
            propertyId,
          )}`,
        );

      const result =
        await parseResponse(
          response,
        );

      const data =
        result.data as BackendProperty;

      setProperty(data);
      setForm(buildForm(data));

      await Promise.all([
        loadConstituencies(
          data.countyId,
        ),
        loadWards(
          data.constituencyId,
        ),
      ]);
    }, [
      propertyId,
      loadConstituencies,
      loadWards,
    ]);

  const loadAll =
    useCallback(async () => {
      try {
        setError('');

        await Promise.all([
          loadCounties(),
          loadAmenities(),
          loadProperty(),
        ]);
      } catch (err) {
        const message =
          err instanceof Error
            ? err.message
            : 'Failed to load property.';

        if (
          message ===
          'MARKETER_AUTH_REQUIRED'
        ) {
          setError(
            'Your marketer session is missing. Please log in again.',
          );
        } else {
          setError(message);
        }
      } finally {
        setLoading(false);
        setRefreshing(false);
      }
    }, [
      loadAmenities,
      loadCounties,
      loadProperty,
    ]);

  useEffect(() => {
    loadAll();
  }, [loadAll]);

  const canEdit =
    property !== null &&
    property.status !== 'RENTED';

  const canSubmit =
    property !== null &&
    (property.status === 'DRAFT' ||
      property.status ===
        'CHANGES_REQUIRED');

  const reviewNote = useMemo(
    () =>
      property
        ? getLatestReviewNote(property)
        : null,
    [property],
  );

  const countyName =
    property?.countyRelation?.name ||
    property?.county ||
    '—';

  const constituencyName =
    property?.constituency?.name ||
    '—';

  const wardName =
    property?.ward?.name ||
    '—';

  const selectedAmenities =
    property?.amenities
      ?.map(
        (item) =>
          item.amenity,
      )
      .filter(
        (
          item,
        ): item is Amenity =>
          Boolean(item),
      ) || [];

  const updateForm =
    <K extends keyof FormState>(
      key: K,
      value: FormState[K],
    ) => {
      setForm(
        (current) =>
          current
            ? {
                ...current,
                [key]: value,
              }
            : current,
      );
    };

  const validateForm =
    useCallback(() => {
      if (!form) {
        return 'Property data is not ready.';
      }

      if (
        form.title.trim().length <
        3
      ) {
        return 'Property title must be at least 3 characters.';
      }

      const rent = Number(
        form.rent,
      );

      if (
        !Number.isInteger(rent) ||
        rent <= 0
      ) {
        return 'Monthly rent must be greater than zero.';
      }

      if (
        form.viewingFee.trim() !== ''
      ) {
        const viewingFee =
          Number(
            form.viewingFee,
          );

        if (
          !Number.isInteger(
            viewingFee,
          ) ||
          viewingFee < 0
        ) {
          return 'Viewing fee must be a non-negative whole number.';
        }
      }

      if (
        form.deposit.trim() !== ''
      ) {
        const deposit =
          Number(form.deposit);

        if (
          !Number.isInteger(
            deposit,
          ) ||
          deposit < 0
        ) {
          return 'Deposit must be a non-negative whole number.';
        }
      }

      if (
        form.bedrooms.trim() !== ''
      ) {
        const bedrooms =
          Number(
            form.bedrooms,
          );

        if (
          !Number.isInteger(
            bedrooms,
          ) ||
          bedrooms < 0
        ) {
          return 'Bedrooms must be a non-negative whole number.';
        }
      }

      if (
        form.bathrooms.trim() !==
        ''
      ) {
        const bathrooms =
          Number(
            form.bathrooms,
          );

        if (
          !Number.isInteger(
            bathrooms,
          ) ||
          bathrooms < 0
        ) {
          return 'Bathrooms must be a non-negative whole number.';
        }
      }

      if (!form.countyId) {
        return 'County is required.';
      }

      if (!form.constituencyId) {
        return 'Constituency is required.';
      }

      if (!form.wardId) {
        return 'Ward is required.';
      }

      return null;
    }, [form]);

  const saveChanges =
    useCallback(async () => {
      if (
        !property ||
        !form ||
        !canEdit
      ) {
        return;
      }

      const validation =
        validateForm();

      if (validation) {
        Alert.alert(
          'Check property details',
          validation,
        );
        return;
      }

      try {
        setSaving(true);

        const payload = {
          title:
            form.title.trim(),
          description:
            form.description.trim(),
          propertyType:
            form.propertyType,
          rent: Number(
            form.rent,
          ),
          viewingFee:
            form.viewingFee.trim() ===
            ''
              ? null
              : Number(
                  form.viewingFee,
                ),
          deposit:
            form.deposit.trim() ===
            ''
              ? null
              : Number(
                  form.deposit,
                ),
          bedrooms:
            form.bedrooms.trim() ===
            ''
              ? null
              : Number(
                  form.bedrooms,
                ),
          bathrooms:
            form.bathrooms.trim() ===
            ''
              ? null
              : Number(
                  form.bathrooms,
                ),
          countyId:
            form.countyId,
          constituencyId:
            form.constituencyId,
          wardId: form.wardId,
          amenityIds:
            form.amenityIds,
          available:
            form.available,
        };

        const response =
          await authenticatedFetch(
            `/marketer/properties/${encodeURIComponent(
              property.id,
            )}`,
            {
              method: 'PATCH',
              body: JSON.stringify(
                payload,
              ),
            },
          );

        const result =
          await parseResponse(
            response,
          );

        const updated =
          result.data as BackendProperty;

        setProperty(updated);
        setForm(
          buildForm(updated),
        );
        setEditMode(false);

        Alert.alert(
          'Saved',
          'Property details have been updated.',
        );
      } catch (err) {
        const message =
          err instanceof Error
            ? err.message
            : 'Failed to save property.';

        if (
          message ===
          'MARKETER_AUTH_REQUIRED'
        ) {
          Alert.alert(
            'Session expired',
            'Please log in again.',
            [
              {
                text: 'OK',
                onPress: () =>
                  router.replace(
                    '/marketer/login',
                  ),
              },
            ],
          );
        } else {
          Alert.alert(
            'Could not save',
            message,
          );
        }
      } finally {
        setSaving(false);
      }
    }, [
      canEdit,
      form,
      property,
      validateForm,
    ]);

  const submitForVerification =
    useCallback(async () => {
      if (
        !property ||
        !form ||
        !canSubmit
      ) {
        return;
      }

      const validation =
        validateForm();

      if (validation) {
        Alert.alert(
          'Complete the property first',
          validation,
        );
        return;
      }

      Alert.alert(
        'Submit for verification?',
        'Makazii admin will review this property before it can be approved and published.',
        [
          {
            text: 'Cancel',
            style: 'cancel',
          },
          {
            text: 'Submit',
            onPress: async () => {
              try {
                setSubmitting(
                  true,
                );

                /*
                 * Save the latest edits first.
                 */
                const updateResponse =
                  await authenticatedFetch(
                    `/marketer/properties/${encodeURIComponent(
                      property.id,
                    )}`,
                    {
                      method:
                        'PATCH',
                      body: JSON.stringify(
                        {
                          title:
                            form.title.trim(),
                          description:
                            form.description.trim(),
                          propertyType:
                            form.propertyType,
                          rent: Number(
                            form.rent,
                          ),
                          viewingFee:
                            form.viewingFee.trim() ===
                            ''
                              ? null
                              : Number(
                                  form.viewingFee,
                                ),
                          deposit:
                            form.deposit.trim() ===
                            ''
                              ? null
                              : Number(
                                  form.deposit,
                                ),
                          bedrooms:
                            form.bedrooms.trim() ===
                            ''
                              ? null
                              : Number(
                                  form.bedrooms,
                                ),
                          bathrooms:
                            form.bathrooms.trim() ===
                            ''
                              ? null
                              : Number(
                                  form.bathrooms,
                                ),
                          countyId:
                            form.countyId,
                          constituencyId:
                            form.constituencyId,
                          wardId:
                            form.wardId,
                          amenityIds:
                            form.amenityIds,
                          available:
                            form.available,
                        },
                      ),
                    },
                  );

                await parseResponse(
                  updateResponse,
                );

                /*
                 * Then submit the property.
                 */
                const statusResponse =
                  await authenticatedFetch(
                    `/marketer/properties/${encodeURIComponent(
                      property.id,
                    )}/status`,
                    {
                      method:
                        'PATCH',
                      body: JSON.stringify(
                        {
                          status:
                            'PENDING_VERIFICATION',
                        },
                      ),
                    },
                  );

                const statusResult =
                  await parseResponse(
                    statusResponse,
                  );

                const updated =
                  statusResult.data as BackendProperty;

                setProperty(
                  updated,
                );
                setForm(
                  buildForm(
                    updated,
                  ),
                );
                setEditMode(false);

                Alert.alert(
                  'Submitted',
                  'Your property has been submitted to Makazii admin for verification.',
                );
              } catch (err) {
                const message =
                  err instanceof Error
                    ? err.message
                    : 'Failed to submit property.';

                Alert.alert(
                  'Could not submit',
                  message,
                );
              } finally {
                setSubmitting(
                  false,
                );
              }
            },
          },
        ],
      );
    }, [
      canSubmit,
      form,
      property,
      validateForm,
    ]);

  const toggleAvailability =
    useCallback(async () => {
      if (
        !property ||
        property.status ===
          'RENTED'
      ) {
        return;
      }

      const nextValue =
        !property.available;

      try {
        setUpdatingAvailability(
          true,
        );

        const response =
          await authenticatedFetch(
            `/marketer/properties/${encodeURIComponent(
              property.id,
            )}/availability`,
            {
              method:
                'PATCH',
              body: JSON.stringify(
                {
                  available:
                    nextValue,
                },
              ),
            },
          );

        const result =
          await parseResponse(
            response,
          );

        const updated =
          result.data as BackendProperty;

        setProperty(
          (current) =>
            current
              ? {
                  ...current,
                  available:
                    updated.available,
                }
              : current,
        );

        setForm(
          (current) =>
            current
              ? {
                  ...current,
                  available:
                    updated.available,
                }
              : current,
        );
      } catch (err) {
        const message =
          err instanceof Error
            ? err.message
            : 'Failed to update availability.';

        Alert.alert(
          'Could not update',
          message,
        );
      } finally {
        setUpdatingAvailability(
          false,
        );
      }
    }, [property]);

  const selectCounty =
    useCallback(
      async (
        countyId: string,
      ) => {
        if (!form) {
          return;
        }

        updateForm(
          'countyId',
          countyId,
        );

        updateForm(
          'constituencyId',
          '',
        );

        updateForm(
          'wardId',
          '',
        );

        setWards([]);

        try {
          await loadConstituencies(
            countyId,
          );
        } catch (err) {
          Alert.alert(
            'Could not load constituencies',
            err instanceof Error
              ? err.message
              : 'Failed to load constituencies.',
          );
        }

        setShowCountyModal(
          false,
        );
      },
      [
        form,
        loadConstituencies,
      ],
    );

  const selectConstituency =
    useCallback(
      async (
        constituencyId: string,
      ) => {
        if (!form) {
          return;
        }

        updateForm(
          'constituencyId',
          constituencyId,
        );

        updateForm(
          'wardId',
          '',
        );

        try {
          await loadWards(
            constituencyId,
          );
        } catch (err) {
          Alert.alert(
            'Could not load wards',
            err instanceof Error
              ? err.message
              : 'Failed to load wards.',
          );
        }

        setShowConstituencyModal(
          false,
        );
      },
      [form, loadWards],
    );

  const selectWard = (
    wardId: string,
  ) => {
    updateForm(
      'wardId',
      wardId,
    );

    setShowWardModal(false);
  };

  const toggleAmenity = (
    amenityId: string,
  ) => {
    setForm(
      (current) => {
        if (!current) {
          return current;
        }

        const exists =
          current.amenityIds.includes(
            amenityId,
          );

        return {
          ...current,
          amenityIds: exists
            ? current.amenityIds.filter(
                (id) =>
                  id !== amenityId,
              )
            : [
                ...current.amenityIds,
                amenityId,
              ],
        };
      },
    );
  };

  if (loading) {
    return (
      <View
        style={styles.loadingScreen}
      >
        <ActivityIndicator
          size="large"
          color={COLORS.lime}
        />

        <Text
          style={styles.loadingText}
        >
          Loading property...
        </Text>
      </View>
    );
  }

  if (error || !property || !form) {
    return (
      <View
        style={styles.loadingScreen}
      >
        <View
          style={styles.errorLargeIcon}
        >
          <AlertCircle
            size={30}
            color={COLORS.red}
          />
        </View>

        <Text
          style={styles.errorLargeTitle}
        >
          Could not load property
        </Text>

        <Text
          style={styles.errorLargeText}
        >
          {error ||
            'The property could not be found.'}
        </Text>

        <View
          style={styles.errorActions}
        >
          <Pressable
            style={
              styles.secondaryButton
            }
            onPress={() =>
              router.back()
            }
          >
            <ArrowLeft
              size={17}
              color={
                COLORS.white
              }
            />

            <Text
              style={
                styles.secondaryButtonText
              }
            >
              Go Back
            </Text>
          </Pressable>

          <Pressable
            style={
              styles.primaryButton
            }
            onPress={() => {
              setLoading(true);
              loadAll();
            }}
          >
            <RefreshCw
              size={17}
              color={
                COLORS.background
              }
            />

            <Text
              style={
                styles.primaryButtonText
              }
            >
              Retry
            </Text>
          </Pressable>
        </View>
      </View>
    );
  }

  const color =
    statusColor(
      property.status,
    );

  return (
    <View
      style={styles.container}
    >
      <ScrollView
        showsVerticalScrollIndicator={
          false
        }
        contentContainerStyle={
          styles.content
        }
        refreshControl={
          <RefreshControl
            refreshing={
              refreshing
            }
            onRefresh={() => {
              setRefreshing(
                true,
              );
              loadAll();
            }}
            tintColor={
              COLORS.lime
            }
          />
        }
      >
        <View
          style={styles.header}
        >
          <Pressable
            style={
              styles.backButton
            }
            onPress={() =>
              router.back()
            }
          >
            <ArrowLeft
              size={20}
              color={
                COLORS.white
              }
            />
          </Pressable>

          <View
            style={
              styles.headerMain
            }
          >
            <Text
              style={
                styles.headerEyebrow
              }
            >
              MARKETER PROPERTY
            </Text>

            <Text
              style={
                styles.headerTitle
              }
              numberOfLines={2}
            >
              {property.title}
            </Text>
          </View>

          {canEdit ? (
            <Pressable
              style={[
                styles.headerAction,
                editMode &&
                  styles.headerActionActive,
              ]}
              onPress={() =>
                setEditMode(
                  (value) =>
                    !value,
                )
              }
            >
              {editMode ? (
                <X
                  size={19}
                  color={
                    COLORS.white
                  }
                />
              ) : (
                <Edit3
                  size={19}
                  color={
                    COLORS.lime
                  }
                />
              )}
            </Pressable>
          ) : null}
        </View>

        <View
          style={
            styles.statusCard
          }
        >
          <View
            style={
              styles.statusLeft
            }
          >
            <View
              style={[
                styles.statusIconBox,
                {
                  borderColor:
                    `${color}44`,
                  backgroundColor:
                    `${color}12`,
                },
              ]}
            >
              <StatusIcon
                status={
                  property.status
                }
                size={20}
              />
            </View>

            <View
              style={
                styles.statusInfo
              }
            >
              <Text
                style={
                  styles.statusCaption
                }
              >
                CURRENT STATUS
              </Text>

              <Text
                style={[
                  styles.statusTitle,
                  {
                    color,
                  },
                ]}
              >
                {statusLabel(
                  property.status,
                )}
              </Text>
            </View>
          </View>

          <View
            style={
              styles.statusRight
            }
          >
            <Text
              style={
                styles.statusIdLabel
              }
            >
              PROPERTY ID
            </Text>

            <Text
              style={
                styles.statusId
              }
              numberOfLines={1}
            >
              {property.id}
            </Text>
          </View>
        </View>

        {reviewNote ? (
          <View
            style={
              styles.feedbackCard
            }
          >
            <View
              style={
                styles.feedbackHeader
              }
            >
              <AlertCircle
                size={18}
                color={
                  property.status ===
                  'REJECTED'
                    ? COLORS.red
                    : COLORS.blue
                }
              />

              <Text
                style={[
                  styles.feedbackTitle,
                  {
                    color:
                      property.status ===
                      'REJECTED'
                        ? COLORS.red
                        : COLORS.blue,
                  },
                ]}
              >
                ADMIN FEEDBACK
              </Text>
            </View>

            <Text
              style={
                styles.feedbackText
              }
            >
              {reviewNote}
            </Text>

            {property.status ===
            'CHANGES_REQUIRED' ? (
              <Text
                style={
                  styles.feedbackHint
                }
              >
                Update the requested
                details, save the
                changes, then submit
                the property again for
                verification.
              </Text>
            ) : null}
          </View>
        ) : null}

        <View
          style={
            styles.imageSection
          }
        >
          {property.images &&
          property.images.length >
            0 ? (
            <ScrollView
              horizontal
              showsHorizontalScrollIndicator={
                false
              }
              contentContainerStyle={
                styles.imageRow
              }
            >
              {property.images.map(
                (
                  image,
                  index,
                ) => (
                  <View
                    key={
                      image.id
                    }
                    style={
                      styles.imageWrap
                    }
                  >
                    <Image
                      source={{
                        uri: image.url,
                      }}
                      style={
                        styles.propertyImage
                      }
                    />

                    {image.isCover ||
                    index ===
                      0 ? (
                      <View
                        style={
                          styles.coverBadge
                        }
                      >
                        <Text
                          style={
                            styles.coverBadgeText
                          }
                        >
                          COVER
                        </Text>
                      </View>
                    ) : null}
                  </View>
                ),
              )}
            </ScrollView>
          ) : (
            <View
              style={
                styles.noImageCard
              }
            >
              <ImageIcon
                size={27}
                color={
                  COLORS.muted
                }
              />

              <Text
                style={
                  styles.noImageTitle
                }
              >
                No property photos
              </Text>

              <Text
                style={
                  styles.noImageText
                }
              >
                Property image upload is
                not connected yet.
                Existing backend images
                will appear here.
              </Text>
            </View>
          )}
        </View>

        <View
          style={
            styles.metricsRow
          }
        >
          <View
            style={
              styles.metricCard
            }
          >
            <Text
              style={
                styles.metricLabel
              }
            >
              MONTHLY RENT
            </Text>

            <Text
              style={
                styles.metricValue
              }
            >
              {formatMoney(
                property.rent,
              )}
            </Text>
          </View>

          <View
            style={
              styles.metricCard
            }
          >
            <Text
              style={
                styles.metricLabel
              }
            >
              TYPE
            </Text>

            <Text
              style={
                styles.metricValue
              }
            >
              {propertyTypeLabel(
                property.propertyType,
              )}
            </Text>
          </View>
        </View>

        {editMode ? (
          <>
            <View
              style={
                styles.sectionCard
              }
            >
              <View
                style={
                  styles.sectionHeader
                }
              >
                <View
                  style={
                    styles.sectionNumber
                  }
                >
                  <Text
                    style={
                      styles.sectionNumberText
                    }
                  >
                    01
                  </Text>
                </View>

                <View
                  style={
                    styles.sectionHeaderText
                  }
                >
                  <Text
                    style={
                      styles.sectionTitle
                    }
                  >
                    Property Details
                  </Text>

                  <Text
                    style={
                      styles.sectionSubtitle
                    }
                  >
                    Update the core
                    listing information.
                  </Text>
                </View>
              </View>

              <Field
                label="PROPERTY TITLE"
                value={
                  form.title
                }
                onChangeText={(
                  value,
                ) =>
                  updateForm(
                    'title',
                    value,
                  )
                }
                placeholder="e.g. Modern bedsitter in Meru"
              />

              <Text
                style={
                  styles.fieldLabel
                }
              >
                PROPERTY TYPE
              </Text>

              <Pressable
                style={
                  styles.selectButton
                }
                onPress={() =>
                  setShowPropertyTypeModal(
                    true,
                  )
                }
              >
                <Building2
                  size={17}
                  color={
                    COLORS.lime
                  }
                />

                <Text
                  style={
                    styles.selectText
                  }
                >
                  {propertyTypeLabel(
                    form.propertyType,
                  )}
                </Text>

                <ChevronDown
                  size={17}
                  color={
                    COLORS.muted
                  }
                />
              </Pressable>

              <View
                style={
                  styles.twoColumns
                }
              >
                <View
                  style={
                    styles.column
                  }
                >
                  <Field
                    label="MONTHLY RENT"
                    value={
                      form.rent
                    }
                    onChangeText={(
                      value,
                    ) =>
                      updateForm(
                        'rent',
                        value.replace(
                          /[^0-9]/g,
                          '',
                        ),
                      )
                    }
                    keyboardType="numeric"
                    placeholder="10000"
                  />
                </View>

                <View
                  style={
                    styles.column
                  }
                >
                  <Field
                    label="VIEWING FEE"
                    value={
                      form.viewingFee
                    }
                    onChangeText={(
                      value,
                    ) =>
                      updateForm(
                        'viewingFee',
                        value.replace(
                          /[^0-9]/g,
                          '',
                        ),
                      )
                    }
                    keyboardType="numeric"
                    placeholder="Optional"
                  />
                </View>
              </View>

              <View
                style={
                  styles.twoColumns
                }
              >
                <View
                  style={
                    styles.column
                  }
                >
                  <Field
                    label="DEPOSIT"
                    value={
                      form.deposit
                    }
                    onChangeText={(
                      value,
                    ) =>
                      updateForm(
                        'deposit',
                        value.replace(
                          /[^0-9]/g,
                          '',
                        ),
                      )
                    }
                    keyboardType="numeric"
                    placeholder="Optional"
                  />
                </View>

                <View
                  style={
                    styles.column
                  }
                >
                  <Field
                    label="BEDROOMS"
                    value={
                      form.bedrooms
                    }
                    onChangeText={(
                      value,
                    ) =>
                      updateForm(
                        'bedrooms',
                        value.replace(
                          /[^0-9]/g,
                          '',
                        ),
                      )
                    }
                    keyboardType="numeric"
                    placeholder="Optional"
                  />
                </View>
              </View>

              <Field
                label="BATHROOMS"
                value={
                  form.bathrooms
                }
                onChangeText={(
                  value,
                ) =>
                  updateForm(
                    'bathrooms',
                    value.replace(
                      /[^0-9]/g,
                      '',
                    ),
                  )
                }
                keyboardType="numeric"
                placeholder="Optional"
              />

              <Text
                style={
                  styles.fieldLabel
                }
              >
                DESCRIPTION
              </Text>

              <TextInput
                value={
                  form.description
                }
                onChangeText={(
                  value,
                ) =>
                  updateForm(
                    'description',
                    value,
                  )
                }
                placeholder="Describe the property..."
                placeholderTextColor={
                  COLORS.muted
                }
                multiline
                textAlignVertical="top"
                style={[
                  styles.input,
                  styles.textArea,
                ]}
              />
            </View>

            <View
              style={
                styles.sectionCard
              }
            >
              <View
                style={
                  styles.sectionHeader
                }
              >
                <View
                  style={
                    styles.sectionNumber
                  }
                >
                  <Text
                    style={
                      styles.sectionNumberText
                    }
                  >
                    02
                  </Text>
                </View>

                <View
                  style={
                    styles.sectionHeaderText
                  }
                >
                  <Text
                    style={
                      styles.sectionTitle
                    }
                  >
                    Location
                  </Text>

                  <Text
                    style={
                      styles.sectionSubtitle
                    }
                  >
                    Use the official
                    Kenya geography.
                  </Text>
                </View>
              </View>

              <Text
                style={
                  styles.fieldLabel
                }
              >
                COUNTY
              </Text>

              <Pressable
                style={
                  styles.selectButton
                }
                onPress={() =>
                  setShowCountyModal(
                    true,
                  )
                }
              >
                <MapPin
                  size={17}
                  color={
                    COLORS.lime
                  }
                />

                <Text
                  style={
                    styles.selectText
                  }
                >
                  {counties.find(
                    (item) =>
                      item.id ===
                      form.countyId,
                  )?.name ||
                    'Select county'}
                </Text>

                <ChevronDown
                  size={17}
                  color={
                    COLORS.muted
                  }
                />
              </Pressable>

              <Text
                style={
                  styles.fieldLabel
                }
              >
                CONSTITUENCY
              </Text>

              <Pressable
                style={[
                  styles.selectButton,
                  !form.countyId &&
                    styles.selectDisabled,
                ]}
                disabled={
                  !form.countyId
                }
                onPress={() =>
                  setShowConstituencyModal(
                    true,
                  )
                }
              >
                <Text
                  style={
                    styles.selectText
                  }
                >
                  {constituencies.find(
                    (item) =>
                      item.id ===
                      form.constituencyId,
                  )?.name ||
                    'Select constituency'}
                </Text>

                <ChevronDown
                  size={17}
                  color={
                    COLORS.muted
                  }
                />
              </Pressable>

              <Text
                style={
                  styles.fieldLabel
                }
              >
                WARD
              </Text>

              <Pressable
                style={[
                  styles.selectButton,
                  !form.constituencyId &&
                    styles.selectDisabled,
                ]}
                disabled={
                  !form.constituencyId
                }
                onPress={() =>
                  setShowWardModal(
                    true,
                  )
                }
              >
                <Text
                  style={
                    styles.selectText
                  }
                >
                  {wards.find(
                    (item) =>
                      item.id ===
                      form.wardId,
                  )?.name ||
                    'Select ward'}
                </Text>

                <ChevronDown
                  size={17}
                  color={
                    COLORS.muted
                  }
                />
              </Pressable>
            </View>

            <View
              style={
                styles.sectionCard
              }
            >
              <View
                style={
                  styles.sectionHeader
                }
              >
                <View
                  style={
                    styles.sectionNumber
                  }
                >
                  <Text
                    style={
                      styles.sectionNumberText
                    }
                  >
                    03
                  </Text>
                </View>

                <View
                  style={
                    styles.sectionHeaderText
                  }
                >
                  <Text
                    style={
                      styles.sectionTitle
                    }
                  >
                    Amenities
                  </Text>

                  <Text
                    style={
                      styles.sectionSubtitle
                    }
                  >
                    Select what the
                    property provides.
                  </Text>
                </View>
              </View>

              <View
                style={
                  styles.amenitiesGrid
                }
              >
                {amenities.map(
                  (
                    amenity,
                  ) => {
                    const selected =
                      form.amenityIds.includes(
                        amenity.id,
                      );

                    return (
                      <Pressable
                        key={
                          amenity.id
                        }
                        style={[
                          styles.amenity,
                          selected &&
                            styles.amenitySelected,
                        ]}
                        onPress={() =>
                          toggleAmenity(
                            amenity.id,
                          )
                        }
                      >
                        <View
                          style={[
                            styles.checkbox,
                            selected &&
                              styles.checkboxSelected,
                          ]}
                        >
                          {selected ? (
                            <Check
                              size={13}
                              color={
                                COLORS.background
                              }
                            />
                          ) : null}
                        </View>

                        <Text
                          style={[
                            styles.amenityText,
                            selected &&
                              styles.amenityTextSelected,
                          ]}
                        >
                          {
                            amenity.name
                          }
                        </Text>
                      </Pressable>
                    );
                  },
                )}
              </View>
            </View>

            <View
              style={
                styles.sectionCard
              }
            >
              <View
                style={
                  styles.sectionHeader
                }
              >
                <View
                  style={
                    styles.sectionNumber
                  }
                >
                  <Text
                    style={
                      styles.sectionNumberText
                    }
                  >
                    04
                  </Text>
                </View>

                <View
                  style={
                    styles.sectionHeaderText
                  }
                >
                  <Text
                    style={
                      styles.sectionTitle
                    }
                  >
                    Availability
                  </Text>

                  <Text
                    style={
                      styles.sectionSubtitle
                    }
                  >
                    Tell Makazii whether
                    the property is
                    currently available.
                  </Text>
                </View>
              </View>

              <Pressable
                style={
                  styles.availabilityRow
                }
                onPress={() =>
                  updateForm(
                    'available',
                    !form.available,
                  )
                }
              >
                <View
                  style={
                    styles.availabilityIcon
                  }
                >
                  <CheckCircle2
                    size={19}
                    color={
                      form.available
                        ? COLORS.green
                        : COLORS.muted
                    }
                  />
                </View>

                <View
                  style={
                    styles.availabilityInfo
                  }
                >
                  <Text
                    style={
                      styles.availabilityTitle
                    }
                  >
                    {form.available
                      ? 'Currently Available'
                      : 'Currently Unavailable'}
                  </Text>

                  <Text
                    style={
                      styles.availabilityText
                    }
                  >
                    {form.available
                      ? 'The property can be offered to customers.'
                      : 'The property should not currently be offered.'}
                  </Text>
                </View>

                <View
                  style={[
                    styles.toggle,
                    form.available &&
                      styles.toggleActive,
                  ]}
                >
                  <View
                    style={[
                      styles.toggleKnob,
                      form.available &&
                        styles.toggleKnobActive,
                    ]}
                  />
                </View>
              </Pressable>
            </View>

            <Pressable
              style={[
                styles.saveButton,
                saving &&
                  styles.buttonDisabled,
              ]}
              disabled={saving}
              onPress={saveChanges}
            >
              {saving ? (
                <ActivityIndicator
                  size="small"
                  color={
                    COLORS.background
                  }
                />
              ) : (
                <Save
                  size={18}
                  color={
                    COLORS.background
                  }
                />
              )}

              <Text
                style={
                  styles.saveButtonText
                }
              >
                {saving
                  ? 'Saving...'
                  : 'Save Changes'}
              </Text>
            </Pressable>

            {canSubmit ? (
              <Pressable
                style={[
                  styles.submitButton,
                  submitting &&
                    styles.buttonDisabled,
                ]}
                disabled={
                  submitting
                }
                onPress={
                  submitForVerification
                }
              >
                {submitting ? (
                  <ActivityIndicator
                    size="small"
                    color={
                      COLORS.background
                    }
                  />
                ) : (
                  <Send
                    size={18}
                    color={
                      COLORS.background
                    }
                  />
                )}

                <Text
                  style={
                    styles.submitButtonText
                  }
                >
                  {submitting
                    ? 'Submitting...'
                    : 'Save & Submit for Verification'}
                </Text>
              </Pressable>
            ) : null}
          </>
        ) : (
          <>
            <View
              style={
                styles.sectionCard
              }
            >
              <View
                style={
                  styles.sectionHeader
                }
              >
                <View
                  style={
                    styles.sectionHeaderIcon
                  }
                >
                  <Building2
                    size={18}
                    color={
                      COLORS.lime
                    }
                  />
                </View>

                <View
                  style={
                    styles.sectionHeaderText
                  }
                >
                  <Text
                    style={
                      styles.sectionTitle
                    }
                  >
                    Property Details
                  </Text>

                  <Text
                    style={
                      styles.sectionSubtitle
                    }
                  >
                    Information stored in
                    the Makazii backend.
                  </Text>
                </View>
              </View>

              <DetailRow
                label="Property Type"
                value={propertyTypeLabel(
                  property.propertyType,
                )}
              />

              <DetailRow
                label="Monthly Rent"
                value={formatMoney(
                  property.rent,
                )}
                emphasized
              />

              <DetailRow
                label="Viewing Fee"
                value={
                  property.viewingFee ===
                  null ||
                  property.viewingFee ===
                    undefined
                    ? 'Not set'
                    : formatMoney(
                        property.viewingFee,
                      )
                }
              />

              <DetailRow
                label="Deposit"
                value={
                  property.deposit ===
                  null ||
                  property.deposit ===
                    undefined
                    ? 'Not set'
                    : formatMoney(
                        property.deposit,
                      )
                }
              />

              <DetailRow
                label="Bedrooms"
                value={
                  property.bedrooms ===
                  null ||
                  property.bedrooms ===
                    undefined
                    ? 'Not set'
                    : String(
                        property.bedrooms,
                      )
                }
                icon={
                  <BedDouble
                    size={15}
                    color={
                      COLORS.muted
                    }
                  />
                }
              />

              <DetailRow
                label="Bathrooms"
                value={
                  property.bathrooms ===
                  null ||
                  property.bathrooms ===
                    undefined
                    ? 'Not set'
                    : String(
                        property.bathrooms,
                      )
                }
                icon={
                  <Bath
                    size={15}
                    color={
                      COLORS.muted
                    }
                  />
                }
              />

              {property.description ? (
                <View
                  style={
                    styles.descriptionBlock
                  }
                >
                  <Text
                    style={
                      styles.detailLabel
                    }
                  >
                    DESCRIPTION
                  </Text>

                  <Text
                    style={
                      styles.descriptionText
                    }
                  >
                    {
                      property.description
                    }
                  </Text>
                </View>
              ) : null}
            </View>

            <View
              style={
                styles.sectionCard
              }
            >
              <View
                style={
                  styles.sectionHeader
                }
              >
                <View
                  style={
                    styles.sectionHeaderIcon
                  }
                >
                  <MapPin
                    size={18}
                    color={
                      COLORS.lime
                    }
                  />
                </View>

                <View
                  style={
                    styles.sectionHeaderText
                  }
                >
                  <Text
                    style={
                      styles.sectionTitle
                    }
                  >
                    Location
                  </Text>

                  <Text
                    style={
                      styles.sectionSubtitle
                    }
                  >
                    Official Kenya
                    geography.
                  </Text>
                </View>
              </View>

              <LocationRow
                label="County"
                value={
                  countyName
                }
              />

              <LocationRow
                label="Constituency"
                value={
                  constituencyName
                }
              />

              <LocationRow
                label="Ward"
                value={
                  wardName
                }
              />
            </View>

            <View
              style={
                styles.sectionCard
              }
            >
              <View
                style={
                  styles.sectionHeader
                }
              >
                <View
                  style={
                    styles.sectionHeaderIcon
                  }
                >
                  <CheckCircle2
                    size={18}
                    color={
                      COLORS.lime
                    }
                  />
                </View>

                <View
                  style={
                    styles.sectionHeaderText
                  }
                >
                  <Text
                    style={
                      styles.sectionTitle
                    }
                  >
                    Amenities
                  </Text>

                  <Text
                    style={
                      styles.sectionSubtitle
                    }
                  >
                    {selectedAmenities.length}{' '}
                    selected
                  </Text>
                </View>
              </View>

              {selectedAmenities.length >
              0 ? (
                <View
                  style={
                    styles.selectedAmenities
                  }
                >
                  {selectedAmenities.map(
                    (
                      amenity,
                    ) => (
                      <View
                        key={
                          amenity.id
                        }
                        style={
                          styles.amenityTag
                        }
                      >
                        <Check
                          size={13}
                          color={
                            COLORS.lime
                          }
                        />

                        <Text
                          style={
                            styles.amenityTagText
                          }
                        >
                          {
                            amenity.name
                          }
                        </Text>
                      </View>
                    ),
                  )}
                </View>
              ) : (
                <Text
                  style={
                    styles.emptySectionText
                  }
                >
                  No amenities have been
                  selected.
                </Text>
              )}
            </View>

            <View
              style={
                styles.sectionCard
              }
            >
              <View
                style={
                  styles.sectionHeader
                }
              >
                <View
                  style={
                    styles.sectionHeaderIcon
                  }
                >
                  <Building2
                    size={18}
                    color={
                      COLORS.lime
                    }
                  />
                </View>

                <View
                  style={
                    styles.sectionHeaderText
                  }
                >
                  <Text
                    style={
                      styles.sectionTitle
                    }
                  >
                    Availability
                  </Text>

                  <Text
                    style={
                      styles.sectionSubtitle
                    }
                  >
                    Current listing
                    availability.
                  </Text>
                </View>
              </View>

              <View
                style={
                  styles.availabilityDisplay
                }
              >
                <View
                  style={
                    styles.availabilityDisplayLeft
                  }
                >
                  <View
                    style={[
                      styles.availabilityStatusDot,
                      {
                        backgroundColor:
                          property.available
                            ? COLORS.green
                            : COLORS.red,
                      },
                    ]}
                  />

                  <View>
                    <Text
                      style={
                        styles.availabilityDisplayTitle
                      }
                    >
                      {property.available
                        ? 'Available'
                        : 'Unavailable'}
                    </Text>

                    <Text
                      style={
                        styles.availabilityDisplayText
                      }
                    >
                      {property.available
                        ? 'This property is currently available.'
                        : 'This property is currently unavailable.'}
                    </Text>
                  </View>
                </View>

                {property.status !==
                'RENTED' ? (
                  <Pressable
                    style={
                      styles.availabilityButton
                    }
                    disabled={
                      updatingAvailability
                    }
                    onPress={
                      toggleAvailability
                    }
                  >
                    {updatingAvailability ? (
                      <ActivityIndicator
                        size="small"
                        color={
                          COLORS.lime
                        }
                      />
                    ) : (
                      <RefreshCw
                        size={15}
                        color={
                          COLORS.lime
                        }
                      />
                    )}

                    <Text
                      style={
                        styles.availabilityButtonText
                      }
                    >
                      {property.available
                        ? 'Mark Unavailable'
                        : 'Mark Available'}
                    </Text>
                  </Pressable>
                ) : null}
              </View>
            </View>

            <View
              style={
                styles.statsRow
              }
            >
              <View
                style={
                  styles.statCard
                }
              >
                <Text
                  style={
                    styles.statNumber
                  }
                >
                  {
                    property._count
                      ?.viewingRequests ??
                    0
                  }
                </Text>

                <Text
                  style={
                    styles.statLabel
                  }
                >
                  VIEWING REQUESTS
                </Text>
              </View>

              <View
                style={
                  styles.statCard
                }
              >
                <Text
                  style={
                    styles.statNumber
                  }
                >
                  {
                    property._count
                      ?.shortlists ??
                    0
                  }
                </Text>

                <Text
                  style={
                    styles.statLabel
                  }
                >
                  SHORTLISTS
                </Text>
              </View>
            </View>

            {canSubmit ? (
              <Pressable
                style={
                  styles.submitButton
                }
                onPress={
                  submitForVerification
                }
              >
                <Send
                  size={18}
                  color={
                    COLORS.background
                  }
                />

                <Text
                  style={
                    styles.submitButtonText
                  }
                >
                  Submit for Verification
                </Text>
              </Pressable>
            ) : null}

            {property.status ===
            'PENDING_VERIFICATION' ? (
              <View
                style={
                  styles.waitingCard
                }
              >
                <Clock3
                  size={20}
                  color={
                    COLORS.amber
                  }
                />

                <View
                  style={
                    styles.waitingContent
                  }
                >
                  <Text
                    style={
                      styles.waitingTitle
                    }
                  >
                    Waiting for admin review
                  </Text>

                  <Text
                    style={
                      styles.waitingText
                    }
                  >
                    Your property is with
                    Makazii admin. You cannot
                    publish it yourself.
                  </Text>
                </View>
              </View>
            ) : null}
          </>
        )}

        <View
          style={
            styles.sectionCard
          }
        >
          <View
            style={
              styles.sectionHeader
            }
          >
            <View
              style={
                styles.sectionHeaderIcon
              }
            >
              <Clock3
                size={18}
                color={
                  COLORS.lime
                }
              />
            </View>

            <View
              style={
                styles.sectionHeaderText
              }
            >
              <Text
                style={
                  styles.sectionTitle
                }
              >
                Property History
              </Text>

              <Text
                style={
                  styles.sectionSubtitle
                }
              >
                Status changes recorded by
                the backend.
              </Text>
            </View>
          </View>

          {property.statusHistory &&
          property.statusHistory.length >
            0 ? (
            property.statusHistory.map(
              (
                item,
                index,
              ) => (
                <View
                  key={
                    item.id
                  }
                  style={
                    styles.historyRow
                  }
                >
                  <View
                    style={
                      styles.historyTimeline
                    }
                  >
                    <View
                      style={[
                        styles.historyDot,
                        {
                          backgroundColor:
                            statusColor(
                              item.status as PropertyStatus,
                            ),
                        },
                      ]}
                    />

                    {index <
                    property
                      .statusHistory!
                      .length -
                      1 ? (
                      <View
                        style={
                          styles.historyLine
                        }
                      />
                    ) : null}
                  </View>

                  <View
                    style={
                      styles.historyContent
                    }
                  >
                    <View
                      style={
                        styles.historyTop
                      }
                    >
                      <Text
                        style={
                          styles.historyStatus
                        }
                      >
                        {statusLabel(
                          item.status as PropertyStatus,
                        )}
                      </Text>

                      <Text
                        style={
                          styles.historyDate
                        }
                      >
                        {formatDate(
                          item.createdAt,
                        )}
                      </Text>
                    </View>

                    {item.note ? (
                      <Text
                        style={
                          styles.historyNote
                        }
                      >
                        {
                          item.note
                        }
                      </Text>
                    ) : null}
                  </View>
                </View>
              ),
            )
          ) : (
            <Text
              style={
                styles.emptySectionText
              }
            >
              No status history is
              available.
            </Text>
          )}
        </View>

        <View
          style={
            styles.bottomNotice
          }
        >
          <AlertCircle
            size={17}
            color={
              COLORS.lime
            }
          />

          <Text
            style={
              styles.bottomNoticeText
            }
          >
            Marketers can create and
            submit properties, but
            publication and approval
            are controlled by Makazii
            admin.
          </Text>
        </View>
      </ScrollView>

      <Modal
        visible={
          showPropertyTypeModal
        }
        transparent
        animationType="slide"
        onRequestClose={() =>
          setShowPropertyTypeModal(
            false,
          )
        }
      >
        <SelectionModal
          title="Property Type"
          items={PROPERTY_TYPES.map(
            (item) => ({
              id: item.value,
              name: item.label,
            }),
          )}
          selectedId={
            form.propertyType
          }
          onSelect={(id) => {
            updateForm(
              'propertyType',
              id as PropertyType,
            );
            setShowPropertyTypeModal(
              false,
            );
          }}
          onClose={() =>
            setShowPropertyTypeModal(
              false,
            )
          }
        />
      </Modal>

      <Modal
        visible={
          showCountyModal
        }
        transparent
        animationType="slide"
        onRequestClose={() =>
          setShowCountyModal(
            false,
          )
        }
      >
        <SelectionModal
          title="Select County"
          items={counties}
          selectedId={
            form.countyId
          }
          onSelect={
            selectCounty
          }
          onClose={() =>
            setShowCountyModal(
              false,
            )
          }
        />
      </Modal>

      <Modal
        visible={
          showConstituencyModal
        }
        transparent
        animationType="slide"
        onRequestClose={() =>
          setShowConstituencyModal(
            false,
          )
        }
      >
        <SelectionModal
          title="Select Constituency"
          items={
            constituencies
          }
          selectedId={
            form.constituencyId
          }
          onSelect={
            selectConstituency
          }
          onClose={() =>
            setShowConstituencyModal(
              false,
            )
          }
        />
      </Modal>

      <Modal
        visible={
          showWardModal
        }
        transparent
        animationType="slide"
        onRequestClose={() =>
          setShowWardModal(
            false,
          )
        }
      >
        <SelectionModal
          title="Select Ward"
          items={wards}
          selectedId={
            form.wardId
          }
          onSelect={
            selectWard
          }
          onClose={() =>
            setShowWardModal(
              false,
            )
          }
        />
      </Modal>
    </View>
  );
}

function Field({
  label,
  value,
  onChangeText,
  placeholder,
  keyboardType = 'default',
}: {
  label: string;
  value: string;
  onChangeText: (
    value: string,
  ) => void;
  placeholder?: string;
  keyboardType?: any;
}) {
  return (
    <>
      <Text
        style={
          styles.fieldLabel
        }
      >
        {label}
      </Text>

      <TextInput
        value={value}
        onChangeText={
          onChangeText
        }
        placeholder={
          placeholder
        }
        placeholderTextColor={
          COLORS.muted
        }
        keyboardType={
          keyboardType
        }
        style={
          styles.input
        }
      />
    </>
  );
}

function DetailRow({
  label,
  value,
  icon,
  emphasized = false,
}: {
  label: string;
  value: string;
  icon?: React.ReactNode;
  emphasized?: boolean;
}) {
  return (
    <View
      style={
        styles.detailRow
      }
    >
      <View
        style={
          styles.detailLabelWrap
        }
      >
        {icon}
        <Text
          style={
            styles.detailLabel
          }
        >
          {label}
        </Text>
      </View>

      <Text
        style={[
          styles.detailValue,
          emphasized &&
            styles.detailValueEmphasized,
        ]}
      >
        {value}
      </Text>
    </View>
  );
}

function LocationRow({
  label,
  value,
}: {
  label: string;
  value: string;
}) {
  return (
    <View
      style={
        styles.locationRow
      }
    >
      <View
        style={
          styles.locationBullet
        }
      />

      <View
        style={
          styles.locationContent
        }
      >
        <Text
          style={
            styles.locationLabel
          }
        >
          {label}
        </Text>

        <Text
          style={
            styles.locationValue
          }
        >
          {value}
        </Text>
      </View>
    </View>
  );
}

function SelectionModal({
  title,
  items,
  selectedId,
  onSelect,
  onClose,
}: {
  title: string;
  items: {
    id: string;
    name: string;
  }[];
  selectedId: string;
  onSelect: (
    id: string,
  ) => void;
  onClose: () => void;
}) {
  return (
    <View
      style={
        styles.modalOverlay
      }
    >
      <Pressable
        style={
          styles.modalBackdrop
        }
        onPress={onClose}
      />

      <View
        style={
          styles.modalCard
        }
      >
        <View
          style={
            styles.modalHeader
          }
        >
          <Text
            style={
              styles.modalTitle
            }
          >
            {title}
          </Text>

          <Pressable
            style={
              styles.modalClose
            }
            onPress={onClose}
          >
            <X
              size={19}
              color={
                COLORS.white
              }
            />
          </Pressable>
        </View>

        <ScrollView
          showsVerticalScrollIndicator={
            false
          }
          contentContainerStyle={
            styles.modalList
          }
        >
          {items.map(
            (item) => {
              const selected =
                item.id ===
                selectedId;

              return (
                <Pressable
                  key={
                    item.id
                  }
                  style={[
                    styles.modalItem,
                    selected &&
                      styles.modalItemSelected,
                  ]}
                  onPress={() =>
                    onSelect(
                      item.id,
                    )
                  }
                >
                  <Text
                    style={[
                      styles.modalItemText,
                      selected &&
                        styles.modalItemTextSelected,
                    ]}
                  >
                    {
                      item.name
                    }
                  </Text>

                  {selected ? (
                    <Check
                      size={18}
                      color={
                        COLORS.lime
                      }
                    />
                  ) : null}
                </Pressable>
              );
            },
          )}
        </ScrollView>
      </View>
    </View>
  );
}

