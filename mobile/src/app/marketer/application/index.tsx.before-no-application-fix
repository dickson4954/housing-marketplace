/* -------------------------------------------------------------------------- */
/* TIMELINE                                                                    */
/* -------------------------------------------------------------------------- */

function TimelineCard({
  activeStep,
  rejected = false,
}: {
  activeStep: number;
  rejected?: boolean;
}) {
  const steps = [
    {
      title: 'Application submitted',
      text: 'Your application has been received.',
    },
    {
      title: 'Application review',
      text: 'The MAKAZII team reviews your information.',
    },
    {
      title: 'Additional action',
      text: 'Any requested updates can be submitted.',
    },
    {
      title: 'Decision',
      text: rejected
        ? 'The application review has been completed.'
        : 'Approved applications receive portal access.',
    },
  ];

  return (
    <View style={styles.timelineCard}>
      <Text style={styles.sectionEyebrow}>
        APPLICATION PROGRESS
      </Text>

      <Text style={styles.timelineTitle}>
        Review process
      </Text>

      <View style={styles.timeline}>
        {steps.map((item, index) => {
          const completed =
            index < activeStep;

          const active =
            index === activeStep;

          const isRejectedEnd =
            rejected && index === 3;

          return (
            <View
              key={item.title}
              style={styles.timelineItem}
            >
              <View style={styles.timelineLeft}>
                <View
                  style={[
                    styles.timelineCircle,
                    completed &&
                      styles.timelineCircleCompleted,
                    active &&
                      styles.timelineCircleActive,
                    isRejectedEnd &&
                      styles.timelineCircleRejected,
                  ]}
                >
                  {completed ? (
                    <Check
                      size={13}
                      color={COLORS.background}
                      strokeWidth={3}
                    />
                  ) : isRejectedEnd ? (
                    <XCircle
                      size={15}
                      color={COLORS.red}
                    />
                  ) : (
                    <View
                      style={[
                        styles.timelineDot,
                        active &&
                          styles.timelineDotActive,
                      ]}
                    />
                  )}
                </View>

                {index < steps.length - 1 && (
                  <View
                    style={[
                      styles.timelineLine,
                      index < activeStep &&
                        styles.timelineLineCompleted,
                    ]}
                  />
                )}
              </View>

              <View
                style={
                  styles.timelineContent
                }
              >
                <Text
                  style={[
                    styles.timelineItemTitle,
                    active &&
                      styles.timelineItemTitleActive,
                  ]}
                >
                  {item.title}
                </Text>

                <Text
                  style={
                    styles.timelineItemText
                  }
                >
                  {item.text}
                </Text>
              </View>
            </View>
          );
        })}
      </View>
    </View>
  );
}

