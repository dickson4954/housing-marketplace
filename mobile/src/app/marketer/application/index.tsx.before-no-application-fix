import React, {
  useCallback,
  useEffect,
  useMemo,
  useState,
} from 'react';
import {
  ActivityIndicator,
  Pressable,
  RefreshControl,
  ScrollView,
  StatusBar,
  StyleSheet,
  Text,
  View,
} from 'react-native';
import { router } from 'expo-router';
import {
  ArrowLeft,
  ArrowRight,
  Check,
  CheckCircle2,
  Clock3,
  FileCheck2,
  FileText,
  ShieldCheck,
  TriangleAlert,
  XCircle,
} from 'lucide-react-native';

import {
  MarketerApplication,
  MarketerApplicationStatus,
  useMarketers,
} from '@/context/MarketerContext';

const COLORS = {
  background: '#0B0F10',
  card: '#14191B',
  cardSoft: '#181E20',
  lime: '#D7FF5F',
  white: '#FFFFFF',
  muted: '#9CA5A7',
  border: '#252C2E',

  green: '#62D39B',
  orange: '#FFB45B',
  red: '#FF7070',
  blue: '#72B7FF',
};

export default function MarketerApplicationStatusScreen() {
  const {
    refreshMyApplicationStatus,
  } = useMarketers();

  const [application, setApplication] =
    useState<MarketerApplication | null>(null);

  const [isLoading, setIsLoading] =
    useState(true);

  const [isRefreshing, setIsRefreshing] =
    useState(false);

  const [errorMessage, setErrorMessage] =
    useState<string | null>(null);

  const loadApplication = useCallback(
    async (showRefreshIndicator = false) => {
      if (showRefreshIndicator) {
        setIsRefreshing(true);
      } else {
        setIsLoading(true);
      }

      setErrorMessage(null);

      try {
        const result =
          await refreshMyApplicationStatus();

        setApplication(result);
      } catch (error) {
        console.error(
          'MARKETER APPLICATION STATUS SCREEN ERROR:',
          error,
        );

        setErrorMessage(
          error instanceof Error
            ? error.message
            : 'Unable to load your application status.',
        );
      } finally {
        setIsLoading(false);
        setIsRefreshing(false);
      }
    },
    [refreshMyApplicationStatus],
  );

  useEffect(() => {
    void loadApplication();
  }, [loadApplication]);

  const submittedDate = useMemo(() => {
    if (!application?.submittedAt) {
      return 'Not available';
    }

    const date = new Date(
      application.submittedAt,
    );

    if (Number.isNaN(date.getTime())) {
      return 'Not available';
    }

    return date.toLocaleDateString('en-KE', {
      day: 'numeric',
      month: 'long',
      year: 'numeric',
    });
  }, [application?.submittedAt]);

  const reviewedDate = useMemo(() => {
    if (!application?.reviewedAt) {
      return null;
    }

    const date = new Date(
      application.reviewedAt,
    );

    if (Number.isNaN(date.getTime())) {
      return null;
    }

    return date.toLocaleDateString('en-KE', {
      day: 'numeric',
      month: 'long',
      year: 'numeric',
    });
  }, [application?.reviewedAt]);

  const approvedDate = useMemo(() => {
    if (!application?.approvedAt) {
      return null;
    }

    const date = new Date(
      application.approvedAt,
    );

    if (Number.isNaN(date.getTime())) {
      return null;
    }

    return date.toLocaleDateString('en-KE', {
      day: 'numeric',
      month: 'long',
      year: 'numeric',
    });
  }, [application?.approvedAt]);

  const rejectedDate = useMemo(() => {
    if (!application?.rejectedAt) {
      return null;
    }

    const date = new Date(
      application.rejectedAt,
    );

    if (Number.isNaN(date.getTime())) {
      return null;
    }

    return date.toLocaleDateString('en-KE', {
      day: 'numeric',
      month: 'long',
      year: 'numeric',
    });
  }, [application?.rejectedAt]);

  const getStatusConfig = (
    status: MarketerApplicationStatus,
  ) => {
    switch (status) {
      case 'PENDING':
        return {
          icon: (
            <Clock3
              size={30}
              color={COLORS.orange}
            />
          ),
          iconBackground:
            'rgba(255,180,91,0.12)',
          color: COLORS.orange,
          label: 'Pending review',
          title:
            'Your application is in the queue',
          description:
            "We've received your application. The MAKAZII team will review the information you submitted before making a decision.",
        };

      case 'UNDER_REVIEW':
        return {
          icon: (
            <FileCheck2
              size={30}
              color={COLORS.blue}
            />
          ),
          iconBackground:
            'rgba(114,183,255,0.12)',
          color: COLORS.blue,
          label: 'Under review',
          title:
            'Your application is being reviewed',
          description:
            'The MAKAZII team is currently reviewing your application and the information you provided.',
        };

      case 'ACTION_REQUIRED':
        return {
          icon: (
            <TriangleAlert
              size={30}
              color={COLORS.orange}
            />
          ),
          iconBackground:
            'rgba(255,180,91,0.12)',
          color: COLORS.orange,
          label: 'Action required',
          title:
            'We need you to update your application',
          description:
            'The MAKAZII team has requested some changes or additional information before your application can continue.',
        };

      case 'APPROVED':
        return {
          icon: (
            <CheckCircle2
              size={30}
              color={COLORS.green}
            />
          ),
          iconBackground:
            'rgba(98,211,155,0.12)',
          color: COLORS.green,
          label: 'Approved',
          title: 'Welcome to MAKAZII',
          description:
            'Your marketer application has been approved. Your marketer portal access is now available.',
        };

      case 'REJECTED':
        return {
          icon: (
            <XCircle
              size={30}
              color={COLORS.red}
            />
          ),
          iconBackground:
            'rgba(255,112,112,0.12)',
          color: COLORS.red,
          label: 'Application not approved',
          title:
            'Your application was not approved',
          description:
            'The MAKAZII team has completed its review of your application.',
        };

      default:
        return {
          icon: (
            <FileText
              size={30}
              color={COLORS.muted}
            />
          ),
          iconBackground: COLORS.cardSoft,
          color: COLORS.muted,
          label: 'Application',
          title: 'Application status',
          description:
            'Your MAKAZII marketer application status is shown below.',
        };
    }
  };

  const handlePrimaryAction = () => {
    if (!application) {
      router.replace('/marketer/apply');
      return;
    }

    if (application.status === 'APPROVED') {
      router.replace('/marketer/dashboard');
      return;
    }

    if (
      application.status === 'ACTION_REQUIRED'
    ) {
      router.replace({
        pathname: '/marketer/apply',
        params: { mode: 'update' },
      });
      return;
    }

    if (application.status === 'REJECTED') {
      router.replace('/marketer/apply');
    }
  };

  /* ------------------------------------------------------------------------ */
  /* LOADING                                                                   */
  /* ------------------------------------------------------------------------ */

  if (isLoading) {
    return (
      <View style={styles.container}>
        <StatusBar barStyle="light-content" />

        <View style={styles.topBar}>
          <Pressable
            onPress={() =>
              router.replace('/marketer')
            }
            style={({ pressed }) => [
              styles.backButton,
              pressed && styles.pressed,
            ]}
          >
            <ArrowLeft
              size={20}
              color={COLORS.white}
            />
          </Pressable>

          <View style={styles.brandWrap}>
            <Text style={styles.brand}>
              MAKAZII
            </Text>

            <Text style={styles.brandLabel}>
              APPLICATION STATUS
            </Text>
          </View>

          <View style={styles.topBarSpacer} />
        </View>

        <View style={styles.loadingContent}>
          <View style={styles.loadingIcon}>
            <FileText
              size={30}
              color={COLORS.lime}
            />
          </View>

          <ActivityIndicator
            size="small"
            color={COLORS.lime}
            style={styles.loadingSpinner}
          />

          <Text style={styles.loadingTitle}>
            Checking your application
          </Text>

          <Text style={styles.loadingDescription}>
            We're getting the latest status from
            MAKAZII.
          </Text>
        </View>
      </View>
    );
  }

  /* ------------------------------------------------------------------------ */
  /* ERROR                                                                     */
  /* ------------------------------------------------------------------------ */

  if (errorMessage) {
    return (
      <View style={styles.container}>
        <StatusBar barStyle="light-content" />

        <View style={styles.topBar}>
          <Pressable
            onPress={() =>
              router.replace('/marketer')
            }
            style={({ pressed }) => [
              styles.backButton,
              pressed && styles.pressed,
            ]}
          >
            <ArrowLeft
              size={20}
              color={COLORS.white}
            />
          </Pressable>

          <View style={styles.brandWrap}>
            <Text style={styles.brand}>
              MAKAZII
            </Text>

            <Text style={styles.brandLabel}>
              APPLICATION STATUS
            </Text>
          </View>

          <View style={styles.topBarSpacer} />
        </View>

        <View style={styles.emptyContent}>
          <View
            style={[
              styles.emptyIcon,
              {
                backgroundColor:
                  'rgba(255,112,112,0.08)',
                borderColor:
                  'rgba(255,112,112,0.25)',
              },
            ]}
          >
            <TriangleAlert
              size={32}
              color={COLORS.red}
            />
          </View>

          <Text style={styles.emptyTitle}>
            Unable to load status
          </Text>

          <Text style={styles.emptyDescription}>
            {errorMessage}
          </Text>

          <Pressable
            onPress={() => {
              void loadApplication();
            }}
            style={({ pressed }) => [
              styles.primaryButton,
              pressed &&
                styles.primaryButtonPressed,
            ]}
          >
            <Text style={styles.primaryButtonText}>
              Try again
            </Text>

            <ArrowRight
              size={19}
              color={COLORS.background}
              strokeWidth={2.5}
            />
          </Pressable>

          <Pressable
            onPress={() =>
              router.replace('/marketer')
            }
            style={({ pressed }) => [
              styles.secondaryButton,
              pressed &&
                styles.secondaryButtonPressed,
            ]}
          >
            <Text style={styles.secondaryButtonText}>
              Back to marketer page
            </Text>
          </Pressable>
        </View>
      </View>
    );
  }

  /* ------------------------------------------------------------------------ */
  /* NO APPLICATION                                                            */
  /* ------------------------------------------------------------------------ */

  if (!application) {
    return (
      <View style={styles.container}>
        <StatusBar barStyle="light-content" />

        <View style={styles.topBar}>
          <Pressable
            onPress={() =>
              router.replace('/marketer')
            }
            style={({ pressed }) => [
              styles.backButton,
              pressed && styles.pressed,
            ]}
          >
            <ArrowLeft
              size={20}
              color={COLORS.white}
            />
          </Pressable>

          <View style={styles.brandWrap}>
            <Text style={styles.brand}>
              MAKAZII
            </Text>

            <Text style={styles.brandLabel}>
              APPLICATION STATUS
            </Text>
          </View>

          <View style={styles.topBarSpacer} />
        </View>

        <View style={styles.emptyContent}>
          <View style={styles.emptyIcon}>
            <FileText
              size={32}
              color={COLORS.muted}
            />
          </View>

          <Text style={styles.emptyTitle}>
            No application found
          </Text>

          <Text style={styles.emptyDescription}>
            We couldn't find an active marketer
            application linked to this device.
            If you have already submitted an
            application, make sure you're using the
            same device where you submitted it.
          </Text>

          <Pressable
            onPress={() =>
              router.replace('/marketer/apply')
            }
            style={({ pressed }) => [
              styles.primaryButton,
              pressed &&
                styles.primaryButtonPressed,
            ]}
          >
            <Text style={styles.primaryButtonText}>
              Apply as a marketer
            </Text>

            <ArrowRight
              size={19}
              color={COLORS.background}
              strokeWidth={2.5}
            />
          </Pressable>
        </View>
      </View>
    );
  }

  const statusConfig = getStatusConfig(
    application.status,
  );

  const showActionMessage =
    application.status === 'ACTION_REQUIRED' &&
    !!application.requestedChanges;

  const showRejectionReason =
    application.status === 'REJECTED' &&
    !!application.rejectionReason;

  const showPrimaryButton =
    application.status === 'APPROVED' ||
    application.status === 'ACTION_REQUIRED' ||
    application.status === 'REJECTED';

  const timelineStep =
    application.status === 'PENDING'
      ? 0
      : application.status === 'UNDER_REVIEW'
        ? 1
        : application.status ===
            'ACTION_REQUIRED'
          ? 2
          : 3;

  return (
    <View style={styles.container}>
      <StatusBar barStyle="light-content" />

      <View style={styles.topBar}>
        <Pressable
          onPress={() =>
            router.replace('/marketer')
          }
          style={({ pressed }) => [
            styles.backButton,
            pressed && styles.pressed,
          ]}
        >
          <ArrowLeft
            size={20}
            color={COLORS.white}
          />
        </Pressable>

        <View style={styles.brandWrap}>
          <Text style={styles.brand}>
            MAKAZII
          </Text>

          <Text style={styles.brandLabel}>
            APPLICATION STATUS
          </Text>
        </View>

        <View style={styles.topBarSpacer} />
      </View>

      <ScrollView
        contentContainerStyle={styles.content}
        showsVerticalScrollIndicator={false}
        refreshControl={
          <RefreshControl
            refreshing={isRefreshing}
            onRefresh={() =>
              void loadApplication(true)
            }
            tintColor={COLORS.lime}
            colors={[COLORS.lime]}
          />
        }
      >
        <View style={styles.hero}>
          <View
            style={[
              styles.statusIcon,
              {
                backgroundColor:
                  statusConfig.iconBackground,
              },
            ]}
          >
            {statusConfig.icon}
          </View>

          <View
            style={[
              styles.statusPill,
              {
                borderColor:
                  statusConfig.color,
              },
            ]}
          >
            <View
              style={[
                styles.statusDot,
                {
                  backgroundColor:
                    statusConfig.color,
                },
              ]}
            />

            <Text
              style={[
                styles.statusPillText,
                {
                  color:
                    statusConfig.color,
                },
              ]}
            >
              {statusConfig.label}
            </Text>
          </View>

          <Text style={styles.heroTitle}>
            {statusConfig.title}
          </Text>

          <Text style={styles.heroDescription}>
            {statusConfig.description}
          </Text>
        </View>

        <ApplicationSection title="Personal information">
          <DetailRow label="Application ID" value={application.id} />
          <DetailRow label="First name" value={application.firstName} />
          <DetailRow label="Last name" value={application.lastName} />
          <DetailRow label="Phone number" value={application.phone} />
          <DetailRow label="Email address" value={application.email} last />
        </ApplicationSection>

        <ApplicationSection title="Identity and verification">
          <DetailRow
            label="Document type"
            value={application.idType}
          />
          <DetailRow
            label="Document number"
            value={application.idNumber}
          />
          <DetailRow
            label="Verification status"
            value={(application.idVerificationStatus || 'PENDING').replace(/_/g, ' ')}
          />
          <DetailRow
            label="Verification decision"
            value={application.idVerificationDecision || 'Not available'}
          />
          <DetailRow
            label="Verification message"
            value={application.idVerificationMessage || 'No additional message'}
          />
          <DetailRow
            label="Verified on"
            value={application.idVerifiedAt
              ? new Date(application.idVerifiedAt).toLocaleDateString('en-KE', {
                  day: 'numeric',
                  month: 'long',
                  year: 'numeric',
                })
              : 'Not yet verified'}
            last
          />
        </ApplicationSection>

        <ApplicationSection title="Application decision">
          <DetailRow
            label="Current status"
            value={application.status.replace(/_/g, ' ')}
          />
          <DetailRow label="Submitted on" value={submittedDate} />
          <DetailRow
            label="Last reviewed"
            value={reviewedDate || 'Not available'}
          />
          <DetailRow
            label="Approved on"
            value={application.status === 'APPROVED'
              ? (approvedDate || 'Approval date not recorded')
              : 'Not approved'}
            last
          />
        </ApplicationSection>

        <ApplicationSection title="Geographic coverage">
          <DetailRow
            label="County"
            value={application.county || 'Not available'}
          />
          <DetailRow
            label="Constituency"
            value={application.constituency || 'Not available'}
          />
          <DetailRow
            label="Wards"
            value={application.wardNames?.length
              ? application.wardNames.join(', ')
              : (application.wardIds?.length
                  ? application.wardIds.join(', ')
                  : 'Not available')}
          />
          <DetailRow
            label="Time in selected areas"
            value={application.timeInSelectedAreas}
            last
          />
        </ApplicationSection>

        <ApplicationSection title="Real estate experience">
          <DetailRow
            label="Has real estate experience"
            value={application.hasRealEstateExperience ? 'Yes' : 'No'}
          />
          <DetailRow
            label="Experience areas"
            value={application.experienceAreas?.length
              ? application.experienceAreas.join(', ')
              : 'Not provided'}
          />
          <DetailRow
            label="Experience duration"
            value={application.experienceDuration}
          />
          <DetailRow
            label="Experience description"
            value={application.experienceDescription}
            last
          />
        </ApplicationSection>

        <ApplicationSection title="Current work">
          <DetailRow
            label="Current occupation"
            value={application.currentOccupation}
          />
          <DetailRow
            label="Works with another agency"
            value={application.workingWithAnotherAgency ? 'Yes' : 'No'}
          />
          <DetailRow
            label="Agency name"
            value={application.workingWithAnotherAgency
              ? (application.currentAgencyName || 'Not provided')
              : 'Not applicable'}
            last
          />
        </ApplicationSection>

        <ApplicationSection title="Motivation and targets">
          <DetailRow
            label="Why I want to join MAKAZII"
            value={application.motivation}
          />
          <DetailRow
            label="My contribution"
            value={application.contribution}
          />
          <DetailRow
            label="Expected properties per month"
            value={application.expectedPropertiesPerMonth}
            last
          />
        </ApplicationSection>

        <ApplicationSection title="Property network">
          <DetailRow
            label="Property sources"
            value={application.propertySources?.length
              ? application.propertySources.join(', ')
              : 'Not provided'}
          />
          <DetailRow
            label="Knows landlords"
            value={application.knowsLandlords ? 'Yes' : 'No'}
          />
          <DetailRow
            label="Approximate number of landlords"
            value={application.approximateLandlordCount == null
              ? 'Not provided'
              : String(application.approximateLandlordCount)}
            last
          />
        </ApplicationSection>

        <ApplicationSection title="Communication and availability">
          <DetailRow
            label="Comfortable communicating with clients"
            value={application.comfortableCommunicating ? 'Yes' : 'No'}
          />
          <DetailRow
            label="Preferred communication methods"
            value={application.communicationMethods?.length
              ? application.communicationMethods.join(', ')
              : 'Not provided'}
          />
          <DetailRow
            label="Availability"
            value={application.timeAvailability}
          />
          <DetailRow
            label="Agrees to follow MAKAZII procedures"
            value={application.willingToFollowProcedures ? 'Yes' : 'No'}
            last
          />
        </ApplicationSection>

        <ApplicationSection title="Reference">
          <DetailRow
            label="Reference name"
            value={application.referenceName}
          />
          <DetailRow
            label="Reference phone"
            value={application.referencePhone}
          />
          <DetailRow
            label="Relationship to reference"
            value={application.referenceRelationship}
            last
          />
        </ApplicationSection>

        <ApplicationSection title="Declaration">
          <DetailRow
            label="Declaration accepted"
            value={application.declarationAccepted ? 'Yes' : 'No'}
            last
          />
        </ApplicationSection>

        {reviewedDate && (
          <View style={styles.infoCard}>
            <View style={styles.infoIcon}>
              <FileCheck2
                size={19}
                color={COLORS.blue}
              />
            </View>

            <View style={styles.infoContent}>
              <Text style={styles.infoTitle}>
                Application reviewed
              </Text>

              <Text style={styles.infoText}>
                Your application was reviewed on{' '}
                {reviewedDate}.
              </Text>
            </View>
          </View>
        )}

        {approvedDate &&
          application.status === 'APPROVED' && (
            <View
              style={[
                styles.infoCard,
                {
                  borderColor:
                    'rgba(98,211,155,0.25)',
                  backgroundColor:
                    'rgba(98,211,155,0.06)',
                },
              ]}
            >
              <View
                style={[
                  styles.infoIcon,
                  {
                    backgroundColor:
                      'rgba(98,211,155,0.10)',
                  },
                ]}
              >
                <CheckCircle2
                  size={19}
                  color={COLORS.green}
                />
              </View>

              <View style={styles.infoContent}>
                <Text
                  style={[
                    styles.infoTitle,
                    {
                      color: COLORS.green,
                    },
                  ]}
                >
                  Application approved
                </Text>

                <Text style={styles.infoText}>
                  Your marketer application was
                  approved on {approvedDate}.
                </Text>
              </View>
            </View>
          )}

        {rejectedDate &&
          application.status === 'REJECTED' && (
            <View
              style={[
                styles.infoCard,
                {
                  borderColor:
                    'rgba(255,112,112,0.25)',
                  backgroundColor:
                    'rgba(255,112,112,0.06)',
                },
              ]}
            >
              <View
                style={[
                  styles.infoIcon,
                  {
                    backgroundColor:
                      'rgba(255,112,112,0.10)',
                  },
                ]}
              >
                <XCircle
                  size={19}
                  color={COLORS.red}
                />
              </View>

              <View style={styles.infoContent}>
                <Text
                  style={[
                    styles.infoTitle,
                    {
                      color: COLORS.red,
                    },
                  ]}
                >
                  Application decision
                </Text>

                <Text style={styles.infoText}>
                  The application review was
                  completed on {rejectedDate}.
                </Text>
              </View>
            </View>
          )}

        {showActionMessage && (
          <MessageCard
            icon={
              <TriangleAlert
                size={21}
                color={COLORS.orange}
              />
            }
            title="Changes requested"
            text={application.requestedChanges!}
            tone="orange"
          />
        )}

        {showRejectionReason && (
          <MessageCard
            icon={
              <XCircle
                size={21}
                color={COLORS.red}
              />
            }
            title="Review outcome"
            text={application.rejectionReason!}
            tone="red"
          />
        )}

        <TimelineCard
          activeStep={timelineStep}
          rejected={
            application.status === 'REJECTED'
          }
        />

        <View style={styles.securityCard}>
          <View style={styles.securityIcon}>
            <ShieldCheck
              size={20}
              color={COLORS.lime}
            />
          </View>

          <View style={styles.securityContent}>
            <Text style={styles.securityTitle}>
              Your information is protected
            </Text>

            <Text style={styles.securityText}>
              Your submitted details are shown here for
              your review. Identity document files remain
              protected and are not displayed on this page.
            </Text>
          </View>
        </View>

        <View style={styles.reviewTimeCard}>
          <Clock3
            size={18}
            color={COLORS.muted}
          />

          <Text style={styles.reviewTimeText}>
            Most applications are reviewed within
            2 business days.
          </Text>
        </View>

        {showPrimaryButton && (
          <Pressable
            onPress={handlePrimaryAction}
            style={({ pressed }) => [
              styles.primaryButton,
              pressed &&
                styles.primaryButtonPressed,
            ]}
          >
            <Text style={styles.primaryButtonText}>
              {application.status ===
              'APPROVED'
                ? 'Enter Marketer Portal'
                : application.status ===
                    'ACTION_REQUIRED'
                  ? 'Update Application'
                  : 'Apply Again'}
            </Text>

            <ArrowRight
              size={19}
              color={COLORS.background}
              strokeWidth={2.5}
            />
          </Pressable>
        )}

        <Pressable
          onPress={() =>
            router.replace('/marketer')
          }
          style={({ pressed }) => [
            styles.secondaryButton,
            pressed &&
              styles.secondaryButtonPressed,
          ]}
        >
          <Text style={styles.secondaryButtonText}>
            Back to marketer page
          </Text>
        </Pressable>
      </ScrollView>
    </View>
  );
}

