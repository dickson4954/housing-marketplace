    useMemo(() => {
      const propertyMap = new Map(
        properties.map((property) => [
          property.id,
          property,
        ]),
      );

      return shortlistedIds
        .map((id) => propertyMap.get(id))
        .filter(
          (
            property,
          ): property is BackendProperty =>
            Boolean(property),
        );
    }, [shortlistedIds, properties]);

  const openProperty = (propertyId: string) => {
    router.push(`/property/${propertyId}`);
  };

  const handleViewingPress = (propertyId: string) => {
    router.push({
      pathname: '/viewing/[propertyId]',
      params: { propertyId },
    });
  };

  const goToExplore = () => {
    router.push('/search');
  };

