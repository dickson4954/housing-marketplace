                                color="#D7FF5F"
                                strokeWidth={1.7}
                              />
                            </View>

                            <View>
                              <Text
                                style={
                                  styles.detailValue
                                }
                              >
                                {property.bathrooms ?? 0}
                              </Text>

                              <Text
                                style={
                                  styles.detailLabel
