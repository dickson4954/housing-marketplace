                  INTRO
              =========================================================== */}

              <View style={styles.introSection}>
                <View>
                  <Text style={styles.pageTitle}>
                    Saved homes
                  </Text>

                  <Text style={styles.pageDescription}>
                    Homes you want to keep an eye on.
                  </Text>
                </View>

                <View style={styles.savedBadge}>
