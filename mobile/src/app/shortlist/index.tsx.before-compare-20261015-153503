                          </View>
                        </View>

                        {/* Rent */}

                        <View
                          style={styles.rentSection}
                        >
                          <Text
                            style={styles.rentLabel}
                          >
                            {property.purpose === 'SHORT_STAY'
                              ? 'Stay rate'
