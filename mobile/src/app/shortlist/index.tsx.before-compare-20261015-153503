function getPropertyImage(property: BackendProperty) {
  const images = [...(property.images ?? [])].sort(
    (a, b) =>
      Number(Boolean(b.isPrimary)) -
      Number(Boolean(a.isPrimary)) ||
      (a.sortOrder ?? 0) - (b.sortOrder ?? 0),
  );

  return images[0]?.url ?? '';
}

function getPropertyLocation(property: BackendProperty) {
  const area = property.area?.trim();
  const town = property.town?.trim();
  const county = property.county?.trim();
  const place = property.place?.name?.trim();

  if (area && town) {
    return `${area}, ${town}`;
  }

  return (
    place ||
    town ||
    area ||
    county ||
    'Kenya'
  );
}

function getPropertyType(property: BackendProperty) {
  if (property.purpose === 'SHORT_STAY') {
    return (
      property.shortStayType ||
      'Short stay'
    );
  }

  return (
    property.longStayType ||
    'Property'
  );
}

function getPropertyRentLabel(property: BackendProperty) {
  if (property.purpose === 'SHORT_STAY') {
    if (property.nightRate != null) {
      return `KSh ${property.nightRate.toLocaleString()} / night`;
    }

    if (property.dayRate != null) {
      return `KSh ${property.dayRate.toLocaleString()} / day`;
    }

    if (property.dayNightRate != null) {
      return `KSh ${property.dayNightRate.toLocaleString()}`;
    }

    return 'Rate available';
  }

  return `KSh ${(property.monthlyRent ?? 0).toLocaleString()}`;
}

export default function ShortlistScreen() {
  const {
    shortlistedIds,
    removeFromShortlist,
    clearShortlist,
  } = useShortlist();

  const [properties, setProperties] =
    useState<BackendProperty[]>([]);

  const [loading, setLoading] =
    useState(true);

  const loadProperties = useCallback(
    async () => {
      try {
        setLoading(true);

        const response = await fetch(
          `${API_BASE_URL}${API_ENDPOINTS.properties}`,
        );

        if (!response.ok) {
          throw new Error(
            'Failed to load properties',
          );
        }

        const result = await response.json();

        const backendProperties =
          Array.isArray(result)
            ? result
            : Array.isArray(result?.data)
              ? result.data
              : Array.isArray(result?.properties)
                ? result.properties
                : [];

        setProperties(
          backendProperties as BackendProperty[],
        );
      } catch (error) {
        console.error(
          'Failed to load shortlist properties:',
          error,
        );

        setProperties([]);
      } finally {
        setLoading(false);
      }
    },
    [],
  );

  useEffect(() => {
    void loadProperties();
  }, [loadProperties]);

