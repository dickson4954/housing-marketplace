        ================================================================= */}

        <View style={styles.header}>
          <TouchableOpacity
            style={styles.backButton}
            onPress={() => router.back()}
            activeOpacity={0.8}
          >
            <ArrowLeft
              size={21}
              color="#FFFFFF"
              strokeWidth={2}
            />
          </TouchableOpacity>

          <View style={styles.headerCenter}>
            <Text style={styles.headerTitle}>
              Shortlist
            </Text>

            <Text style={styles.headerSubtitle}>
              {shortlistedProperties.length}{' '}
              {shortlistedProperties.length === 1
                ? 'home'
                : 'homes'}{' '}
              saved
            </Text>
          </View>

          {shortlistedProperties.length > 0 ? (
            <TouchableOpacity
              style={styles.clearButton}
              onPress={() => {
                void clearShortlist();
              }}
              activeOpacity={0.8}
            >
              <Trash2
                size={16}
                color="#FF8F8F"
                strokeWidth={1.8}
              />

              <Text style={styles.clearButtonText}>
                Clear
              </Text>
            </TouchableOpacity>
          ) : (
            <View style={styles.headerSpacer} />
          )}
        </View>

        {/* ================================================================
            CONTENT
        ================================================================= */}

        <ScrollView
          showsVerticalScrollIndicator={false}
          contentContainerStyle={styles.scrollContent}
        >
          {loading ? (
            <View style={styles.emptyState}>
              <View style={styles.emptyIcon}>
                <Heart
                  size={34}
                  color="#D7FF5F"
                  strokeWidth={1.7}
                />
              </View>

              <Text style={styles.emptyTitle}>
                Loading your shortlist
              </Text>

              <Text style={styles.emptyDescription}>
                We are loading the homes you saved.
              </Text>
            </View>
          ) : shortlistedProperties.length === 0 ? (
            <View style={styles.emptyState}>
              <View style={styles.emptyIcon}>
                <Heart
                  size={34}
                  color="#D7FF5F"
                  strokeWidth={1.7}
                />
              </View>

              <Text style={styles.emptyTitle}>
                Your shortlist is empty
              </Text>

              <Text style={styles.emptyDescription}>
                Save homes you like while exploring
                Makazii. They will appear here so you
                can easily compare them later.
              </Text>

              <TouchableOpacity
                style={styles.exploreButton}
                onPress={goToExplore}
                activeOpacity={0.85}
              >
                <Text style={styles.exploreButtonText}>
                  Explore homes
                </Text>

                <ChevronRight
                  size={19}
                  color="#0B0F10"
                  strokeWidth={2.3}
                />
              </TouchableOpacity>
            </View>
