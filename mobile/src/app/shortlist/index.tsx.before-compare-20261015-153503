                              >
                                {property.bathrooms === 1
                                  ? 'Bathroom'
                                  : 'Bathrooms'}
                              </Text>
                            </View>
                          </View>

                          {property.rooms != null ? (
                            <View
                              style={
                                styles.sizeContainer
