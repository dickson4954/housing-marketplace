export default function PropertiesScreen() {
  const {
    isShortlisted,
    toggleShortlist,
  } = useShortlist();

  const properties = useMemo(
    () => getPublishedProperties(),
    [],
  );

  const openProperty = (propertyId: string) => {
    router.push({
      pathname: '/properties/[id]',
      params: {
        id: propertyId,
      },
    });
  };

  return (
    <SafeAreaView style={styles.safeArea}>
      <View style={styles.container}>
        {/* Header */}
        <View style={styles.header}>
          <TouchableOpacity
            style={styles.backButton}
            onPress={() => router.back()}
            activeOpacity={0.8}
          >
            <ArrowLeft
              size={21}
              color={COLORS.white}
              strokeWidth={2}
            />
          </TouchableOpacity>

          <View style={styles.headerText}>
            <Text style={styles.eyebrow}>
              MAKAZII
            </Text>

            <Text style={styles.title}>
              Properties
            </Text>
          </View>

          <View style={styles.headerSpacer} />
        </View>

        {/* Intro */}
        <View style={styles.intro}>
          <Text style={styles.introTitle}>
            Find a place to call home
          </Text>

          <Text style={styles.introSubtitle}>
            Browse verified rental homes available
            across different locations.
          </Text>
        </View>

        {/* Results count */}
        <View style={styles.resultRow}>
          <Text style={styles.resultCount}>
            {properties.length}{' '}
            {properties.length === 1
              ? 'property'
              : 'properties'}
          </Text>

          <View style={styles.resultDot} />

          <Text style={styles.resultLabel}>
            Available listings
          </Text>
        </View>

        {/* Property list */}
        <ScrollView
          showsVerticalScrollIndicator={false}
          contentContainerStyle={styles.listContent}
        >
          {properties.length === 0 ? (
            <View style={styles.emptyCard}>
              <View style={styles.emptyIcon}>
                <MapPin
                  size={24}
                  color={COLORS.lime}
                />
              </View>

              <Text style={styles.emptyTitle}>
                No properties available
              </Text>

              <Text style={styles.emptyText}>
                New homes will appear here when
                they are published.
              </Text>

              <TouchableOpacity
                style={styles.exploreButton}
                onPress={() =>
                  router.push('/search')
                }
                activeOpacity={0.85}
              >
                <Text
                  style={styles.exploreButtonText}
                >
                  Explore Search
                </Text>
              </TouchableOpacity>
            </View>
          ) : (
            properties.map((property) => {
              const saved = isShortlisted(
                property.id,
              );

              const mainImage =
                property.images?.[0];

              return (
                <TouchableOpacity
                  key={property.id}
                  style={styles.propertyCard}
                  onPress={() =>
                    openProperty(property.id)
                  }
                  activeOpacity={0.92}
                >
                  {/* Image */}
                  <View
                    style={styles.imageContainer}
                  >
                    {mainImage ? (
                      <Image
                        source={{
                          uri: mainImage,
                        }}
                        style={styles.propertyImage}
                        resizeMode="cover"
                      />
                    ) : (
                      <View
                        style={
                          styles.imagePlaceholder
                        }
                      >
                        <MapPin
                          size={30}
                          color={COLORS.muted}
                        />
                      </View>
                    )}

                    {/* Badges */}
                    <View
                      style={styles.badgeRow}
                    >
                      {property.verified && (
                        <View
                          style={
                            styles.verifiedBadge
                          }
                        >
                          <CheckCircle2
                            size={13}
                            color={
                              COLORS.background
                            }
                            strokeWidth={2.5}
                          />

                          <Text
                            style={
                              styles.verifiedText
                            }
                          >
                            Verified
                          </Text>
                        </View>
                      )}

                      {property.available && (
                        <View
                          style={
                            styles.availableBadge
                          }
                        >
                          <Text
                            style={
                              styles.availableText
                            }
                          >
                            Available
                          </Text>
                        </View>
                      )}
                    </View>

                    {/* Shortlist */}
                    <TouchableOpacity
                      style={[
                        styles.heartButton,
                        saved &&
                          styles.heartButtonSaved,
                      ]}
                      onPress={(event) => {
                        event.stopPropagation();

                        toggleShortlist(
                          property.id,
                        );
                      }}
                      activeOpacity={0.85}
                    >
                      <Heart
                        size={19}
                        color={
                          saved
                            ? COLORS.lime
                            : COLORS.white
                        }
                        fill={
                          saved
                            ? COLORS.lime
                            : 'transparent'
                        }
                        strokeWidth={1.8}
                      />
                    </TouchableOpacity>
                  </View>

                  {/* Content */}
                  <View
                    style={styles.cardContent}
                  >
                    <View
                      style={styles.titleRow}
                    >
                      <View
                        style={styles.titleArea}
                      >
                        <Text
                          style={
                            styles.propertyTitle
                          }
                          numberOfLines={1}
                        >
                          {property.title}
                        </Text>

                        <View
                          style={
                            styles.locationRow
                          }
                        >
                          <MapPin
                            size={14}
                            color={
                              COLORS.muted
                            }
                            strokeWidth={1.8}
                          />

                          <Text
                            style={
                              styles.locationText
                            }
                            numberOfLines={1}
                          >
                            {property.area},{' '}
                            {property.town}
                          </Text>
                        </View>
                      </View>

                      <View
                        style={styles.typeBadge}
                      >
                        <Text
                          style={
                            styles.typeBadgeText
                          }
                        >
                          {property.type}
                        </Text>
                      </View>
                    </View>

                    {/* Price */}
                    <View
                      style={styles.priceRow}
                    >
                      <Text
                        style={styles.price}
                      >
                        KSh{' '}
                        {property.rent.toLocaleString()}
                      </Text>

                      <Text
                        style={styles.perMonth}
                      >
                        / month
                      </Text>
                    </View>

                    {/* Property stats */}
                    <View
                      style={styles.statsRow}
                    >
                      <View style={styles.stat}>
                        <BedDouble
                          size={16}
                          color={
                            COLORS.muted
                          }
                          strokeWidth={1.8}
                        />

                        <Text
                          style={
                            styles.statText
                          }
                        >
                          {property.bedrooms}{' '}
                          bed
                        </Text>
                      </View>

                      <View style={styles.stat}>
                        <Bath
                          size={16}
                          color={
                            COLORS.muted
                          }
                          strokeWidth={1.8}
                        />

                        <Text
                          style={
                            styles.statText
                          }
                        >
                          {property.bathrooms}{' '}
                          bath
                        </Text>
                      </View>

                      {property.size && (
                        <View
                          style={styles.stat}
                        >
                          <Ruler
                            size={16}
                            color={
                              COLORS.muted
                            }
                            strokeWidth={1.8}
                          />

                          <Text
                            style={
                              styles.statText
                            }
                          >
                            {property.size}
                          </Text>
                        </View>
                      )}
                    </View>

                    {/* Footer */}
                    <View
                      style={styles.cardFooter}
                    >
                      <View>
                        <Text
                          style={
                            styles.depositLabel
                          }
                        >
                          Deposit
                        </Text>

                        <Text
                          style={
                            styles.depositValue
                          }
                        >
                          KSh{' '}
                          {property.deposit.toLocaleString()}
                        </Text>
                      </View>

                      <View
                        style={
                          styles.viewButton
                        }
                      >
                        <Text
                          style={
                            styles.viewButtonText
                          }
                        >
                          View home
                        </Text>
                      </View>
                    </View>
                  </View>
                </TouchableOpacity>
              );
            })
          )}

          <View
            style={styles.bottomSpacing}
          />
        </ScrollView>
      </View>
    </SafeAreaView>
  );
}

