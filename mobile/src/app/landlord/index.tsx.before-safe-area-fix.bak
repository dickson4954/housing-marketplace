import React from "react";
import { router } from "expo-router";
import { Pressable, SafeAreaView, StyleSheet, Text, View } from "react-native";
import { ArrowLeft, ArrowRight, Building2, LogIn, UserPlus } from "lucide-react-native";

export default function LandlordEntry() {
  return (
    <SafeAreaView style={styles.safe}>
      <View style={styles.container}>
        <Pressable onPress={() => router.back()} style={styles.back}>
          <ArrowLeft size={19} color="#FFFFFF" />
          <Text style={styles.backText}>Back</Text>
        </Pressable>

        <Text style={styles.brand}>MAKAZII</Text>
        <Text style={styles.eyebrow}>LANDLORD PORTAL</Text>
        <Text style={styles.title}>List with confidence.</Text>
        <Text style={styles.description}>
          Apply to list your property or sign in to manage an existing landlord account.
          All applications and properties are reviewed by the Makazii team.
        </Text>

        <Pressable
          style={({ pressed }) => [styles.card, pressed && styles.pressed]}
          onPress={() => router.push("/landlord/apply" as any)}
        >
          <View style={styles.iconBox}>
            <UserPlus size={23} color="#D7FF5F" />
          </View>
          <View style={styles.cardBody}>
            <Text style={styles.cardTitle}>Apply as a landlord</Text>
            <Text style={styles.cardDescription}>
              New to Makazii? Create an account and submit your application and national ID.
            </Text>
          </View>
          <ArrowRight size={20} color="#D7FF5F" />
        </Pressable>

        <Pressable
          style={({ pressed }) => [styles.card, pressed && styles.pressed]}
          onPress={() => router.push("/landlord/login" as any)}
        >
          <View style={styles.iconBox}>
            <LogIn size={23} color="#D7FF5F" />
          </View>
          <View style={styles.cardBody}>
            <Text style={styles.cardTitle}>Already a landlord? Log in</Text>
            <Text style={styles.cardDescription}>
              Sign in to check your application, verification and property updates.
            </Text>
          </View>
          <ArrowRight size={20} color="#D7FF5F" />
        </Pressable>

        <View style={styles.notice}>
          <Building2 size={18} color="#D7FF5F" />
          <Text style={styles.noticeText}>
            Your properties must be approved by Makazii before appearing in the marketplace.
          </Text>
        </View>
      </View>
    </SafeAreaView>
  );
}

const styles = StyleSheet.create({
  safe: { flex: 1, backgroundColor: "#0B0F10" },
  container: { flex: 1, padding: 22, paddingTop: 16, justifyContent: "center" },
  back: { flexDirection: "row", alignItems: "center", gap: 8, marginBottom: 35 },
  backText: { color: "#FFFFFF", fontSize: 14, fontWeight: "600" },
  brand: { color: "#D7FF5F", fontSize: 15, fontWeight: "900", letterSpacing: 3 },
  eyebrow: { color: "#9CA5A7", fontSize: 11, fontWeight: "800", letterSpacing: 2, marginTop: 25 },
  title: { color: "#FFFFFF", fontSize: 30, fontWeight: "900", marginTop: 9 },
  description: { color: "#9CA5A7", fontSize: 14, lineHeight: 22, marginTop: 10, marginBottom: 27 },
  card: { flexDirection: "row", alignItems: "center", gap: 13, padding: 16, borderRadius: 17, borderWidth: 1, borderColor: "#252C2E", backgroundColor: "#14191B", marginBottom: 13 },
  pressed: { opacity: 0.78 },
  iconBox: { width: 46, height: 46, borderRadius: 14, backgroundColor: "#202729", alignItems: "center", justifyContent: "center" },
  cardBody: { flex: 1 },
  cardTitle: { color: "#FFFFFF", fontSize: 15, fontWeight: "800" },
  cardDescription: { color: "#9CA5A7", fontSize: 12, lineHeight: 18, marginTop: 5 },
  notice: { flexDirection: "row", alignItems: "flex-start", gap: 10, padding: 14, borderRadius: 14, backgroundColor: "#181E20", marginTop: 10 },
  noticeText: { color: "#C6CDCE", fontSize: 12, lineHeight: 18, flex: 1 },
});
