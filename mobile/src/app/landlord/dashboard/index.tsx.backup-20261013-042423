import React, { useCallback, useEffect, useState } from "react";
import {
  ActivityIndicator,
  Alert,
  Pressable,
  ScrollView,
  StyleSheet,
  Text,
  View,
} from "react-native";
import * as SecureStore from "expo-secure-store";
import { router } from "expo-router";
import { API_BASE_URL } from "@/config/api";

const TOKEN_KEY = "makazii_landlord_token";

const items = [
  {
    title: "My application",
    detail: "Check your application and verification status",
    route: "/landlord/application",
  },
  {
    title: "My properties",
    detail: "View submitted properties and review statuses",
    route: "/landlord/properties",
  },
  {
    title: "Add a property",
    detail: "Submit a property to Makazii for admin review",
    route: "/landlord/properties/add",
  },
  {
    title: "Viewings",
    detail: "Track viewing requests and updates",
    route: "/landlord/viewings",
  },
  {
    title: "My concerns",
    detail: "Review customer concerns about your properties",
    route: "/landlord/concerns",
  },
  {
    title: "Payments",
    detail: "View available fee and payment information",
    route: "/landlord/payments",
  },
  {
    title: "Account",
    detail: "Manage your landlord account",
    route: "/landlord/account",
  },
] as const;

async function getToken(): Promise<string | null> {
  try {
    if (typeof window !== "undefined" && window.localStorage) {
      return window.localStorage.getItem(TOKEN_KEY);
    }
  } catch {
    // Fall back to secure storage.
  }

  try {
    return await SecureStore.getItemAsync(TOKEN_KEY);
  } catch {
    return null;
  }
}

export default function LandlordDashboard() {
  const [checking, setChecking] = useState(true);
  const [error, setError] = useState("");
  const [propertyCounties, setPropertyCounties] = useState<
    { id: string; name: string }[]
  >([]);

  const checkApproval = useCallback(async () => {
    setChecking(true);
    setError("");

    try {
      const token = await getToken();

      if (!token) {
        router.replace("/landlord/login" as any);
        return;
      }

      const response = await fetch(
        `${API_BASE_URL}/auth/landlord/application-status`,
        {
          headers: {
            Accept: "application/json",
            Authorization: `Bearer ${token}`,
          },
        }
      );

      const result = await response.json().catch(() => null);

      if (response.status === 401 || response.status === 403) {
        router.replace("/landlord/login" as any);
        return;
      }

      if (!response.ok || !result?.success || !result?.data) {
        throw new Error(
          result?.message || "Could not verify your landlord approval."
        );
      }

      if (
        String(result.data.applicationStatus || "").toUpperCase() !==
        "APPROVED"
      ) {
        router.replace("/landlord/application" as any);
        return;
      }

      const dashboardResponse = await fetch(
        `${API_BASE_URL}/landlord/dashboard/`,
        {
          headers: {
            Accept: "application/json",
            Authorization: `Bearer ${token}`,
          },
        }
      );

      const dashboardResult = await dashboardResponse.json().catch(() => null);

      if (
        !dashboardResponse.ok ||
        !dashboardResult?.success ||
        !dashboardResult?.data
      ) {
        throw new Error(
          dashboardResult?.message || "Could not load your approved counties."
        );
      }

      const savedCounties = dashboardResult.data.propertyCounties;
      setPropertyCounties(
        Array.isArray(savedCounties)
          ? savedCounties.filter(
              (county: any) =>
                county &&
                typeof county.id === "string" &&
                typeof county.name === "string"
            )
          : []
      );
    } catch (err) {
      setError(
        err instanceof TypeError
          ? "Unable to connect to Makazii. Check your internet connection."
          : err instanceof Error
            ? err.message
            : "Unable to verify your application."
      );
    } finally {
      setChecking(false);
    }
  }, []);

  useEffect(() => {
    void checkApproval();
  }, [checkApproval]);

  const handleLogout = async () => {
    Alert.alert(
      "Sign out",
      "Are you sure you want to sign out of your landlord account?",
      [
        { text: "Cancel", style: "cancel" },
        {
          text: "Sign out",
          style: "destructive",
          onPress: async () => {
            try {
              if (
                typeof window !== "undefined" &&
                window.localStorage
              ) {
                window.localStorage.removeItem(TOKEN_KEY);
              } else {
                await SecureStore.deleteItemAsync(TOKEN_KEY);
              }
            } catch (error) {
              console.error("LANDLORD LOGOUT ERROR:", error);
              try {
                await SecureStore.deleteItemAsync(TOKEN_KEY);
              } catch (storageError) {
                console.error(
                  "Unable to clear landlord session:",
                  storageError
                );
              }
            } finally {
              router.replace("/" as any);
            }
          },
        },
      ]
    );
  };

  if (checking) {
    return (
      <View style={styles.centered}>
        <ActivityIndicator size="large" color="#D7FF5F" />
        <Text style={styles.loadingText}>
          Verifying your landlord approval...
        </Text>
      </View>
    );
  }

  // Fail closed: never render the dashboard if approval could not be verified.
  if (error) {
    return (
      <View style={styles.centered}>
        <Text style={styles.errorTitle}>Dashboard unavailable</Text>
        <Text style={styles.errorText}>{error}</Text>

        <Pressable style={styles.primaryButton} onPress={checkApproval}>
          <Text style={styles.primaryButtonText}>Try again</Text>
        </Pressable>

        <Pressable
          style={styles.secondaryButton}
          onPress={() => router.replace("/landlord/application" as any)}
        >
          <Text style={styles.secondaryButtonText}>
            View application status
          </Text>
        </Pressable>
      </View>
    );
  }

  return (
    <ScrollView
      style={styles.screen}
      contentContainerStyle={styles.content}
    >
      <Text style={styles.brand}>MAKAZII</Text>
      <Text style={styles.eyebrow}>LANDLORD PORTAL</Text>
      <Text style={styles.heading}>Your property space</Text>
      <Text style={styles.subtitle}>
        Your landlord application is approved. Manage your properties and
        submit new listings for review.
      </Text>

      <View style={styles.notice}>
        <Text style={styles.noticeTitle}>Your selected property counties</Text>
        <Text style={styles.noticeText}>
          {propertyCounties.length > 0
            ? propertyCounties.map((county) => county.name).join(", ")
            : "No counties were saved on your application. Please contact Makazii to update your county selections before adding a property."}
        </Text>
      </View>

      <View style={styles.notice}>
        <Text style={styles.noticeTitle}>Property approval required</Text>
        <Text style={styles.noticeText}>
          Every property you submit must be reviewed and approved by Makazii
          before it can appear in the marketplace. Your landlord approval
          does not automatically approve your properties or national ID
          verification.
        </Text>
      </View>

      {items.map((item) => (
        <Pressable
          key={item.route}
          style={styles.card}
          onPress={() => router.push(item.route as any)}
        >
          <View style={styles.cardText}>
            <Text style={styles.cardTitle}>{item.title}</Text>
            <Text style={styles.cardDetail}>{item.detail}</Text>
          </View>
          <Text style={styles.arrow}>›</Text>
        </Pressable>
      ))}

      <Pressable
        accessibilityRole="button"
        style={{
          marginTop: 24,
          paddingVertical: 16,
          paddingHorizontal: 18,
          borderRadius: 14,
          borderWidth: 1,
          borderColor: "#713B3B",
          backgroundColor: "#211516",
          alignItems: "center",
        }}
        onPress={handleLogout}
      >
        <Text style={{ color: "#FF8A8A", fontSize: 15, fontWeight: "800" }}>
          Sign out of landlord account
        </Text>
      </Pressable>
    </ScrollView>
  );
}

