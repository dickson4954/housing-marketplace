import React, {
  createContext,
  useCallback,
  useContext,
  useMemo,
  useState,
} from 'react';

import {
  PROPERTIES as INITIAL_PROPERTIES,
} from '@/data/properties';

import type {
  Property,
  PropertyAvailability,
  PropertyImage,
  PropertyStatus,
  VerificationStatus,
} from '@/types/property';

type PropertyContextValue = {
  properties: Property[];

  getPropertyById: (id: string) => Property | undefined;
  getPublishedProperties: () => Property[];
  getAvailableProperties: () => Property[];

  createProperty: (property: Property) => void;
  updateProperty: (id: string, updates: Partial<Property>) => void;
  deleteProperty: (id: string) => void;

  savePropertyDraft: (
    property: Property,
  ) => void;

  submitPropertyForReview: (
    id: string,
  ) => void;

  approveProperty: (
    id: string,
    notes?: string,
  ) => void;

  requestPropertyChanges: (
    id: string,
    notes: string,
  ) => void;

  rejectProperty: (
    id: string,
    notes: string,
  ) => void;

  publishProperty: (id: string) => void;
  unpublishProperty: (id: string) => void;

  setAvailability: (
    id: string,
    availability: PropertyAvailability,
  ) => void;

  setVerificationStatus: (
    id: string,
    status: VerificationStatus,
    notes?: string,
  ) => void;

  addPropertyImage: (
    id: string,
    image: PropertyImage,
  ) => void;

  removePropertyImage: (
    id: string,
    imageId: string,
  ) => void;

  setCoverImage: (
    id: string,
    imageId: string,
  ) => void;

  reorderPropertyImages: (
    id: string,
    images: PropertyImage[],
  ) => void;

  featuredProperty: (
    id: string,
    featured: boolean,
  ) => void;
};

const PropertyContext =
  createContext<PropertyContextValue | undefined>(
    undefined,
  );

function normalizeInitialProperties(): Property[] {
  return INITIAL_PROPERTIES.map((property: any) => ({
    ...property,

    location: property.location ?? {
      county: property.county ?? '',
      town: property.town ?? '',
      area: property.area ?? '',
      landmark: property.landmark ?? '',
      address: property.address ?? '',
      latitude: property.latitude,
      longitude: property.longitude,
    },

    images: Array.isArray(property.images)
      ? property.images.map(
          (image: any, index: number) => {
            if (typeof image === 'string') {
              return {
                id: `${property.id}-image-${index}`,
                uri: image,
                isCover: index === 0,
                order: index,
              };
            }

            return {
              id:
                image.id ??
                `${property.id}-image-${index}`,
              uri:
                image.uri ??
                image.url ??
                '',
              isCover:
                image.isCover ??
                index === 0,
              order:
                image.order ??
                index,
            };
          },
        )
      : [],

    amenities: Array.isArray(property.amenities)
      ? property.amenities
      : [],

    nearby: Array.isArray(property.nearby)
      ? property.nearby.map(
          (place: any, index: number) => ({
            id:
              place.id ??
              `${property.id}-nearby-${index}`,
            name: place.name ?? '',
            type:
              place.type ??
              'Nearby',
            distance:
              place.distance ??
              '',
          }),
        )
      : [],

    verificationStatus:
      property.verificationStatus ??
      (property.verified
        ? 'verified'
        : 'pending'),

    availability:
      property.availability ??
      (property.available
        ? 'available'
        : 'occupied'),

    status:
      property.status ??
      'published',

    featured:
      property.featured ??
      false,

    createdAt:
      property.createdAt ??
      new Date().toISOString(),

    updatedAt:
      property.updatedAt ??
      new Date().toISOString(),
  })) as Property[];
}

export function PropertyProvider({
  children,
}: {
  children: React.ReactNode;
}) {
  const [
    properties,
    setProperties,
  ] = useState<Property[]>(
    normalizeInitialProperties(),
  );

  const getPropertyById =
    useCallback(
      (id: string) => {
        return properties.find(
          (property) =>
            property.id === id,
        );
      },
      [properties],
    );

  /*
   * Customer-facing published properties.
   *
   * Only published + available properties
   * are returned here.
   */
  const getPublishedProperties =
    useCallback(() => {
      return properties.filter(
        (property) =>
          property.status ===
            'published' &&
          property.availability ===
            'available',
      );
    }, [properties]);

  const getAvailableProperties =
    useCallback(() => {
      return properties.filter(
        (property) =>
          property.availability ===
          'available',
      );
    }, [properties]);

  const createProperty =
    useCallback(
      (property: Property) => {
        setProperties((current) => [
          property,
          ...current,
        ]);
      },
      [],
    );

  const updateProperty =
    useCallback(
      (
        id: string,
        updates: Partial<Property>,
      ) => {
        setProperties((current) =>
          current.map((property) =>
            property.id === id
              ? {
                  ...property,
                  ...updates,
                  updatedAt:
                    new Date().toISOString(),
                }
              : property,
          ),
        );
      },
      [],
    );

  const deleteProperty =
    useCallback((id: string) => {
      setProperties((current) =>
        current.filter(
          (property) =>
            property.id !== id,
        ),
      );
    }, []);

  /*
   * Save a property as a draft.
   */
  const savePropertyDraft =
    useCallback(
      (property: Property) => {
        setProperties((current) => {
          const exists =
            current.some(
              (item) =>
                item.id === property.id,
            );

          if (exists) {
            return current.map(
              (item) =>
                item.id === property.id
                  ? {
                      ...item,
                      ...property,
                      status: 'draft',
                      updatedAt:
                        new Date().toISOString(),
                    }
                  : item,
            );
          }

          return [
            {
              ...property,
              status: 'draft',
              updatedAt:
                new Date().toISOString(),
            },
            ...current,
          ];
        });
      },
      [],
    );

  /*
   * Marketer submits a draft for admin review.
   */
  const submitPropertyForReview =
    useCallback((id: string) => {
      setProperties((current) =>
        current.map((property) =>
          property.id === id
            ? {
                ...property,
                status:
                  'under_review',
                verificationStatus:
                  'pending',
                submittedAt:
                  new Date().toISOString(),
                updatedAt:
                  new Date().toISOString(),
              }
            : property,
        ),
      );
    }, []);

  /*
   * Admin approves and publishes.
   */
  const approveProperty =
    useCallback(
      (
        id: string,
        notes?: string,
      ) => {
        setProperties((current) =>
          current.map(
            (property) =>
              property.id === id
                ? {
                    ...property,
                    status:
                      'published',
                    verificationStatus:
                      'verified',
                    verificationNotes:
                      notes ??
                      property.verificationNotes,
                    adminReviewNotes:
                      notes ??
                      property.adminReviewNotes,
                    verifiedBy:
                      'Makazii Admin',
                    verifiedDate:
                      new Date().toISOString(),
                    approvedAt:
                      new Date().toISOString(),
                    publishedAt:
                      new Date().toISOString(),
                    updatedAt:
                      new Date().toISOString(),
                  }
                : property,
          ),
        );
      },
      [],
    );

  /*
   * Admin requests changes.
   */
  const requestPropertyChanges =
    useCallback(
      (
        id: string,
        notes: string,
      ) => {
        setProperties((current) =>
          current.map(
            (property) =>
              property.id === id
                ? {
                    ...property,
                    status:
                      'changes_required',
                    verificationStatus:
                      'pending',
                    adminReviewNotes:
                      notes,
                    updatedAt:
                      new Date().toISOString(),
                  }
                : property,
          ),
        );
      },
      [],
    );

  /*
   * Admin rejects the property.
   */
  const rejectProperty =
    useCallback(
      (
        id: string,
        notes: string,
      ) => {
        setProperties((current) =>
          current.map(
            (property) =>
              property.id === id
                ? {
                    ...property,
                    status:
                      'rejected',
                    verificationStatus:
                      'rejected',
                    adminReviewNotes:
                      notes,
                    rejectedAt:
                      new Date().toISOString(),
                    updatedAt:
                      new Date().toISOString(),
                  }
                : property,
          ),
        );
      },
      [],
    );

  /*
   * Admin-only publishing method.
   */
  const publishProperty =
    useCallback((id: string) => {
      setProperties((current) =>
        current.map((property) =>
          property.id === id
            ? {
                ...property,
                status:
                  'published',
                publishedAt:
                  new Date().toISOString(),
                updatedAt:
                  new Date().toISOString(),
              }
            : property,
        ),
      );
    }, []);

  const unpublishProperty =
    useCallback((id: string) => {
      setProperties((current) =>
        current.map((property) =>
          property.id === id
            ? {
                ...property,
                status: 'hidden',
                updatedAt:
                  new Date().toISOString(),
              }
            : property,
        ),
      );
    }, []);

  const setAvailability =
    useCallback(
      (
        id: string,
        availability: PropertyAvailability,
      ) => {
        setProperties((current) =>
          current.map((property) =>
            property.id === id
              ? {
                  ...property,
                  availability,
                  updatedAt:
                    new Date().toISOString(),
                }
              : property,
          ),
        );
      },
      [],
    );

  const setVerificationStatus =
    useCallback(
      (
        id: string,
        status: VerificationStatus,
        notes?: string,
      ) => {
        setProperties((current) =>
          current.map((property) => {
            if (
              property.id !== id
            ) {
              return property;
            }

            return {
              ...property,
              verificationStatus:
                status,
              verificationNotes:
                notes ??
                property.verificationNotes,
              verifiedBy:
                status === 'verified'
                  ? property.verifiedBy ??
                    'Makazii Team'
                  : property.verifiedBy,
              verifiedDate:
                status === 'verified'
                  ? new Date().toISOString()
                  : property.verifiedDate,
              updatedAt:
                new Date().toISOString(),
            };
          }),
        );
      },
      [],
    );

  const addPropertyImage =
    useCallback(
      (
        id: string,
        image: PropertyImage,
      ) => {
        setProperties((current) =>
          current.map((property) => {
            if (
              property.id !== id
            ) {
              return property;
            }

            const nextOrder =
              property.images.length;

            const newImage: PropertyImage =
              {
                ...image,
                order: nextOrder,
                isCover:
                  property.images
                    .length === 0
                    ? true
                    : image.isCover,
              };

            let images = [
              ...property.images,
              newImage,
            ];

            if (newImage.isCover) {
              images = images.map(
                (item) => ({
                  ...item,
                  isCover:
                    item.id ===
                    newImage.id,
                }),
              );
            }

            return {
              ...property,
              images,
              updatedAt:
                new Date().toISOString(),
            };
          }),
        );
      },
      [],
    );

  const removePropertyImage =
    useCallback(
      (
        id: string,
        imageId: string,
      ) => {
        setProperties((current) =>
          current.map((property) => {
            if (
              property.id !== id
            ) {
              return property;
            }

            const wasCover =
              property.images.some(
                (image) =>
                  image.id ===
                    imageId &&
                  image.isCover,
              );

            let images =
              property.images
                .filter(
                  (image) =>
                    image.id !==
                    imageId,
                )
                .map(
                  (
                    image,
                    index,
                  ) => ({
                    ...image,
                    order: index,
                  }),
                );

            if (
              wasCover &&
              images.length > 0
            ) {
              images =
                images.map(
                  (
                    image,
                    index,
                  ) => ({
                    ...image,
                    isCover:
                      index === 0,
                  }),
                );
            }

            return {
              ...property,
              images,
              updatedAt:
                new Date().toISOString(),
            };
          }),
        );
      },
      [],
    );

  const setCoverImage =
    useCallback(
      (
        id: string,
        imageId: string,
      ) => {
        setProperties((current) =>
          current.map((property) => {
            if (
              property.id !== id
            ) {
              return property;
            }

            return {
              ...property,
              images:
                property.images.map(
                  (image) => ({
                    ...image,
                    isCover:
                      image.id ===
                      imageId,
                  }),
                ),
              updatedAt:
                new Date().toISOString(),
            };
          }),
        );
      },
      [],
    );

  const reorderPropertyImages =
    useCallback(
      (
        id: string,
        images: PropertyImage[],
      ) => {
        setProperties((current) =>
          current.map((property) => {
            if (
              property.id !== id
            ) {
              return property;
            }

            return {
              ...property,
              images: images.map(
                (
                  image,
                  index,
                ) => ({
                  ...image,
                  order: index,
                }),
              ),
              updatedAt:
                new Date().toISOString(),
            };
          }),
        );
      },
      [],
    );

  const featuredProperty =
    useCallback(
      (
        id: string,
        featured: boolean,
      ) => {
        setProperties((current) =>
          current.map((property) =>
            property.id === id
              ? {
                  ...property,
                  featured,
                  updatedAt:
                    new Date().toISOString(),
                }
              : property,
          ),
        );
      },
      [],
    );

  const value =
    useMemo<PropertyContextValue>(
      () => ({
        properties,
        getPropertyById,
        getPublishedProperties,
        getAvailableProperties,

        createProperty,
        updateProperty,
        deleteProperty,

        savePropertyDraft,
        submitPropertyForReview,

        approveProperty,
        requestPropertyChanges,
        rejectProperty,

        publishProperty,
        unpublishProperty,

        setAvailability,
        setVerificationStatus,

        addPropertyImage,
        removePropertyImage,
        setCoverImage,
        reorderPropertyImages,

        featuredProperty,
      }),
      [
        properties,
        getPropertyById,
        getPublishedProperties,
        getAvailableProperties,

        createProperty,
        updateProperty,
        deleteProperty,

        savePropertyDraft,
        submitPropertyForReview,

        approveProperty,
        requestPropertyChanges,
        rejectProperty,

        publishProperty,
        unpublishProperty,

        setAvailability,
        setVerificationStatus,

        addPropertyImage,
        removePropertyImage,
        setCoverImage,
        reorderPropertyImages,

        featuredProperty,
      ],
    );

  return (
    <PropertyContext.Provider
      value={value}
    >
      {children}
    </PropertyContext.Provider>
  );
}

export function useProperties() {
  const context =
    useContext(PropertyContext);

  if (!context) {
    throw new Error(
      'useProperties must be used inside PropertyProvider',
    );
  }

  return context;
}

