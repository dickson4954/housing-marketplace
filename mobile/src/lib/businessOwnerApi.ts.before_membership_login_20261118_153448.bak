type GeographyEnvelope<T> = {
  success: boolean;
  message?: string;
  data?: T;
};

async function requestPublicGeography<T>(endpoint: string): Promise<T> {
  const response = await fetch(`${API_BASE_URL}${endpoint}`, {
    method: 'GET',
    headers: { Accept: 'application/json' },
  });

  let result: GeographyEnvelope<T>;

  try {
    result = await response.json();
  } catch {
    throw new Error('The geography service returned an invalid response.');
  }

  if (!response.ok || !result.success || !result.data) {
    throw new Error(
      result.message || 'Unable to load the location options. Please try again.',
    );
  }

  return result.data;
}

export async function getPublicGeographyCounties() {
  const result = await requestPublicGeography<{
    counties: PublicGeographyCounty[];
  }>(API_ENDPOINTS.geographyCounties);

  return result.counties || [];
}

export async function getPublicGeographyConstituencies(countyId: string) {
  const result = await requestPublicGeography<{
    constituencies: PublicGeographyConstituency[];
  }>(API_ENDPOINTS.geographyConstituencies(encodeURIComponent(countyId)));

  return result.constituencies || [];
}

export async function getPublicGeographyWards(constituencyId: string) {
  const result = await requestPublicGeography<{
    wards: PublicGeographyWard[];
  }>(API_ENDPOINTS.geographyWards(encodeURIComponent(constituencyId)));

  return result.wards || [];
}

export async function getPublicGeographyPlaces(countyId: string) {
  const result = await requestPublicGeography<{
    places: PublicGeographyPlace[];
  }>(API_ENDPOINTS.geographyPlaces(encodeURIComponent(countyId)));

  return result.places || [];
}

