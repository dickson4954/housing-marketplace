}

export async function getBusinessInventoryMovements(
  businessId: string,
  itemId: string,
): Promise<BusinessInventoryMovement[]> {
  return catalogueRequest(
    businessId,
    `/items/${encodeURIComponent(itemId)}/inventory-movements`,
  );
}

async function catalogueMediaRequest<T>(
  businessId: string,
  path: string,
  form: FormData,
): Promise<T> {
  const token = await getBusinessSetupToken();
  const response = await request<T>(
    `${cataloguePath(businessId)}${path}`,
    { method: 'POST', body: form },
    token,
  );
  if (response.data === undefined) {
    throw new Error(response.message || 'The image upload returned no data.');
  }
  return response.data;
}

function appendCatalogueImage(form: FormData, field: string, image: BusinessIdImage) {
  const filename = image.name || `catalogue-${Date.now()}.jpg`;
  const mimeType = image.mimeType || image.type || 'image/jpeg';
  if (Platform.OS === 'web' && image.file) {
    form.append(field, image.file, filename);
  } else {
    form.append(field, {
      uri: image.uri,
      name: filename,
      type: mimeType,
    } as any);
  }
}

export async function uploadBusinessCatalogueCategoryImage(
  businessId: string,
  categoryId: string,
  image: BusinessIdImage,
) {
  const form = new FormData();
  appendCatalogueImage(form, 'image', image);
  return catalogueMediaRequest<unknown>(
    businessId,
    `/categories/${encodeURIComponent(categoryId)}/image`,
    form,
  );
}

export async function uploadBusinessCatalogueItemImages(
  businessId: string,
  itemId: string,
  images: BusinessIdImage[],
) {
  if (!images.length || images.length > 8) {
    throw new Error('Choose between 1 and 8 images per upload.');
  }
  const form = new FormData();
  images.forEach((image) => appendCatalogueImage(form, 'images', image));
  return catalogueMediaRequest<unknown>(
    businessId,
    `/items/${encodeURIComponent(itemId)}/images`,
    form,
  );
}

export async function removeBusinessCatalogueCategoryImage(
  businessId: string,
  categoryId: string,
) {
  return catalogueRequest(
    businessId,
    `/categories/${encodeURIComponent(categoryId)}/image`,
    'DELETE',
  );
}

export async function removeBusinessCatalogueItemImage(
  businessId: string,
  itemId: string,
  imageId: string,
) {
  return catalogueRequest(
    businessId,
    `/items/${encodeURIComponent(itemId)}/images/${encodeURIComponent(imageId)}`,
    'DELETE',
  );
}
