async function getBusinessSetupToken(): Promise<string> {
  const token = await getBusinessOwnerToken();

  if (!token) {
    throw new Error('Please sign in to your business-owner account.');
  }

  return token;
}

export type BusinessStorefrontImageKind = 'logo' | 'banner';

export type BusinessStorefrontMediaResult = {
  logoUrl: string | null;
  bannerUrl: string | null;
  updatedAt?: string;
};

/**
 * Uploads or replaces one storefront brand image.
 * The backend keeps the uploaded object private and returns a public image URL.
 */
export async function uploadBusinessStorefrontImage(
  businessId: string,
  kind: BusinessStorefrontImageKind,
  image: BusinessIdImage,
): Promise<BusinessStorefrontMediaResult> {
  const token = await getBusinessSetupToken();
  const form = new FormData();
  const filename = image.name || `${kind}-${Date.now()}.jpg`;
  const mimeType = image.mimeType || image.type || 'image/jpeg';

  if (Platform.OS === 'web' && image.file) {
    form.append('image', image.file, filename);
  } else {
    form.append('image', {
      uri: image.uri,
      name: filename,
      type: mimeType,
    } as any);
  }

  const response = await request<BusinessStorefrontMediaResult>(
    `/business-owner/workspaces/${encodeURIComponent(businessId)}/storefront/media/${kind}`,
    { method: 'POST', body: form },
    token,
  );

  if (!response.data) {
    throw new Error('The server did not return the uploaded storefront image.');
  }

  return response.data;
}

/**
 * Removes an image from the editable storefront draft.
 * Previously published media remains available to the published snapshot.
 */
export async function removeBusinessStorefrontImage(
  businessId: string,
  kind: BusinessStorefrontImageKind,
): Promise<BusinessStorefrontMediaResult> {
  const token = await getBusinessSetupToken();

  const response = await request<BusinessStorefrontMediaResult>(
    `/business-owner/workspaces/${encodeURIComponent(businessId)}/storefront/media/${kind}`,
    { method: 'DELETE' },
    token,
  );

  if (!response.data) {
    throw new Error('The server did not confirm removal of the storefront image.');
  }

  return response.data;
}

/**
 * Loads the selected business profile and storefront draft.
 */
export async function getBusinessSetup(
  businessId: string,
): Promise<BusinessSetupResponse> {
  const token = await getBusinessSetupToken();

  const response = await request<BusinessSetupResponse>(
    `/business-owner/workspaces/${encodeURIComponent(businessId)}/setup`,
    { method: 'GET' },
    token,
  );

  if (!response.data?.business?.id) {
    throw new Error('The server returned invalid business setup details.');
  }

  return response.data;
}

/**
 * Saves business profile changes as a draft.
 */
export async function updateBusinessProfile(
  businessId: string,
  input: BusinessProfileInput,
): Promise<BusinessProfile> {
  const token = await getBusinessSetupToken();

  const response = await request<BusinessProfile>(
    `/business-owner/workspaces/${encodeURIComponent(businessId)}/profile`,
    {
      method: 'PATCH',
      body: JSON.stringify(input),
    },
    token,
  );

  if (!response.data) {
    throw new Error('The server did not return the saved business profile.');
  }

  return response.data;
}

/**
 * Saves storefront appearance as a draft.
 */
export async function updateBusinessStorefront(
  businessId: string,
  input: BusinessStorefrontInput,
): Promise<BusinessStorefront> {
  const token = await getBusinessSetupToken();

  const response = await request<BusinessStorefront>(
    `/business-owner/workspaces/${encodeURIComponent(businessId)}/storefront`,
    {
      method: 'PATCH',
      body: JSON.stringify(input),
    },
    token,
  );

  if (!response.data) {
    throw new Error('The server did not return the saved storefront draft.');
  }

  return response.data;
}

/**
 * Loads the authenticated draft preview.
 */
export async function getBusinessStorefrontPreview(
  businessId: string,
): Promise<BusinessStorefrontPreview> {
  const token = await getBusinessSetupToken();

  const response = await request<BusinessStorefrontPreview>(
    `/business-owner/workspaces/${encodeURIComponent(businessId)}/storefront/preview`,
    { method: 'GET' },
    token,
  );

  if (!response.data?.preview) {
    throw new Error('The server did not return the storefront preview.');
  }

  return response.data;
}

/**
 * Publishes the currently saved storefront draft.
 */
export async function publishBusinessStorefront(
  businessId: string,
): Promise<BusinessStorefrontPublishResult> {
  const token = await getBusinessSetupToken();

  const response = await request<BusinessStorefrontPublishResult>(
    `/business-owner/workspaces/${encodeURIComponent(businessId)}/storefront/publish`,
    {
      method: 'POST',
      body: JSON.stringify({}),
    },
    token,
  );

  if (response.data?.status !== 'PUBLISHED') {
    throw new Error('The server did not confirm storefront publication.');
  }

  return response.data;
}


/* BUSINESS CATALOGUE API */

export type BusinessCatalogueCategory = {
  id: string;
  businessId: string;
  name: string;
  slug?: string;
  description?: string | null;
  displayOrder?: number;
  isActive?: boolean;
  imageStorageKey?: string | null;
};

export type BusinessCatalogueVariant = {
  id: string;
  name: string;
  sku?: string | null;
  priceAmount?: number | null;
  stockQuantity?: number;
  trackInventory?: boolean;
  allowBackorder?: boolean;
  isActive?: boolean;
  displayOrder?: number;
  options?: unknown;
};

export type BusinessCatalogueImage = {
  id: string;
  altText?: string | null;
  displayOrder?: number;
  storageKey?: string;
};

export type BusinessCatalogueItem = {
  id: string;
  businessId: string;
  categoryId?: string | null;
  name: string;
  slug?: string;
  type: 'PRODUCT' | 'SERVICE' | 'MENU_ITEM';
  shortDescription?: string | null;
  description?: string | null;
  sku?: string | null;
  currency?: string;
  priceAmount?: number;
  compareAtPriceAmount?: number | null;
  specifications?: unknown;
  attributes?: unknown;
  durationMinutes?: number | null;
  preparationMinutes?: number | null;
  stockQuantity?: number;
  lowStockThreshold?: number;
  trackInventory?: boolean;
  allowBackorder?: boolean;
  isBookable?: boolean;
  isFeatured?: boolean;
  displayOrder?: number;
  status: 'DRAFT' | 'PUBLISHED' | 'ARCHIVED';
  category?: BusinessCatalogueCategory | null;
  variants?: BusinessCatalogueVariant[];
  images?: BusinessCatalogueImage[];
  createdAt?: string;
  updatedAt?: string;
};

export type BusinessCatalogueData = {
  categories: BusinessCatalogueCategory[];
  items: BusinessCatalogueItem[];
};

export type BusinessInventoryMovement = {
  id: string;
  quantityChange: number;
  quantityBefore: number;
  quantityAfter: number;
  reason: string;
  note?: string | null;
  reference?: string | null;
  createdAt: string;
  variantId?: string | null;
};

function cataloguePath(businessId: string) {
  return `/business-owner/workspaces/${encodeURIComponent(businessId)}/catalogue`;
}

async function catalogueRequest<T>(
  businessId: string,
  path: string,
  method = 'GET',
  body?: unknown,
): Promise<T> {
  const token = await getBusinessSetupToken();
  const response = await request<T>(
    `${cataloguePath(businessId)}${path}`,
    {
      method,
      ...(body !== undefined ? { body: JSON.stringify(body) } : {}),
    },
    token,
  );
  if (response.data === undefined) {
    throw new Error(response.message || 'The catalogue request returned no data.');
  }
  return response.data;
}

export async function getBusinessCatalogue(
  businessId: string,
): Promise<BusinessCatalogueData> {
  return catalogueRequest<BusinessCatalogueData>(businessId, '');
}

export async function createBusinessCatalogueCategory(
  businessId: string,
  input: { name: string; description?: string; displayOrder?: number },
): Promise<BusinessCatalogueCategory> {
  return catalogueRequest(businessId, '/categories', 'POST', input);
}

export async function updateBusinessCatalogueCategory(
  businessId: string,
  categoryId: string,
  input: Partial<BusinessCatalogueCategory>,
): Promise<BusinessCatalogueCategory> {
  return catalogueRequest(
    businessId,
    `/categories/${encodeURIComponent(categoryId)}`,
    'PATCH',
    input,
  );
}

export async function createBusinessCatalogueItem(
  businessId: string,
  input: Record<string, unknown>,
): Promise<BusinessCatalogueItem> {
  return catalogueRequest(businessId, '/items', 'POST', input);
}

export async function updateBusinessCatalogueItem(
  businessId: string,
  itemId: string,
  input: Record<string, unknown>,
): Promise<BusinessCatalogueItem> {
  return catalogueRequest(
    businessId,
    `/items/${encodeURIComponent(itemId)}`,
    'PATCH',
    input,
  );
}

export async function publishBusinessCatalogueItem(
  businessId: string,
  itemId: string,
): Promise<BusinessCatalogueItem> {
  return catalogueRequest(
    businessId,
    `/items/${encodeURIComponent(itemId)}/publish`,
    'POST',
    {},
  );
}

export async function archiveBusinessCatalogueItem(
  businessId: string,
  itemId: string,
): Promise<BusinessCatalogueItem> {
  return catalogueRequest(
    businessId,
    `/items/${encodeURIComponent(itemId)}/archive`,
    'POST',
    {},
  );
}

export async function createBusinessCatalogueVariant(
  businessId: string,
  itemId: string,
