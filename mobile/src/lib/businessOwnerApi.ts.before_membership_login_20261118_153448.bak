type ApiEnvelope<T> = {
  success: boolean;
  message?: string;
  data?: T;
};

type BusinessOwnerLoginData = {
  token: string;
  user: {
    id: string;
    firstName?: string;
    lastName?: string;
    email?: string;
    phone?: string;
    role?: string;
  };
  businessOwner: {
    id: string;
    status: string;
    idVerificationStatus: string;
    reviewNotes?: string | null;
    businesses: OwnerBusiness[];
  };
};

async function request<T>(
  endpoint: string,
  options: RequestInit = {},
  token?: string,
): Promise<ApiEnvelope<T>> {
  const headers = new Headers(options.headers);

  headers.set('Accept', 'application/json');

  if (token) {
    headers.set('Authorization', `Bearer ${token}`);
  }

  if (
    options.body &&
    !(options.body instanceof FormData)
  ) {
    headers.set('Content-Type', 'application/json');
  }

  let response: Response;

  try {
    response = await fetch(
      `${API_BASE_URL}${endpoint}`,
      {
        ...options,
        headers,
      },
    );
  } catch {
    throw new Error(
      'Unable to connect to MAKAZII. Check your internet connection and try again.',
    );
  }

  let result: ApiEnvelope<T>;

  try {
    result = await response.json();
  } catch {
    throw new Error(
      'The server returned an invalid response.',
    );
  }

  if (!response.ok || !result.success) {
    throw new Error(
      result.message ||
      `MAKAZII request failed (${response.status}).`,
    );
  }

  return result;
}

async function saveToken(token: string) {
  if (Platform.OS === 'web') {
    if (typeof window !== 'undefined') {
      window.localStorage.setItem(TOKEN_KEY, token);
    }
    return;
  }

  await SecureStore.setItemAsync(TOKEN_KEY, token);
}

export async function getBusinessOwnerToken(): Promise<string | null> {
  if (Platform.OS === 'web') {
    if (typeof window === 'undefined') return null;

    return window.localStorage.getItem(TOKEN_KEY);
  }

  return SecureStore.getItemAsync(TOKEN_KEY);
}

export async function clearBusinessOwnerToken() {
  if (Platform.OS === 'web') {
    if (typeof window !== 'undefined') {
      window.localStorage.removeItem(TOKEN_KEY);
    }
    return;
  }

  await SecureStore.deleteItemAsync(TOKEN_KEY);
}

function appendImage(
  form: FormData,
  field: string,
  image: BusinessIdImage,
  fallbackName: string,
) {
  if (!image?.uri) {
    throw new Error(
      `Please upload ${field === 'idFront' ? 'the front' : 'the back'} of your National ID.`,
    );
  }

  const filename = image.name || fallbackName;
  const mimeType =
    image.mimeType ||
    image.type ||
    'image/jpeg';

  if (Platform.OS === 'web' && image.file) {
    form.append(field, image.file, filename);
    return;
  }

  form.append(
    field,
    {
      uri: image.uri,
      name: filename,
      type: mimeType,
    } as any,
  );
}

function appendLocationEvidence(
  form: FormData,
  evidence: BusinessLocationEvidenceUpload[],
) {
  if (!Array.isArray(evidence) || evidence.length > 8) {
    throw new Error('Upload no more than eight location evidence images.');
  }

  const manifest = evidence.map(item => {
    if (!item?.image?.uri) {
      throw new Error('One of the selected location evidence images is missing.');
    }

    return { evidenceType: item.evidenceType };
  });

  form.append('evidenceManifest', JSON.stringify(manifest));

  evidence.forEach((item, index) => {
    const image = item.image;
    const mimeType = image.mimeType || image.type || 'image/jpeg';
    const filename = image.name || `location-evidence-${index + 1}.jpg`;

    if (!['image/jpeg', 'image/png', 'image/webp'].includes(mimeType)) {
      throw new Error('Location evidence must be a JPEG, PNG or WebP image.');
    }

    if (Platform.OS === 'web') {
      if (!image.file) {
        throw new Error(
          'Please remove and reselect this image so the browser can attach the original file.',
        );
      }

      form.append('locationEvidence', image.file, filename);
      return;
    }

    form.append(
      'locationEvidence',
      {
        uri: image.uri,
        name: filename,
        type: mimeType,
      } as any,
    );
  });
}

function appendLocation(
  form: FormData,
  location: BusinessLocationInput,
  evidence: BusinessLocationEvidenceUpload[],
) {
  form.append('location', JSON.stringify(location));
  appendLocationEvidence(form, evidence);
}

export async function registerBusinessOwner(
  input: BusinessOwnerRegistrationInput,
) {
  const form = new FormData();

  form.append('firstName', input.firstName.trim());
  form.append('lastName', input.lastName.trim());
  form.append('email', input.email.trim().toLowerCase());
  form.append('phone', input.phone.trim());
  form.append('password', input.password);
  form.append('nationalIdNumber', input.nationalIdNumber.trim());

  form.append(
    'firstBusiness',
    JSON.stringify(input.firstBusiness),
  );

  appendLocation(form, input.location, input.locationEvidence);

  appendImage(
    form,
    'idFront',
    input.idFront,
    'national-id-front.jpg',
  );

  appendImage(
    form,
    'idBack',
    input.idBack,
    'national-id-back.jpg',
  );

  const response = await request<{
    user: BusinessOwnerLoginData['user'];
    businessOwner: BusinessOwnerLoginData['businessOwner'];
    business: OwnerBusiness;
    verificationRequired: boolean;
    verificationExpiresAt?: string | null;
  }>(
    '/auth/business-owner/signup',
    {
      method: 'POST',
      body: form,
    },
  );

  if (!response.data) {
    throw new Error(
      'The server did not return the registration details.',
    );
  }

  // Registration intentionally does not save a session token.
  // The applicant verifies their email, then uses Business Login.
  return response.data;
}

export async function loginBusinessOwner(
  emailOrPhone: string,
  password: string,
) {
  const response = await request<BusinessOwnerLoginData>(
    '/auth/business-owner/login',
    {
      method: 'POST',
      body: JSON.stringify({
        emailOrPhone: emailOrPhone.trim(),
        password,
      }),
    },
  );

  if (!response.data?.token) {
    throw new Error(
      'The server did not return a Business Login token.',
    );
  }

  await saveToken(response.data.token);

  return response.data;
}

export async function verifyBusinessOwnerEmail(
  email: string,
  code: string,
) {
  const response = await request<{
    user?: BusinessOwnerLoginData['user'];
    token?: string;
  }>(
    '/auth/business-owner/verify-email',
    {
      method: 'POST',
      body: JSON.stringify({
        email: email.trim().toLowerCase(),
        code: code.trim(),
      }),
    },
  );

  return response;
}

export async function resendBusinessOwnerVerification(
  email: string,
) {
  const response = await request<{
    verificationExpiresAt?: string;
  }>(
    '/auth/business-owner/resend-verification',
    {
      method: 'POST',
      body: JSON.stringify({
        email: email.trim().toLowerCase(),
      }),
    },
  );

  return response;
}

export async function getBusinessOwnerStatus() {
  const token = await getBusinessOwnerToken();

  if (!token) {
    throw new Error(
      'Please sign in to your business-owner account.',
    );
  }

  const response = await request<BusinessOwnerStatus>(
    '/business-owner/me',
    {
      method: 'GET',
    },
    token,
  );

  if (!response.data) {
    throw new Error(
      'Unable to retrieve your business application.',
    );
  }

  return response.data;
}

export async function getOwnerBusinesses() {
  const token = await getBusinessOwnerToken();

  if (!token) {
    throw new Error(
      'Please sign in to your business-owner account.',
    );
  }

  const response = await request<BusinessOwnerStatus>(
    '/business-owner/businesses',
    {
      method: 'GET',
    },
    token,
  );

  return response.data;
}

export async function addBusinessForOwner(
  input: FirstBusinessInput,
  location: BusinessLocationInput,
  locationEvidence: BusinessLocationEvidenceUpload[],
) {
  const token = await getBusinessOwnerToken();

  if (!token) {
    throw new Error(
      'Please sign in to your business-owner account.',
    );
  }

  const form = new FormData();
  form.append('business', JSON.stringify(input));
  appendLocation(form, location, locationEvidence);

  const response = await request<{
    business: OwnerBusiness;
    ownerApplication: {
      status: string;
      idVerificationStatus: string;
    };
    message: string;
  }>(
    '/business-owner/businesses',
    {
      method: 'POST',
      body: form,
    },
    token,
  );

  return response.data;
}

export async function correctBusinessLocation(
  businessId: string,
  locationId: string,
  location: BusinessLocationInput,
  locationEvidence: BusinessLocationEvidenceUpload[],
) {
  const token = await getBusinessOwnerToken();

  if (!token) {
    throw new Error(
      'Please sign in to your business-owner account.',
    );
  }

  const form = new FormData();
  appendLocation(form, location, locationEvidence);

  const response = await request<{
    businessId: string;
    location: {
      id: string;
      status: string;
    };
    message: string;
  }>(
    `/business-owner/businesses/${encodeURIComponent(businessId)}/locations/${encodeURIComponent(locationId)}/correction`,
    {
      method: 'PATCH',
      body: form,
    },
    token,
  );

  if (!response.data) {
    throw new Error(
      response.message || 'Unable to resubmit your premises details.',
    );
  }

  return response.data;
}


/**
 * Returns only workspaces the backend currently authorises
 * for this authenticated business-owner account.
 */
export async function getApprovedBusinessWorkspaces(): Promise<ApprovedBusinessWorkspace[]> {
  const token = await getBusinessOwnerToken();

  if (!token) {
    throw new Error("Please sign in to your business-owner account.");
  }

  const response = await request<ApprovedBusinessWorkspace[]>(
    "/business-owner/workspaces",
    { method: "GET" },
    token,
  );

  if (!Array.isArray(response.data)) {
    throw new Error("The server returned an invalid workspace list.");
  }

  return response.data;
}

/**
 * Retrieves one selected workspace. The backend rechecks
 * membership, owner approval, identity and business approval.
 */
export async function getApprovedBusinessWorkspace(
  businessId: string,
): Promise<BusinessWorkspaceDetails> {
  const token = await getBusinessOwnerToken();

  if (!token) {
    throw new Error("Please sign in to your business-owner account.");
  }

  const response = await request<BusinessWorkspaceDetails>(
    `/business-owner/workspaces/${encodeURIComponent(businessId)}`,
    { method: "GET" },
    token,
  );

  if (!response.data?.id) {
    throw new Error("The server did not return the selected workspace.");
  }

  return response.data;
}

/**
 * Retrieves live operational indicators for the selected business.
 * Access is checked by the protected business-owner workspace endpoint.
 */
export async function getBusinessWorkspaceOverview(
  businessId: string,
): Promise<BusinessWorkspaceOverview> {
  const token = await getBusinessOwnerToken();

  if (!token) {
    throw new Error("Please sign in to your business-owner account.");
  }

  const response = await request<BusinessWorkspaceOverview>(
    `/business-owner/workspaces/${encodeURIComponent(businessId)}/overview`,
    { method: "GET" },
    token,
  );

  if (!response.data?.business?.id) {
    throw new Error("The server did not return the business overview.");
  }

  return response.data;
}

